for oo in kugeCC do
(if (lclnum1=findItem lcl_selbijiao oo.material)==0 or(lclnum1!=0 and (findItem lcl_selbijiao oo.wireColor)!=(lclnum1+1))do
(append lcl_selbijiao oo.material
append lcl_selbijiao oo.wireColor))
if lcl_selbijiao.count>0 do
(for b in kugeAA do(lclnum2=findItem lcl_selbijiao b.material
lclnum3=findItem lcl_selbijiao b.wireColor
if (lclnum3-lclnum2)==1 do append kugeCCC b))
Groupfiltrate kugeCCC undefined))	
