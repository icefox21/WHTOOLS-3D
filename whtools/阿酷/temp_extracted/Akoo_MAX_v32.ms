rollout KR_ModuleDriveLine "阿酷_车道线生成工具" width:221 height:220
(local DriveLineMode=(getINISetting (getMAXIniFile()) "akoo2009" "DriveLineMode")as Integer
local DriveLineScal=(getINISetting (getMAXIniFile()) "akoo2009" "DriveLineScal")as float
local DriveLineDash=(getINISetting (getMAXIniFile()) "akoo2009" "DriveLineDash")as float
