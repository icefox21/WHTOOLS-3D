)
if KC_CBG2.state or KC_CBG4.state do(KL_Pos=for r=1 to 3 collect getUserProp m ("Rotate"+(r as string))
KL_MovY=try([KL_Pos[1],KL_Pos[2],KL_Pos[3]])catch(undefined)
KL_RanN1=-KL_SP2.value
if KC_CB92.state then KL_RanN2=KL_SP2B.value
else KL_RanN2=KL_SP2.value
KL_Move=[(random KL_RanN1 KL_RanN2),(random KL_RanN1 KL_RanN2),(random KL_RanN1 KL_RanN2)]
if (not KC_CBB1.state and not KC_CBB4.state) do KL_Move[1]=0
if (not KC_CBB2.state and not KC_CBB4.state) do KL_Move[2]=0
if (not KC_CBB3.state and not KC_CBB4.state) do KL_Move[3]=0
if KL_MovY!=undefined then if not KC_CBS2.state do(m.rotation.x_rotation=KL_MovY[1]
m.rotation.y_rotation=KL_MovY[2]
m.rotation.z_rotation=KL_MovY[3])
else(setUserProp m "Rotate1" m.rotation.x_rotation
setUserProp m "Rotate2" m.rotation.y_rotation
setUserProp m "Rotate3" m.rotation.z_rotation)
case KL_RA2.state of   
(
1:(coordsys world  Rotate m (eulerangles KL_Move[1] KL_Move[2] KL_Move[3]))
2:(coordsys local  Rotate m (eulerangles KL_Move[1] KL_Move[2] KL_Move[3]))
3:(coordsys screen  Rotate m (eulerangles KL_Move[1] KL_Move[2] KL_Move[3]))
)
)
if KC_CBG3.state or KC_CBG4.state do(KL_Pos=for r=1 to 3 collect getUserProp m ("Scale"+(r as string))
KL_MovY=try([KL_Pos[1],KL_Pos[2],KL_Pos[3]])catch(undefined)
KL_RanN1=1-KL_SP3.value
if KC_CB93.state then KL_RanN2=1+KL_SP3B.value
else KL_RanN2=1+KL_SP3.value
KL_VBC=random KL_RanN1 KL_RanN2
KL_Move=[KL_VBC,KL_VBC,KL_VBC]
if (not KC_CBC1.state and not KC_CBC4.state) do KL_Move[1]=1
if (not KC_CBC2.state and not KC_CBC4.state) do KL_Move[2]=1
if (not KC_CBC3.state and not KC_CBC4.state) do KL_Move[3]=1
if KL_MovY!=undefined then if not KC_CBS3.state do m.scale=KL_MovY
else for r=1 to 3 do setUserProp m ("Scale"+(r as string)) m.scale[r]
case KL_RA3.state of   
(
1:(coordsys world  scale m KL_Move)
2:(coordsys local  scale m KL_Move)
3:(coordsys screen  scale m KL_Move)
)
)
)))
on KC_BU5  pressed do(undo on(
KLSel=for i in selection where not(isGroupMember i and not isOpenGroupMember i) and isProperty i "rotation" collect i 
for m in KLSel do(if KC_CBG1.state or KC_CBG4.state do(KL_Pos=for r=1 to 3 collect getUserProp m ("Move"+(r as string))
KL_MovY=try([KL_Pos[1],KL_Pos[2],KL_Pos[3]])catch(undefined)
if KL_MovY!=undefined do m.pos=KL_MovY
for r=1 to 3 do setUserProp m ("Move"+(r as string)) undefined)
if KC_CBG2.state or KC_CBG4.state do(KL_Pos=for r=1 to 3 collect getUserProp m ("Rotate"+(r as string))
KL_MovY=try([KL_Pos[1],KL_Pos[2],KL_Pos[3]])catch(undefined)
if KL_MovY!=undefined do(m.rotation.x_rotation=KL_MovY[1]
m.rotation.y_rotation=KL_MovY[2]
m.rotation.z_rotation=KL_MovY[3])
for r=1 to 3 do setUserProp m ("Rotate"+(r as string)) undefined)									  
if KC_CBG3.state or KC_CBG4.state do(KL_Pos=for r=1 to 3 collect getUserProp m ("Scale"+(r as string))
KL_MovY=try([KL_Pos[1],KL_Pos[2],KL_Pos[3]])catch(undefined)
if KL_MovY!=undefined do m.scale=KL_MovY
for r=1 to 3 do setUserProp m ("Scale"+(r as string)) undefined)))) 
on KC_BU6  pressed do(undo on(
KLSel=for i in selection where not(isGroupMember i and not isOpenGroupMember i) and isProperty i "rotation" collect i 
for m in KLSel do(if KC_CBG1.state or KC_CBG4.state do for r=1 to 3 do setUserProp m ("Move"+(r as string)) undefined
if KC_CBG2.state or KC_CBG4.state do for r=1 to 3 do setUserProp m ("Rotate"+(r as string)) undefined								  
