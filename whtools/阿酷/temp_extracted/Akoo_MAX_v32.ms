else(KC_Sub2.value=KL_FillArrN
KC_Sub1.value=(KL_FillDirN*Syun))
KC_BU2.visible=(KC_Sub1.enabled and not KC_BU1.enabled)
KC_BU2.text=KL_TruDirN)
on KC_BU4 changed sp1 do(if sp1 then(KL_Arshape=pickObject message:"点击阵列路径:" filter:kuge_singleFIshape
