fn KF_CollAkooFile aa=
(KL_UntleFiAR=#()
KL_MUA=#((GetDir #ui),((GetDir #ui)+"macroscripts\\"),((GetDir #startupScripts)+"\\"),((GetDir #scripts)+"\\"),((GetDir #maxData)+"ui\\"),((GetDir #userMacros)+"\\"),((GetDir #userStartupScripts)+"\\"),((GetDir #userScripts)+"\\"),((GetDir #help)+"\\"),(GetDir #maxData))
for m in KL_MUA do(if aa do(join KL_UntleFiAR (getFiles(m+"阿酷*.*"))
join KL_UntleFiAR (getFiles(m+"Max*UI.*"))
join KL_UntleFiAR (getFiles(m+"akoo*.*"))
join KL_UntleFiAR (getFiles(m+"akoo2008*.*"))
join KL_UntleFiAR (getFiles(m+"AK*.max"))
join KL_UntleFiAR (getFiles(m+"AK_*.*")))
join KL_UntleFiAR (getFiles(m+"kuge*.*"))
join KL_UntleFiAR (getFiles(m+"lcl*.*")))
KL_UntleFiARG=for m in KL_UntleFiAR where (getFilenameType m)==".ms"or(getFilenameType m)==".mcr"or(getFilenameType m)==".mse" collect m
#(KL_MUA,KL_UntleFiAR,KL_UntleFiARG))
