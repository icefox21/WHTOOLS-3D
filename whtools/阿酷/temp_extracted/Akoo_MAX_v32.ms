fn lcl_Tools_Gravity=
(undo on(if selection.count>0 do(KF_SceneUnitsJC()	
KL_LuoDiJZIniSet=(getINISetting(getMAXIniFile())"akoo2009" "KL_LuoDiJZIniSet")=="1"
if selection.count==1 and canConvertTo selection[1] Mesh and (selection[1].max.z-selection[1].min.z)<(10*Syun) then(if canConvertTo selection[1] SplineShape then 
(thawSelection()
lclMatpik=pickObject message:"点击落地目标对象:" filter:ViewgeoFilt  
if lclMatpik!=undefined do
(jk=copy selection[1] name:("Map_"+selection[1].name) 
if classof jk !=line and classof jk !=SplineShape do convertToSplineShape jk                             
select lclMatpik
kugeINdist=for i in selection where ViewgeoFilt i collect snapshot i
for g=2 to  kugeINdist.count do meshop.attach  kugeINdist[1].mesh  kugeINdist[g].mesh targetNode:kugeINdist[1] sourceNode:kugeINdist[g] attachMat:#IDToMat condenseMat:true
if kugeINdist[1]!=undefined do(for t=1 to numSplines jk do(for u=1 to numKnots jk t do(KL_Point=getKnotPoint jk t u
kugeZpoint=kugeZAinter kugeINdist[1] iik KL_Point false KL_LuoDiJZIniSet
if kugeZpoint!=undefined do setKnotPoint jk t u kugeZpoint.pos)))
updateShape jk
select jk
delete kugeINdist[1]))
else(if canConvertTo selection[1] Mesh do
(thawSelection()
lclMatpik=pickObject message:"点击落地目标对象:" filter:ViewgeoFilt  
if lclMatpik!=undefined do
(jk=copy selection[1] name:("Map_"+selection[1].name) 
convertToMesh jk
select lclMatpik
kugeINdist=for i in selection where ViewgeoFilt i collect snapshot i
for g=2 to  kugeINdist.count do meshop.attach  kugeINdist[1].mesh  kugeINdist[g].mesh targetNode:kugeINdist[1] sourceNode:kugeINdist[g] attachMat:#IDToMat condenseMat:true
if kugeINdist[1]!=undefined do(for t=1 to jk.numverts do(KL_Point=getVert jk t
kugeZpoint=kugeZAinter kugeINdist[1] iik KL_Point false KL_LuoDiJZIniSet
if kugeZpoint!=undefined do setVert jk t kugeZpoint.pos))
update jk
select jk
delete kugeINdist[1]))))
else(kugegetM=for i in selection where not(isGroupMember i and not isOpenGroupMember i) collect i 
if kugegetM.count>0 do
(thawSelection()
lclMatpik=pickObject message:"点击落地目标对象:" filter:ViewgeoFilt
if lclMatpik!=undefined do(select lclMatpik
kugeINdist=for i in selection where ViewgeoFilt i collect  i
KL_LuoDiObj=snapshot kugeINdist[1]                      
if kugeINdist.count>1 do for g=2 to  kugeINdist.count do(KL_PPPObj=snapshot kugeINdist[g]
meshop.attach  KL_LuoDiObj.mesh  KL_PPPObj.mesh targetNode:KL_LuoDiObj sourceNode:KL_PPPObj attachMat:#IDToMat condenseMat:true)
for iik in kugegetM do(kugeZpoint=kugeZAinter KL_LuoDiObj iik ggg true KL_LuoDiJZIniSet
if KL_LuoDiJZIniSet then(KL_Oldpos1=iik.center
KL_Oldpos2=iik.Min
KL_Oldpos3=[KL_Oldpos1.x,KL_Oldpos1.y,KL_Oldpos2.z])
else KL_Oldpos3=iik.pivot
if kugeZpoint!=undefined do iik.pos=iik.pos+(kugeZpoint.pos-KL_Oldpos3))
select kugegetM
delete KL_LuoDiObj)))
gc())))
