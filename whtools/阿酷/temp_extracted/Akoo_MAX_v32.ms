local KGL_YouZFNum6=(getINISetting (getMAXIniFile()) "akoo2009" "KGL_YouZFNum6")as integer
local KGL_YouZFNum7=(getINISetting (getMAXIniFile()) "akoo2009" "KGL_YouZFNum7")as integer
