KL_upper="ABCDEFGHIJKLMNOPQRSTUVWXYZ"
KL_lower="abcdefghijklmnopqrstuvwxyz"
KL_OncecouA=zifu1.count
for i=1 to KL_OncecouA do if(KL_aa1=findString KL_upper zifu1[i])!=undefined do zifu1[i]=KL_lower[KL_aa1]
zifu1)                             ----大写转小写函数;
