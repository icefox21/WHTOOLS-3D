if aa==1 then(KC_ET26.visible=KC_LB27.visible=KC_ET28.visible=true
KC_OutBack.visible=KC_OutBack1.visible=false)
else(KC_ET26.visible=KC_LB27.visible=KC_ET28.visible=false
KC_OutBack.visible=KC_OutBack1.visible=true))	
on KC_OutBack pressed do(KL_FileN=getSaveFileName caption:"设置输出路径" filename:("浏览到目标文件夹直接点保存") types:"输出路径(*.输出文件夹)|*.*|"
if KL_FileN!=undefined do(KL_JyFiname=getFilenamePath KL_FileN
KC_OutBack1.text=KL_JyFiname
rendOutputFilename=KL_JyFiname+(getFilenameFile maxFileName)+KC_DL24.selected
renderSceneDialog.update()))
on KC_BT29 pressed do(if KC_LB25.state==1 or rendOutputFilename==""
then ShellLaunch  ("\""+(KF_AutoPathFile KC_ET26 KC_ET28 maxFilePath)+"\"") ""
else KFShellPathFN rendOutputFilename)
on KC_CB18 changed aa do(if(not aa)and KC_CB22.checked and KC_CB22.checked do(messageBox "开启自动邮件功能的情况下不允许取消“自动打包”选项!" title:"自动邮件功能警告--阿酷提示"
KC_CB18.checked=true))
