on KC_DLF2 selected aa do(KGL_kuge_AK1102=KGL_SceneMatLIB[2]=KC_DLF2.selected
setINISetting (getMAXIniFile()) "akoo2009" "INI_RightPerYS2" KC_DLF2.selected)
