if findItem lcl_pos_view (viewport.getType())!=0 then(case kugepp=viewport.getType() of
(
#view_top:(kugeINDir=-(getViewTM()).row3
KUGEINRay = ray KL_Vpoint kugeINDir)
#view_bottom:(kugeINDir=-(getViewTM()).row3
KUGEINRay = ray KL_Vpoint kugeINDir)
#view_front:(kugeINDir=(getViewTM()).row3
