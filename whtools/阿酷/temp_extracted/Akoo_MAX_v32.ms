CreateDialog KR_AuotConn_roll width:200 height:110 pos:[(mouse.screenpos[1]-200),mouse.screenpos[2]]))
if (getINISetting (getMAXIniFile()) "akoo2009" "SplineAutoDir")=="" do setINISetting (getMAXIniFile()) "akoo2009" "SplineAutoDir" "1"
global kugeEdSpModAr=#("Edit Spline","编辑样条线","Editable Spline","Line","可编辑样条线")
fn kugecompareFNY v1 v2 valArray: =
(kd=valArray[V1].y-valArray[V2].y
case of
(
(kd < 0.): -1
(kd > 0.): 1
default: 0
)
)
fn kuge_spline_fanlib kugefan=						 
(local kugevetou,kugexum,kuge2,kuge1,kugeff
for g=1 to numSplines kugefan do(kugevetou=for kkk=1 to (numKnots kugefan g) collect (in coordsys local getKnotPoint kugefan g kkk)
kugexum=for bb=1 to (numKnots kugefan g) collect bb
qsort kugexum kugecompareFNY valArray:kugevetou
kuge2=kugevetou[(kugexum[2])]
kuge1=kugevetou[(kugexum[1])]
kugeff=kugexum[2]-kugexum[1]
if (isClosed kugefan g) do(if kuge2.x-kuge1.x<0 then if(kugeff>0 and kugeff!=kugexum.count-1)or(kugeff<0 and kugeff==-(kugexum.count-1))do reverse kugefan g
else if(kugeff<0 and kugeff!=-(kugexum.count-1))or(kugeff>0 and kugeff==kugexum.count-1)do reverse kugefan g)))
fn kuge_spline_fnlib ggg zicengji VV=   ---第三个变量用来作为条件一决定是否需要统一所有子线条方向的处理
(if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify
KL_Temp=modPanel.getCurrentObject()
if selection.count==1 and superclassof selection[1].baseObject==shape then
(kugeyy=selection[1].modifiers.count
if kugeyy==0 then(if classof selection[1]!=line and classof selection[1]!=SplineShape do convertToSplineShape selection[1]
if subObjectLevel!=zicengji do subObjectLevel=zicengji
if VV and (getINISetting (getMAXIniFile()) "akoo2009" "SplineAutoDir")=="1" do kuge_spline_fanlib selection[1]
ggg selection[1])
else(if findItem kugeEdSpModAr (selection[1].baseObject as string)==0 and superclassof selection[1].baseObject==shape do
(if findItem kugeEdSpModAr (selection[1].modifiers)[kugeyy].name==0 then(modPanel.setCurrentObject selection[1].baseObject node:selection[1] 
modPanel.addModToSelection (Edit_Spline()))
else maxOps.CollapseNodeTo selection[1] kugeyy true)  
if findItem kugeEdSpModAr (selection[1].baseObject as string)!=0 do
(modPanel.setCurrentObject selection[1].baseObject node:selection[1]
if subObjectLevel!=zicengji do subObjectLevel=zicengji
if VV and (getINISetting (getMAXIniFile()) "akoo2009" "SplineAutoDir")=="1" do kuge_spline_fanlib selection[1]
ggg selection[1])))
else(if selection.count==1 do(if classof KL_Temp==Editable_mesh do meshOps.startAttach selection[1]
if classof KL_Temp==Edit_Mesh do meshOps.startAttach KL_Temp
if classof KL_Temp==Editable_Poly do KL_Temp.enterPickMode #Attach
if classof KL_Temp==Edit_Poly do KL_Temp.enterPickMode #Attach)))
fn lcl_spline_Weld=
(undo on(	
if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify
if selection.count==1 and superclassof selection[1].baseObject==shape and numSubObjectLevels>0 do
(lcliduu=modPanel.getCurrentObject()
if lcliduu.superClassID==2064 and findItem kugeEdSpModAr lcliduu.name!=0 do
(kugeyy=modPanel.getModifierIndex selection[1] lcliduu
maxOps.CollapseNodeTo selection[1] kugeyy true
modPanel.setCurrentObject selection[1].baseObject node:selection[1])
if (modPanel.getCurrentObject())==selection[1].baseObject do
(if subObjectLevel!=1 do subObjectLevel=1
for g=1 to numSplines selection[1] do(setKnotSelection selection[1] g #()
if not(isClosed selection[1] g) do
(kugehh=numKnots selection[1] g
setKnotSelection selection[1] g #(1,kugehh) keep:true))
splineOps.weld selection[1]))))
fn lcl_spline_Fuse=
(if subObjectLevel==1 do
(lcliduu=modPanel.getCurrentObject()
if lcliduu.superClassID==2064 and findItem kugeEdSpModAr lcliduu.name!=0 do(splineOps.fuse lcliduu
splineOps.weld lcliduu)
if lcliduu==selection[1].baseObject and findItem kugeEdSpModAr (lcliduu as string)!=0 do
(splineOps.fuse selection[1]
splineOps.weld selection[1])))		 										  
fn lcl_spline_Connect=
(undo off(
lcliduu=modPanel.getCurrentObject()	
if selection.count==1 and lcliduu==selection[1].baseObject and findItem kugeEdSpModAr (lcliduu as string)!=0 and  subObjectLevel==1 do
(kugeconn=selection[1]
lcl_con_vetT=#()
lcl_con_vetA=#()
kugetr=numSplines kugeconn
for d=1 to kugetr do(lcl_vetxu=getKnotSelection kugeconn d
for gg in lcl_vetxu do(append lcl_con_vetT (getKnotPoint kugeconn d gg)
if findItem #(1,(numKnots kugeconn d)) gg!=0 do append lcl_con_vetA (getKnotPoint kugeconn d gg)))
if lcl_con_vetT.count==2 then lcl_con_vet=lcl_con_vetT
else lcl_con_vet=lcl_con_vetA
if lcl_con_vet.count==2 do(lcl_con_new=splineShape()
addnewSpline lcl_con_new
addKnot lcl_con_new 1 #corner #line lcl_con_vet[1]
addKnot lcl_con_new 1 #corner #line lcl_con_vet[2]
updateShape lcl_con_new
addAndWeld kugeconn lcl_con_new 0
max select none))))
global lcl_div_lcllen=1000
global lcl_div_lclnum=2
fn lcl_divisionFN lcl_divstyle=
(local lcliduu,kugerrb,lclkkksel,lclseginit,lclseg,lcl_len,lclsegdiv,lclsegcur,lclsegdiv,kugelo,vkj
if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify
lcliduu=modPanel.getCurrentObject()	
if selection.count==1 and lcliduu==selection[1].baseObject and findItem kugeEdSpModAr (lcliduu as string)!=0 and subObjectLevel==2 and selection[1].modifiers.count==0 do	
(lclABC=selection[1] 
lclkkksel=copy lclABC
thawSelection()
clearSelection()  
delete lclABC
select lclkkksel            
for d=1 to numSplines lclkkksel do
(lclseginit=0
lclseg=getSegSelection lclkkksel d
lcl_len=getSegLengths lclkkksel d 
for ff=1 to lclseg.count do
(if lcl_divstyle==2 then lclsegdiv=lcl_div_lclnum
else(lclsegcur=lcl_len[lclseg[ff]+(lcl_len.count-1)/2]
lclsegdiv=(floor(lclsegcur/lcl_div_lcllen))as Integer)
if lclsegdiv>1 do(if lclsegdiv>400 do lclsegdiv=400
kugelo=lclseg[ff]+lclseginit
subdivideSegment lclkkksel d kugelo (lclsegdiv-1)
lclseginit+=(lclsegdiv-1)
vkj=for gk=kugelo to lclseg[ff]+lclseginit collect gk
setSegSelection lclkkksel d vkj keep:true)))))	
fn lcl_spline_division=
(if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify
lcliduu=modPanel.getCurrentObject()	
if selection.count==1 and lcliduu==selection[1].baseObject and findItem kugeEdSpModAr (lcliduu as string)!=0 and numSubObjectLevels>0 and selection[1].modifiers.count==0 do
(if subObjectLevel!=2 do(subObjectLevel=2
max select none)
KF_SceneUnitsJC()				 
rollout spline_divroll "阿酷--样条线等分工具" 
(spinner lcllenSS "指定间距: "fieldWidth:55  range:[(100*Syun),(50000*Syun),(lcl_div_lcllen*Syun)] scale:(100*Syun)  pos:[8,10]
button bylen "按间距等分" width:80 pos:[138,7] 
spinner lclnum "指定数量: "fieldWidth:55  type:#integer scale:1 range:[2,500,lcl_div_lclnum] pos:[8,37]
button bynum "按数量等分" width:80 offset:[0,3] pos:[138,35] 
on lcllenSS changed val do global lcl_div_lcllen=val 
on lclnum changed val do global lcl_div_lclnum=val
on bylen pressed do undo on(lcl_divisionFN 1)
on bynum pressed do undo on(lcl_divisionFN 2)
on spline_divroll open do KF_SceneUnitsJC()
on spline_divroll rbuttondown xs do DestroyDialog spline_divroll)
CreateDialog spline_divroll width:232 height:65 pos:[(mouse.screenpos[1]-232),mouse.screenpos[2]]))   
global KG_ADyuzhi=0.015
global KG_AutoDS=1000
global KG_AutoDS_S=false
global KG_AutoDE=10000
global KG_AutoDE_S=false
fn lcl_AutoDivFN ADVi1 ADVi2 ADVi3=
(local lcliduu,kugerrb,lclkkksel,lclseginit,lclseg,lcl_len,lclsegdiv,lclsegcur,lclsegdiv,kugelo,vkj
if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify
lcliduu=modPanel.getCurrentObject()	
if selection.count==1 and lcliduu==selection[1].baseObject and findItem kugeEdSpModAr (lcliduu as string)!=0 and numSubObjectLevels>0 and selection[1].modifiers.count==0 do	
(if subObjectLevel!=0 do subObjectLevel=0
kugerrb=selection[1]
KL_sel=copy kugerrb
thawSelection()
clearSelection()  
select KL_sel        
subObjectLevel=1          
for q=1 to numSplines KL_sel do
(KL_TempS=getSegLengths KL_sel q
KL_TeN=KL_TempS.count
KL_TempN=for w=((KL_TeN-1)/2+1) to (KL_TeN-1) collect KL_TempS[w]
KL_CCN=0
for r=1 to (KL_TempN.count-1) do
(KL_A1=KL_TempN[r]
KL_ii=(KL_TempN[r]/ADVi2)as Integer
if KL_ii>400 do KL_ii=400
KL_uu=(KL_TempN[r]/ADVi3)as Integer
if KL_uu>400 do KL_uu=400
KL_A2=distance (getKnotPoint KL_sel q (r+KL_CCN)) (getKnotPoint KL_sel q ((r+KL_CCN)+1))
KL_CN=(1-KL_A2/KL_A1)/ADVi1
if KL_CN>400 do KL_CN=400
case  of
(
(KL_CN<2 and KL_CN>0.001):(if KL_uu>=2 do(subdivideSegment KL_sel q (r+KL_CCN) (KL_uu-1)
KL_CCN+=(KL_uu-1)))
(KL_CN>=2):(if KL_ii>=2 do(if KL_ii<(KL_CN as Integer)
then(subdivideSegment KL_sel q (r+KL_CCN) (KL_ii-1)
KL_CCN+=(KL_ii-1))
else(subdivideSegment KL_sel q (r+KL_CCN) ((KL_CN as Integer)-1)
KL_CCN+=((KL_CN as Integer)-1))))
)
)
KL_A1=KL_TempN[KL_TempN.count]
KL_uu=(KL_TempN[KL_TempN.count]/ADVi3)as Integer
if KL_uu>400 do KL_uu=400
KL_ii=(KL_TempN[KL_TempN.count]/ADVi2)as Integer
if KL_ii>400 do KL_ii=400
if isClosed KL_sel q then(KL_A2=distance(getKnotPoint KL_sel q(KL_TempN.count+KL_CCN))(getKnotPoint KL_sel q 1))
else(KL_A2=distance(getKnotPoint KL_sel q(KL_TempN.count+KL_CCN))(getKnotPoint KL_sel q(KL_TempN.count+KL_CCN+1)))
KL_CN=(1-KL_A2/KL_A1)/ADVi1
if KL_CN>400 do KL_CN=400
case  of
(
(KL_CN<2 and KL_CN>0.0001):(if KL_uu>=2 do(subdivideSegment KL_sel q (KL_TempN.count+KL_CCN) (KL_uu-1)))
(KL_CN>=2):(if KL_ii>=2 do(if KL_ii<(KL_CN as Integer)
then(subdivideSegment KL_sel q (KL_TempN.count+KL_CCN) (KL_ii-1))
else(subdivideSegment KL_sel q (KL_TempN.count+KL_CCN) ((KL_CN as Integer)-1))))
)
)
updateShape KL_sel))
fn lcl_spline_AutoDiv=
(if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify
lcliduu=modPanel.getCurrentObject()	
if selection.count==1 and lcliduu==selection[1].baseObject and findItem kugeEdSpModAr (lcliduu as string)!=0 and numSubObjectLevels>0 and selection[1].modifiers.count==0 do
(if subObjectLevel!=1 do subObjectLevel=1
KF_SceneUnitsJC()			 
rollout spline_Adivroll "样条线_自动等分" 
(slider KC_Sl1 "自动等分密度调节(密←→疏)"  ticks:10 range:[0.001,0.1,KG_ADyuzhi]
checkbox KC_Cb2 "" checked:KG_AutoDS_S across:2
spinner KC_Sp3 "最短间距限制" fieldWidth:60 align:#right offset:[6,0] scale:(100*Syun) range:[(100*Syun),(10000*Syun),(KG_AutoDS*Syun)] enabled:KC_Cb2.checked
checkbox KC_Cb4 "" checked:KG_AutoDE_S across:2
spinner KC_Sp5 "最长间距限制" fieldWidth:60 align:#right offset:[6,0] scale:(1000*Syun) range:[(1000*Syun),(75000*Syun),(KG_AutoDE*Syun)] enabled:KC_Cb4.checked
button KC_Bu6 "自动等分处理" align:#center
on KC_Sl1 changed val do KG_ADyuzhi=val 
on KC_Cb2 changed val do(KG_AutoDS_S=KC_Sp3.enabled=val)
on KC_Sp3 changed val do KG_AutoDS=val 
on KC_Cb4 changed val do(KG_AutoDE_S=KC_Sp5.enabled=val)
on KC_Sp5 changed val do KG_AutoDE=val 
on KC_Bu6 pressed do(undo on(if not KC_Cb2.checked then KL_o1 =0.001
else KL_o1 =KG_AutoDS
if not KC_Cb4.checked then KL_o2=1000000
else KL_o2=KG_AutoDE
lcl_AutoDivFN KG_ADyuzhi KL_o1 KL_o2))
on spline_Adivroll rbuttondown xs do DestroyDialog spline_Adivroll)
CreateDialog spline_Adivroll width:200 height:130 pos:[(mouse.screenpos[1]-200),mouse.screenpos[2]]))
fn lcl_spline_Detach=
(if (subObjectLevel==2 or subObjectLevel==3)do
(lcliduu=modPanel.getCurrentObject()
if lcliduu.superClassID==2064 and findItem kugeEdSpModAr lcliduu.name!=0 do splineOps.detach lcliduu 
if lcliduu==selection[1].baseObject and findItem kugeEdSpModAr (lcliduu as string)!=0 do splineOps.detach selection[1])) 
global lclNor_huihuilen=2500
global lclNor_huihuinum=10   
fn kuge_NormalizeFN selecttype =
(local lcliduu,jk,huihuimar,huihuimCar,guigeshu,chen1,chen2,huihuinumaa,huihuiar,ooo
if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify
lcliduu=modPanel.getCurrentObject()	
if selection.count==1 and lcliduu==selection[1].baseObject and findItem kugeEdSpModAr (lcliduu as string)!=0 and numSubObjectLevels>0 do	
(if subObjectLevel!=3 do(subObjectLevel=3
max select none)
jk=selection[1] 
if (getSplineSelection jk).count!=0 then guigeshu=getSplineSelection jk
else guigeshu=(for tth=1 to numSplines jk  collect tth)
subObjectLevel=0
thawSelection()
clearSelection()  
huihuimar=#()        
huihuimCar=#()         
for tt in guigeshu do(chen1=getSegLengths jk tt 
chen2=chen1[chen1.count]    
if selecttype==1 then huihuinumaa=floor(chen2/lclNor_huihuilen) 
else huihuinumaa=lclNor_huihuinum
if huihuinumaa<=1000 then(huihuiar=#() 
for lll=0 to 1.0001 by (1.0/huihuinumaa) do(lclkkk=interpCurve3D jk tt lll 
append huihuiar lclkkk)
if huihuiar.count>2 do(if isClosed jk tt then append huihuimCar 0
else append huihuimCar 1
append huihuimar huihuiar)) 
else(messageBox "按长度规格化时有超过极限的等分数[1000],请重新设置并规格化!" title:"样条线规格化警告--阿酷提示"
global lclNor_huihuilen=lclNor_huihuilen*2
createDialog lcl_spline_Nor 200 65 pos:[(mouse.screenpos[1]-200),mouse.screenpos[2]]
huihuimar=#()        
huihuimCar=#() 
select jk
exit))						 
if huihuimar.count>0 do(
ooo=SplineShape pos:jk.pos
for xx=1 to huihuimar.count do(addNewSpline ooo   
if huihuimCar[xx]==0 then(deleteItem huihuimar[xx] huihuimar[xx].count
for yyy=1 to huihuimar[xx].count do addKnot ooo xx #smooth #curve huihuimar[xx][yyy]
close ooo xx)
else(for yyy=1 to huihuimar[xx].count do addKnot ooo xx #smooth #curve huihuimar[xx][yyy]))
updateShape ooo  
select ooo
subObjectLevel=1)))
fn lcl_Spline_Normalize=
(if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify
lcliduu=modPanel.getCurrentObject()	
if selection.count==1 and lcliduu==selection[1].baseObject and findItem kugeEdSpModAr (lcliduu as string)!=0 and numSubObjectLevels>0 do	
(	KF_SceneUnitsJC()	
rollout lcl_spline_Nor "阿酷--样条线规格化工具"
(spinner lcllen "间距: " pos:[8,11] fieldWidth:50 across:2 align:#left type:#float scale:(100*Syun) range:[(100*Syun),(100000*Syun),(lclNor_huihuilen*Syun)]
button bylen "按间距规格化"  align:#left width:80 pos:[108,8]
spinner lclnum "数量: " pos:[8,37] fieldWidth:50 across:2 align:#left type:#integer scale:1 range:[2,1000,lclNor_huihuinum]
button bynum "按数量规格化"  align:#left width:80 pos:[108,34]
on lcllen changed val do global lclNor_huihuilen= val 
