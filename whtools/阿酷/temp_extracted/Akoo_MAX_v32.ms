createDialog lcl_spline_Nor 200 65 pos:[(mouse.screenpos[1]-200),mouse.screenpos[2]]))  
global lcl_Opyuzhi=0.00001
global kugeging=1	
global kugeQU=1
global lcl_intensity_num=1	
global spline_Optimizeroll
global spline_Optimizefl	
global spline_divfl
global spline_divroll		
global lcl_spline_Nor
global lcl_spline_Norfl		
fn lcl_Sp_OptimizeFN  kugeper typek=
(local lcliduu,kukk,lclnum,kugeoptrue,kugeopdutrue,kugeseltrue,kugelength,kugeln,kugenewj,kugetop
if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify
lcliduu=modPanel.getCurrentObject()	
if selection.count==1 and lcliduu==selection[1].baseObject and findItem kugeEdSpModAr (lcliduu as string)!=0 and numSubObjectLevels>0 do	
(if subObjectLevel!=1 and subObjectLevel!=2 do subObjectLevel=1
global typek=subObjectLevel
max select none
kukk=selection[1]
lclnum= numsplines kukk
for p = 1 to lclnum do(kugeoptrue=#() 
kugeopdutrue=#()   
kugeseltrue=#()                           
kugelength=getSegLengths kukk p  
kugeln=(kugelength.count-1)/2
kugenewj=for ii=kugeln+1 to kugeln*2 collect kugelength[ii]
if not(isClosed kukk p)then kugetop=kugeln-1
else kugetop=kugeln
for uu=1 to kugetop do
(if uu+2>kugeln and isClosed kukk p then uu2=uu+2-kugeln
else uu2=uu+2
kugedist=distance (getKnotPoint kukk p uu) (getKnotPoint kukk p uu2)
if uu+1>kugeln and isClosed kukk p then uu2=uu+1-kugeln
else uu2=uu+1
if (1-kugedist/(kugenewj[uu]+kugenewj[uu2]))>kugeper then append kugeoptrue false
else append kugeoptrue true)
for kk=1 to kugeoptrue.count do
(if kugeoptrue[kk] do if kk<kugeln then append kugeseltrue (kk+1)
else append kugeseltrue 1)
for kk=1 to kugeoptrue.count-1 do if kugeoptrue[kk] and kugeoptrue[kk+1] do append kugeopdutrue (kk+1)
if (isClosed kukk p) and kugeoptrue[1] and kugeoptrue[kugeoptrue.count] do append kugeopdutrue 1
if typek==1 then(subObjectLevel=1
setKnotSelection kukk p kugeseltrue keep:true)
else(subObjectLevel=2
setSegSelection kukk p kugeopdutrue keep:true))))
fn lcl_Spline_Optimize=
(if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify
lcliduu=modPanel.getCurrentObject()	
if selection.count==1 and lcliduu==selection[1].baseObject and findItem kugeEdSpModAr (lcliduu as string)!=0 and numSubObjectLevels>0 do	
(if subObjectLevel!=1 and subObjectLevel!=2 do subObjectLevel=1
global kugeging=subObjectLevel
rollout spline_Optimizeroll "阿酷--样条线优化工具" 
(radiobuttons kugetupgj labels:#("顶点","线段") default:kugeging align:#left pos:[8,9]
slider kugeyuzhi "冗余子元素选择阈值(弱←→强)"  ticks:20 range:[0.00001,0.01,lcl_Opyuzhi]
radiobuttons kugetupgjbb labels:#("标准","增强","最强") default:lcl_intensity_num align:#left
on spline_Optimizeroll open do undo on(lcl_Sp_OptimizeFN (lcl_Opyuzhi*kugeQU) kugeging)
on kugetupgj changed state do undo on((lcl_Sp_OptimizeFN (lcl_Opyuzhi*kugeQU) state)
global kugeging=state)
on kugeyuzhi changed val do(undo on(lcl_Sp_OptimizeFN (val*kugeQU) kugeging)
global lcl_Opyuzhi=val )
on kugetupgjbb changed state do(case state of
(
2:(global kugeQU=3)
3:(global kugeQU=10)
default:(global kugeQU=1)
)
undo on(lcl_Sp_OptimizeFN (lcl_Opyuzhi*kugeQU) kugeging)
)  
on spline_Optimizeroll rbuttondown xs do DestroyDialog spline_Optimizeroll)
CreateDialog spline_Optimizeroll width:230 height:105 pos:[(mouse.screenpos[1]-230),mouse.screenpos[2]]))
if (getINISetting (getMAXIniFile()) "akoo2009" "KUGESubUVW")=="" do setINISetting (getMAXIniFile()) "akoo2009" "KUGESubUVW" "1"
global lcl_subLevel_array=#(1,2,3,4,5,6)
fn lcl_subLevel_T lcl_sLn= 
(lclsubok=undefined
if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify
if selection.count==1 then
(lsb=selection[1].modifiers
if lsb.count==0 then
(if superClassOf selection[1]==shape and numSubObjectLevels==0 do 
(if classof selection[1]!=line and classof selection[1]!=SplineShape do convertToSplineShape selection[1])
if superClassOf selection[1]==GeometryClass and numSubObjectLevels==0 and (selection[1].classid as string)!="#(1828010099, 536368280)" do
(if canConvertTo selection[1] Mesh do convertToMesh selection[1])
if numSubObjectLevels>(lcl_sLn-1) do if subObjectLevel!=lcl_sLn do subObjectLevel=lcl_sLn)
else(KL_lcl=(getINISetting (getMAXIniFile()) "akoo2009" "KUGESubUVW")=="1"
if KL_lcl then lcl_uvw=((modPanel.getCurrentObject()).classID as string)!=(#(1012401, 0)as string)
else lcl_uvw=true
if numSubObjectLevels>(lcl_sLn-1) and lcl_uvw then if subObjectLevel!=lcl_sLn do subObjectLevel=lcl_sLn
else
(lclid=(modPanel.getCurrentObject()).superClassID
if lclid==2080 or lclid==2064 then
(ffcyh=modPanel.getModifierIndex selection[1] (modPanel.getCurrentObject())+1)
else ffcyh=1
for ff=ffcyh to lsb.count do
(modPanel.setCurrentObject lsb[ff] node:selection[1]
if KL_lcl then lcl_uvw=((modPanel.getCurrentObject()).classID as string)!=(#(1012401, 0)as string)
else lcl_uvw=true
if numSubObjectLevels>(lcl_sLn-1) and lcl_uvw do(if subObjectLevel!=lcl_sLn do subObjectLevel=lcl_sLn
lclsubok=true)
if lclsubok==true do exit)
if lclsubok==undefined and ffcyh!=1 do(modPanel.setCurrentObject selection[1].baseObject node:selection[1]
if numSubObjectLevels>(lcl_sLn-1) do if subObjectLevel!=lcl_sLn do subObjectLevel=lcl_sLn))))
else if numSubObjectLevels>(lcl_sLn-1) do if subObjectLevel!=lcl_sLn do subObjectLevel=lcl_sLn
if KGL_CurrentCustview==undefined then toolMode.coordsys #view    ---防止自定义坐标系统的强制退出;
else toolMode.coordsys #grid)											  
fn lcl_subLevel_Exit=
(if (findItem lcl_subLevel_array subObjectLevel)!=0 
then(setCommandPanelTaskMode mode:#create
setCommandPanelTaskMode mode:#modify)
else(if selection.count>0 then(thawSelection()
max select none)
else if not(getToolbtnState #move)and not(getToolbtnState #rotate)and not(getToolbtnState #nuscale)and not(getToolbtnState #uscale)and not(getToolbtnState #select) do
(thePainterInterface.endPaintSession()
try(KF_PlantScatt.KC_XXY3C.checked=KF_PlantScatt.KC_XXY3D.checked=KF_PlantScatt.KC_XXY2C.checked=KF_PlantScatt.KC_XXY2D.checked=KF_PlantScatt.KC_XXY7C.checked=false)catch()
max move)))
fn lcl_subLevel_Modifier rt=
(setCommandPanelTaskMode mode:#create
setCommandPanelTaskMode mode:#modify
KL_Cuesel=getCurrentSelection()
KL_Modiobja=for i in KL_Cuesel where ViewgeoFilt i or ViewshapeFilt i collect i
if KL_Modiobja.count>0 do
(KL_Modlidt=#()
for u in KL_Modiobja[1].modifiers do
(KL_Ttemp=#()
for tt in refs.dependents u where IsValidNode tt do if ViewgeoFilt tt and tt.isSelected do append KL_Ttemp tt
if KL_Ttemp.count==KL_Modiobja.count and(findItem KL_Modlidt u)==0 do append KL_Modlidt u)
if KL_Modlidt.count>=rt do(KL_Selsat=isSelectionFrozen()
if not KL_Selsat do freezeSelection()
modPanel.setCurrentObject KL_Modlidt[rt]
if subObjectLevel!=0 do subObjectLevel=0
if not KL_Selsat do thawSelection())
if KL_Modlidt.count==rt-1 and KL_Modiobja.count==1 do(modPanel.setCurrentObject KL_Modiobja[1].baseObject node:KL_Modiobja[1]
if subObjectLevel!=0 do subObjectLevel=0)))
if (getINISetting (getMAXIniFile()) "akoo2009" "RanMSRMoveD")=="" do setINISetting (getMAXIniFile()) "akoo2009" "RanMSRMoveD" "1000"
if (getINISetting (getMAXIniFile()) "akoo2009" "RanMSRRotaD")=="" do setINISetting (getMAXIniFile()) "akoo2009" "RanMSRRotaD" "30"
if (getINISetting (getMAXIniFile()) "akoo2009" "RanMSRScaleD")=="" do setINISetting (getMAXIniFile()) "akoo2009" "RanMSRScaleD" "0.75"
