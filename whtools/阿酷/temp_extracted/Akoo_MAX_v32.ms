KF_SceneUnitsJC()
PrevScatterObjTarget=for m in PrevScatterObjTarget where IsValidNode m collect m 
KC_BT6.text="目标:["+PrevScatterObjTarget.count as string+"]"
if IsValidNode KGL_PSRegonSpline do(KC_XXY214.object=KGL_PSRegonSpline 
KC_XXY214.text=KGL_PSRegonSpline.name)
if IsValidNode KGL_PSPathSpline do(KC_XXY514.object=KGL_PSPathSpline
KC_XXY514.text=KGL_PSPathSpline.name)
KC_JJKj3.indeterminate=KC_LBrB3.indeterminate=KC_LBrC3.indeterminate=true)   ---先屏蔽所有缺省控制;
