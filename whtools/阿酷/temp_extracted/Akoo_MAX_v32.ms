KG_RenCamlName=Kl_KKCCmo[2]
KR_Render_MulCam.KC_MB15.items=KG_RenCamlName)
on KC_BT3 pressed do(if KC_MB.selected!=undefined then(KC_DL11.text=KC_MB.selected
KF_KLMN KC_MB.selected KC_MB.selected)
else(KC_DL11.text="灯光层选择"
KF_KLMN "C" "")
DestroyDialog KR_SceObjGroSel3)
