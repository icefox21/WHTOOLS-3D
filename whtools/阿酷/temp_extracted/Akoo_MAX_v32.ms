fn lcl_Select_wireframe=
(undo on(
lcl_wireframe=#()
kugeCCCC=#()
kugeAA=for ii in objects where ViewgeoFilt ii collect ii  
kugeCC=for oo in selection where ViewgeoFilt oo collect oo 
for m in kugeCC do if (getPolygonCount m)[2]>3 do
(kugeMESH=snapshotAsMesh m
fff=kugeMESH.numverts
lclvert1=distance (getVert kugeMESH 1) (getVert kugeMESH fff)
lclvert2=distance (getVert kugeMESH 1) (getVert kugeMESH (fff/2))
lclvert3=distance (getVert kugeMESH fff) (getVert kugeMESH (fff/2))
lclvert4=((lclvert1/lclvert2)+(lclvert1/lclvert3)+(lclvert2/lclvert3))as string
lclvertB=(substring lclvert4 1 (lclvert4.count-2))as Float 
if findItem lcl_wireframe lclvertB==0 do append lcl_wireframe lclvertB)
if lcl_wireframe.count>0 do
(for b in kugeAA do if (getPolygonCount b)[2]>3 do
(kugeMESH=snapshotAsMesh b
fff=kugeMESH.numverts
lclvert1=distance (getVert kugeMESH 1) (getVert kugeMESH fff)
lclvert2=distance (getVert kugeMESH 1) (getVert kugeMESH (fff/2))
lclvert3=distance (getVert kugeMESH fff) (getVert kugeMESH (fff/2))
lclvert4=((lclvert1/lclvert2)+(lclvert1/lclvert3)+(lclvert2/lclvert3))as string
lclvertB=(substring lclvert4 1 (lclvert4.count-2))as Float 
if findItem lcl_wireframe lclvertB!=0 do append kugeCCCC b) 
Groupfiltrate kugeCCCC undefined)))
