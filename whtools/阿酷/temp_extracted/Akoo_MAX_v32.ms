global lcl_FiArrayPath=KL_Arshape)
else KC_BU4.text="路径阵列"
undo on(lcl_FiArrayFN KC_BU4.state lcl_FiArrayPath false)
if (KL_FillSat==2) then KC_Sub1.value=(KL_FillDirN*Syun)
else(KC_Sub2.value=KL_FillArrN
KC_Sub1.value=(KL_FillDirN*Syun)))
