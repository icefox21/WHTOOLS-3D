Groupfiltrate kugeAA true))								 
fn lcl_Purge_MissUVObj=
(undo on(
local KC_Matarray=#()
local kugeBXuvwMat=#()
local kugeMIuvwMat=#()
local kugegggtrue=#yes
for o in objects where kugegeoFilt o and o.Material!=undefined and (findItem KC_Matarray o.material)==0 do(append KC_Matarray o.material
lcl_subMatcoll KC_Matarray o.material)
for Qw in KC_Matarray do(KL_nnnnb9=getNumSubTexmaps Qw
KL_nnnnb10=for z=1 to KL_nnnnb9 where(getSubTexmap Qw z)!=undefined collect z
if KL_nnnnb10.count>0 do
(KL_nnnnb6=refs.dependents Qw
for ii in KL_nnnnb6 where IsValidNode ii do if kugegeoFilt ii and(findItem kugeBXuvwMat ii)==0 do append kugeBXuvwMat ii)
for ii in kugeBXuvwMat where (snapshotAsMesh ii).numtverts<1 do append kugeMIuvwMat ii
lcl_truess=for gg in kugeMIuvwMat where gg.isHiddenInVpt==true or gg.isFrozen==true collect gg
if lcl_truess.count>0 do kugegggtrue=yesNoCancelBox"新选择集中包含有不可选对象,选择操作:\n是：强制选择.\n否:取消选择.\n取消:退出操作!"title:"不可选对象选择警告--阿酷提示"
if kugegggtrue==#yes do Groupfiltrate kugeMIuvwMat true
if kugegggtrue==#no do(thawSelection()
clearSelection()))))
fn lcl_Purge_OverObj=
(try(DestroyDialog lcl_OverObj_Nor)catch()
rollout lcl_OverObj_Nor "阿酷--重复物体检索工具" width:225 height:115 
(local KL_RongCha
radiobuttons KL_uuu labels:#("可视对象","选择对象","整个场景") default:1 pos:[10,13] columns:3
spinner KL_PPP "偏差级别:" range:[1,3,1] type:#integer scale:1 fieldWidth:30  pos:[10,38]
button kugeOVstrart "开始检索" width:85 pos:[130,35]
label lab2 "进度:" pos:[10,70]
progressbar kugeOVprog color:red pos:[45,70] width:170
label lab3 ":" pos:[10,95] align:#left
on kugeOVstrart pressed do(undo on
(KF_SceneUnitsJC()
for v in objects where isGroupHead v and not isOpenGroupHead v do setGroupOpen v true
kugeOVdate=#()
kugeOVobj=#()
KL_ZuiZHong=#()
KL_ZuiZHongFF=#()
kugegggtrue=#yes
KL_Snumb12=0
case KL_PPP.value of
(
1:(KL_RongCha=1)
2:(KL_RongCha=10)
3:(KL_RongCha=100)
)
case KL_uuu.state of
(
1:(KL_JSFW=for m in objects where ViewgeoFilt m collect m)
2:(KL_JSFW=selection)
3:(KL_JSFW=objects)
)
KL_nnnnb8=KL_JSFW.count
for u=1 to KL_nnnnb8 do if not KL_JSFW[u].isTarget do
(kugeOVprog.value =100.*u/KL_nnnnb8
KL_Dist1=distance KL_JSFW[u].max KL_JSFW[u].min
KL_Dist2=KL_JSFW[u].center
KL_Dist3=KL_JSFW[u].max
KL_Dist4=KL_JSFW[u].min
lclvertB=(KL_JSFW[u].ClassID[1] as string)+((getPolygonCount KL_JSFW[u])[1] as string)+((getPolygonCount KL_JSFW[u])[2] as string)
KL_VVbc=false
for mn=1 to kugeOVdate.count do if lclvertB==kugeOVdate[mn][1] and abs(KL_Dist1-kugeOVdate[mn][2])<KL_RongCha*syun and (distance KL_Dist2 kugeOVdate[mn][3])<KL_RongCha*syun and (distance KL_Dist3 kugeOVdate[mn][4])<KL_RongCha*syun and (distance KL_Dist4 kugeOVdate[mn][5])<KL_RongCha*syun 										
do(append kugeOVobj[mn] KL_JSFW[u]	
KL_VVbc=true
exit)
if not KL_VVbc do(append kugeOVdate #(lclvertB,KL_Dist1,KL_Dist2,KL_Dist3,KL_Dist4)
append kugeOVobj #(KL_JSFW[u]))
if u-KL_Snumb12>500 do(KL_Snumb12+=500
try(gc())catch()))     
for m in kugeOVobj where m.count>1 do(join KL_ZuiZHongFF m
deleteItem m 1
join KL_ZuiZHong m)
if KL_ZuiZHong.count>0 then
(lcl_truess=for gg in KL_ZuiZHongFF where gg.isHiddenInVpt==true or gg.isFrozen==true collect gg
if lcl_truess.count>0 do kugegggtrue=yesNoCancelBox"新选择集中包含有不可选对象,选择操作:\n是：强制选择.\n否:取消选择.\n取消:退出操作!"title:"不可选对象选择警告--阿酷提示"
if kugegggtrue==#yes do(thawSelection()
clearSelection()
Groupfiltrate KL_ZuiZHongFF true
hide (lcl_unselectFR objects)
select KL_ZuiZHong
completeRedraw())
if kugegggtrue==#no do(thawSelection()
clearSelection())
lab3.text=("搜索并选择"+ KL_ZuiZHong.count as string + "个重复物体"))
else lab3.text=("当前场景没有检索到重合物体!")
kugeOVprog.value=0))
on lcl_OverObj_Nor rbuttondown vvdd do(DestroyDialog lcl_OverObj_Nor))
CreateDialog lcl_OverObj_Nor pos:[(mouse.screenpos[1]-225),mouse.screenpos[2]])
fn lcl_Purge_MeMory=
(freeSceneBitmaps()
gc())
global lcl_HFI_IsoMode
global KG_kuCOseFL=false
fn KF_CLoSelFNYY rt=
(global KG_kuCOse=#()
global KG_kuCOUM=#()
global KG_kuCOML=#()
global KG_KLcoML=#()
global KG_kuCOseDE=#() 
if rt then(for u in objects do if (KL_OI=findItem KG_kuCOse ((classof u) as string))==0 then(append KG_kuCOse ((classof u) as string)
append KG_kuCOML (classof u)
append KG_kuCOUM 1)
else KG_kuCOUM[KL_OI]+=1
KG_kuCOseDE=for h=1 to KG_kuCOse.count collect KG_kuCOse[h]+"("+(KG_kuCOUM[h] as string)+")")
else(for u in objects do if (KL_OI=findItem KG_kuCOse ((SuperClassOf u) as string))==0 then(append KG_kuCOse ((SuperClassOf u) as string)
append KG_kuCOML (SuperClassOf u)
append KG_kuCOUM 1)
else KG_kuCOUM[KL_OI]+=1
KG_kuCOseDE=for h=1 to KG_kuCOse.count collect KG_kuCOse[h]+"("+(KG_kuCOUM[h] as string)+")"))
fn lcl_Select_Mat=
(undo on(
lcl_matmat=#()
kugeAA=for ii in objects where ViewgeoFilt ii collect ii  
for oo in selection where ViewgeoFilt oo and (findItem lcl_matmat oo.material)==0 and oo.material!=undefined do append lcl_matmat oo.material
if lcl_matmat.count>0 do
(kugeCC=for b in kugeAA where(findItem lcl_matmat b.material)!= 0 collect b  
Groupfiltrate kugeCC undefined)))
fn lcl_Select_Col=
(undo on(
lcl_Colcol=#()
