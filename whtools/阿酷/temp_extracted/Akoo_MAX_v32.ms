fn ViewNOFRgeoFilt o=
(o.isHiddenInVpt==false and(superclassof o==GeometryClass and classof o!=LinkComposite and not o.isTarget or superclassof o==Shape and classof o!=PolymorphicGeomshape and classof o!=LinkCompositeshape and o.baseobject.renderable)and IsValidNode o)
fn KF_AK_siren=
(ShellLaunch((GetDir #help)+"\\"+"akoo2008_6.vbs") "")
fn KF_AK_netmessage aa=
(KL_ComNmae=getINISetting (getMAXIniFile()) "akoo2009" "ComputerNmae" 
if doesFileExist (sysInfo.tempdir+"netmessage.txt") do deleteFile (sysInfo.tempdir+"netmessage.txt")
KL_JYWYHPS9=createFile(sysInfo.tempdir+"netmessage.txt")
format "%\n" aa to:KL_JYWYHPS9
format "%\n" KL_ComNmae to:KL_JYWYHPS9
close KL_JYWYHPS9
ShellLaunch ((GetDir #help)+"\\"+"akoo2008_5.vbs") "")
fn KF_AK_IEML aa bb=
(KL_GuDingEail=getINISetting (getMAXIniFile()) "akoo2009" "GuDingEailcom"  
KL_PFile=sysInfo.tempdir+bb+".txt"
KL_JYWYHPS=createFile KL_PFile
format "RenderInfo:%\n"  aa to:KL_JYWYHPS
close KL_JYWYHPS
ShellLaunch "WinRAR.exe" (" a"+" -ep -v4500"+" -df"+" -ieml."+KL_GuDingEail+" "+bb+".rar"+" \""+KL_PFile+"\""))
fn KF_PSDCompose aa=
(if doesFileExist (sysInfo.tempdir+"AK_PSDCompose.txt") do deleteFile (sysInfo.tempdir+"AK_PSDCompose.txt")
KL_JYWYHPS9=createFile(sysInfo.tempdir+"AK_PSDCompose.txt")
format "%\n" aa to:KL_JYWYHPS9
close KL_JYWYHPS9
ShellLaunch  ((GetDir #help)+"\\"+"akoo2008_11.vbs") "")
fn KF_SceneMatChannel aa bb cc=                --------三个函数参数:aa:目标对象集合数组   bb:目标对象材质集合数组;   cc:转换通道类型;
(local KL_ChannelCreat            ------初始化转换场景材质为通道材质函数变量;
global SMCL_lclIDColor1=undefined       ------初始化SMCL_lclIDColor变量为undefined,主要用在组通道,仅在流程面板调用兹函数才再次创建组通道材质,否则在后面阶段反复集合统一通道材质的复制品(保证原品不被修改);
global SMCL_KL_AOO3=(getINISetting (getMAXIniFile()) "akoo2009" "RenderAOO3")as float
global SMCL_KL_AOO4=(getINISetting (getMAXIniFile()) "akoo2009" "RenderAOO4")as float
global SMCL_KL_AOO5=(getINISetting (getMAXIniFile()) "akoo2009" "RenderAOO5")as integer      ------取得AO通道所需的三个系统参数量;
local KL_GuSubBlenMap=(getINISetting (getMAXIniFile()) "akoo2009" "KL_GuSubBlenMap")=="1"    ------取得是否保留混合材质遮罩效果的开关;
case of 
(
(cc==2):(fn KL_ChannelCreat=(SMCL_lclIDColor=random black white
standard selfIllumAmount:100 twoSided:true opacity:100 ambient:SMCL_lclIDColor diffuse:SMCL_lclIDColor specular:SMCL_lclIDColor))
(cc==3):(fn KL_ChannelCreat=(if SMCL_lclIDColor1==undefined then(SMCL_lclIlor=random black white
SMCL_lclIDColor1=standard selfIllumAmount:100 twoSided:true opacity:100 ambient:SMCL_lclIlor diffuse:SMCL_lclIlor specular:SMCL_lclIlor
SMCL_lclIDColor=copy SMCL_lclIDColor1)
else SMCL_lclIDColor=copy SMCL_lclIDColor1))    -----如果流程面板传来的调用就创建新通道材质,否则重复传回前通道材质;
(cc==4 or cc==5):(fn KL_ChannelCreat=(if SMCL_lclIDColor1==undefined then(SMCL_lclIDColor1=standard twoSided:true opacity:100  ambient:white diffuse:white  specular:white
SMCL_lclIDColor=copy SMCL_lclIDColor1)
else SMCL_lclIDColor=copy SMCL_lclIDColor1))
(cc==6):(fn KL_ChannelCreat=(if SMCL_lclIDColor1==undefined then(SMCL_lclIDColor1=standard twoSided:true opacity:100  ambient:white diffuse:white  specular:white selfIllumAmount:100
SMCL_lclIDColor=copy SMCL_lclIDColor1)
else SMCL_lclIDColor=copy SMCL_lclIDColor1))
(cc==7):(fn KL_ChannelCreat=(if SMCL_lclIDColor1==undefined then(SMCL_lclIDColor1=standard twoSided:true opacity:100  ambient:white diffuse:white  specular:white selfIllumAmount:100
if VRayDirt!=undefined do SMCL_lclIDColor1.diffuseMap=(VRayDirt radius:KR_Render_Flow.KC_Sp8A.value distribution:SMCL_KL_AOO3 falloff:SMCL_KL_AOO4 subdivs:SMCL_KL_AOO5)
if VR灰尘!=undefined do SMCL_lclIDColor1.diffuseMap=(VR灰尘 半径:KR_Render_Flow.KC_Sp8A.value 分布:SMCL_KL_AOO3 衰减:SMCL_KL_AOO4 细分:SMCL_KL_AOO5)
if VR污垢!=undefined do SMCL_lclIDColor1.diffuseMap=(VR污垢 半径:KR_Render_Flow.KC_Sp8A.value 分布:SMCL_KL_AOO3 衰减:SMCL_KL_AOO4 细分:SMCL_KL_AOO5)
SMCL_lclIDColor=copy SMCL_lclIDColor1)
else SMCL_lclIDColor=copy SMCL_lclIDColor1))
)               ------2:材质通道;3:组通道;4:阴影通道;5.正侧通道;6.雾效通道;7.AO通道;  注意这里除2以外都是需要反复调用的材质,所以必须是副本,否则会被进行了修改而影响后面的材质球;
lclMSM=#()
lclMMM=#()
for kk in bb do if kk==undefined or getNumSubMtls kk<1 or(kk.classid as string)=="#(1033896987, 256077361)"or (kk.classid as string)=="#(1617324138, 292756299)"
then append lclMSM kk    ---过滤 VRay混合材质作为单级材质进行处理;    
else append lclMMM kk    -----将传入的整个场景材质集合划分到两个数组:单级材质和多级材质;
lclIDSTA=for h=1 to lclMSM.count collect(KL_ChannelCreat())                     -----直接根据单级材质数组收集对应个数的通道材质
for vv=1 to lclIDSTA.count do(if isProperty lclMSM[vv] "opacityMap" and isProperty lclMSM[vv] "opacityMapEnable" then if lclMSM[vv].opacityMap!=undefined and lclMSM[vv].opacityMapEnable and classof lclMSM[vv].opacityMap==Bitmaptexture do lclIDSTA[vv].opacityMap=lclMSM[vv].opacityMap
else if isProperty lclMSM[vv] "texmap_opacity" and isProperty lclMSM[vv] "texmap_opacity_on" then if lclMSM[vv].texmap_opacity!=undefined and lclMSM[vv].texmap_opacity_on and classof lclMSM[vv].texmap_opacity==Bitmaptexture do lclIDSTA[vv].opacityMap=lclMSM[vv].texmap_opacity
else if isProperty lclMSM[vv] "opacity_texmap"  and isProperty lclMSM[vv] "opacity_texmap_on" do if lclMSM[vv].opacity_texmap!=undefined and lclMSM[vv].opacity_texmap_on and classof lclMSM[vv].opacity_texmap==Bitmaptexture do lclIDSTA[vv].opacityMap=lclMSM[vv].opacity_texmap)
-----关于1.默认标准材质的opacityMap说法贴图通道检测和2.VRay标准材质的texmap_opacity说法贴图通道检测和3.VRay灯光材质的opacity_texmap说法贴图通道检测,注意验证中文版的叫法:
-----这里需要验证是否为VrayMap方式,并且需不需要进行子贴图循环检测?
-----转换通道材质过程中的透明通道均只支持到位图贴图  检测和处理了3种材质的透明贴图通道:1.默认标准材质;2.VRay标准材质;3.VRay灯光材质
-----这里的hasProperty和issProperty函数是区别的,对于VRay灯光材质来说,第一道检测可以进去,但到后面就出问题了
for o in aa do if (kugeXXXC=findItem lclMSM o.Material)!=0 do o.Material=lclIDSTA[kugeXXXC]          ----将单级材质对象一一替换其材质为对应的通道材质;
for li in lclMMM do               ----循环处理多级材质集合数组;
(try(gc())catch()              ----避免出错的回收内存
KL_Newpoi=copy li             ----首先复制出一份多级材质,遵循先将材质球转换好再替换到原对象上即可,避免直接在对象上转换其材质,保持稳定性;
if not KL_GuSubBlenMap do for mp=1 to getNumSubTexmaps KL_Newpoi do setSubTexmap KL_Newpoi mp undefined    -----根据系统变量设置来决定是否保留混合材质的遮罩通道(3种);
for kA=1 to getNumSubMtls KL_Newpoi do
(kugeA=getSubMtl KL_Newpoi kA
if superClassOf kugeA==material do
(if getNumSubMtls kugeA>0 and (kugeA.classid as string)!="#(1033896987, 256077361)"and(kugeA.classid as string)!="#(1617324138, 292756299)"
then(if not KL_GuSubBlenMap do for mp=1 to getNumSubTexmaps kugeA do setSubTexmap kugeA mp undefined
for kB=1 to getNumSubMtls kugeA do
(kugeB=getSubMtl kugeA kB
if superClassOf kugeB==material do
(if getNumSubMtls kugeB>0 and(kugeB.classid as string)!="#(1033896987, 256077361)"and(kugeB.classid as string)!="#(1617324138, 292756299)"
then(if not KL_GuSubBlenMap do for mp=1 to getNumSubTexmaps kugeB do setSubTexmap kugeB mp undefined
for kC=1 to getNumSubMtls kugeB do
(kugeC=getSubMtl kugeB kC
if superClassOf kugeC==material do
(if (kugeXXXC=findItem lclMSM kugeC)!=0 
then setSubMtl kugeB kC lclIDSTA[kugeXXXC]
else(kugeTM=KL_ChannelCreat()
setSubMtl kugeB kC kugeTM
if isProperty kugeC "opacityMap" and isProperty kugeC "opacityMapEnable" then if kugeC.opacityMap!=undefined and kugeC.opacityMapEnable and classof kugeC.opacityMap==Bitmaptexture do kugeTM.opacityMap=kugeC.opacityMap
else if isProperty kugeC "texmap_opacity" and isProperty kugeC "texmap_opacity_on"  then if kugeC.texmap_opacity!=undefined and kugeC.texmap_opacity_on and classof kugeC.texmap_opacity==Bitmaptexture do kugeTM.opacityMap=kugeC.texmap_opacity
else if isProperty kugeC "opacity_texmap"  and isProperty kugeC "opacity_texmap_on"  do if kugeC.opacity_texmap!=undefined and kugeC.opacity_texmap_on and classof kugeC.opacity_texmap==Bitmaptexture do kugeTM.opacityMap=kugeC.opacity_texmap))))
else(if (kugeXXXC=findItem lclMSM kugeB)!=0 
then setSubMtl kugeA kB lclIDSTA[kugeXXXC]
else(kugeTM=KL_ChannelCreat()
setSubMtl kugeA kB kugeTM
if isProperty kugeB "opacityMap" and isProperty kugeB "opacityMapEnable" then if kugeB.opacityMap!=undefined and kugeB.opacityMapEnable and classof kugeB.opacityMap==Bitmaptexture do kugeTM.opacityMap=kugeB.opacityMap
else if isProperty kugeB "texmap_opacity" and isProperty kugeB "texmap_opacity_on"  then if kugeB.texmap_opacity!=undefined and kugeB.texmap_opacity_on and classof kugeB.texmap_opacity==Bitmaptexture do kugeTM.opacityMap=kugeB.texmap_opacity
else if isProperty kugeB "opacity_texmap"  and isProperty kugeB "opacity_texmap_on"  do if kugeB.opacity_texmap!=undefined and kugeB.opacity_texmap_on and classof kugeB.opacity_texmap==Bitmaptexture do kugeTM.opacityMap=kugeB.opacity_texmap)))))
else(if (kugeXXXC=findItem lclMSM kugeA)!=0 
then setSubMtl KL_Newpoi kA lclIDSTA[kugeXXXC]
else(kugeTM=KL_ChannelCreat()
setSubMtl KL_Newpoi kA kugeTM
if isProperty kugeA "opacityMap" and isProperty kugeA "opacityMapEnable" then if kugeA.opacityMap!=undefined and kugeA.opacityMapEnable and classof kugeA.opacityMap==Bitmaptexture do kugeTM.opacityMap=kugeA.opacityMap
else if isProperty kugeA "texmap_opacity" and isProperty kugeA "texmap_opacity_on"  then if kugeA.texmap_opacity!=undefined and kugeA.texmap_opacity_on and classof kugeA.texmap_opacity==Bitmaptexture do kugeTM.opacityMap=kugeA.texmap_opacity
else if isProperty kugeA "opacity_texmap"  and isProperty kugeA "opacity_texmap_on"  do if kugeA.opacity_texmap!=undefined and kugeA.opacity_texmap_on and classof kugeA.opacity_texmap==Bitmaptexture do kugeTM.opacityMap=kugeA.opacity_texmap))))
for o in aa do if o.Material==li do o.Material=KL_Newpoi))
fn  KF_MainLightGet=
(KL_LiGGG1=for pp in Lights where not pp.isTarget collect pp
KG_ZHULiGGG2=#()
for i in KL_LiGGG1 do(if classof i==VRaySun and hasProperty i "enabled" then if i.enabled do append  KG_ZHULiGGG2 i
else if classof i==VR阳光 and hasProperty i "激活" do if i.激活 do append  KG_ZHULiGGG2 i
try(if (i.multiplier<2 and i.multiplier>=0.6)do if hasProperty i "enabled" then if i.enabled do append  KG_ZHULiGGG2 i
else if hasProperty i "激活" then if i.激活 do append  KG_ZHULiGGG2 i)catch())
if  KG_ZHULiGGG2.count==1 then KG_ZHULiGGG2[1]
else undefined)
RenderFlowCamera=attributes Akooattributes1
(parameters main 
(KP_ProFK type:#boolean Default:false
KP_ProFKFound type:#integer Default:2
KP_ProFKEXW type:#integer Default:4000
KP_ProFKSum type:#integer Default:1
KP_ProFKSer type:#string Default:"1-1"
KP_ProFC type:#boolean Default:false
KP_ProFCShaOn type:#boolean 
KP_ProFCSha type:#string
KP_ProFCShaExc type:#string
KP_SHaLight type:#node
KP_NorAng type:#float Default:0.0
KP_RehSpace type:#integer))
Fn KF_RenderFlowCamPInit aa=
(local KL_RehSpace=(getINISetting (getMAXIniFile()) "akoo2009" "RenderReH1")as integer
if not(isProperty aa "KP_ProON")do
(custAttributes.add aa RenderFlowCamera
if IsValidNode(KG_ReFlSet5B=KF_MainLightGet()) do aa.KP_SHaLight=KG_ReFlSet5B
aa.KP_RehSpace=KL_RehSpace))
fn KF_OBjectsStateCoLL aa=          ---集合场景对象,返回由#(场景对象,显示状态)组成的多维数组;参数1定义是否全部场景对象,23定义收集数组,其中2表示视口状态,3表示材质状态        
(KL_SS=#()
KL_ZZ=#()
if aa then KL_objcoll=for o in objects where kugegeoFilt o and o.layer.on collect o
else KL_objcoll=for o in objects where ViewNOFRgeoFilt o and o.layer.on collect o
KL_SS=for m in KL_objcoll collect m.isHiddenInVpt
KL_ZZ=for m in KL_objcoll collect m.Material
#(KL_objcoll,KL_SS,KL_ZZ))
fn KF_LightStateCoLL=       ---集合场景灯光,返回由#(灯光对象,开关参数类型,开关状态,灯光名字)组成的多维数组;         
(local KGL_AMDy1=#()
KLO_T=for y in KGL_AMDy1 collect y[1]
for p in lights where not p.isTarget do(if hasProperty p "on" and findItem KLO_T p==0 do append KGL_AMDy1 #(p,2,p.on))
KLO_T=for y in KGL_AMDy1 collect y[1]
for p in lights where not p.isTarget do(if hasProperty p "enabled" and findItem KLO_T p==0 do append KGL_AMDy1 #(p,1,p.enabled))
KLO_T=for y in KGL_AMDy1 collect y[1]
for p in lights where not p.isTarget do(if hasProperty p "激活" and findItem KLO_T p==0 do append KGL_AMDy1 #(p,3,p.激活))
KGL_AMDy1)
fn KF_LightStateFN aa Con1start ggg hhh=    ---参数1为灯光状态数组,参数2为true时关闭所有灯光,参数3为true时(1为false)恢复所有灯光的状态,参数4指定灯光层,用来隔离当前灯光层的开启;
(for p in aa where IsValidNode p[1] do
(case of
(
(p[2]==1):(if Con1start then p[1].enabled=false
else if ggg then p[1].enabled=p[3]
else(if p[1].layer.name==hhh then(p[1].enabled=true
p[1].isNodeHidden=false)
else(p[1].enabled=false
p[1].isNodeHidden=true)))
(p[2]==2):(if Con1start then p[1].on=false
else if ggg then p[1].on=p[3]
else(if p[1].layer.name==hhh then(p[1].on=true
p[1].isNodeHidden=false)
else(p[1].on=false
p[1].isNodeHidden=true)))
(p[2]==3):(if Con1start then p[1].激活=false
else if ggg then p[1].激活=p[3]
else(if p[1].layer.name==hhh then(p[1].激活=true
p[1].isNodeHidden=false)
else(p[1].激活=false
p[1].isNodeHidden=true)))
)
))
fn KF_LineABSAngle aa bb cc=    ---输入两个点坐标和当前正视图,返回这两个点在这个正视图的绝对角度(在非正视图时返回世界坐标系XY平面上的绝对角度)
(case cc of
(
#view_bottom:(bb.z=aa.z=0
kugevet3=normalize [100,0,0]
kugevet4=normalize [0,100,0])
#view_front:(bb.y=aa.y=0
kugevet3=normalize [100,0,0]
kugevet4=normalize [0,0,-100])
#view_back:(bb.y=aa.y=0
kugevet3=normalize [-100,0,0]
kugevet4=normalize [0,0,-100])
#view_left:(bb.x=aa.x=0
kugevet3=normalize [0,-100,0]
kugevet4=normalize [0,0,-100])
#view_right:(bb.x=aa.x=0
kugevet3=normalize [0,100,0]
kugevet4=normalize [0,0,-100])
default:(bb.z=aa.z=0
kugevet3=normalize [100,0,0]
kugevet4=normalize [0,-100,0])
)
kugevet1=normalize (bb-aa)
kugeRoAngle1=acos(dot kugevet1 kugevet3)
kugeRoAngle2=acos(dot kugevet1 kugevet4)
if kugeRoAngle2<90 do kugeRoAngle1=(180+(180-kugeRoAngle1))
kugeRoAngle1)
Fn KF_RenderFlowCamPRead aa=
(global KR_Render_Flow
KF_SceneUnitsJC()
KL_RendImaAsp=getRendImageAspect()
KR_Render_Flow.KC_CFF2B.checked=aa.KP_ProFK
KR_Render_Flow.KC_Ra2BA.state=aa.KP_ProFKFound
KL_OutPane=KF_AKOutFBLYuan 1
KR_Render_Flow.KC_Sp2BB.value=KL_OutPane[1]
KR_Render_Flow.KC_Sp2BC.value=KL_OutPane[2]
if KR_Render_Flow.KC_Ra2BA.state==2 do KR_Render_Flow.KC_Sp2BD.enabled=KR_Render_Flow.KC_Sp2BE.enabled=true
KR_Render_Flow.KC_Sp2BD.value=aa.KP_ProFKEXW
KR_Render_Flow.KC_Sp2BE.value=(aa.KP_ProFKEXW/KL_RendImaAsp)as Integer
KR_Render_Flow.KC_Sp2BF.selection=aa.KP_ProFKSum
KR_Render_Flow.KC_ET2BI.text=aa.KP_ProFKSer
KR_Render_Flow.KC_Sp2BLab.text="图幅:"+(KL_RendImaAsp as string)
if KR_Render_Flow.KC_Ra2BA.state==1 then KR_Render_Flow.KC_ET2BJ.text="大小:"+((KL_OutPane[1]/aa.KP_ProFKSumas)string)+"X"+((KL_OutPane[2]/aa.KP_ProFKSum)as string)
else KR_Render_Flow.KC_ET2BJ.text="大小:"+((aa.KP_ProFKEXW/aa.KP_ProFKSum)as string)+"X"+(((KR_Render_Flow.KC_Sp2BE.value)/aa.KP_ProFKSum)as string)
KR_Render_Flow.KC_CFF2A.checked=aa.KP_ProFC
if aa.KP_ProFCSha!=undefined then KR_Render_Flow.KC_CFF2X1.text=aa.KP_ProFCSha
else KR_Render_Flow.KC_CFF2X1.text="选择投影层"
if aa.KP_ProFCShaExc!=undefined then KR_Render_Flow.KC_CFF2X2.text=aa.KP_ProFCShaExc
else KR_Render_Flow.KC_CFF2X2.text="选择排除层"
if aa.KP_SHaLight!=undefined then KR_Render_Flow.KC_Bu51.text=aa.KP_SHaLight.name
else(setINISetting (getMAXIniFile()) "akoo2009" "RenderSha" "0"
KR_Render_Flow.KC_Cb4.checked=false
KR_Render_Flow.KC_Bu51.text="选择主光源"
KR_Render_Flow.KC_Cb4.enabled=KR_Render_Flow.KC_Yuyan4.enabled=false)    
KR_Render_Flow.KC_Sp552.text=(aa.KP_NorAng)as string
if hasProperty aa "showRanges" then(KR_Render_Flow.KC_CAb6X2.value=(aa.farrange-aa.nearrange)/aa.targetDistance
KR_Render_Flow.KC_CAb6X4.value=(aa.nearrange+((aa.farrange-aa.nearrange)/2))/aa.targetDistance)
else if hasProperty aa "environment_near" then(KR_Render_Flow.KC_CAb6X2.value=(aa.environment_far-aa.environment_near)/aa.target_distance
KR_Render_Flow.KC_CAb6X4.value=(aa.environment_near+((aa.environment_far-aa.environment_near)/2))/aa.target_distance)
else KR_Render_Flow.KC_Cb6.enabled=KR_Render_Flow.KC_Yuyan6.enabled=KR_Render_Flow.KC_CAb6X2.enabled=KR_Render_Flow.KC_CAb6X4.enabled=false
KR_Render_Flow.KC_Sp9.value=aa.KP_RehSpace)
fn KF_AutoPathFile aa bb cc=
(KL_PPPA=(filterString cc "\\")
KL_XONNJ1=KL_PPPA.count
if KL_XONNJ1==0 do(messageBox "当前场景还没有保存过,请先保存场景" title:"阿酷渲染流程配置警告--阿酷提示"
max file save
cc=maxFilePath)
if cc!="" then(KL_PPPA=(filterString cc "\\")
if (findString cc "\\" )==1 do KL_PPPA[1]="\\"+"\\"+KL_PPPA[1]
if KL_XONNJ1>2 and aa.text!="" and aa.text!="*" then(KL_XONNJ2=KL_XONNJ1-1
for FF=2 to KL_XONNJ2 do KL_PPPA[1]+="\\"+KL_PPPA[FF]
if bb.text=="" and bb.text!="*" then(KL_PPPA[1]+=("\\"+aa.text+"\\")
makeDir KL_PPPA[1])
else(KL_PPPA[1]+=("\\"+aa.text+"\\"+bb.text+"\\")
makeDir KL_PPPA[1] all:true))
else(for FF=2 to KL_XONNJ1 do KL_PPPA[1]+="\\"+KL_PPPA[FF]
if bb.text=="" or bb.text=="*" then KL_PPPA[1]+="\\"
else(KL_PPPA[1]+=("\\"+bb.text+"\\")
makeDir KL_PPPA[1]))
KL_PPPA[1])
else "")
fn KFShellPathFN aa=
(KL_pp1=filterString (getFilenamePath aa) "\\"
if(findString aa "\\") ==1 do KL_pp1[1]="\\"+"\\"+KL_pp1[1]
KL_OncecouA=KL_pp1.count
notfound=true
for o=1 to KL_OncecouA while notfound do(KL_C2=KL_pp1[1]+"\\"
KL_OncecouB=(KL_pp1.count+1)-o
for jj=2 to KL_OncecouB do KL_C2+=KL_pp1[jj]+"\\"
KL_C3=ShellLaunch  ("\""+KL_C2+"\"") ""
if KL_C3 do notfound=false))
fn KF_SceneLIghtGro aa=      --灯光对象层集合函数,参数1定义收集量,仅对象层名字还是包括对象层对象集合,
(KL_Gro=#() 
KL_GroObj=#() 
kugeKG_Ligh=for pp in lights where not pp.isTarget collect pp                                                                             
KL_LayNum=LayerManager.count
for i=1 to KL_LayNum where(LayerManager.getLayer(KL_LayNum-i)).on!=false do((LayerManager.getLayer (KL_LayNum-i)).nodes &hhh 
KL_BHJJ=for m in hhh where findItem kugeKG_Ligh m!=0 collect m
if KL_BHJJ.count>0 do (if aa do append KL_GroObj KL_BHJJ
append KL_Gro(LayerManager.getLayer (KL_LayNum-i)).name))
#(KL_Gro,KL_GroObj))
fn KF_SceneObjGro aa bb cc WW dd=      --场景对象层集合函数,参数1定义收集量,仅对象层名字还是包括对象层对象集合,参数2为true时收集组对象层,参数3为true时收集层对象层,参数4定义处理范围,true代表所有,false代表可视
(KL_Gro=#() 
KL_GroObj=#() 
KL_WirGro=#() 
KL_WirGroObj=#() 
KL_LayGro=#() 
KL_LayGroObj=#()
if dd then KL_Objects=for o in objects where kugegeoFilt o collect o
else KL_Objects=for o in objects where ViewNOFRgeoFilt o collect o
if bb do(for ggg in objects do if isgroupHead ggg and  not isGroupMember ggg do(KL_Objcoll=join #() ggg
KL_BHJJ=for m in KL_Objcoll where findItem KL_Objects m!=0 collect m
if KL_BHJJ.count>0 do(if aa do append KL_GroObj KL_BHJJ
append KL_Gro ggg))
KL_BHJJ=for gg in KL_Objects where not isGroupMember gg collect gg
if KL_BHJJ.count>0 do(append KL_GroObj KL_BHJJ
append KL_Gro "NoneGroup"))
if cc do(for gg in KL_Objects do if (KL_UUpos=findItem KL_WirGro gg.wireColor)==0 then(append KL_WirGro gg.wireColor
append KL_WirGroObj #(gg))
else append KL_WirGroObj[KL_UUpos] gg)
if WW do(KL_LayNum=LayerManager.count
for i=1 to KL_LayNum where(LayerManager.getLayer(KL_LayNum-i)).on!=false do((LayerManager.getLayer (KL_LayNum-i)).nodes &hhh 
KL_BHJJ=for m in hhh where findItem KL_Objects m!=0 collect m
if KL_BHJJ.count>0 do (if aa do append KL_LayGroObj hhh
append KL_LayGro(LayerManager.getLayer (KL_LayNum-i)).name)))
#(#(KL_Gro,KL_GroObj),#(KL_WirGro,KL_WirGroObj),#(KL_LayGro,KL_LayGroObj)))
try(DestroyDialog KR_RenderFlowSet)catch()
rollout KR_RenderFlowSet "阿酷_渲染流程参数设置面板" width:398 height:325
(global Syun,KG_Photoshoppath
local KL_Pspath=getINISetting (getMAXIniFile()) "akoo2009" "Photoshoppath"
local KL_ComputerNmae=getINISetting (getMAXIniFile()) "akoo2009" "ComputerNmae" 
local KL_GuDingEail=getINISetting (getMAXIniFile()) "akoo2009" "GuDingEailcom" 
local KL_ProON=(getINISetting (getMAXIniFile()) "akoo2009" "RenderPro")=="1"
local KL_ProCC=(getINISetting (getMAXIniFile()) "akoo2009" "RenderProK5")as integer
local KL_ProMatM=(getINISetting (getMAXIniFile()) "akoo2009" "RenderMatM")=="1"
local KL_MatON=(getINISetting (getMAXIniFile()) "akoo2009" "RenderMat")=="1"
local KL_GroON=(getINISetting (getMAXIniFile()) "akoo2009" "RenderGro")=="1"
local KL_GroType=(getINISetting (getMAXIniFile()) "akoo2009" "RenderGro1")as integer
local KL_ShaON=(getINISetting (getMAXIniFile()) "akoo2009" "RenderSha")=="1"
local KL_NorON=(getINISetting (getMAXIniFile()) "akoo2009" "RenderNor")=="1"
local KL_FogON=(getINISetting (getMAXIniFile()) "akoo2009" "RenderFog")=="1"  
local KL_Fog2A=(getINISetting (getMAXIniFile()) "akoo2009" "CameraFog2A")as integer
local KL_Fog2B=(getINISetting (getMAXIniFile()) "akoo2009" "CameraFog2B")as integer
local KL_AOON=(getINISetting (getMAXIniFile()) "akoo2009" "RenderAOO1")=="1"
