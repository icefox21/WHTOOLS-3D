fn KF_AKOutFBLYuan aa=
(renderSceneDialog.commit()
KL_RendImaAsp=getRendImageAspect()
if hasProperty renderers.current "output_on" and hasProperty renderers.current "output_getsetsfrommax"
then(if renderers.current.output_on and renderers.current.output_getsetsfrommax==false 
then(Ak_renderHeight=(renderers.current.output_height*1.0)/aa
Ak_renderWidth=Ak_renderHeight*KL_RendImaAsp)
else(Ak_renderHeight=(renderHeight*1.0)/aa
Ak_renderWidth=Ak_renderHeight*KL_RendImaAsp))
else(Ak_renderHeight=(renderHeight*1.0)/aa
Ak_renderWidth=Ak_renderHeight*KL_RendImaAsp)
[(Ak_renderWidth as Integer),(Ak_renderHeight as Integer)])


fn KF_DelBackInit aa=
(undo off(KL_Snumb=0
KL_MMPUG=objects.count
KL_Snumb1GG1=0
KL_Snumb1GG2=0
for tt=1 to KL_MMPUG where canConvertTo objects[tt] Mesh do(KL_CXUB=(snapshotAsMesh objects[tt]).numfaces
KL_Snumb+=KL_CXUB
KL_Snumb1GG1+=KL_CXUB
if KL_Snumb1GG1-KL_Snumb1GG2>500000 do(KL_Snumb1GG2+=500000
try(gc())catch()))
KC_Edl1.text=(KL_Snumb as string)+"个三角面"
KC_Edl2.text=((for tt in objects where kugegeoFilt tt collect tt).count as string)+"个几何体"
if aa do KC_Edl3.text=KC_Edl4.text=""))
on KC_Boba1 pressed do KF_DelBackInit true
on KC_Bob1B pressed do(thawSelection()
clearSelection() 
KL_CCC=for m in objects where ViewgeoFilt m collect m
kl_objCM=KF_ClownpObjSel KL_CCC true false
if not kl_objCM[1] do(kl_objCM=for m in KL_CCC where findItem kl_objCM[2] m==0 collect m
KC_Edl3.text=kl_objCM.count as string
select kl_objCM))
on KC_Bob1C pressed do(thawSelection()
clearSelection() 
KL_CCC=for m in objects where ViewgeoFilt m collect m
kl_objCM=KF_ClownpObjSel KL_CCC true false
if not kl_objCM[1] do if viewport.getType()==#view_camera then(KL_QQMM=queryBox "确定要删除视角外面的物体吗?" title:"根据视角减面警告--阿酷提示"
if KL_QQMM do(kl_objCM=for m in KL_CCC where findItem kl_objCM[2] m==0 collect m
KC_Edl3.text=kl_objCM.count as string
undo on delete kl_objCM))
else messageBox "这个命令只能工作在相机视图!" title:"根据视角减面警告--阿酷提示")
on KC_Bob2C pressed do if viewport.getType()==#view_camera then
(KL_QQMM=queryBox "确定要删除背向视线的面吗?" title:"根据视角减面警告--阿酷提示"
if KL_QQMM do
(thawSelection()
clearSelection()  
if not displaySafeFrames do displaySafeFrames=true
try(gc())catch()
undo off(
kugennn=for tt in objects where ViewgeoFilt tt and canConvertTo tt Mesh  collect tt
convertToMesh kugennn
KL_Snumb11=0
KL_Snumb12=0
KL_CMDPU=kugennn.count
for u=1 to KL_CMDPU do(KC_Pro2.value=100.0*U/KL_CMDPU
KL_tefaar=#()      
KL_CMDPUB=kugennn[u].numfaces    
KL_pos1=(viewport.getCamera()).pos        
for i=1 to KL_CMDPUB do(Kl_pos2=meshop.getFaceCenter kugennn[u] i 
KL_vet1=getFaceNormal kugennn[u] i 
KL_Ang1=acos(dot KL_vet1 (normalize(KL_pos1-Kl_pos2)))
if KL_Ang1>=92 do append KL_tefaar i
if i==100000 do try(gc())catch())
KL_Snumb11+=KL_tefaar.count
if KL_Snumb11-KL_Snumb12>100000 do(KL_Snumb12+=100000
try(gc())catch())
if KL_tefaar.count<KL_CMDPUB then meshop.deleteFaces kugennn[u] KL_tefaar delIsoVerts:true
else delete kugennn[u])
KC_Edl4.text=KL_Snumb11 as string
KC_Pro2.value=0
try(gc())catch())))
else messageBox "这个命令只能工作在相机视图!" title:"根据视角减面警告--阿酷提示"
on KR_Delback open do(KF_DelBackInit true)
on KR_Delback rbuttondown aa do DestroyDialog KR_Delback)
CreateDialog KR_Delback)))
if (getINISetting (getMAXIniFile()) "akoo2009" "CollapseFaceLimit")=="" do setINISetting (getMAXIniFile()) "akoo2009" "CollapseFaceLimit" "50000"
fn  lcl_collapse_Union_CH KH_sel KH_CCC=
(convertToMesh KH_sel
KL_COmgjkd1=KH_sel.count                           
if KH_sel[1].material==undefined do(for p=2 to KL_COmgjkd1 where KH_sel[p].material!=undefined do 
(KH_sel[1].material=KH_sel[p].material 
exit))   
for gg=2 to KL_COmgjkd1 do(if KH_CCC do if KH_sel[gg].material!=undefined do KH_sel[gg].material=undefined
meshop.attach KH_sel[1].mesh KH_sel[gg].mesh targetNode:KH_sel[1] sourceNode:KH_sel[gg] attachMat:#IDToMat condenseMat:true)
select KH_sel[1]
displayTempPrompt ("共塌陷合并选择几何体--"+(KL_COmgjkd1 as string)) 12000)	
fn kuge_collapse_code lcl_matobj lcl_matmat dddd=
(local kuge_numfaces_limit,lcl_selobj,lclhy,lclik
kuge_numfaces_limit=(getINISetting (getMAXIniFile()) "akoo2009" "CollapseFaceLimit") as Integer
lcl_selobj=#()
KL_COmgjkd2=lcl_matobj.count
KL_Snumb11=0
KL_Snumb12=0
for uu=1 to KL_COmgjkd2 do
(convertToMesh lcl_matobj[uu]
KL_COmgjkd3=lcl_matobj[uu].count
progressStart ("当前:"+lcl_matmat[uu].name+"("+KL_COmgjkd3 as string +"个对象)")
lclhy=1
lcl_matobj[uu][lclhy].name=lcl_matmat[uu].name
append lcl_selobj lcl_matobj[uu][lclhy]		
for lclik=(lclhy+1) to KL_COmgjkd3 do
(if (lcl_matobj[uu][lclhy].numfaces+(getPolygonCount lcl_matobj[uu][lclik])[1])<kuge_numfaces_limit then
(meshop.attach lcl_matobj[uu][lclhy].mesh lcl_matobj[uu][lclik].mesh targetNode:lcl_matobj[uu][lclhy] sourceNode:lcl_matobj[uu][lclik] 
progressUpdate (100.0*lclik/KL_COmgjkd3))
else(lclhy=lclik
lcl_matobj[uu][lclhy].name=lcl_matmat[uu].name
append lcl_selobj lcl_matobj[uu][lclhy]
progressUpdate (100.0*lclik/KL_COmgjkd3)))
progressEnd()
KL_Snumb11+=1
if KL_Snumb11-KL_Snumb12>50 do(KL_Snumb12+=50
if dddd!=undefined then try(gc())catch()
else try(gc light:true)catch()))
if dddd!=undefined then group lcl_selobj name:dddd
else select lcl_selobj)
fn	lcl_collapse_Mesh AA=
(undo on(	
setCommandPanelTaskMode mode:#create
if kuge_singleshape selection then convertToMesh selection[1]
else(if AA then(kugell=for i in objects where kugegeoFilt i and (canConvertTo i Mesh) collect i
kugemm="场景")
else(kugell=for i in selection where ViewgeoFilt i and (canConvertTo i Mesh) collect i
kugemm="选择")
if kugell.count>=1 do(thawSelection()
clearSelection()                   
convertToMesh kugell
if not AA do select kugell
displayTempPrompt ("共塌陷堆栈处理"+kugemm+"几何体--"+kugell.count as string) 12000))
setCommandPanelTaskMode mode:#modify))	
fn  lcl_collapse_Union=
(kuge_numfaces_limit=(getINISetting (getMAXIniFile()) "akoo2009" "CollapseFaceLimit") as Integer
setCommandPanelTaskMode mode:#create
if(for yy in selection where isGroupHead yy collect yy).count==0 then
(lclunion=for i in selection where ViewgeoFilt i and (canConvertTo i Mesh) collect i 
jjjnumstart=0 
kugeshu=for ll in lclunion do jjjnumstart+=(getPolygonCount ll)[1]
if jjjnumstart<kuge_numfaces_limit then
(if lclunion.count>0 do(
thawSelection()
clearSelection() 
undo on(lcl_collapse_Union_CH lclunion true)
setCommandPanelTaskMode mode:#modify))
else messageBox ("当前选择几何体的总面数超过限制数,请重新操作!\n 选择总面数为:"+(jjjnumstart as string)+";限制面数为:"+(kuge_numfaces_limit as string)) title:"塌陷合并总面数警告--阿酷提示") 
else messageBox "当前选择含有组对象,很可能不是你希望的操作,请重新操作!" title:"塌陷合并组警告--阿酷提示")
fn  lcl_collapse_Union_Mul=
(setCommandPanelTaskMode mode:#create
lclunion=for i in selection where ViewgeoFilt i and (canConvertTo i Mesh) collect i 
if lclunion.count>=2 do
(explodeGroup (for jj in selection where isGroupHead jj and not isGroupMember jj collect jj)    
thawSelection()
clearSelection() 
undo on(lcl_collapse_Union_CH lclunion false)
setCommandPanelTaskMode mode:#modify))
fn lcl_Collapse_ByMatSel_CH=
(kugeseVV=getCurrentSelection()
thawSelection()
clearSelection() 
explodeGroup (for jj in kugeseVV where isGroupHead jj and not isGroupMember jj collect jj) 
kugeselo=for uu in kugeseVV where IsValidNode uu and (canConvertTo uu Mesh) collect uu
lcl_matobj=#()
lcl_matmat=#()
for oo in kugeselo where ViewgeoFilt oo and oo.material!=undefined do
(if (kugemnum=findItem lcl_matmat oo.material)==0 then(append lcl_matmat oo.material
append lcl_matobj #(oo))
else append lcl_matobj[kugemnum] oo)
kuge_collapse_code lcl_matobj lcl_matmat undefined
displayTempPrompt ("选择按材质塌陷处理--"+lcl_matmat.count as string+"种材质") 12000)
fn lcl_Collapse_ByMatSel=
(setCommandPanelTaskMode mode:#create
undo on(lcl_Collapse_ByMatSel_CH())
setCommandPanelTaskMode mode:#modify)
fn lcl_Collapse_ByMatSce=
(setCommandPanelTaskMode mode:#create
KUGE_Q1=queryBox "继续操作之前请确认是否备份好文件！\n点击“是”继续操作；点击“否”先退出。" title:"场景组按材质塌陷警告--阿酷提示"
if KUGE_Q1 do(
undo off(
thawSelection()
clearSelection() 
kugematg= for o in objects where isGroupHead o and  not isGroupMember o and not o.isHiddenInVpt and not o.isFrozen collect o 
KL_COmgjkd4=kugematg.count
for sa=1 to KL_COmgjkd4 do(kugename=kugematg[sa].name
lcl_matobj=#()
lcl_matmat=#()
KL_COmgjkd5=join #() kugematg[sa]
for kkk in KL_COmgjkd5 where ViewgeoFilt kkk and kkk.material!=undefined and (canConvertTo kkk Mesh) do
(if (kugemnum=findItem lcl_matmat kkk.material)==0 then(append lcl_matmat kkk.material
append lcl_matobj #(kkk))
else append lcl_matobj[kugemnum] kkk)
explodeGroup kugematg[sa]       
kuge_collapse_code lcl_matobj lcl_matmat kugename)
displayTempPrompt ("场景组按材质塌陷处理--"+KL_COmgjkd4 as string+"个组") 12000))
setCommandPanelTaskMode mode:#modify)
fn lcl_Explode_ByMat=							 
(undo on(	
setCommandPanelTaskMode mode:#create
explodeGroup (for jj in selection where isGroupHead jj and not isGroupMember jj collect jj) 
kugeExpobj =for i in selection where ViewgeoFilt i and i.material!=undefined and (canConvertTo i Mesh) collect i  
kugeExp=for h in kugeExpobj where h.Material.classID[1]==512 collect h  
thawSelection()
clearSelection()
gc()
kksele=#() 
KL1=kugeExp.count
for sb=1 to  KL1 do(KL_WQnewObj=KF_ExperFRest kugeExp[sb]
kugegrn=KL_WQnewObj.name 
kugecolor=KL_WQnewObj.wireColor
kugemat=KL_WQnewObj.material                     
kugewww=#()
kugeExpa=snapshotAsMesh KL_WQnewObj
delete KL_WQnewObj
while kugeExpa.numfaces>0 do(kuge2bb=getFaceMatID kugeExpa 1   
kuge2bbname=(getSubMtl kugemat kuge2bb).name   
KL_XXXND1=kugeExpa.numfaces   
kugeAB=(for s=1 to KL_XXXND1 where (getFaceMatID kugeExpa s)==kuge2bb collect s) 
newMesh=meshop.detachFaces kugeExpa kugeAB delete:true asMesh:true 
lelmesh = Editable_mesh()
lelmesh.mesh=newMesh
kugenew=mesh lengthsegs:1 widthsegs:1 position:lelmesh.center wireColor:kugecolor material:(getSubMtl kugemat kuge2bb) name:kuge2bbname              
meshop.attach kugenew.mesh lelmesh.mesh targetNode:kugenew sourceNode:lelmesh
meshop.deleteFaces kugenew.mesh #{1..2} delIsoVerts:true
append kugewww kugenew
gc())
if KL1>1 then append kksele	(group kugewww name:kugegrn)
else join kksele	 kugewww)
select kksele
displayTempPrompt ("选择按材质炸开处理--"+ KL1 as string+"个多维对象") 12000
setCommandPanelTaskMode mode:#modify))
fn lcl_Explode_ByElem=							 
(undo on(	
setCommandPanelTaskMode mode:#create
gc()
kugeExp=#()
explodeGroup (for jj in selection where isGroupHead jj and not isGroupMember jj collect jj) 
kugeExpobj=for i in selection where ViewgeoFilt i and (canConvertTo i Mesh) collect i  
thawSelection()
clearSelection() 
kksele=#() 
for kk in kugeExpobj do(klj=snapshotAsMesh kk
if klj.numfaces>((meshop.getElementsUsingFace klj #(1))as array).count do append kugeExp kk)
KL1=kugeExp.count
for sb=1 to  KL1 do(KL_WQnewObj=KF_ExperFRest kugeExp[sb]
kugegrn=KL_WQnewObj.name 
kugecolor=KL_WQnewObj.wireColor
kugemat1=KL_WQnewObj.material        
if kugemat1!=undefined do if kugemat1.classID[1]==512 do kugemat1=getSubMtl KL_WQnewObj.material 1          
kugewww=#()
kugeExpa=snapshotAsMesh KL_WQnewObj
delete KL_WQnewObj
while kugeExpa.numfaces>0 do(kugeAB=meshop.getElementsUsingFace kugeExpa #(1)
newMesh=meshop.detachFaces kugeExpa kugeAB delete:true asMesh:true 
lelmesh = Editable_mesh()
lelmesh.mesh=newMesh
kugenew=(mesh lengthsegs:1 widthsegs:1 position:lelmesh.center wireColor:kugecolor material:kugemat1 name:kugegrn)               
meshop.attach kugenew.mesh lelmesh.mesh targetNode:kugenew sourceNode:lelmesh
meshop.deleteFaces kugenew.mesh #{1..2} delIsoVerts:true
append kugewww kugenew
gc())
if KL1>1 then append kksele	(group kugewww name:kugegrn)
else join kksele kugewww)
select kksele
displayTempPrompt ("选择按体元素炸开处理--"+ KL1 as string+"个网格对象") 12000
setCommandPanelTaskMode mode:#modify))	
fn lcl_Explode_ByEQElem=							 
(undo on(
setCommandPanelTaskMode mode:#create
kugeExp=#()
explodeGroup (for jj in selection where isGroupHead jj and not isGroupMember jj collect jj) 
kugeExpobj=for i in selection where ViewgeoFilt i and (canConvertTo i Mesh) collect i  
thawSelection()
clearSelection() 
gc()
kksele=#() 
for kk in kugeExpobj do(klj=snapshotAsMesh kk
if klj.numfaces>((meshop.getElementsUsingFace klj #(1))as array).count do append kugeExp kk)
KL1=kugeExp.count
for sb=1 to  KL1 do(KL_WQnewObj=KF_ExperFRest kugeExp[sb]
kugeExpFace=#()
kugeExpFacearc=#()
kugegrn=KL_WQnewObj.name 
kugecolor=KL_WQnewObj.wireColor
kugemat2=KL_WQnewObj.material        
if kugemat2!=undefined do if kugemat2.classID[1]==512 do kugemat2=getSubMtl KL_WQnewObj.material 1                    
kugewww=#()
kugeExpa=snapshotAsMesh KL_WQnewObj
kkknum=1
while kkknum<=kugeExpa.numfaces do(lllkk=meshop.getElementsUsingFace kugeExpa #(kkknum)
llarm=meshop.getFaceArea kugeExpa lllkk
kugemnum=0
KL_XXXNB=kugeExpFacearc.count
for uu=1 to KL_XXXNB where llarm/kugeExpFacearc[uu]>0.97 and llarm/kugeExpFacearc[uu]<1.03 do(kugemnum=uu
exit)
if kugemnum==0 then(append kugeExpFacearc llarm
append kugeExpFace lllkk
kkknum+=(lllkk as array).count) 
else(join kugeExpFace[kugemnum] lllkk
kkknum+=(lllkk as array).count))
delete KL_WQnewObj
KL_XXXNC=kugeExpFace.count
for hh=1 to KL_XXXNC do(kugeAB=kugeExpFace[hh]
newMesh=meshop.detachFaces kugeExpa kugeAB delete:false asMesh:true 
lelmesh = Editable_mesh()
lelmesh.mesh=newMesh
kugenew=(mesh lengthsegs:1 widthsegs:1 position:lelmesh.center wireColor:kugecolor material:kugemat2 name:kugegrn)               
meshop.attach kugenew.mesh lelmesh.mesh targetNode:kugenew sourceNode:lelmesh
meshop.deleteFaces kugenew.mesh #{1..2} delIsoVerts:true
append kugewww kugenew
gc())
if KL1>1 then append kksele	(group kugewww name:kugegrn)
else join kksele kugewww)
select kksele
displayTempPrompt ("选择按等体积体元素炸开处理--"+ KL1 as string+"个网格对象") 12000
setCommandPanelTaskMode mode:#modify))	
fn KHF_OpenGroupCH ZZ=   ----场景忽略组模式检测工作,因为如果在进行组操作之前本身选择有打开组,将处理不正确;参数1:ZZ，传入开组和关组指示;
(thawSelection()             ---取消选择;
clearSelection()       
KL_HHHgro=for i in helpers where isGroupHead i collect i    ----这里收集所有组头,用来总体开关组头集合;
if ZZ  then(for m in KL_HHHgro do setGroupOpen m true        ---如果需要开组,则直接打开且隐藏所有组头
hide KL_HHHgro)
else(Kl_FFm=for m in KL_HHHgro where isOpenGroupHead m and(m.parent==undefined or(m.parent!=undefined and not isGroupHead m.parent))collect m
for m in Kl_FFm do setGroupOpen m false          ---如果需要关闭组,则隐藏所有组头，并针对:1.打开的组头;2.没有父对象或有父对象但父对象不是组头的  的明确组头进行处理;
unhide KL_HHHgro)
KGL_IgnGroupMode=ZZ)                                          ---跳转全局系统变量;
fn lcl_Group_g=
(KL_old=selection as array
KHF_OpenGroupCH false
select KL_old
for gf in selection where gf.parent!=undefined and not isGroupMember gf do gf.parent=undefined 
for gf in selection where isGroupMember gf and gf.parent==undefined do setGroupMember gf false
for gf in selection where isOpenGroupMember gf do (
if gf.parent!=undefined then(setGroupOpen gf.parent false
selectMore gf.parent
kugestate=false)
else setGroupMember gf false)
for gf in selection where isOpenGroupHead gf do(setGroupOpen gf false
selectMore gf
kugestate=false)
kugegshapeobj=for o in selection where (o.isHiddenInVpt==false and o.isFrozen==false and(superclassof o==Shape and classof o!=PolymorphicGeomshape and classof o!=LinkCompositeshape and not o.baseobject.renderable)and IsValidNode o and not o.isTarget) or isGroupHead o collect o
xujgshapeobj=for jj in kugegshapeobj where isGroupMember jj or isGroupHead jj collect jj
lxgshapeobj=for jj in kugegshapeobj where isGroupHead jj and not isGroupMember jj collect jj
kugeggeoobj=for o in selection where (o.isHiddenInVpt==false and o.isFrozen==false and((superclassof o==GeometryClass and classof t!=LinkComposite)or(superclassof o==Shape and classof o!=PolymorphicGeomshape and classof o!=LinkCompositeshape and o.baseobject.renderable))and IsValidNode o and not o.isTarget) or isGroupHead o collect o  
xujggeoobj=for jj in kugeggeoobj where isGroupMember jj or isGroupHead jj collect jj
lxggeoobj=for jj in kugeggeoobj where isGroupHead jj and not isGroupMember jj collect jj
if kugegshapeobj.count>0 or kugeggeoobj.count>0 do
(if kugegshapeobj.count>kugeggeoobj.count 
then if not(xujgshapeobj.count==kugegshapeobj.count and lxgshapeobj.count==1) do(clearSelection()
group kugegshapeobj select:true)
else if not(xujggeoobj.count==kugeggeoobj.count and lxggeoobj.count==1) do(clearSelection()
group kugeggeoobj select:true
if selection.count==0 do select kugeggeoobj)))																				 			 
fn lcl_Group_Un=
(KL_old=selection as array
KHF_OpenGroupCH false
select KL_old
for gf in selection where isOpenGroupMember gf do (
if gf.parent!=undefined then(setGroupOpen gf.parent false
selectMore gf.parent)
else setGroupMember gf false)
for gf in selection where isOpenGroupHead gf do(setGroupOpen gf false
selectMore gf)
kugeung=for jj in selection where isGroupHead jj and not isGroupMember jj collect jj
ungroup kugeung)
fn lcl_Group_exp=
(KL_old=selection  as array
KHF_OpenGroupCH false
select KL_old	
for gf in selection where isOpenGroupMember gf do (
if gf.parent!=undefined then(setGroupOpen gf.parent false
selectMore gf.parent)
else setGroupMember gf false)
for gf in selection where isOpenGroupHead gf do(setGroupOpen gf false
selectMore gf)
kugeexg=for jj in selection where isGroupHead jj and not isGroupMember jj collect jj
explodeGroup kugeexg)
fn lcl_Group_Ignore ZZ=
(if ZZ then KHF_OpenGroupCH false  
else KHF_OpenGroupCH true)	  ----总是禁止选择,基于帮助对象组进行集合,
global lcl_iso_Lib=#()
global lcl_hide_Lib=#()
fn lcl_unselectFR HFISEL=(for i in HFISEL where i.isHiddenInVpt==false and i.isSelected==false and IsValidNode i collect i)
fn lcl_unselect HFISEL=(for i in HFISEL where i.isHiddenInVpt==false and i.isSelected==false and i.isFrozen==false and IsValidNode i collect i)
fn lcl_hide HFISEL=(for i in HFISEL where i.isHiddenInVpt==true and IsValidNode i collect i)
fn lcl_freezeobj HFISEL=(for i in HFISEL where i.isFrozen==true and IsValidNode i collect i)
fn lcl_unhide HFISEL=(for i in HFISEL where i.isHiddenInVpt==false and IsValidNode i collect i)
fn kuge_FreezeObjFI o=(o.isFrozen and IsValidNode o)	
fn lcl_HFI_IsoMode=
(mmjj=false
if lcl_iso_Lib.count>0 do(kkkiso=for kkk in lcl_iso_Lib[1] where IsValidNode kkk collect kkk	
if kkkiso.count>0 then mmjj=kkkiso[1].isHiddenInVpt
else lcl_iso_Lib=#())                                											
if mmjj  then(unhide kkkiso
global lcl_iso_Lib=#())
else(if selection.count>0 and (lcl_unselectFR objects).count>0 do
(global lcl_iso_Lib=#()
append lcl_iso_Lib (lcl_unselectFR objects)
hide (lcl_unselectFR objects)
completeRedraw())))
fn lcl_HFI_HideSel=
(if selection.count>0 do(if lcl_hide_Lib.count==5 do deleteItem lcl_hide_Lib 1
append lcl_hide_Lib (selection as array)
hide selection
thawSelection()
clearSelection()))						
fn lcl_HFI_UnHideLast=
(local kugekil						
if lcl_hide_Lib.count>0 do(kugekil=for ii in lcl_hide_Lib[lcl_hide_Lib.count] where IsValidNode ii  collect ii
unhide kugekil doLayer:false
deleteItem lcl_hide_Lib lcl_hide_Lib.count))
fn lcl_HFI_hideUnSel=
(if (lcl_unselect objects).count>0 do(if lcl_hide_Lib.count==5 do deleteItem lcl_hide_Lib 1
append lcl_hide_Lib (lcl_unselect objects)
hide (lcl_unselect objects)
completeRedraw()))
fn lcl_HFI_UnHideSwap=
(kuge1=(lcl_unhide objects)
kuge2=(lcl_hide objects)
if kuge1.count>0 and kuge2.count>0 do
(hide kuge1 
thawSelection()
clearSelection()
unhide kuge2 doLayer:false
if KGL_IgnGroupMode do(KL_HHHgro=for i in helpers where isGroupHead i collect i
hide KL_HHHgro)
global lcl_hide_Lib=#()))
fn lcl_HFI_Unfreezebypick=
(thawSelection()   
kugeUnFPK=pickObject message:"点击需解冻对象:" count:#multiple filter:kuge_FreezeObjFI  select:true  pickFrozen:true forceListenerFocus:false
if kugeUnFPK.count>0 do(kugetemp=#()
for j in kugeUnFPK do if j.parent!=undefined and IsValidNode j then join  kugetemp j.parent
else join  kugetemp j
unfreeze kugetemp doLayer:true
clearSelection()))     
