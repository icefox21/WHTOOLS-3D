(if nnn.superClassID==2064 or nnn.superClassID==2080 do
(for hh in refs.dependents nnn where IsValidNode hh do
(if kugegeoFilt hh and (findItem hh.modifiers nnn)!=0 and(findItem lcl_Modifiers hh)==0 do append lcl_Modifiers hh))) 
else(for oo in selection where kugegeoFilt oo do
