if KL_BDN.count>0 do KHF_SertchFN KGM_BitmFiNa KGM_StyPeiNa KGM_MMTTFiNa KC_PGB1 #(KGM_SceBitthA1,KGM_SceBitthA2,KGM_SceBitthA3,KGM_SceBitthA4,KGM_SceBitthA5) KL_BDN true))

