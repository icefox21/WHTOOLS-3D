if KL_BDN.count>0 do KHF_SertchFN KGM_BitmFiNa KGM_StyPeiNa KGM_MMTTFiNa KC_PGB1 #(KC_Ed5.text+"\\") KL_BDN true
KC_Ed5CT.checked=false))
on KC_Ed6CT changed aa do(if aa do(KL_BDN=KR_SceneBitlist.KCXMLB1.selection as array
