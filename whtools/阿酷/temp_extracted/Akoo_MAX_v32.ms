try(deletefile ABFile)catch(print ("无法删除文件"+ABFile)))
UpdateAB_List())))


rollout KR_ABackLoader "阿酷场景文件管理工具"
(local ShunXSort,CreateSort,NameSort,SizeSort,DateSort
dotNetControl LB_Main "System.Windows.Forms.ListView"  width:598 height:290
Spinner SP_ABNoF "备份数量:"  fieldwidth:35 range:[1,20,autoSave.NumberOfFiles] type:#integer align:#left 
Spinner SP_ABTime "备份间隔:"  fieldwidth:35 range:[5,60,autoSave.Interval] type:#integer align:#left 
checkbox BT_FileMAX "备份文件" checked:true offset:[112,-41]
checkbox BT_FileRec "最近文件" checked:true offset:[112,0]
Button BT_Update "更新列表" width:60 offset:[0,-33]
colorpicker BT_FileMAXco2 "" color:[255,233,200] enabled:false fieldWidth:30 height:14 offset:[180,-33]
--label KLA_BT "启动场景:" offset:[0,-41]
--Button BT_SS1 "保存当前" width:60 offset:[0,-41]
--Button BT_SS2 "加载" width:60 offset:[50,8]
--Button BT_SS3 "删除" width:60 offset:[50,8]
Fn KF_LoadRecentFileList=
(local XMLArray=#()
local KL_CMDA1=getINISetting (getMAXIniFile()) "FileList"	
if (maxVersion())[1]/1000>=12 
then(recentfiles=(getdir #maxData)+"RecentDocuments.xml"
if doesfileexist recentfiles do(local xDoc=dotnetobject "system.xml.xmldocument"	
xDoc.Load recentfiles
Rootelement=xDoc.documentelement
KL_BFG=rootelement.childnodes.item[4].childnodes.itemof[0].childnodes
for i=0 to (KL_BFG.count-1) where doesFileExist KL_BFG.itemof[i].childnodes.itemof[3].innertext and findItem XMLArray KL_BFG.itemof[i].childnodes.itemof[3].innertext==0 do append XMLArray KL_BFG.itemof[i].childnodes.itemof[3].innertext))
else(for m in KL_CMDA1 where(matchPattern m pattern:"File*")do(KL_GHF1=getINISetting (getMAXIniFile()) "FileList" m
if doesFileExist KL_GHF1 and findItem XMLArray KL_GHF1==0 do append XMLArray KL_GHF1))

Return XMLArray)
fn KF_ABackFileLIUp=
(fn KF_TimeDateForMat time1=
(local KL_LTA=#("下午","PM")
local KL_LT0=#("2000","00","00","00","00","00","00")
KL_LTX=filterString time1 ".,/,-, ,:"
if KL_LTX.count>6 then KL_LT1=#(KL_LTX[3],KL_LTX[1],KL_LTX[2],KL_LTX[7],KL_LTX[4],KL_LTX[5],KL_LTX[6])
else KL_LT1=#(KL_LTX[3],KL_LTX[1],KL_LTX[2],"undefined",KL_LTX[4],KL_LTX[5],KL_LTX[6])
if KL_LT1.count>6 then if (KL_LT1[4] as Integer)==undefined do if KL_LT1[5]=="12" do(KL_LT1[5]=(execute(KL_LT1[5]+"-12"))as string
KL_LT1[4]="PM")
else deleteItem KL_LT1 4
for m=1 to KL_LT1.count do if KL_LT1[m].count<KL_LT0[m].count do KL_LT1[m]=replace KL_LT0[m]((KL_LT0[m].count+1)-KL_LT1[m].count) KL_LT1[m].count KL_LT1[m]
if (KL_LT1[4] as Integer)==undefined do if(findItem KL_LTA KL_LT1[4])==0 then deleteItem KL_LT1 4
else(KL_LT1[5]=(execute(KL_LT1[5]+"+12"))as string
deleteItem KL_LT1 4)
return (KL_LT1[1]+"/"+KL_LT1[2]+"/"+KL_LT1[3]+" "+KL_LT1[4]+":"+KL_LT1[5]+":"+KL_LT1[6]))
fn ShunXSort v1 v2 =
(case of
(
(v1[1] < v2[1]):-1
(v1[1] > v2[1]):1
default: 0
)
)
fn CreateSort v1 v2 =
(case of
(
(v1[2] < v2[2]):-1
(v1[2] > v2[2]):1
default: 0
)
)
fn NameSort v1 v2=
(case of
(
(v1[3] < v2[3]):-1
(v1[3] > v2[3]):1
default: 0
)
)
fn SizeSort v1 v2 =
(case of
(
(v1[4] < v2[4]):1
(v1[4] > v2[4]):-1
default: 0
)
)
fn DateSort v1 v2 =
(case of
(
(v1[5] < v2[5]):1
(v1[5] > v2[5]):-1
default: 0
)
)
fn KF_LongNaShor FilePath aa=
(kl_P1=filterString FilePath "\\"
kl_P2=substring kl_P1[1] 1 aa
if (findString FilePath "\\" )==1 do kl_P2="\\\\"+kl_P2
if kl_P1.count<=aa then KL_P3=kl_P1.count-1
else KL_P3=(aa-1)                         
for yy=2 to KL_P3 do kl_P2+=("\\"+(substring kl_P1[yy] 1 aa))
if kl_P1.count>aa do kl_P2+=("\\"+"...")
if kl_P1.count>1 then kl_P2+=("\\"+kl_P1[kl_P1.count]+"\\")
else kl_P2+="\\"
return kl_P2)

KGF_LastFileCol=#()
if KR_ABackLoader.BT_FileRec.checked do(KL_ZUiJFile=KF_LoadRecentFileList()
for m in KL_ZUiJFile where findItem KGF_LastFileCol m==0 do append KGF_LastFileCol m)
KG_ABackFiles=#()
if KR_ABackLoader.BT_FileMAX.checked do(KL_ABK1=getfiles((getdir #autoback)+"\\*.max")
for tt in KL_ABK1 where findItem KGF_LastFileCol tt==0 do append KG_ABackFiles tt)
if KR_ABackLoader.BT_FileMAX.checked do(KL_ABK1=getfiles((getdir #autoback)+"\\*.bak")
for tt in KL_ABK1 where findItem KGF_LastFileCol tt==0 do append KG_ABackFiles tt)
if KR_ABackLoader.BT_FileMAX.checked do(KL_ABK1=getfiles((getdir #autoback)+"\\*.mx")
for tt in KL_ABK1 where findItem KGF_LastFileCol tt==0 do append KG_ABackFiles tt)
local TheFileData=#()
local AKKA=1
for i=1 to KGF_LastFileCol.count do(append TheFileData #(AKKA,(KF_LongNaShor(getFilenamePath KGF_LastFileCol[i]) 6),(filenameFromPath KGF_LastFileCol[i]),(((getfilesize KGF_LastFileCol[i])/10000)/100.0),(KF_TimeDateForMat (getFileModDate KGF_LastFileCol[i])),KGF_LastFileCol[i])
AKKA+=1)
KAA_Cabs=for i=1 to KG_ABackFiles.count collect (KF_TimeDateForMat (getFileModDate KG_ABackFiles[i]))	
KAA_CabsB=join #() KAA_Cabs
sort KAA_CabsB
KAA_CabsB=for m in KAA_CabsB collect findItem KAA_Cabs m
KG_ABackFiles=for m=1 to KG_ABackFiles.count collect KG_ABackFiles[KAA_CabsB[(KAA_CabsB.count+1-m)]]
for i=1 to KG_ABackFiles.count do(append TheFileData #(AKKA,(KF_LongNaShor(getFilenamePath KG_ABackFiles[i]) 6),(filenameFromPath KG_ABackFiles[i]),(((getfilesize KG_ABackFiles[i])/10000)/100.0),(KF_TimeDateForMat (getFileModDate KG_ABackFiles[i])),KG_ABackFiles[i])
AKKA+=1)
return  TheFileData)
fn initListView lv= 
(lv.gridlines = true
lv.View=(dotNetClass "System.Windows.Forms.View").Details
lv.fullRowSelect = true
lv.Columns.add "序" (25)
lv.Columns.add "文件路径" (250)
lv.Columns.add "文件名称" (110)
lv.Columns.add "大小(M)" (50)
lv.Columns.add "保存时间" (130))
fn fillInSpreadSheet lv arr=
(lv.items.clear()
theRange=#() 
for i=1 to arr.count do
(li=dotNetObject "System.Windows.Forms.ListViewItem" ((arr[i][1])as string)
sub_li=li.SubItems.add arr[i][2]
sub_li=li.SubItems.add arr[i][3]
sub_li=li.SubItems.add ((arr[i][4])as string)
sub_li=li.SubItems.add arr[i][5]
append theRange li)
lv.Items.AddRange theRange
for i=1 to KR_ABackLoader.LB_Main.items.count do
(if findItem KGF_LastFileCol arr[i][6]==0 do KR_ABackLoader.LB_Main.Items.item[i-1].BackColor=(dotNetClass "System.Drawing.Color").BlanchedAlmond))
fn updateAB_List=
(ABData=KF_ABackFileLIUp()
case LastColumnState of
(
"ShunXDec":qsort ABData ShunXSort
"CreateDec":qsort ABData CreateSort
"NameDec":qsort ABData NameSort
"SizeDec":qsort ABData SizeSort
"ModDec":qsort ABData DateSort
)
fillInSpreadSheet KR_ABackLoader.LB_Main ABData
KR_ABackLoader.SP_ABNoF.value=autoSave.NumberOfFiles
KR_ABackLoader. SP_ABTime.value=autoSave.Interval)

on KR_ABackLoader open do 
(initListView LB_Main
Local tmpSizeX, tmpSizeY, tmpPosX, tmpPosY
LastColumnState=getINISetting AK_INIT_File "KR_ABackLoader" "ColumnSort"
BT_FileMAX.checked=(getINISetting AK_INIT_File "KR_ABackLoader" "BT_FileMAX")as BooleanClass
BT_FileRec.checked=(getINISetting AK_INIT_File "KR_ABackLoader" "BT_FileRec")as BooleanClass
updateAB_List())
on SP_ABNoF changed arg do autosave.NumberOfFiles=arg
on SP_ABTime changed arg do autoSave.Interval=arg
on LB_Main ColumnClick arg do
(case arg.column of 
(
0:(qsort ABData ShunXSort)
1:(qsort ABData CreateSort)
2:(qsort ABData NameSort)
3:(qsort ABData SizeSort)
4:(qsort ABData DateSort)
)
fillInSpreadSheet LB_Main ABData)
on LB_Main mouseUp arg do
(if KR_ABackLoader.LB_Main.SelectedItems.count!=0 do
(if arg.button==(dotnetclass "System.Windows.Forms.MouseButtons").Right do
(popUpMenu KG_RC_Main pos:[arg.x+LB_Main.pos.x, arg.y+LB_Main.pos.y] rollout:KR_ABackLoader)))
on KR_ABackLoader resized size do
(theHeight=size.y
maxHeight=(getMAXWindowSize()).y-50
case of
(
(theHeight>maxHeight):(theHeight=maxHeight)
(theHeight<200):theheight=200
)
KR_ABackLoader.height=theHeight
if size.x < 495 do KR_ABackLoader.width = 495
LB_Main.width=KR_ABackLoader.width-25
KR_ABackLoader.height=theHeight
KR_ABackLoader.LB_Main.height=(KR_ABackLoader.height-45)
KR_ABackLoader.SP_ABTime.pos.y=(KR_ABackLoader.LB_Main.height+9)
KR_ABackLoader.SP_ABNoF.pos.y=(KR_ABackLoader.LB_Main.height+26)
KR_ABackLoader.BT_FileMAX.pos.y=(KR_ABackLoader.LB_Main.height+9)
KR_ABackLoader.BT_FileRec.pos.y=(KR_ABackLoader.LB_Main.height+26)
KR_ABackLoader.BT_FileMAXco2.pos.y=(KR_ABackLoader.LB_Main.height+9)
KR_ABackLoader.BT_Update.pos.y=(KR_ABackLoader.LB_Main.height+9))
on KR_ABackLoader close do
(setINISetting AK_INIT_File "KR_ABackLoader" "ColumnSort" LastColumnState
setINISetting AK_INIT_File "KR_ABackLoader" "BT_FileMAX" (BT_FileMAX.checked as string)
setINISetting AK_INIT_File "KR_ABackLoader" "BT_FileRec" (BT_FileRec.checked as string))
on BT_FileMAX changed arg do updateAB_List()
on BT_FileRec changed arg do updateAB_List()
on BT_Update pressed do updateAB_List())
createdialog KR_ABackLoader 623 342 style:#(#style_resizing,#style_sysmenu,#style_minimizebox,#style_titlebar)))
fn lcl_Miscell_MulSamAuto=   
(if (KL_JianCLigObj aaa:1 bbb:3 ccc:2)do
(local KL_Destobj
if not(matchPattern maxFileName pattern:"ShowStencil_*") then(KL_SBSce=getOpenFileName caption:"选择模版场景" filename:KGL_MankPathInI types:"小样模版场景|*.max|"
if KL_SBSce!=undefined do loadMaxFile KL_SBSce useFileUnits:true quiet:true)
else KL_SBSce=maxFilePath+maxFileName
KL_NameStr=(getFiles(KGL_MankPathInI+"SampleWater_*.tga"))[1]
if KL_NameStr!=undefined do Kl_new=openBitMap KL_NameStr       ----必须成方,带Alpha通道,它的尺寸决定着最终渲出小样的尺寸;
if KL_SBSce!=undefined and doesFileExist KL_SBSce do if Kl_new!=undefined then
(KL_ZtimeBJ2=(timeStamp())/1000
KL_Destobj=getNodeByName "RenderBoxFloor"                   ----获得地板对象;
KL_Finae=KGL_MankPathInI+"SampleRenderErr.log"
if doesFileExist KL_Finae and getFileSize KL_Finae<1000000 then(KL_NewLogfile=openFile KL_Finae mode:"a"            ----当该文件存在且小于1M的时候才会打开追加,否则直接新建覆写;
Kl_ttime=KHF_DaForMatCO localtime true
Kl_ttimeZ=Kl_ttime[1]+"年"+Kl_ttime[2]+"月"+Kl_ttime[3]+"日"+Kl_ttime[4]+"时"+Kl_ttime[5]+"分"+Kl_ttime[6]+"秒"
format "%:小样渲染记录----------------\n" Kl_ttimeZ to:KL_NewLogfile)
else KL_NewLogfile=createFile KL_Finae 
kl_CollFolder=#()                                           ---场景文件目录;
KL_Q1RR=getSavePath caption:"添加单个选择路径的所有子路径"   ----添加父路径
if KL_Q1RR!=""and KL_Q1RR!=undefined and IsValidNode KL_Destobj do                    ----如果添加行为有效;
(KL_Q1RR+="\\"
KHF_SubfolderColl KL_Q1RR kl_CollFolder 10 0               ----收集当前路径和他所有的子路径;
for m in kl_CollFolder while(not keyboard.escPressed)do    ----依次处理每个目录
(if KR_MoBankTVRoll!=undefined do KR_MoBankTVRoll.KL_AAA1.value=0   ----如果需要进度条,复位进度条
KL_Once=#()
KL_ReNodeFile=#()   
KL_ReMatNodeAR=#()                                    ---初始化数组,准备收集所有材质对象(文件名+对象名)
KL_ReMatAR=#()                                    ---初始化数组,准备收集所有材质对象(文件名+材质名)
Kl_MaxFile=getFiles(m+"*.max")    ----收集当前目录所有的文件;
KL_NodeMax=getFiles(m+"*.mat.max")                ---集合当前目录下的所有材质场景文件对象;
KL_MatMax=getFiles(m+"*.mat")  
for mq in KL_NodeMax do(KL_Once=getMAXFileObjectNames mq quiet:true           -----遍寻每一个材质场景文件对象,取得每个材质场景文件里面的对象集合;
for mm in KL_Once where not(matchPattern mm pattern:"Mathelp_*") do append KL_ReMatNodeAR #(mq,mm))  ----遍寻每个场景对象,如果不为辅助对象,则收集数组;
for mq in KL_MatMax do(KL_Once=loadTempMaterialLibrary mq
if KL_Once!=undefined and KL_Once.count!=0 do for mm in KL_Once do append KL_ReMatAR #(mq,mm.name))  ----遍寻每个场景对象,如果不为辅助对象,则收集数组;
KL_ReNodeFile=for kh in Kl_MaxFile where not(matchPattern kh pattern:"*.mat*")collect kh  
if (matchPattern KL_SBSce pattern:"*_Model*")             -----这里通配符得允许别人加后缀才行;
----------------------------------这里开始处理Max场景模型素材部分
then(kl_conub=KL_ReNodeFile.count
if kl_conub>0 do for n=1 to kl_conub while(not keyboard.escPressed)do undo off  
(KL_outfile=(getFilenamePath KL_ReNodeFile[n])+(getFilenameFile KL_ReNodeFile[n])+".bmp"     ----算出小样最终文件名;
if not(doesFileExist KL_outfile)do KL_outfile=(getFilenamePath KL_ReNodeFile[n])+(getFilenameFile KL_ReNodeFile[n])+".jpg" 
if not(doesFileExist KL_outfile)do                                                    ----
(pushPrompt ("当前处理场景"+"["+(kl_conub as string)+"]:"+(n as string)+"-"+KL_ReNodeFile[n])
thawSelection()
clearSelection()       ----退出当前选择状态
KL_Destobj.pos=[0,0,0]                               ----总是先复位样品场景的地板对象和贴图坐标大小;
mergeMAXFile KL_ReNodeFile[n] #mergeDups #select #useSceneMtlDups quiet:true    ----并入该场景;
convertToMesh(for m in selection where  kugegeoFilt m collect m) 
KL_DelObj=for ll in selection where SuperClassOf ll==camera or SuperClassOf ll==light or classof ll==Targetobject or(superClassOf i==shape and findItem KGL_ProxyXRefID(i.classid as string)==0 and not i.baseobject.render_renderable)collect ll  ---集合左右相机灯光对象;
if KL_DelObj.count!=selection.count do delete KL_DelObj           ----如果当前场景所有对象不只有灯光或相机,则删除这些对象;
KHF_ProxyScale selection
for m in selection do m.pivot=m.center          ----一定要非常注意单位的影响;
ResetTransform selection
if selection.count>0                                                                   ----如果导入有效,继续进行操作;
then(KHF_MergeObjShow KL_ReNodeFile[n] undefined KL_NameStr Kl_new KL_outfile KL_NewLogfile KL_Destobj 
Delete selection
)                                             -----清除当前导入的内容,准备处理下一个场景
else format "__________\"%\"文件渲染小样无效,请核对文件版本和对应图层是否关闭!\n" KL_ReNodeFile[n] to:KL_NewLogfile)  
if KR_MoBankTVRoll!=undefined do KR_MoBankTVRoll.KL_AAA1.value=n))
----------------------------------这里开始处理Max场景材质素材部分
else(select geometry
kl_conub=KL_ReMatNodeAR.count
if kl_conub>0 do for n=1 to kl_conub while(not keyboard.escPressed)do undo off  
(KL_ppname=getFilenameFile KL_ReMatNodeAR[n][1]    ---取得当前场景材质对象的文件名
KL_Zuname=substring KL_ppname 1 (KL_ppname.count-4)   ----截取已经获得文件名的点缀部分".mat";
KL_outfile=(getFilenamePath KL_ReMatNodeAR[n][1])+KL_Zuname+"{}"+KL_ReMatNodeAR[n][2]+".bmp"  ----优先尝试访问jpg格式的大样图片;
if not(doesFileExist KL_outfile)do KL_outfile=(getFilenamePath KL_ReMatNodeAR[n][1])+KL_Zuname+"{}"+KL_ReMatNodeAR[n][2]+".jpg"  ----优先尝试访问jpg格式的大样图片;
if not(doesFileExist KL_outfile)do                                                    ----
(KL_AAb=KL_ReMatNodeAR[n][1]+"["+KL_ReMatNodeAR[n][2]+"]"
pushPrompt("当前处理材质"+"["+(kl_conub as string)+"]:"+(n as string)+"-"+KL_AAb)
KL_MergMat=undefined              ----初始化定义并入材质;
aa=objects.count
undo off(mergeMAXFile KL_ReMatNodeAR[n][1] #(KL_ReMatNodeAR[n][2]) #mergeDups #useMergedMtlDups quiet:true
Kl_GuoK=objects[objects.count]
if objects.count-aa>0 and isProperty Kl_GuoK"material"and Kl_GuoK.material!=undefined do KL_MergMat=copy Kl_GuoK.material
delete Kl_GuoK)	 
if KL_MergMat!=undefined          ----如果导入有效,继续进行操作;
then KHF_MergeObjShow KL_ReMatNodeAR[n][1] KL_MergMat KL_NameStr Kl_new KL_outfile KL_NewLogfile KL_Destobj        -----写出渲染耗时日志;
else format "__________\"%\"文件渲染小样无效,请核对文件版本和材质对象是否有效!\n" KL_ReMatNodeAR[n][1] to:KL_NewLogfile)  
if KR_MoBankTVRoll!=undefined do KR_MoBankTVRoll.KL_AAA1.value=n)
----------------------------------这里开始处理材质库材质素材部分
kl_conub=KL_ReMatAR.count
if kl_conub>0 do for n=1 to kl_conub while(not keyboard.escPressed)do undo off  
(KL_Zuname=getFilenameFile KL_ReMatAR[n][1]    ---取得当前场景材质对象的文件名
KL_outfile=(getFilenamePath KL_ReMatAR[n][1])+KL_Zuname+"{}"+KL_ReMatAR[n][2]+".bmp"  ----优先尝试访问jpg格式的大样图片;
if not(doesFileExist KL_outfile)do KL_outfile=(getFilenamePath KL_ReMatAR[n][1])+KL_Zuname+"{}"+KL_ReMatAR[n][2]+".jpg"  ----优先尝试访问jpg格式的大样图片;
if not(doesFileExist KL_outfile)do
(KL_AAb=KL_ReMatAR[n][1]+"["+KL_ReMatAR[n][2]+"]"
pushPrompt("当前处理材质"+"["+(kl_conub as string)+"]:"+(n as string)+"-"+KL_AAb)
KL_MergMat=undefined              ----初始化定义并入材质;
KL_Once=loadTempMaterialLibrary KL_ReMatAR[n][1]
if KL_Once!=undefined and KL_Once.count!=0 do for mm in KL_Once where mm.name==KL_ReMatAR[n][2]do KL_MergMat=mm
if KL_MergMat!=undefined          ----如果导入有效,继续进行操作;
then KHF_MergeObjShow KL_ReMatAR[n][1] KL_MergMat KL_NameStr Kl_new KL_outfile KL_NewLogfile KL_Destobj---写出渲染耗时日志;
else format "__________\"%\"文件渲染小样无效,请核对文件版本和材质对象是否有效!\n" KL_ReMatAR[n][1] to:KL_NewLogfile)  
if KR_MoBankTVRoll!=undefined do KR_MoBankTVRoll.KL_AAA1.value=n))
thawSelection()
clearSelection()       ----退出当前选择状态
))          -----更新进度条指示;
try(close Kl_new)catch()
try(close KL_NewLogfile)catch()              ----关闭logo位图和日志文件流
if KR_MoBankTVRoll!=undefined do KR_MoBankTVRoll.KL_AAA1.value=0      
KL_Destobj.pos=[0,0,0])
else(messageBox "水印文件无效,请用图像软件处理合法的水印文件!" title:"不合法的水印文件警告--阿酷提示")))                           ----保证地板对象最后的复位;
fn lcl_Miscell_RepFileClear=   
(if (KL_JianCLigObj aaa:1 bbb:3 ccc:2)do
(try(DestroyDialog KR_RepeatFileSeR)catch()
rollout KR_RepeatFileSeR "阿酷_重复文件搜索"	 width:530 height:200
(local KL_DupFileFull,KL_DupFileName,KL_DupFileSize,KL_DupFileMode,KL_iniA="",KL_FFCV
edittext KC_Ed1 text:"" fieldWidth:390 pos:[1,5] 
button KC_Ed1BT "源路径1" pos:[400,3] width:55
edittext KC_Ed2 text:"" fieldWidth:390 pos:[1,30]
button KC_Ed2BT "源路径2"  pos:[400,28] width:55
edittext KC_Ed3 text:"" fieldWidth:390 pos:[1,55] 
button KC_Ed3BT "源路径3" pos:[400,53] width:55            ----三个整体检索目标路径;

dropdownlist KC_DM1 "" items:#("大小+名字+时间","大小+名字","名字+时间","大小+时间") height:8 width:125 pos:[5,92]   ---检索条件(四种组合方式)
progressBar KC_PGB1 value:0 pos:[150,95] Width:305                 -----进度条
label KF_GG2 "操作结果:"   pos:[150,115]

button KC_EdXBT "开始检索" pos:[468,86] width:55 height:30         ----检索处理启动和进度条指示;
button KC_EdXBJ "自动处理" pos:[468,126] width:55 height:30        ----自动删除每个重复文件簇除第一个外的所有临时文件(然后再通过"最终删除"命令进行最后处理);
button KC_EdXBD "最终删除" pos:[468,166] width:55 height:30        ----最终根据日志文件和临时文件的存在与否在删除最终源文件;

edittext KC_Ed4 text:"" fieldWidth:390 pos:[1,135] 
button KC_Ed4BT "临时路径" pos:[400,133] width:55                  ----重复文件临时存放路径(足够的大才行,建议10G以上);
--    spinner KC_Spneer "重复索引" range:[1,100,1]  type:#integer scale:1 fieldWidth:20 pos:[80,166]
--    button KC_EdXX2 "打开路径" pos:[150,166] width:55        ----最终根据日志文件和临时文件的存在与否在删除最终源文件;

fn KHF_RepeatFileSC ZZ aaa bbb=   ----重复文件处理函数,两个参数:1:ZZ.搜索路径集(已排除重复),2:aaa.进度条对象,3.bbb,减速条件状态整数;
(KL_DupFileFull=#()  ---完整路径名对象重复数组
KL_DupFileName=#()  ---文件名重复数组
KL_DupFileSize=#()  ---文件大小重复数组
KL_DupFileMode=#()  ---文件时间重复数组
KL_FFb=0             ----进度条计数器复位;
KL_FFC=ZZ.count      ----统计总路径数
case bbb of             -----根据当前检索条件进行规则处理,集合合适规格的重复文件集合数组;
(
4:(for aa=1 to KL_FFC while(not keyboard.escPressed)do   ----遍寻每个输入路径数组对象;
(Kl_DirFile=getFiles(ZZ[aa]+"*.*")       ----获得当前路径的所有附属文件;
for m in Kl_DirFile while(not keyboard.escPressed) where not(getFileAttribute m #system)do      ----排除掉系统文件属性的文件;
try(KL_Size=getFileSize m
KL_Midey=getFileModDate m      ----首先收集每个文件的大小属性和修改数据属性;
if(Kl_XX=findItem KL_DupFileSize KL_Size)==0 
then(append KL_DupFileSize KL_Size
append KL_DupFileMode #(KL_Midey)
append KL_DupFileFull #(#(#(m)))) 
else if(Kl_YY=findItem KL_DupFileMode[Kl_XX] KL_Midey)==0 
then(append KL_DupFileMode[Kl_XX] KL_Midey
append KL_DupFileFull[Kl_XX][1] #(m)) 
else append KL_DupFileFull[Kl_XX][1][Kl_YY] m)catch()
KL_FFb+=1           ----计数器开始启动;
aaa.value=(KL_FFb*100.0)/KL_FFC))
2:(for aa=1 to KL_FFC  while(not keyboard.escPressed)do   ----遍寻每个输入路径数组对象;
(Kl_DirFile=getFiles(ZZ[aa]+"*.*")       ----获得当前路径的所有附属文件;
for m in Kl_DirFile  while(not keyboard.escPressed) where not(getFileAttribute m #system)do 
try(KL_Size=getFileSize m
KL_SigFile=(getFilenameFile m)+(getFilenameType m)
if(Kl_XX=findItem KL_DupFileSize KL_Size)==0 
then(append KL_DupFileSize KL_Size
append KL_DupFileName #(KL_SigFile)
append KL_DupFileFull #(#(#(m)))) 
else if(Kl_YY=findItem KL_DupFileName[Kl_XX] KL_SigFile)==0 
then(append KL_DupFileName[Kl_XX] KL_SigFile
append KL_DupFileFull[Kl_XX][1] #(m)) 
else append KL_DupFileFull[Kl_XX][1][Kl_YY] m)catch()
KL_FFb+=1           ----计数器开始启动;
aaa.value=(KL_FFb*100.0)/KL_FFC))
3:(for aa=1 to KL_FFC while(not keyboard.escPressed)do   ----遍寻每个输入路径数组对象;
(Kl_DirFile=getFiles(ZZ[aa]+"*.*")       ----获得当前路径的所有附属文件;
for m in Kl_DirFile while(not keyboard.escPressed) where not(getFileAttribute m #system)do 
try(KL_SigFile=(getFilenameFile m)+(getFilenameType m)
KL_Midey=getFileModDate m      ----首先收集每个文件的大小属性和修改数据属性;
if(Kl_XX=findItem KL_DupFileMode KL_Midey)==0 
then(append KL_DupFileMode KL_Midey
append KL_DupFileName #(KL_SigFile)
append KL_DupFileFull #(#(#(m)))) 
else if(Kl_YY=findItem KL_DupFileName[Kl_XX] KL_SigFile)==0 
then(append KL_DupFileName[Kl_XX] KL_SigFile
append KL_DupFileFull[Kl_XX][1] #(m)) 
else append KL_DupFileFull[Kl_XX][1][Kl_YY] m)catch()
KL_FFb+=1           ----计数器开始启动;
aaa.value=(KL_FFb*100.0)/KL_FFC))
1:(for aa=1 to KL_FFC while(not keyboard.escPressed)do   ----遍寻每个输入路径数组对象;
(Kl_DirFile=getFiles(ZZ[aa]+"*.*")       ----获得当前路径的所有附属文件;
for m in Kl_DirFile while(not keyboard.escPressed) where not(getFileAttribute m #system)do 
try(KL_Size=getFileSize m
KL_SigFile=(getFilenameFile m)+(getFilenameType m)
KL_Midey=getFileModDate m      ----首先收集每个文件的大小属性,文件名和修改数据属性;
if(Kl_XX=findItem KL_DupFileSize KL_Size)==0    -----如果大小不存在,则直接追加大小,#(修改时间),#(#(文件名)),#(#(#(最终完整文件名)))
then(append KL_DupFileSize KL_Size
append KL_DupFileMode #(KL_Midey)
append KL_DupFileName #(#(KL_SigFile))
append KL_DupFileFull #(#(#(m)))) 
else if(Kl_YY=findItem KL_DupFileMode[Kl_XX] KL_Midey)==0     ----否则,检测是否#(修改时间)是否已存在,如果不存在,追加#(修改时间)进 修改时间,#(文件名),#(#(最终完整文件名))
then(append KL_DupFileMode[Kl_XX] KL_Midey
append KL_DupFileName[Kl_XX] #(KL_SigFile)
append KL_DupFileFull[Kl_XX] #(#(m))) 
else if(Kl_ZZ=findItem KL_DupFileName[Kl_XX][Kl_YY] KL_SigFile)==0   ---如果修改时间也存在,则检测是否存在重复文件名,如果不存在,则追加#(#(文件名))进  文件名,#(最终完整文件名)
then(append KL_DupFileName[Kl_XX][Kl_YY] KL_SigFile
append KL_DupFileFull[Kl_XX][Kl_YY] #(m)) 
else append KL_DupFileFull[Kl_XX][Kl_YY][Kl_ZZ] m)catch()
KL_FFb+=1           ----计数器开始启动;
aaa.value=(KL_FFb*100.0)/KL_FFC))   ----否则,则添加进最终的完整路径名;
)
aaa.value=0
KL_DupFileFull)      ------复位进度条

on KC_Ed1BT pressed do(KL_Q11=getSavePath caption:"定义搜索源路径1" initialDir:KC_Ed1.text
if KL_Q11!=undefined then KL_Q11A=KL_Q11+"\\"
else KL_Q11A=""
KC_Ed1.text=KL_Q11A)
on KC_Ed2BT pressed do(KL_Q11=getSavePath caption:"定义搜索源路径2" initialDir:KC_Ed2.text
if KL_Q11!=undefined then KL_Q11A=KL_Q11+"\\"
else KL_Q11A=""
KC_Ed2.text=KL_Q11A)
on KC_Ed3BT pressed do(KL_Q11=getSavePath caption:"定义搜索源路径3" initialDir:KC_Ed3.text
if KL_Q11!=undefined then KL_Q11A=KL_Q11+"\\"
else KL_Q11A=""
KC_Ed3.text=KL_Q11A)
on KC_Ed4BT pressed do(KL_Q11=getSavePath caption:"定义核查临时路径" initialDir:KC_Ed4.text
if KL_Q11!=undefined then KL_Q11A=KL_Q11+"\\"
else KL_Q11A=""
KC_Ed4.text=KL_Q11A)
on KC_EdXBT pressed do
(KR_RepeatFileSeR.KF_GG2.text="操作结果:"
KL_Array=for m in #(KR_RepeatFileSeR.KC_Ed1.text,KR_RepeatFileSeR.KC_Ed2.text,KR_RepeatFileSeR.KC_Ed3.text) where m!="" collect m
KL_PathWQ12=#()
for tt in KL_Array do KHF_SubfolderColl tt KL_PathWQ12 20 0
if KL_PathWQ12.count>0 and  KR_RepeatFileSeR.KC_Ed4.text!="" do
(KL_iniA=KR_RepeatFileSeR.KC_Ed4.text+"RepeatFile.ini"           -----重复文件处理的缺省变量文件;
if doesFileExist KL_iniA then KL_QQ=queryBox "存在上次重复检索的日志文件,是否覆盖?"  title:"自动整理重复文件警告--阿酷提示"
else KL_QQ=true           ----如果日志文件已存在,冲突询问;
if KL_QQ do(KL_FFCV=createFile KL_iniA          ----如果确定或未存在,写出日志文件准备记录;
if KL_FFCV!=undefined do
(KL_ASDar=KR_RepeatFileSeR.KC_Ed4.text+"RepeatFile\\"
makeDir KL_ASDar all:true  
KHF_DeleteNestFile KL_ASDar             ----保证首先清除所有文件,避免先后错乱;
KHF_RepeatFileSC KL_PathWQ12 KR_RepeatFileSeR.KC_PGB1 KC_DM1.selection        ----调用重复文件检索处理,
Kl_Num=0
for m1 in KL_DupFileFull do for m2 in m1 do for m3 in m2 where(KL_PrNum=m3.count)>1 do   ---遍寻返回得到的多维数组,检测每个可能存在的簇文件夹;
(Kl_Num+=1
KL_CurFolad=(KL_PrNum as string)+"-RepeatFile-"+(Kl_Num as string)          ----求得当前标题名,用作文件夹名和ini段名;  ----定义当前的重复文件簇名
KL_Pathname=KR_RepeatFileSeR.KC_Ed4.text+"RepeatFile\\"+KL_CurFolad+"\\"
makeDir KL_Pathname all:true                                                                 -----创建当前簇文件夹
for m4=1 to KL_PrNum do
(KR_RepeatFileSeR.KC_PGB1.value=m4*100.0/KL_PrNum                   ------每簇开始处理中(反复刷新进度条)
KL_ABC=getFilenamePath m3[m4]                                       -----获得当前簇的文件
KL_Ol=KL_ABC.count                                                   -----求得当前文件字节数
for oo=1 to KL_Ol where(findItem #("\\","/",":") KL_ABC[oo])!=0 do KL_ABC[oo]="~"   ----逐一替换当前簇文件的特殊字符(将用来写文件名)
Kl_KFC=KL_Pathname+KL_ABC+(getFilenameFile m3[m4])+"  ["+(m4 as string)+"]"+(getFilenameType m3[m4])  ---复制出新格式命名的重复簇文件
if(copyFile m3[m4] Kl_KFC)or doesFileExist Kl_KFC do setINISetting KL_iniA  KL_CurFolad Kl_KFC m3[m4]))     -----真正复制操作,如果成功,则将簇文件写入日志文件(到后面会根据这个临时文件是否存在而删除最终源文件);
close KL_FFCV
DOSCommand ("attrib \""+KR_RepeatFileSeR.KC_Ed4.text+"RepeatFile\\"+"*.*\" -r -h /s /d")
KR_RepeatFileSeR.KF_GG2.text="操作结果:共检索整理出"+(Kl_Num as string)+"个重复文件簇!" -----统计最后检索到的总重复文件簇数(包括所有复制成功和未成功的);
KR_RepeatFileSeR.KC_PGB1.value=0))))     -----复位进度条;
on KC_EdXBJ pressed do
(KL_iniA=KR_RepeatFileSeR.KC_Ed4.text+"RepeatFile.ini"           -----重复文件处理的缺省变量文件;
KL_DiePath=getDirectories(KR_RepeatFileSeR.KC_Ed4.text+"RepeatFile\\*")   -----获得临时路径所有子文件夹,
KL_VC=KL_DiePath.count
Kl_Num=0
if KL_VC>0 and doesFileExist KL_iniA then KL_QQ=queryBox "每个重复簇将只保留第一个文件,是否自动进行删除处理?"  title:"自动整理重复文件警告--阿酷提示"
else KL_QQ=false                     ----如果存在子文件夹,则进行询问处理;
if KL_QQ do for m=1 to KL_VC do(KR_RepeatFileSeR.KC_PGB1.value=m*100.0/KL_VC                 -----更新进度条;
Kl_F1=filterString KL_DiePath[m] "\\:"                     -----迭代处理每个路径;首先肢解路径名;(用来获得ini文件里的簇名)
KL_FA=getFiles (KL_DiePath[m]+"*.*")                       ----获得当前重复路径的所有文件;
KL_FB=getINISetting KL_iniA Kl_F1[Kl_F1.count]        ----获得当前重复文件簇的集合数组(取第一个)
for mm in KL_FA where findItem KL_FB mm>1 do if(deleteFile mm)do Kl_Num+=1)   ----一一删除非1文件数(必须存在列表且不为1),如果成功,追加删除成功计数器;
KR_RepeatFileSeR.KF_GG2.text="操作结果:共删除重复文件引用"+(Kl_Num as string)+"个!"
KR_RepeatFileSeR.KC_PGB1.value=0)                                                              ----提示操作结果并复位进度条;
on KC_EdXBD pressed do
(KL_iniA=KR_RepeatFileSeR.KC_Ed4.text+"RepeatFile.ini"           -----重复文件处理的缺省变量文件;
KL_DiePath=getDirectories(KR_RepeatFileSeR.KC_Ed4.text+"RepeatFile\\*")          -----获得所有临时路径的子文件夹;
KL_VC=KL_DiePath.count
Kl_Num=0
if KL_VC>0 and doesFileExist KL_iniA then KL_QQ=queryBox "是否最终删除真正的重复源文件?"  title:"最终删除重复文件警告--阿酷提示"  
else KL_QQ=false                                ----如果存在子文件夹,则进行询问处理;
if KL_QQ do(KL_PathnaA=KR_RepeatFileSeR.KC_Ed4.text+"DeleteFile\\"
makeDir KL_PathnaA all:true                                                                 -----创建当前簇文件夹
for m=1 to KL_VC do
(KR_RepeatFileSeR.KC_PGB1.value=m*100.0/KL_VC                -----更新进度条;
Kl_F1=filterString KL_DiePath[m] "\\:"                     -----迭代处理每个路径;首先肢解路径名;(用来获得ini文件里的簇名)
KL_FA=getFiles (KL_DiePath[m]+"*.*")                       ----获得当前重复路径的所有文件;
KL_FB=getINISetting KL_iniA Kl_F1[Kl_F1.count]               ----获得当前重复文件簇的集合数组
for mm in KL_FB where(findItem KL_FA mm)==0 do
(KL_bgh=getINISetting KL_iniA Kl_F1[Kl_F1.count] mm
if doesFileExist KL_bgh do(if getFileAttribute KL_bgh #readOnly or getFileAttribute KL_bgh #hidden do DOSCommand("attrib \""+(getFilenamePath KL_bgh)+"*.*\" -r -h /s /d")
Kl_BBBfile=KL_PathnaA+(getFilenameFile mm)+(getFilenameType mm)
if doesFileExist Kl_BBBfile do deleteFile Kl_BBBfile
Kl_TTT=renameFile KL_bgh Kl_BBBfile
if Kl_TTT then Kl_Num+=1          ---目标文件必须存在才操作;
else print ("文件"+KL_bgh+"删除无效,请检查系统属性和权限!")))))  ---如果ini登记文件已不存在,则进行最终源文件删除,成功则计数;
KR_RepeatFileSeR.KF_GG2.text="操作结果:最终删除重复文件"+(Kl_Num as string)+"个!"
KR_RepeatFileSeR.KC_PGB1.value=0)                                          ----提示操作结果并复位进度条;

--    on KC_EdXX2 pressed do
-- 	    (KL_iniA=KR_RepeatFileSeR.KC_Ed4.text+"RepeatFile.ini"           -----重复文件处理的缺省变量文件;
-- 	     KL_DiePath=getDirectories(KR_RepeatFileSeR.KC_Ed4.text+"RepeatFile\\*")          -----获得所有临时路径的子文件夹;
-- 	     Kl_CCF=for m in KL_DiePath where matchPattern m pattern:("*-RepeatFile-"+(KC_Spneer.value as string)+"*") collect m

-- 		 KR_RepeatFileSeR.KC_Ed4.text+"RepeatFile\\*") 
on KR_RepeatFileSeR rbuttondown fdsf do DestroyDialog KR_RepeatFileSeR)
CreateDialog KR_RepeatFileSeR))
fn lcl_Miscell_ResetSetup=   
(if (KL_JianCLigObj aaa:1 bbb:3 ccc:2)do
(try(DestroyDialog KR_ResetSetup)catch()
rollout KR_ResetSetup "MAX设置复位工具" width:200 height:160
(local Kl_OldFile=#(((GetDir #scene)+"\\"),((GetDir #downloads)+"\\"),((GetDir #autoback)+"\\"),((GetDir #maxroot)+"Defaults\\"),(KGXL_ZongMJLLCT[1][10]+"Defaults\\"),KGXL_ZongMJLLCT[1][10],KGXL_ZongMJLLCT[1][9])
local KL_IniCC=(getDirectories(Kl_OldFile[4]+"*"))+(getDirectories(Kl_OldFile[5]+"*"))
local KL_OldList
label KC_LBa1 ""                      pos:[10,15]  align:#left
button KL_VV5 "删除垃圾文件"  width:80 pos:[110,10]
button KL_VV3A "删除启动场景" width:80 pos:[110,40] 
button KL_VV3B "创建启动场景" width:80 pos:[10,40]
button KL_VV4A "删除启动材编" width:80 pos:[110,70]
button KL_VV4B "创建启动材编" width:80 pos:[10,70]
button KL_VV2 "初始阿酷设置"  width:80 pos:[110,100]
button KL_VV1 "初始MAX设置"   width:80 pos:[110,130]
on KL_VV1 pressed do
(KL_QQ=queryBox "初始化MAX设置后将直接退出需要重启MAX,是否继续!"  title:"MAX设置复位警告--阿酷提示"
if KL_QQ do(deleteFile(Kl_OldFile[6]+"3dsmax.ini")
quitMax()))       ----删除设置
on KL_VV2 pressed do
(KL_QQ=queryBox "这个操作将复位阿酷插件的所有初始化设置,是否继续!"  title:"MAX设置复位警告--阿酷提示"
if KL_QQ do(delIniSetting (getMAXIniFile()) "akoo2009"
deleteFile AK_INIT_File
fileIn(KGXL_ZongMJLLCT[1][3]+"Akoo_MAX.mse")))                                ---删除阿酷设置
on KL_VV3A pressed do
(KL_QQ=queryBox "这个操作将删除模版场景,下次MAX将启动原始空白场景,是否继续!"  title:"MAX设置复位警告--阿酷提示"
if KL_QQ do(KL_PathAR=#()
for m in #(Kl_OldFile[4],Kl_OldFile[5],Kl_OldFile[1]) do KHF_SubfolderColl m KL_PathAR 5 0         ----调用子路径嵌套收集函数收集所有相关路径;
for m in KL_PathAR where doesFileExist(KL_CMD=(m+"maxstart.max"))do deleteFile KL_CMD))     ----删除工厂启动场景   
on KL_VV3B pressed do
(KL_QQ=queryBox "这个操作将创建模版场景,以后每次MAX启动将自动加载这个模版场景,是否继续!"  title:"MAX设置复位警告--阿酷提示"
if KL_QQ do(KL_PathAR=#()
for m in #(Kl_OldFile[4],Kl_OldFile[5],Kl_OldFile[1]) do KHF_SubfolderColl m KL_PathAR 5 0         ----调用子路径嵌套收集函数收集所有相关路径;
for m in KL_PathAR where doesFileExist(KL_CMD=(m+"maxstart.max"))do deleteFile KL_CMD
KL_Count=KL_IniCC.count
if KL_Count>0 do(saveMaxFile(KL_IniCC[1]+"maxstart.max") clearNeedSaveFlag:false useNewFile:false quiet:true
for gg=2 to KL_Count do copyFile(KL_IniCC[1]+"maxstart.max")(KL_IniCC[gg]+"maxstart.max"))))  ----创建工厂启动场景(不受安装用户限制);
on KL_VV4A pressed do
(KL_QQ=queryBox "这个操作将删除模版材质编辑器,下次MAX将启动原始空白材质编辑器,是否继续!"  title:"MAX设置复位警告--阿酷提示"
if KL_QQ do(KL_PathAR=#()
for m in #(Kl_OldFile[4],Kl_OldFile[5],Kl_OldFile[1]) do KHF_SubfolderColl m KL_PathAR 5 0         ----调用子路径嵌套收集函数收集所有相关路径;
for m in KL_PathAR where doesFileExist(KL_CMD=(m+"medit.mat"))do deleteFile KL_CMD
for m in KL_IniCC do copyFile(Kl_OldFile[7]+"medit.mat")(m+"medit.mat")))    ----替换启动材编
on KL_VV4B pressed do
(KL_QQ=queryBox "这个操作将创建模版材质编辑器,以后每次MAX启动将自动加载这个模版材质编辑器,是否继续!"  title:"MAX设置复位警告--阿酷提示"
if KL_QQ do(KL_PathAR=#()
for m in #(Kl_OldFile[4],Kl_OldFile[5],Kl_OldFile[1]) do KHF_SubfolderColl m KL_PathAR 5 0         ----调用子路径嵌套收集函数收集所有相关路径;
for m in KL_PathAR where doesFileExist(KL_CMD=(m+"medit.mat"))do deleteFile KL_CMD
KL_MatLib=materialLibrary() 
for m in meditMaterials do append KL_MatLib m
for m in KL_IniCC do saveTempMaterialLibrary KL_MatLib(m+"medit.mat")))    ----创建启动材编
on KL_VV5 pressed do
(KL_QQ=queryBox "这个操作将自动删除各个临时路径(autoback,scenes,downloads)下超过15天的垃圾文件,是否继续!"  title:"MAX设置复位警告--阿酷提示"
if KL_QQ do(Kl_CountFile=#()
KL_PathAR=#(Kl_OldFile[1],Kl_OldFile[2],Kl_OldFile[3])
for m in KL_PathAR do join Kl_CountFile (getFiles(m+"*.*"))
KL_OldList=for m in Kl_CountFile where(not(KHF_DDttBIJI(KHF_DaForMatCO localtime true)(KHF_DaForMatCO(getFileModDate m)false) -15 false))collect m      ----这里先获取当前文件的时间属性(注意用Try函数包裹)
for m in KL_OldList do deleteFile m
KC_LBa1.text="删除完毕!"))  ---逐一删除这些文件;
on KR_ResetSetup open do
(Kl_CountFile=#()
KL_PathAR=#(Kl_OldFile[1],Kl_OldFile[2],Kl_OldFile[3])
