---------------------------------------------------------------------------笔刷种植部分
---------------------------------------------------------------------------笔刷种植部分
fn PlantScatt_paintStart= 	  ----绘制脚本初始化启动函数
(if getCommandPanelTaskMode!=#create do setCommandPanelTaskMode mode:#create
KGL_globalFirstHit=true  ----喷洒和栽种切换控制变量
KGL_PlantScattObj=for m in KGL_PlantScattObj where IsValidNode m collect m
for rr in KGL_PlantScattObj where rr.isHidden do rr.isHidden=false
KGL_Plantcatbj=for m=1 to KGL_PlantScattObj.count where (KF_PlantScatt.KL_ML1.Items.Item(m-1)).checked and(not KGL_PlantScattObj[m].isHiddenInVpt)collect KGL_PlantScattObj[m]
if KGL_PlantScattObj.count>0 and KGL_Plantcatbj.count>0   ---必须存在合法的源对象且被勾选在源对象列表中
then(thawSelection()
clearSelection()
KC_LastPiontARS=#()         ----这里收集最原始的对象参数组
KL_ObjRanar=#()
if Kl_BoolAr.count==0 do(Kl_BoolAr=for qq=1 to(random KC_XXY356.value  KC_XXY357.value)collect true
for qq=1 to(random KC_XXY358.value  KC_XXY359.value) do append Kl_BoolAr false)
for m in KGL_Plantcatbj do(KL_ZXjuli=m.max-m.min
KL_CCCm=(KL_ZXjuli.x+KL_ZXjuli.y)/2
append KC_LastPiontARS #([0,0,0],0,KL_CCCm)
for n=1 to m.KP_PlantPercent do append KL_ObjRanar m)
----初始化每种植源对象的#(上一次落点位置;两次落点距离;每源对象的边界框大小;每落点处理的通断开关)参数数组;
KL_RestrictMaxMin=(getINISetting AK_INIT_File "AI_PlantTool" "RestrictMaxMin")as float
KL_BISHUApath=#() 
thePainterInterface.undoStart())
else(KC_XXY3C.checked=KC_XXY3D.checked=false
thePainterInterface.endPaintSession()
if KGL_PlantScattObj.count==0 then(KL_ML1.Items.clear()            
messagebox "请先添加有效的源对象至种植列表!")
else if KGL_Plantcatbj.count==0 do messagebox "请先勾选种植源对象或确保源对象没有被隐藏!"))
fn PlantScatt_paintStroke=
(setWaitCursor()
worldHitA=mouse.pos
KL_YuanDist+=(distance KL_YuanPOs worldHitA)
if KL_YuanDist>=20 do
(append KL_BISHUApath [worldHitA.x,worldHitA.y,0]
KL_YuanPOs=worldHitA
KL_YuanDist=0
gw.setColor #line red
gw.wPolyline KL_BISHUApath false
gw.enlargeUpdateRect #whole 
gw.updateScreen())
KC_LastPiontAR=join #() KC_LastPiontARS  
worldHit=mapScreenToCP mouse.pos   ----是否基于栅格种植(速度最快)
if not KC_XXY370.checked then KGL_PlantVFtbj=join #() KGL_Plantcatbj
else KGL_PlantVFtbj=#(KL_ObjRanar[(random 1 KL_ObjRanar.count)])
for u=1 to KGL_PlantVFtbj.count do
(KC_LastPiontAR[u][2]+=distance KC_LastPiontAR[u][1] worldHit     -----根据最小间距检测何时需要种植,累计增长每次的落点间距值,直到达到阈值完成种植后复位为0;                                                  
if(KC_LastPiontAR[u][2]>=(KC_LastPiontAR[u][3]*KGL_PlantVFtbj[u].KP_PlantDist))and(thePainterInterface.getHitCount()!=1) and(not keyboard.altPressed) ----第二个落点开始且距离超过最小间距时将进行种植;
then(if u==1 do(if KC_XXY360.checked then(KLG_TDQJ=Kl_BoolAr[1]
deleteItem Kl_BoolAr 1  ----如果当前步骤为当前对象的最后一次出现时从通断集合里面减除当前项[基于每源对象,但比率大于1时需要反复使用多次]
if Kl_BoolAr.count==0 do(Kl_BoolAr=for qq=1 to(random KC_XXY356.value  KC_XXY357.value)collect true
for qq=1 to(random KC_XXY358.value  KC_XXY359.value) do append Kl_BoolAr false))
else KLG_TDQJ=true)
strokeVec=normalize(worldHit-KC_LastPiontAR[u][1])   ----获得两次落点定义的向量; 注意这里两个参数的顺序; 
KC_LastPiontAR[u][1]=worldHit       ----更新最后一次落点坐标值(必须进行在笔刷矢量计算过之后);否则根本没法读取路径矢量
KC_LastPiontAR[u][2]=0              ----一旦有完成当前种植,复位两次落点距离值,以等待下一次的距离检测种植;
if KLG_TDQJ do   ----如果当前为断,就不进行任何后续工作
(ScatterObjTMA=matrix3 1     -----种植新对象的初始化矩阵变量
yVec=normalize(cross KLPait_zVec strokeVec)  -----获得Z向量+笔刷向量的分量; 注意这里两个参数的顺序;  注意这里是顺时针
xVec=normalize(cross yVec KLPait_zVec)       -----根据分量+Z向量获得转化成平面的向量; 注意这里两个参数的顺序; 注意这里是顺时针
ScatterObjTMA.row1=xVec
ScatterObjTMA.row2=yVec
ScatterObjTMA.row3=KLPait_zVec     ----根据刚才求得的笔刷平面向量,分量,Z向量设置新对象的变换矩阵
if KC_XXY37.value>0 and KC_XXY315.checked and KC_XXY362.checked and not KC_XXY370.checked then KJ_CHB=KGL_PlantVFtbj[u].KP_PlantPercent
else KJ_CHB=1   ---只有开启了随机位置才启用多份数,否则自动禁止
for ww=1 to KJ_CHB do
(ScatterObjTM=copy ScatterObjTMA
if KC_XXY39.value>0 and KC_XXY316.checked and KC_XXY362.checked do
(KL_oriRnd=random -KC_XXY39.value KC_XXY39.value
rotateZ ScatterObjTM KL_oriRnd)   -----取得随机旋转角度结果并旋转目标矩阵
ScatterObjTM.row4=worldHit   -----给目标矩阵定位坐标点;
if KC_XXY37.value>0 and KC_XXY315.checked and KC_XXY362.checked do
(ScatterObjTMFF=matrix3 1
ScatterObjTMSS=matrix3 1   -----初始标准中介矩阵,用来初载变换值,再乘以到笔刷矩阵变换系统
KL_oriRnd=random 0 360
rotateZ ScatterObjTMFF KL_oriRnd
KL_MNB1=random (KC_LastPiontAR[u][3]*KL_RandomPOSPC) (KC_LastPiontAR[u][3]*KC_XXY37.value) 
KL_posRnd=[KL_MNB1,0,0]    ---这样处理限制掉小于正负对象边界框0.3倍的小距离随机位移值;
translate ScatterObjTMSS KL_posRnd   -----取得随机变换位置值并赋值到中介标准矩阵;
ScatterObjTMSS*=ScatterObjTMFF   
ScatterObjTMSS*=ScatterObjTM
ScatterObjTM.row4=ScatterObjTMSS.row4)        -----将中介标准矩阵乘以到目标矩阵,达到在目标矩阵自身系统进行随机位置的效果	
scale ScatterObjTM KGL_PlantVFtbj[u].transform.scale     -----取得源对象的缩放值并预先缩放目标矩阵;
if KC_XXY311.value>0 and KC_XXY317.checked and KC_XXY362.checked do
(KL_scale=random -KC_XXY311.value KC_XXY311.value
if KL_scale<0 do if ScatterObjTM.scale.x*(1-abs(KL_scale))<KGL_PlantVFtbj[u].KP_PlantScale*(1-KL_RestrictMaxMin) do KL_scale=-KL_scale
if KL_scale>0 do if ScatterObjTM.scale.x/(1-KL_scale)>KGL_PlantVFtbj[u].KP_PlantScale/(1-KL_RestrictMaxMin) do KL_scale=-KL_scale
KL_scale+=1
scale ScatterObjTM [KL_scale,KL_scale,KL_scale])  -----取得随机缩放结果大小并缩放目标矩阵											   
maxOps.cloneNodes KGL_PlantVFtbj[u] cloneType:#instance expandHierarchy:true newNodes:&PrevScatterObj  ----完成绘制新物体的关联创建;
flagForeground PrevScatterObj[1] false      -----设置新绘制对象为后台对象
append PrevScatterObjAR PrevScatterObj[1]
PrevScatterObj[1].transform=ScatterObjTM)))   -----应用目标矩阵至新绘制的对象;
else(KC_LastPiontAR[u][1]=worldHit
if KC_XXY360.checked and(keyboard.altPressed or thePainterInterface.getHitCount()==1)do
(Kl_BoolAr=for qq=1 to(random KC_XXY356.value  KC_XXY357.value)collect true
for qq=1 to(random KC_XXY358.value  KC_XXY359.value) do append Kl_BoolAr false))))  ---在不允许的种植落点时仍然需要记录更新上次落点 
fn PlantScatt_PlaceStroke=     ------放置模式的笔画处理函数
(KC_LastPiontAR=join #() KC_LastPiontARS 
worldHit=mapScreenToCP mouse.pos
if KGL_globalFirstHit or keyboard.shiftPressed then            --第一次落点或按住Shift键,否则处理为追踪定位模式
(if not keyboard.shiftPressed and KGL_globalFirstHit then   ---第一次落点或不按住Shift键,否则处理为阵列栽种模式;
(KGL_globalFirstHit=false  -----只要一起动放置模式了,就屏蔽KGL_globalFirstHit全局变量为False,阻止后面的重复放置处理(仅放置定位);
KL_BVCXZ=false
KC_Las1iontAR=worldHit    ----更新第一个落点变量,给后面的定位和阵列栽种模式访问;
PrevScatPlaObj=#()
if not KC_XXY370.checked then KGL_PlantVFtbj=join #() KGL_Plantcatbj
else KGL_PlantVFtbj=#(KL_ObjRanar[(random 1 KL_ObjRanar.count)])
for u=1 to KGL_PlantVFtbj.count do
(ScatterObjTMA=matrix3 1     -----种植新对象的初始化矩阵变量
if KC_XXY37.value>0 and KC_XXY315.checked and KC_XXY362.checked and not KC_XXY370.checked then KJ_CHB=KGL_PlantVFtbj[u].KP_PlantPercent
else KJ_CHB=1
for ww=1 to KJ_CHB do
(ScatterObjTM=copy ScatterObjTMA
if KC_XXY39.value>0 and KC_XXY316.checked and KC_XXY362.checked do
(KL_oriRnd=random -KC_XXY39.value KC_XXY39.value
rotateZ ScatterObjTM KL_oriRnd)   -----取得随机旋转角度结果并旋转目标矩阵
ScatterObjTM.row4=worldHit   -----给目标矩阵定位坐标点;
if KC_XXY37.value>0 and KC_XXY315.checked and KC_XXY362.checked do
(ScatterObjTMFF=matrix3 1
ScatterObjTMSS=matrix3 1   -----初始标准中介矩阵,用来初载变换值,再乘以到笔刷矩阵变换系统
KL_oriRnd=random 0 360
rotateZ ScatterObjTMFF KL_oriRnd
KL_MNB1=random (KC_LastPiontAR[u][3]*KL_RandomPOSPC) (KC_LastPiontAR[u][3]*KC_XXY37.value) 
KL_posRnd=[KL_MNB1,0,0]    ---这样处理限制掉小于正负对象边界框0.3倍的小距离随机位移值;
translate ScatterObjTMSS KL_posRnd   -----取得随机变换位置值并赋值到中介标准矩阵;
ScatterObjTMSS*=ScatterObjTMFF   
ScatterObjTMSS*=ScatterObjTM
ScatterObjTM.row4=ScatterObjTMSS.row4)        -----将中介标准矩阵乘以到目标矩阵,达到在目标矩阵自身系统进行随机位置的效果	
scale ScatterObjTM KGL_PlantVFtbj[u].transform.scale     -----取得源对象的缩放值并预先缩放目标矩阵;
if KC_XXY311.value>0 and KC_XXY317.checked and KC_XXY362.checked do
(KL_scale=random -KC_XXY311.value KC_XXY311.value
if KL_scale<0 do if ScatterObjTM.scale.x*(1-abs(KL_scale))<KGL_PlantVFtbj[u].KP_PlantScale*(1-KL_RestrictMaxMin) do KL_scale=-KL_scale
if KL_scale>0 do if ScatterObjTM.scale.x/(1-KL_scale)>KGL_PlantVFtbj[u].KP_PlantScale/(1-KL_RestrictMaxMin) do KL_scale=-KL_scale
KL_scale+=1
scale ScatterObjTM [KL_scale,KL_scale,KL_scale])  -----取得随机缩放结果大小并缩放目标矩阵											   
maxOps.cloneNodes KGL_PlantVFtbj[u] cloneType:#instance expandHierarchy:true newNodes:&PrevScatterObj  ----完成绘制新物体的关联创建;
flagForeground PrevScatterObj[1] false      -----设置新绘制对象为后台对象
append PrevScatterObjAR PrevScatterObj[1]  ----注意这里只要取第一个就成员就可以了,因为总是针对第一个成员复制出来的,这里也只需要appned而不能join,否则又全部进去了;
append PrevScatPlaObj PrevScatterObj[1]
PrevScatterObj[1].transform=ScatterObjTM)))   -----应用目标矩阵至新绘制的对象;		                 
else(setWaitCursor()
KL_Akkk=distance KC_Las1iontAR worldHit    ----阵列栽种阶段:这时已有了初始落点(总是上一次落点);  ---必须是非首次落点且shift键按下
if not KC_XXY370.checked then KGL_PlantVFtbj=join #() KGL_Plantcatbj
else KGL_PlantVFtbj=#(KGL_Plantcatbj[1])
for u=1 to KGL_PlantVFtbj.count do
(KL_FFD=KC_LastPiontAR[u][3]*KGL_PlantVFtbj[u].KP_PlantDist
KL_FFFDegAR=#()    ---有效偏移坐标值数组;
KL_MP1=(KL_Akkk/KL_FFD)as Integer 
if u==1 then(KL_VBCX55=#()
if KC_XXY360.checked and not KL_BVCXZ do(deleteItem Kl_BoolAr 1
KL_BVCXZ=true)
append KL_VBCX55 #(0.0)
KL_MMA=false
for aa=1 to KL_MP1 do(KL_FFo=(KL_Akkk/KL_MP1)*aa     
if KC_XXY360.checked  then(KLG_TDQJ=Kl_BoolAr[1] ----or aa>(KL_MP1-KC_XXY356.value)
deleteItem Kl_BoolAr 1  ----如果当前步骤为当前对象的最后一次出现时从通断集合里面减除当前项[基于每源对象,但比率大于1时需要反复使用多次]
if Kl_BoolAr.count==0 do (Kl_BoolAr=for qq=1 to(random KC_XXY356.value  KC_XXY357.value)collect true
for qq=1 to(random KC_XXY358.value  KC_XXY359.value) do append Kl_BoolAr false))
else KLG_TDQJ=true
if KLG_TDQJ then(if KL_MMA do append KL_VBCX55 #(KL_FFo)
append KL_FFFDegAR KL_FFo	 ----计算出阵列位置点集合(包含起始点)
KL_MMA=false)
else(if not KL_MMA do append KL_VBCX55[KL_VBCX55.count] KL_FFo
KL_MMA=true))
append KL_VBCX55[KL_VBCX55.count] KL_Akkk)																			
else(for aa=1 to KL_MP1 do(KL_FFo=(KL_Akkk/KL_MP1)*aa 
KL_AAX=true									  
while KL_AAX do(for gg in KL_VBCX55 where KL_FFo>gg[1] and KL_FFo<gg[2] do(append KL_FFFDegAR KL_FFo
KL_AAX=false)
KL_AAX=false)))
for oo=1 to KL_FFFDegAR.count do    
(if not KC_XXY370.checked then KGL_antVFtbj=KGL_PlantVFtbj[u]
else KGL_antVFtbj=KL_ObjRanar[(random 1 KL_ObjRanar.count)]  
ScatterObjTMA=matrix3 1     -----种植新对象的初始化矩阵变量
strokeVec=normalize(worldHit-KC_Las1iontAR) 
yVec=normalize(cross KLPait_zVec strokeVec)  -----获得Z向量+笔刷向量的分量; 注意这里两个参数的顺序;
xVec=normalize(cross yVec KLPait_zVec)       -----根据分量+Z向量获得转化成平面的向量; 注意这里两个参数的顺序;
ScatterObjTMA.row1=xVec
ScatterObjTMA.row2=yVec
ScatterObjTMA.row3=KLPait_zVec     ----根据刚才求得的笔刷平面向量,分量,Z向量设置新对象的变换矩阵
ScatterObjTMA.row4=KC_Las1iontAR
if KC_XXY37.value>0 and KC_XXY315.checked and KC_XXY362.checked and not KC_XXY370.checked then KJ_CHB=KGL_antVFtbj.KP_PlantPercent
else KJ_CHB=1   ---只有开启了随机位置才启用多份数,否则自动禁止
for ww=1 to KJ_CHB do
(ScatterObjTMSSBB=matrix3 1   -----初始标准中介矩阵,用来初载变换值,再乘以到笔刷矩阵变换系统
ScatterObjTM=matrix3 1
if KC_XXY39.value>0 and KC_XXY316.checked and KC_XXY362.checked do
(KL_oriRnd=random -KC_XXY39.value KC_XXY39.value
rotateZ ScatterObjTM KL_oriRnd)   -----取得随机旋转角度结果并旋转目标矩阵
ScatterObjTM.row4=KC_Las1iontAR
translate ScatterObjTMSSBB [KL_FFFDegAR[oo],0,0]	
ScatterObjTMSSBB*=ScatterObjTMA
ScatterObjTM.row4=ScatterObjTMSSBB.row4
if KC_XXY37.value>0 and KC_XXY315.checked and KC_XXY362.checked do
(ScatterObjTMFF=matrix3 1
ScatterObjTMSS=matrix3 1   -----初始标准中介矩阵,用来初载变换值,再乘以到笔刷矩阵变换系统
KL_oriRnd=random 0 360
rotateZ ScatterObjTMFF KL_oriRnd
KL_MNB1=random (KC_LastPiontAR[u][3]*KL_RandomPOSPC) (KC_LastPiontAR[u][3]*KC_XXY37.value) 
KL_posRnd=[KL_MNB1,0,0]    ---这样处理限制掉小于正负对象边界框0.3倍的小距离随机位移值;
translate ScatterObjTMSS KL_posRnd   -----取得随机变换位置值并赋值到中介标准矩阵;
ScatterObjTMSS*=ScatterObjTMFF   
ScatterObjTMSS*=ScatterObjTM
ScatterObjTM.row4=ScatterObjTMSS.row4)
scale ScatterObjTM KGL_antVFtbj.transform.scale     -----取得源对象的缩放值并预先缩放目标矩阵;
if KC_XXY311.value>0 and KC_XXY317.checked and KC_XXY362.checked do
(KL_scale=random -KC_XXY311.value KC_XXY311.value
if KL_scale<0 do if ScatterObjTM.scale.x*(1-abs(KL_scale))<KGL_antVFtbj.KP_PlantScale*(1-KL_RestrictMaxMin) do KL_scale=-KL_scale
if KL_scale>0 do if ScatterObjTM.scale.x/(1-KL_scale)>KGL_antVFtbj.KP_PlantScale/(1-KL_RestrictMaxMin) do KL_scale=-KL_scale
KL_scale+=1
scale ScatterObjTM [KL_scale,KL_scale,KL_scale])  -----取得随机缩放结果大小并缩放目标矩阵
maxOps.cloneNodes KGL_antVFtbj cloneType:#instance expandHierarchy:true newNodes:&PrevScatterObj  ----完成绘制新物体的关联创建;
flagForeground PrevScatterObj[1] false
append PrevScatterObjAR PrevScatterObj[1]
PrevScatterObj[1].transform=ScatterObjTM ))))
KC_Las1iontAR=worldHit)      -----设置新绘制对象为后台对象		  	
else(for mm=1 to PrevScatPlaObj.count do(KL_VVMM=PrevScatPlaObj[mm].transform
KL_VVMM.row4+=(worldHit-KC_Las1iontAR)   ---重定位矩阵变量,相对当前落点与首落点的偏移值;
PrevScatPlaObj[mm].transform=KL_VVMM)
KC_Las1iontAR=worldHit))

fn PlantScatt_endStroke=(thePainterInterface.undoAccept()
if PrevScatterObjAR.count>0 do PrevScatterObjMP=join #() PrevScatterObjAR
setArrowCursor())
fn PlantScatt_cancelStroke=(thePainterInterface.undoCancel()
if PrevScatterObjAR.count>0 do PrevScatterObjMP=join #() PrevScatterObjAR
setArrowCursor())
fn PlantScatt_systemEnd=(thePainterInterface.undoCancel()
if PrevScatterObjAR.count>0 do PrevScatterObjMP=join #() PrevScatterObjAR
setArrowCursor())
fn KF_startPaintP=
(if KGL_PlantScattObj.count>0 then(thePainterInterface.offMeshHitType=1
thePainterInterface.updateOnMouseUp=false
thePainterInterface.drawRing=false
thePainterInterface.drawNormal=false
thePainterInterface.drawTrace=false
KLPait_zVec=point3 0 0 1     -----预置绘制时每个种植新物体变换计算需要用到的Z向量,
PrevScatterObjAR=#()         -----每笔刷创建对象集合;
PrevScatPlaObj=#()
Kl_BoolAr=#()
KL_BVCXZ=true             ----用来指示放置栽种时上一个落点是单点还是连点,以区别是否要在通断计算时去掉第一个 
KL_YuanPOs=[0,0]
KL_YuanDist=0	  
thePainterInterface.startPaintSession())     ----绘制功能初始化并启动;
else(KC_XXY3C.checked=KC_XXY3D.checked=false
thePainterInterface.endPaintSession()
if KGL_PlantScattObj.count==0 do messagebox "种植源对象为空,请先添加源对象到列表!"))
on KC_XXY3C changed state do
(max move
if state then(KC_XXY3D.checked=false
thePainterInterface.ScriptFunctions PlantScatt_paintStart PlantScatt_PlaceStroke PlantScatt_endStroke PlantScatt_cancelStroke PlantScatt_systemEnd
KF_PlantScatt.KF_startPaintP())
else thePainterInterface.endPaintSession())                          ----总是激活选择+移动模式;
on KC_XXY3D changed state do
(max move
if state then(KC_XXY3C.checked=false
thePainterInterface.ScriptFunctions PlantScatt_paintStart PlantScatt_paintStroke PlantScatt_endStroke PlantScatt_cancelStroke PlantScatt_systemEnd
KF_PlantScatt.KF_startPaintP())
else thePainterInterface.endPaintSession())                          ----总是激活选择+移动模式;
---------------------------------------------------------------------------区域散种部分
---------------------------------------------------------------------------区域散种部分
fn KF_startPaintR=
(PrevScatterObjTarget=for m in PrevScatterObjTarget where IsValidNode m collect m            
if KGL_PlantScattObj.count>0 and(PrevScatterObjTarget.count>0 or KC_VBC319.state==3)  ---必须有源对象,目标对象和栅格种植模式二选一;
then(if KC_VBC319.state==3 then thePainterInterface.offMeshHitType=1
else(thePainterInterface.initializeNodes 0 PrevScatterObjTarget
thePainterInterface.offMeshHitType=2)
thePainterInterface.updateOnMouseUp=false
thePainterInterface.drawRing=false
thePainterInterface.drawNormal=false
thePainterInterface.drawTrace=false
PrevScatterObjAR=#()           ---最后一次对象总是针对整个笔刷操作;
KL_YuanPOs=[0,0]
KL_YuanDist=0
thePainterInterface.startPaintSession())     ----绘制功能初始化并启动;
else(KC_XXY2C.checked=KC_XXY2D.checked=false
thePainterInterface.endPaintSession()
if KGL_PlantScattObj.count==0 do messagebox "种植源对象为空,请先添加源对象到列表!"
if KC_VBC319.state!=3 and PrevScatterObjTarget.count==0 do messagebox "种植目标对象为空,请先加载目标对象!"))
fn KF_RegionCustFn KC_LastPiontAR KL_RegedtList AKinX AKaxX AKinY AKaxY=
(local localHit=Point3 0 0 0;localNormal=Point3 0 0 0;worldHit=Point3 0 0 0;worldNormal=Point3 0 0 0;str=0.0f   ----初始化各种变量                                       
KL_Corn1=mapScreenToCP [AKaxX,AKinY]
KL_Corn2=mapScreenToCP [AKinX,AKaxY]   -----最小坐标值,注意屏幕坐标的特点,Y轴值越大越靠下
for u=1 to KGL_Plantcatbj.count do
(KL_Mode1=KC_LastPiontAR[u]*KGL_Plantcatbj[u].KP_PlantDist   ---先计算好对象间隔值,避免后面循环里的迭代计算;
KL_SumA=((KL_Corn1.x-KL_Corn2.x)/KL_Mode1)as Integer/KC_XXY213.value
KL_SumB=((KL_Corn1.y-KL_Corn2.y)/KL_Mode1)as Integer/KC_XXY213.value  ---计算出来每轴向上允许的物体个数;
KL_CountDD=KL_SumA*KL_SumB
if KL_CountDD>5000 do KL_CountDD=5000
for ww=1 to KGL_Plantcatbj[u].KP_PlantPercent do   ---每份数迭代处理;
(nn=0
While nn<KL_CountDD do
(nn+=1
KL_TextPoint=Point2 (random AKinX AKaxX) (random AKinY AKaxY)   ---随机测试落点
if(thePainterInterface.isPointInside KL_TextPoint KL_RegedtList)do 
(if KC_VBC319.state!=3 then(if(thePainterInterface.getTestHit KL_TextPoint)then  ---绘制区域越不规则越容易缺失,越方越不容易缺失;
(thePainterInterface.getCustomHitPointData &localHit &localNormal &worldHit &worldNormal  &str     ----获得最后绘制点数据;
KL_True=true)
else KL_True=false)
else(worldHit=mapScreenToCP KL_TextPoint
KL_True=true) 
if KL_True do
(ScatterObjTMSS=matrix3 1   -----初始标准矩阵,用来初载变换值,再乘以到笔刷矩阵变换系统
ScatterObjTM=matrix3 1
if KC_XXY29.value>0 and KC_XXY216.checked and KC_XXY262.checked do
(KL_oriRnd=random -KC_XXY29.value KC_XXY29.value
rotateZ ScatterObjTM KL_oriRnd)   -----取得随机旋转角度结果并旋转目标矩阵
scale ScatterObjTM KGL_Plantcatbj[u].transform.scale     -----取得源对象的缩放值并预先缩放目标矩阵;
if KC_XXY211.value>0 and KC_XXY217.checked and KC_XXY262.checked do
(KL_scale=random -KC_XXY211.value KC_XXY211.value
if KL_scale<0 do if ScatterObjTM.scale.x*(1-abs(KL_scale))<KGL_Plantcatbj[u].KP_PlantScale*(1-KL_RestrictMaxMin) do KL_scale=-KL_scale
if KL_scale>0 do if ScatterObjTM.scale.x/(1-KL_scale)>KGL_Plantcatbj[u].KP_PlantScale/(1-KL_RestrictMaxMin) do KL_scale=-KL_scale
KL_scale+=1
scale ScatterObjTM [KL_scale,KL_scale,KL_scale])  -----取得随机缩放结果大小并缩放目标矩阵
ScatterObjTM.row4=worldHit   -----给目标矩阵定位坐标点;
KL_PaintFFF=true
if KC_VBC319.state!=3 do(KL_PaintFFF=false	  ---预置变量为false,除非检测有效,否则最终输出false而屏蔽掉后面的正式创建;
KL_NewPosR=ray (ScatterObjTM.row4+[0,0,1000000]) [0,0,-1]
KL_ZZuhn2=[0,0,-1000000]
for m in PrevScatterObjTarget do
(KL_ZZponit=intersectRay m KL_NewPosR
if KL_ZZponit!=undefined do(KL_Fnpointpos=KL_ZZponit.pos
if KL_Fnpointpos.z>KL_ZZuhn2.z do
(KL_ZZuhn2=KL_Fnpointpos
if KC_VBC319.state==1 then KL_PaintFFF=m.material!=undefined and findItem KC_VBC31.items m.material.name!=0
else  KL_PaintFFF=true
ScatterObjTM.row4=KL_ZZuhn2))))										   
if KL_PaintFFF do(maxOps.cloneNodes KGL_Plantcatbj[u] cloneType:#instance expandHierarchy:true newNodes:&PrevScatterObj  ----完成绘制新物体的关联创建;
flagForeground PrevScatterObj[1] false
append PrevScatterObjAR PrevScatterObj[1]
PrevScatterObj[1].transform=ScatterObjTM)))))))   -----应用目标矩阵至新绘制的对象;

fn PlantScatt_RegionStart= 	  ----绘制脚本初始化启动函数
(if getCommandPanelTaskMode!=#create do setCommandPanelTaskMode mode:#create    ----清除选择,保证切换到创建命令面板;
KGL_PlantScattObj=for m in KGL_PlantScattObj where IsValidNode m collect m
for rr in KGL_PlantScattObj where rr.isHidden do rr.isHidden=false
KGL_Plantcatbj=for m=1 to KGL_PlantScattObj.count where (KF_PlantScatt.KL_ML1.Items.Item(m-1)).checked and(not KGL_PlantScattObj[m].isHiddenInVpt)collect KGL_PlantScattObj[m]	
if KGL_PlantScattObj.count>0 and KGL_Plantcatbj.count>0 and(KC_VBC319.state!=1 or KC_VBC31.items.count>0)
then(thawSelection()
clearSelection()
KC_LastPiontAR=#()         ----这里收集最原始的对象参数组
for m in KGL_Plantcatbj do(KL_ZXjuli=m.max-m.min
KL_CCCm=(KL_ZXjuli.x+KL_ZXjuli.y)/2
append KC_LastPiontAR KL_CCCm)	
KL_RestrictMaxMin=(getINISetting AK_INIT_File "AI_PlantTool" "RestrictMaxMin")as float
KL_BISHUApath=#()
thePainterInterface.undoStart())
else(KC_XXY2C.checked=KC_XXY2D.checked=false
thePainterInterface.endPaintSession()
if KGL_PlantScattObj.count==0 then(KL_ML1.Items.clear()            
messagebox "请先添加有效的源对象至种植列表!")
else if KGL_Plantcatbj.count==0 then messagebox "请先勾选种植源对象或确保源对象没有被隐藏!"
else if (KC_VBC319.state==1 and KC_VBC31.items.count==0) do messagebox "请先定义所需识别的表面材质!"))
fn PlantScatt_Regionpaint=
(setWaitCursor()
worldHitA=mouse.pos
KL_YuanDist+=(distance KL_YuanPOs worldHitA)
if KL_YuanDist>=20 do
(append KL_BISHUApath [worldHitA.x,worldHitA.y,0]
KL_YuanPOs=worldHitA
KL_YuanDist=0
gw.setColor #line red
gw.wPolyline KL_BISHUApath true 
gw.enlargeUpdateRect #whole 
gw.updateScreen()))
fn PlantScatt_Splineend=
(KL_FF=KC_XXY214.object
if IsValidNode KL_FF do   --样条线对象有效时开始收集并转换其路径为笔刷路径;
(convertToSplineShape KL_FF
for tt=1 to numSplines KL_FF do if(isClosed KL_FF tt)do
(KL_hitCount=((curveLength KL_FF tt)/(KC_LastPiontAR[1]*5))as Integer 
KL_PPG=1.0/KL_hitCount
KL_RegedtList=#()
local AKinX=0,AKaxX=0,AKinY=0,AKaxY=0   ----预置落点位置,X轴向上范围和Y轴向上范围变量
for j=1 to KL_hitCount do
(gw.setTransform(Matrix3 1)
KL_CCm=gw.wTransPoint(interpCurve3D KL_FF tt (KL_PPG*j))       ---依次转换和收集每个落点的鼠标位置;
KL_p1=[KL_CCm.x,KL_CCm.y]
Append KL_RegedtList KL_p1
if j==1 do(AKinX=KL_p1.x
AKaxX=KL_p1.x
AKinY=KL_p1.y
AKaxY=KL_p1.y)  ---这一步还是要,否则不知道从哪个范围段开始;
if (KL_p1.x>AKaxX) do AKaxX=KL_p1.x
if (KL_p1.x<AKinX) do AKinX=KL_p1.x
if (KL_p1.y>AKaxY) do AKaxY=KL_p1.y
if (KL_p1.y<AKinY) do AKinY=KL_p1.y)
KF_RegionCustFn KC_LastPiontAR KL_RegedtList AKinX AKaxX AKinY AKaxY)
thePainterInterface.undoAccept()
--thePainterInterface.endPaintSession()
--KC_XXY2C.checked=KC_XXY2D.checked=false
completeRedraw()
if PrevScatterObjAR.count>0 do PrevScatterObjMP=join #() PrevScatterObjAR
setArrowCursor()))
fn PlantScatt_Regionend=
(KL_hitCount=thePainterInterface.GetHitCount()	     ----获得当前笔刷所有落点数量
KL_RegedtList=#()
local AKinX=0,AKaxX=0,AKinY=0,AKaxY=0   ----预置落点位置,X轴向上范围和Y轴向上范围变量
for j=1 to KL_hitCount do
(KL_p1=thePainterInterface.getHitMousePos j       ---依次转换和收集每个落点的鼠标位置;
Append KL_RegedtList KL_p1
if j==1 do(AKinX=KL_p1.x
AKaxX=KL_p1.x
AKinY=KL_p1.y
AKaxY=KL_p1.y)  ---这一步还是要,否则不知道从哪个范围段开始;
if (KL_p1.x>AKaxX) do AKaxX=KL_p1.x
if (KL_p1.x<AKinX) do AKinX=KL_p1.x
if (KL_p1.y>AKaxY) do AKaxY=KL_p1.y
if (KL_p1.y<AKinY) do AKinY=KL_p1.y)
KF_RegionCustFn KC_LastPiontAR KL_RegedtList AKinX AKaxX AKinY AKaxY
thePainterInterface.undoAccept()
--thePainterInterface.endPaintSession()
--KC_XXY2C.checked=KC_XXY2D.checked=false
completeRedraw()
if PrevScatterObjAR.count>0 do PrevScatterObjMP=join #() PrevScatterObjAR
setArrowCursor())
on KC_XXY2C changed state do
(max move
if state and IsValidNode KC_XXY214.object 
then(KC_XXY2D.checked=false
thePainterInterface.ScriptFunctions PlantScatt_RegionStart PlantScatt_Regionpaint PlantScatt_Splineend PlantScatt_cancelStroke PlantScatt_systemEnd
KF_PlantScatt.KF_startPaintR())
else(KC_XXY2C.checked=false
thePainterInterface.endPaintSession()
if not(IsValidNode KC_XXY214.object)do messagebox "请先选择合法的目标样条线!"))                          ----总是激活选择+移动模式;
on KC_XXY2D changed state do
(max move
if state then(KC_XXY2C.checked=false
thePainterInterface.ScriptFunctions PlantScatt_RegionStart PlantScatt_Regionpaint PlantScatt_Regionend PlantScatt_cancelStroke PlantScatt_systemEnd
KF_PlantScatt.KF_startPaintR())
else(KC_XXY2D.checked=false
thePainterInterface.endPaintSession()))                          ----总是激活选择+移动模式;
-------------------------------------------------------------------------
-------------------------------------------------------------------------
fn AK_plantPPFnGZ KL_Pathspline KL_FFD bb cc=
(if bb==1    ----首轮除了要收集种植路径点以外,还需要收集通断范围段,以供后面的源对象进行通断参照;
then(KL_VBCX55=#()   ---通断范围段复合数组初始变量
append KL_VBCX55 #(0.0)   ----定义第一段开始头
KL_MMA=false              ----先假,必须要间断状态才记录和切换,如果全通,则直接到后面收集对应的端点;
for m=1 to cc do(KL_Akkk=curveLength KL_Pathspline m
KL_MP1=(KL_Akkk/KL_FFD) as Integer 
for aa=0 to(KL_MP1-1)do(KL_FFo=(1.0/KL_MP1)*aa      
if KC_XXY560.checked  then(KLG_TDQJ=Kl_BoolAr[1] ----or aa>(KL_MP1-KC_XXY556.value)
deleteItem Kl_BoolAr 1  ----如果当前步骤为当前对象的最后一次出现时从通断集合里面减除当前项[基于每源对象,但比率大于1时需要反复使用多次]
if Kl_BoolAr.count==0 do(Kl_BoolAr=for qq=1 to(random KC_XXY556.value  KC_XXY557.value)collect true
for qq=1 to(random KC_XXY558.value  KC_XXY559.value) do append Kl_BoolAr false))
else KLG_TDQJ=true
if KLG_TDQJ then(if KL_MMA do append KL_VBCX55 #((KL_FFo+m))
append KL_FFFDegAR #(KL_FFo,m)	 ----计算出阵列位置点集合(包含起始点)
KL_MMA=false)
else(if not KL_MMA do append KL_VBCX55[KL_VBCX55.count] (KL_FFo+m)
KL_MMA=true))
if not(isClosed KL_Pathspline m) do append KL_FFFDegAR #(1.0,m))
append KL_VBCX55[KL_VBCX55.count] (1.0+cc))																		
else(for m=1 to cc do(KL_Akkk=curveLength KL_Pathspline m
KL_MP1=(KL_Akkk/KL_FFD) as Integer 
for aa=0 to KL_MP1 do(KL_FFo=(1.0/KL_MP1)*aa   
KL_AAX=true								 
while KL_AAX do(for gg in KL_VBCX55 where (KL_FFo+m)>gg[1] and (KL_FFo+m)<gg[2] do(append KL_FFFDegAR #(KL_FFo,m)
KL_AAX=false)
KL_AAX=false)))))
fn AK_plantPPFnSJ KL_Pathspline KL_FFD bb cc=               ----因为专门种车,所以忽略间隔功能和去掉路径首尾种植点;
(for m=1 to cc do(KL_Akkk=curveLength KL_Pathspline m
KL_MP1YY=(KL_Akkk/KL_FFD) as Integer
KL_MP1=1.0/KL_MP1YY
for aa=1 to (KL_MP1YY-1) do(KL_FFo=random ((KL_MP1*aa)-(KL_MP1/4)) ((KL_MP1*aa)+(KL_MP1/4))
append KL_FFFDegAR #(KL_FFo,m)))
KL_BVC=KL_FFFDegAR.count/KC_XXY55.value
while KL_FFFDegAR.count>KL_BVC do deleteItem KL_FFFDegAR(random 1 KL_FFFDegAR.count))		    ----收集所有种植点标准位插值数;	
fn PlantPathStar aa=
(if getCommandPanelTaskMode!=#create do setCommandPanelTaskMode mode:#create
KL_RestrictMaxMin=(getINISetting AK_INIT_File "AI_PlantTool" "RestrictMaxMin")as float
KL_RestrictCarDist=(getINISetting AK_INIT_File "AI_PlantTool" "RestrictCarDist")as Integer
PrevScatterObjAR=#()         -----每笔刷创建对象集合;
KLPait_zVec=point3 0 0 1
KGL_PlantScattObj=for m in KGL_PlantScattObj where IsValidNode m collect m
for rr in KGL_PlantScattObj where rr.isHidden do rr.isHidden=false
KGL_Plantcatbj=for m=1 to KGL_PlantScattObj.count where (KF_PlantScatt.KL_ML1.Items.Item(m-1)).checked and(not KGL_PlantScattObj[m].isHiddenInVpt)collect KGL_PlantScattObj[m]
if IsValidNode KC_XXY514.object and KGL_PlantScattObj.count>0 and KGL_Plantcatbj.count>0
then(thawSelection()
clearSelection()
setWaitCursor()
convertToSplineShape KF_PlantScatt.KC_XXY514.object
KC_LastPiontAR=#()         ----这里收集源对象的边界框大小
KL_ObjRanar=#()             ----这里收集迭代种植实际的源对象集合; 
Kl_BoolAr=for qq=1 to(random KC_XXY556.value  KC_XXY557.value)collect true
for qq=1 to(random KC_XXY558.value  KC_XXY559.value) do append Kl_BoolAr false
for m in KGL_Plantcatbj do(KL_ZXjuli=m.max-m.min
KL_CCCm=(KL_ZXjuli.x+KL_ZXjuli.y)/2
append KC_LastPiontAR KL_CCCm
for n=1 to m.KP_PlantPercent do append KL_ObjRanar m)
if not KC_XXY570.checked and aa then KGL_PlantVFtbj=join #() KGL_Plantcatbj   ----定义处理几轮,根据源对象的个数;
else KGL_PlantVFtbj=#(KGL_Plantcatbj[1])
KL_Pathspline=KF_PlantScatt.KC_XXY514.object
KL_Spnum1=numSplines KL_Pathspline
undo on
(for u=1 to KGL_PlantVFtbj.count do
(if aa then KL_FFD=KC_LastPiontAR[u]*KGL_PlantVFtbj[u].KP_PlantDist
else KL_FFD=KC_LastPiontAR[u]*KL_RestrictCarDist
KL_FFFDegAR=#()
if aa then AK_plantPPFnGZ KL_Pathspline KL_FFD u KL_Spnum1
else AK_plantPPFnSJ KL_Pathspline KL_FFD u KL_Spnum1
for oo=1 to KL_FFFDegAR.count do    
(if not KC_XXY570.checked and aa then KGL_antVFtbj=KGL_PlantVFtbj[u]
else KGL_antVFtbj=KL_ObjRanar[(random 1 KL_ObjRanar.count)]  
ScatterObjTMA=matrix3 1     -----种植新对象的初始化矩阵变量
strokeVec=tangentCurve3D KL_Pathspline KL_FFFDegAR[oo][2] KL_FFFDegAR[oo][1]
yVec=normalize(cross KLPait_zVec strokeVec)  -----获得Z向量+笔刷向量的分量; 注意这里两个参数的顺序;
KLPait_zVec=normalize(cross strokeVec yVec)       -----根据分量+Z向量获得转化成平面的向量; 注意这里两个参数的顺序;
ScatterObjTMA.row1=strokeVec
ScatterObjTMA.row2=yVec
ScatterObjTMA.row3=KLPait_zVec     ----根据刚才求得的笔刷平面向量,分量,Z向量设置新对象的变换矩阵
if KC_XXY57.value>0 and KC_XXY515.checked and KC_XXY562.checked and not KC_XXY570.checked and aa then KJ_CHB=KGL_antVFtbj.KP_PlantPercent
else KJ_CHB=1   ---只有开启了随机位置才启用多份数,否则自动禁止
for ww=1 to KJ_CHB do
(ScatterObjTM=copy ScatterObjTMA
if KC_XXY59.value>0 and KC_XXY516.checked and KC_XXY562.checked and aa do
(KL_oriRnd=random -KC_XXY59.value KC_XXY59.value
rotateZ ScatterObjTM KL_oriRnd)   -----取得随机旋转角度结果并旋转目标矩阵
ScatterObjTM.row4=interpCurve3D KL_Pathspline KL_FFFDegAR[oo][2] KL_FFFDegAR[oo][1] -----给目标矩阵定位坐标点;
if KC_XXY57.value>0 and KC_XXY515.checked and KC_XXY562.checked and aa do
(ScatterObjTMFF=matrix3 1
ScatterObjTMSS=matrix3 1   -----初始标准中介矩阵,用来初载变换值,再乘以到笔刷矩阵变换系统
KL_oriRnd=random 0 360
rotateZ ScatterObjTMFF KL_oriRnd
KL_MNB1=random (KC_LastPiontAR[u]*KL_RandomPOSPC) (KC_LastPiontAR[u]*KC_XXY57.value) 
KL_posRnd=[KL_MNB1,0,0]    ---这样处理限制掉小于正负对象边界框0.3倍的小距离随机位移值;
translate ScatterObjTMSS KL_posRnd   -----取得随机变换位置值并赋值到中介标准矩阵;
ScatterObjTMSS*=ScatterObjTMFF   
ScatterObjTMSS*=ScatterObjTM
ScatterObjTM.row4=ScatterObjTMSS.row4)        -----将中介标准矩阵乘以到目标矩阵,达到在目标矩阵自身系统进行随机位置的效果
scale ScatterObjTM KGL_antVFtbj.transform.scale     -----取得源对象的缩放值并预先缩放目标矩阵;
if KC_XXY511.value>0 and KC_XXY517.checked and KC_XXY562.checked and aa do
(KL_scale=random -KC_XXY511.value KC_XXY511.value
if KL_scale<0 do if ScatterObjTM.scale.x*(1-abs(KL_scale))<KGL_antVFtbj.KP_PlantScale*(1-KL_RestrictMaxMin) do KL_scale=-KL_scale
if KL_scale>0 do if ScatterObjTM.scale.x/(1-KL_scale)>KGL_antVFtbj.KP_PlantScale/(1-KL_RestrictMaxMin) do KL_scale=-KL_scale
KL_scale+=1
scale ScatterObjTM [KL_scale,KL_scale,KL_scale])  -----取得随机缩放结果大小并缩放目标矩阵										   
maxOps.cloneNodes KGL_antVFtbj cloneType:#instance expandHierarchy:true newNodes:&PrevScatterObj  ----完成绘制新物体的关联创建;
flagForeground PrevScatterObj[1] false
append PrevScatterObjAR PrevScatterObj[1]
PrevScatterObj[1].transform=ScatterObjTM))))
setArrowCursor())   -----应用目标矩阵至新绘制的对象;
else(if KGL_PlantScattObj.count==0 then(KL_ML1.Items.clear()            
messagebox "请先添加有效的源对象至种植列表!")
else if KGL_Plantcatbj.count==0 then messagebox "请先勾选种植源对象或确保源对象没有被隐藏!"
else if not(IsValidNode KC_XXY514.object)do messagebox "请先选择合法的目标样条线!")
if PrevScatterObjAR.count>0 do PrevScatterObjMP=join #() PrevScatterObjAR)
on KC_XXY5C pressed do PlantPathStar true       -----设置新绘制对象为后台对象						   
on KC_XXY5D pressed do PlantPathStar false				  
-------------------------------------------------------------------------综合处理部分
-------------------------------------------------------------------------综合处理部分
fn JiQunPaint=
(thePainterInterface.offMeshHitType=1
thePainterInterface.drawTrace=false
thePainterInterface.drawNormal=false
thePainterInterface.drawRing=false
KL_YuanPOs=[0,0]
KL_YuanDist=0
thePainterInterface.startPaintSession())     ----绘制功能初始化并启动;)
fn PlantScatt_JiQunStart=
(KLPait_zVec=point3 0 0 1
KL_eList=for i in selection where not(isGroupMember i and not isOpenGroupMember i)collect i 
if KL_eList.count>0 then(for m in KL_eList where not(isProperty m "KP_PlantScale") do
(custAttributes.add m PlantObjparameters #unique     ---注意这里一定要添加独立的自定义属性,否则关联出来的物体即使塌陷了也会保持自定义属性之间的关联;
m.KP_PlantPercent=(getINISetting AK_INIT_File "AI_PlantTool" "InitiaPercent")as integer  
m.KP_PlantDist=(getINISetting AK_INIT_File "AI_PlantTool" "InitiaDist")as float
m.KP_PlantScale=m.scale.x)    -----如果源对象还没有自定义种植参数,按缺省值进行预置;
KL_RestrictMaxMin=(getINISetting AK_INIT_File "AI_PlantTool" "RestrictMaxMin")as float
thePainterInterface.undoStart())
else(KC_XXY7C.checked=false
thePainterInterface.endPaintSession()
messagebox "请先选择选择需要集群处理的目标对象!"))
fn PlantScatt_JiQunpaint=
(setWaitCursor()
KL_Bnkjj=(getINISetting AK_INIT_File "AI_PlantTool" "Plantradius")as Integer 
worldHitA=mouse.pos
KL_YuanDist+=(distance KL_YuanPOs worldHitA)
if KL_YuanDist>=20 do
(ScatterObjTMFF=matrix3 1
strokeVec=normalize((mapScreenToCP worldHitA)-(mapScreenToCP KL_YuanPOs))   ----获得两次落点定义的向量; 注意这里两个参数的顺序;
yVec=normalize(cross KLPait_zVec strokeVec)  -----获得Z向量+笔刷向量的分量; 注意这里两个参数的顺序;
xVec=normalize(cross yVec KLPait_zVec)       -----根据分量+Z向量获得转化成平面的向量; 注意这里两个参数的顺序;
ScatterObjTMFF.row1=xVec
ScatterObjTMFF.row2=yVec
ScatterObjTMFF.row3=KLPait_zVec     ----根据刚才求得的笔刷平面向量,分量,Z向量设置新对象的变换矩阵	  
KL_YuanPOs=worldHitA
KL_YuanDist=0
gw.setColor #line red
gw.wPolyline #([(worldHitA.x-KL_Bnkjj),worldHitA.y,0],[worldHitA.x,(worldHitA.y-KL_Bnkjj),0],[(worldHitA.x+KL_Bnkjj),worldHitA.y,0],[worldHitA.x,(worldHitA.y+KL_Bnkjj),0]) true 
gw.enlargeUpdateRect #whole 
gw.updateScreen()
KL_cirbanjing=[(worldHitA.x-KL_Bnkjj),worldHitA.y]
KC_Region=box2 0 0 0 0
KC_Region.left=worldHitA.x
KC_Region.bottom=worldHitA.y
KC_Region.right=KL_cirbanjing.x
KC_Region.top=KL_cirbanjing.y
KL_mmm=circlePickNode KC_Region crossing:true
KL_ZUizhongobj=for m in KL_mmm where m.isSelected collect m
worldHit=mapScreenToCP worldHitA
worldHit2=mapScreenToCP KL_cirbanjing
KL_FFGV1=distance worldHit  worldHit2   ----求得当前笔刷的世界单位长度;
for aa in KL_ZUizhongobj do
(ScatterObjTMB=copy ScatterObjTMFF
KL_ZXjuli=aa.max-aa.min
KL_JUHG=(KL_ZXjuli.x+KL_ZXjuli.y)/2	
ScatterObjTMB.row4=worldHit
in coordsys ScatterObjTMB KL_XiangPOS=aa.pos.y	   
KL_FFGV3=(1-((abs(KL_XiangPOS))/KL_FFGV1))^2
KL_CCCmAT=aa.transform 
KL_CCCmAT.row4=[0,0,0]               ----这里直接基于对象自己的变换系统进行处理;是不是随机变换也应该是这种逻辑的了;
if not keyboard.altPressed then(if KC_XXY79.value>0 and KC_XXY716.checked do
(if KL_XiangPOS>0 then KL_oriRnd=KC_XXY79.value*KL_FFGV3
else KL_oriRnd=-(KC_XXY79.value*KL_FFGV3)
rotateZ KL_CCCmAT KL_oriRnd))   -----取得随机旋转角度结果并旋转目标矩阵
else(if KC_XXY79.value>0 and KC_XXY716.checked do
(if KL_XiangPOS>0 then KL_oriRnd=-(KC_XXY79.value*KL_FFGV3)
else KL_oriRnd=KC_XXY79.value*KL_FFGV3
rotateZ KL_CCCmAT KL_oriRnd))   -----取得随机旋转角度结果并旋转目标矩阵 
KL_CCCmAT.row4=aa.pos   -----给目标矩阵定位坐标点;
ScatterObjTMB.row4=aa.pos
if not keyboard.altPressed then(if KC_XXY77.value>0 and KC_XXY715.checked do
(ScatterObjTMSS=matrix3 1   -----初始标准中介矩阵,用来初载变换值,再乘以到笔刷矩阵变换系统
if KL_XiangPOS>0 then KL_ZUig=-(KL_JUHG*KC_XXY77.value*KL_FFGV3)
else KL_ZUig=KL_JUHG*KC_XXY77.value*KL_FFGV3
KL_posRnd=[0,KL_ZUig,0]
translate ScatterObjTMSS KL_posRnd   -----取得随机变换位置值并赋值到中介标准矩阵;
ScatterObjTMSS*=ScatterObjTMB
KL_CCCmAT.row4=ScatterObjTMSS.row4))        -----将中介标准矩阵乘以到目标矩阵,达到在目标矩阵自身系统进行随机位置的效果
else(if KC_XXY77.value>0 and KC_XXY715.checked do
(ScatterObjTMSS=matrix3 1   -----初始标准中介矩阵,用来初载变换值,再乘以到笔刷矩阵变换系统
if KL_XiangPOS>0 then KL_ZUig=KL_JUHG*KC_XXY77.value*KL_FFGV3
else KL_ZUig=-(KL_JUHG*KC_XXY77.value*KL_FFGV3)
KL_posRnd=[0,KL_ZUig,0]
translate ScatterObjTMSS KL_posRnd   -----取得随机变换位置值并赋值到中介标准矩阵;
ScatterObjTMSS*=ScatterObjTMB
KL_CCCmAT.row4=ScatterObjTMSS.row4))        -----将中介标准矩阵乘以到目标矩阵,达到在目标矩阵自身系统进行随机位置的效果
if not keyboard.altPressed then(if KC_XXY711.value>0 and KC_XXY717.checked do
(KL_scale=KC_XXY711.value*KL_FFGV3
if KL_CCCmAT.scale.x/(1-KL_scale)<=aa.KP_PlantScale/(1-KL_RestrictMaxMin) do
(KL_scale+=1
scale KL_CCCmAT [KL_scale,KL_scale,KL_scale])))  -----取得随机缩放结果大小并缩放目标矩阵
else(if KC_XXY711.value>0 and KC_XXY717.checked do
(KL_scale=-(KC_XXY711.value*KL_FFGV3)
if KL_CCCmAT.scale.x*(1-abs(KL_scale))>=aa.KP_PlantScale*(1-KL_RestrictMaxMin) do
(KL_scale+=1
scale KL_CCCmAT [KL_scale,KL_scale,KL_scale])))  -----取得随机缩放结果大小并缩放目标矩阵
aa.transform=KL_CCCmAT   -----应用目标矩阵至新绘制的对象;
flagForeground aa false)))      -----设置新绘制对象为后台对象
fn PlantScatt_JiQunend=
(thePainterInterface.undoAccept()
setArrowCursor())
fn PlantScatt_JiQuncancel=
(thePainterInterface.undoCancel()
setArrowCursor())
fn PlantScatt_JiQunsystemEnd=
(thePainterInterface.undoCancel()
setArrowCursor())

on KC_XXY7C changed state do
(max move
if state then(setCommandPanelTaskMode mode:#create    ---总是切换到创建命令面板;
thePainterInterface.ScriptFunctions PlantScatt_JiQunStart PlantScatt_JiQunpaint PlantScatt_JiQunend PlantScatt_JiQuncancel PlantScatt_JiQunsystemEnd
KF_PlantScatt.JiQunPaint())
else(thePainterInterface.endPaintSession()
KC_XXY7C.checked=false))                          ----总是激活选择+移动模式;

on KC_XXY7B pressed do
(KL_RestrictMaxMin=(getINISetting AK_INIT_File "AI_PlantTool" "RestrictMaxMin")as float
undo on(setWaitCursor()
KL_eList=for i in selection where not(isGroupMember i and not isOpenGroupMember i)collect i 
for m in KL_eList where not(isProperty m "KP_PlantScale") do
(custAttributes.add m PlantObjparameters #unique     ---注意这里一定要添加独立的自定义属性,否则关联出来的物体即使塌陷了也会保持自定义属性之间的关联;
m.KP_PlantPercent=(getINISetting AK_INIT_File "AI_PlantTool" "InitiaPercent")as integer  
m.KP_PlantDist=(getINISetting AK_INIT_File "AI_PlantTool" "InitiaDist")as float
m.KP_PlantScale=m.scale.x)    -----如果源对象还没有自定义种植参数,按缺省值进行预置;
for m in KL_eList do(KL_CCCmAT=m.transform            ---所有综合处理系列的命令操作在相对矩阵模式;
KL_CCCmAT.row4=[0,0,0] 
KL_ZXjuli=m.max-m.min
KL_JUHG=(KL_ZXjuli.x+KL_ZXjuli.y)/2	 ----取得对象边界框大小;
if KC_XXY79.value>0 and KC_XXY716.checked do
(KL_oriRnd=random -KC_XXY79.value KC_XXY79.value
rotateZ KL_CCCmAT KL_oriRnd)   -----取得随机旋转角度结果并旋转目标矩阵
KL_CCCmAT.row4=m.pos   -----给目标矩阵定位坐标点;
if KC_XXY77.value>0 and KC_XXY715.checked do
(ScatterObjTMSS=matrix3 1   -----初始标准中介矩阵,用来初载变换值,再乘以到笔刷矩阵变换系统
KL_MNB1=random -(KL_JUHG*KC_XXY77.value)  (KL_JUHG*KC_XXY77.value) 
KL_MNB2=random -(KL_JUHG*KC_XXY77.value)  (KL_JUHG*KC_XXY77.value) 
KL_posRnd=[KL_MNB1,KL_MNB2,0]    ---这样处理限制掉小于正负对象边界框0.3倍的小距离随机位移值;
translate ScatterObjTMSS KL_posRnd   -----取得随机变换位置值并赋值到中介标准矩阵;
ScatterObjTMSS*=KL_CCCmAT
KL_CCCmAT=ScatterObjTMSS)        -----将中介标准矩阵乘以到目标矩阵,达到在目标矩阵自身系统进行随机位置的效果
if KC_XXY711.value>0 and KC_XXY717.checked do
(KL_scale=random -KC_XXY711.value KC_XXY711.value
if KL_scale<0 do if KL_CCCmAT.scale.x*(1-abs(KL_scale))<m.KP_PlantScale*(1-KL_RestrictMaxMin) do KL_scale=-KL_scale
if KL_scale>0 do if KL_CCCmAT.scale.x/(1-KL_scale)>m.KP_PlantScale/(1-KL_RestrictMaxMin) do KL_scale=-KL_scale
KL_scale+=1
scale KL_CCCmAT [KL_scale,KL_scale,KL_scale])  -----取得随机缩放结果大小并缩放目标矩阵
flagForeground m false
m.transform=KL_CCCmAT) -----应用目标矩阵至新绘制的对象;
setArrowCursor()))    ----如果不需要,总是清空寄存数组;   
on KC_XXY7D pressed do
(undo on(setWaitCursor()
KL_eList=for i in selection where not(isGroupMember i and not isOpenGroupMember i)collect i 
KL_Arraycount=KL_eList.count
if KL_Arraycount>=10 do(KL_BNewNum=(KL_Arraycount*KC_XXY75.value)as Integer
KL_New=#()
KL_New[KL_BNewNum]=0
for nn=1 to KL_BNewNum do KL_New[nn]=KL_eList[(random 1 KL_Arraycount)]
thawSelection()
select KL_New)
setArrowCursor()))
on KC_XXY7F pressed do
(undo on(setWaitCursor()
if getCommandPanelTaskMode!=#create do setCommandPanelTaskMode mode:#create 
KGL_PlantScattObj=for m in KGL_PlantScattObj where IsValidNode m collect m
for rr in KGL_PlantScattObj where rr.isHidden do rr.isHidden=false
KGL_Plantcatbj=for m=1 to KGL_PlantScattObj.count where (KF_PlantScatt.KL_ML1.Items.Item(m-1)).checked and(not KGL_PlantScattObj[m].isHiddenInVpt)collect KGL_PlantScattObj[m]
KL_BVCF=#()
KL_BVCFBB=#()
for i in selection where not(isGroupMember i and not isOpenGroupMember i)and findItem KL_BVCFBB i==0 do
(KL_MMM1=InstanceMgr.GetInstances i &KHHHHH 
KHHHHH=for ss in KHHHHH  where findItem KGL_PlantScattObj ss==0 and IsValidNode ss collect ss  
if KHHHHH.count>0 do(append KL_BVCF KHHHHH
join KL_BVCFBB KHHHHH))
if KGL_PlantScattObj.count>0 and KGL_Plantcatbj.count>0 and KL_BVCFBB.count>0  ---必须存在合法的源对象且被勾选在源对象列表中
then(KL_ObjRanar=#()
thawSelection()
clearSelection()  -----这个不能放在开始,否则会有问题;
for m in KGL_Plantcatbj do for n=1 to m.KP_PlantPercent do append KL_ObjRanar m
for vv in KL_BVCF do(KL_NBVc=(vv[1].max-vv[1].min)[3]
for bb in vv do(KL_s1=KL_ObjRanar[(random 1 KL_ObjRanar.count)]  
maxOps.CloneNodes KL_s1 expandHierarchy:true cloneType:#instance newNodes:&ReplObjObj
---maxOps.CloneNodes KL_s1 offset:(bb.pos-KL_s1.pos) expandHierarchy:true cloneType:#instance newNodes:&ReplObjObj
ReplObjObj[1].transform=bb.transform
print ((bb.max-bb.min)[3]/KL_NBVc)
KL_NBVc11=KL_s1.scale*((bb.max-bb.min)[3]/KL_NBVc)
ReplObjObj[1].scale=KL_NBVc11))
delete KL_BVCFBB)
else(if KGL_PlantScattObj.count==0 then messagebox "请先添加有效的源对象至种植列表!"
else if KGL_Plantcatbj.count==0 then messagebox "请先勾选替换源对象或确保源对象没有被隐藏!"
else if KL_BVCFBB.count==0 do messagebox "请选择替换目标对象!")
setArrowCursor()))
on KC_XXY7A pressed do
(undo on(KL_eList=for i in selection where kugegeoFilt i collect i 
if getCommandPanelTaskMode!=#create do setCommandPanelTaskMode mode:#create 
PrevScatterObjTarget=for m in PrevScatterObjTarget where IsValidNode m collect m 
KC_BT6.text="目标:["+PrevScatterObjTarget.count as string+"]"
if PrevScatterObjTarget.count>0 and(KC_VBC319.state!=1 or KC_VBC31.items.count>0)  ---种植修正总是基于目标对象进行处理,没目标的情况下不处理;
then(setWaitCursor()
KL_OldObj=#()
thawSelection()
clearSelection()
for mm in KL_eList do
(ScatterObjTM=mm.transform
KL_PaintFFF=false	  ---预置变量为false,除非检测有效,否则最终输出false而屏蔽掉后面的正式创建;
KL_NewPosR=ray (ScatterObjTM.row4+[0,0,1000000]) [0,0,-1]
KL_ZZuhn2=[0,0,-1000000]
flagForeground mm false
for m in PrevScatterObjTarget do
(KL_ZZponit=intersectRay m KL_NewPosR
if KL_ZZponit!=undefined do(KL_Fnpointpos=KL_ZZponit.pos
if KL_Fnpointpos.z>KL_ZZuhn2.z do
(KL_ZZuhn2=KL_Fnpointpos
if KC_VBC319.state==1 then KL_PaintFFF=m.material!=undefined and findItem KC_VBC31.items m.material.name!=0
else  KL_PaintFFF=true
ScatterObjTM.row4=KL_ZZuhn2)))
if not KL_PaintFFF then append KL_OldObj mm
else mm.transform=ScatterObjTM)
delete KL_OldObj
setArrowCursor())
else(if PrevScatterObjTarget.count==0 then messagebox "请先加载用来修正的目标对象!"
else if (KC_VBC319.state==1 and KC_VBC31.items.count==0) do messagebox "请先定义所需识别的表面材质!")))

on KL_ML1C changed aa do																   
(KL_MC1=#()
for j in selection where((kugegeoFilt j)and(findItem KL_MC1 j==0))do           ----必须是几何体且没有已经处理才进行显示转换;
(if j.classid as string=="#(1828010099, 536368280)" then(if aa==1 then j.display=0
else j.display=1
InstanceMgr.GetInstances j &Kl_NewVrcoll
join KL_MC1 Kl_NewVrcoll)
else(InstanceMgr.GetInstances j &Kl_NewVrcoll
if aa==1 then for kk in Kl_NewVrcoll do kk.boxMode=true
else for kk in Kl_NewVrcoll do kk.boxMode=false
join KL_MC1 Kl_NewVrcoll)))	
on KC_BT4 pressed do(KL_QQ=queryBox "确定删除最后创建的种植对象吗?"  title:"阿酷超级种植工具警告--阿酷提示"
