setINISetting (getMAXIniFile()) "akoo2009" "RendSampR40" (aa as string))
on KC_RenA6 selected aa do(KG_KCRenA6=aa
setINISetting (getMAXIniFile()) "akoo2009" "KG_KCRenA6" (aa as string))	 
on KC_RenA11 changed aa do(KG_KCRenA11=aa
setINISetting (getMAXIniFile()) "akoo2009" "RendSampR46" (aa as string)) 
on KC_RenA12 changed aa do(KG_KCRenA12=KC_RenA13.enabled=aa
if aa then setINISetting (getMAXIniFile()) "akoo2009" "RendSampR47" "1"
else setINISetting (getMAXIniFile()) "akoo2009" "RendSampR47" "0")		
on KC_RenA13 changed aa do(KG_KCRenA13=aa
setINISetting (getMAXIniFile()) "akoo2009" "RendSampR48" (aa as string))  
on KC_RenB1 changed aa do(KG_AKfilteron=aa
if aa then setINISetting (getMAXIniFile()) "akoo2009" "KG_AKfilteron" "1"
else setINISetting (getMAXIniFile()) "akoo2009" "KG_AKfilteron" "0")		
on KC_RenB2 changed aa do(KG_AKrefRefon=aa
if aa then setINISetting (getMAXIniFile()) "akoo2009" "KG_AKrefRefon" "1"
else setINISetting (getMAXIniFile()) "akoo2009" "KG_AKrefRefon" "0")		
