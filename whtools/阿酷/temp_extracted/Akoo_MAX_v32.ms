KL_FFF=true)
KHF_CollToArray KL_Bfij1 XXX[1] XXX[2] XXX[3] XXX[4] "VPR  " AKu2[j] "文件名" KL_FFF)))	  --A2.Vray代理   
(SuperClassOf AKu2[j]==light):
