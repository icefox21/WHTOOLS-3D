setINISetting (getMAXIniFile()) "akoo2009" "KG_KCRenC1" (aa as string))		 						 	
on KC_RenA1 changed aa do(KG_KCRenA1=aa
if aa then setINISetting (getMAXIniFile()) "akoo2009" "RendSampRO2" "1"
else setINISetting (getMAXIniFile()) "akoo2009" "RendSampRO2" "0")		
