fn lcl_Miscell30_FileManage=
(if (KL_JianCLigObj aaa:1 bbb:3 ccc:2) do(
Global LastColumnState,KG_RC_Main
Global KR_ABackLoader
Global KGF_LastFileCol
try(destroydialog KR_ABackLoader)catch()
Global ABData=#()

rcmenu KG_RC_Main
(menuitem MI_Open "加载场景"
menuitem MI_Explore "打开目录"
separator SE_01
menuitem MI_DelFile "删除"
on MI_Explore picked do(for i = 0 to KR_ABackLoader.LB_Main.SelectedItems.count-1 do
(ABFile=ABData[KR_ABackLoader.LB_Main.SelectedItems.item[i].index+1][6]
shelllaunch "explorer" (trimright (getfilenamepath ABFile) "/\\")))
