KR_Render_Flow.KC_CV104.enabled=KR_Render_Flow.KC_CV104CS.enabled=KX_ShuttExist
KR_Render_Flow.KC_CV102.enabled=KX_NetMFExist and KX_CompuNmae!=""
KR_Render_Flow.KC_CV102CS.enabled=KX_NetMFExist
KR_Render_Flow.KC_OutBack1.text=getFilenamePath rendOutputFilename
KGL_YouZFNum)
fn KF_AKOutFBLUpden aa bb=
(if hasProperty renderers.current "output_on" and hasProperty renderers.current "output_getsetsfrommax" 
then(if renderers.current.output_on and renderers.current.output_getsetsfrommax==false 
then(renderers.current.output_width=aa
renderers.current.output_height=bb)
else(renderWidth=aa
renderHeight=bb))
else(renderWidth=aa
renderHeight=bb))
fn KF_RenderReGJIACe KL_initW KL_initH KL_ImageAsp AK_Blowup cc DFS=
(global KR_Render_Flow
local KL_Sarnd=true
local KL_Sarnd2=false
KL_D1=copy KL_initW
KL_D2=copy KL_initH
KL_D3=(KL_D2/(DFS*1.0))
KL_D4=(ceil(KL_D2/(DFS*1.0)))
if KL_D3!=KL_D4 do(KL_D2=KL_D4*DFS
KL_D1=KL_D2*KL_ImageAsp
if cc then(KF_AKOutFBLUpden KL_D1 KL_D2
KR_Render_Flow.KC_Sp2BB.value=KL_D1
KR_Render_Flow.KC_Sp2BC.value=KL_D2)
else(KR_Render_Flow.KC_Sp2BE.value=KL_D2
KR_Render_Flow.KC_Sp2BD.value=KL_D1)
KL_Sarnd2=true)
KL_inito=0
while (KL_D1/(DFS*1.0))!=(ceil(KL_D1/(DFS*1.0))) and KL_inito<5 do
(KL_D2=KL_D2+DFS
KL_D1=KL_D2*KL_ImageAsp
KL_inito+=1
KL_Sarnd2=true)
if KL_inito==5 then(if cc then(KF_AKOutFBLUpden KL_initW KL_initH
KR_Render_Flow.KC_Sp2BB.value=KL_initW
KR_Render_Flow.KC_Sp2BC.value=KL_initH)
else(KR_Render_Flow.KC_Sp2BE.value=KL_initH
KR_Render_Flow.KC_Sp2BD.value=KL_initW)
messageBox "当前渲染尺寸和分块数无法获得均匀尺寸的最终渲染块,请调整相关参数!" title:"渲染流程配置警告--阿酷提示"
KL_Sarnd=false
KL_Sarnd2=false)
else(if cc then(KF_AKOutFBLUpden KL_D1 KL_D2
KR_Render_Flow.KC_Sp2BB.value=KL_D1
KR_Render_Flow.KC_Sp2BC.value=KL_D2)
else(KR_Render_Flow.KC_Sp2BE.value=KL_D2
KR_Render_Flow.KC_Sp2BD.value=KL_D1)
KL_Sarnd=true
if getrendertype()==#blowUp do
(KL_BL1=viewport.getBlowupRect viewport.activeViewport 
KL_D1=KL_BL1.w
KL_D2=KL_BL1.h
KL_D3=(KL_D2/(DFS*1.0))
KL_D4=(ceil(KL_D2/(DFS*1.0)))
if KL_D3!=KL_D4 do(KL_BL1.h=KL_D4*DFS
viewport.setBlowupRect viewport.activeViewport KL_BL1
KL_Sarnd2=true)
KL_initoW=0
while((viewport.getBlowupRect viewport.activeViewport).w/(DFS*1.0))!=(ceil((viewport.getBlowupRect viewport.activeViewport).w/(DFS*1.0)))and KL_initoW<5 do
(KL_BL1=viewport.getBlowupRect viewport.activeViewport  
KL_BL1.h+=DFS
viewport.setBlowupRect viewport.activeViewport KL_BL1
KL_initoW+=1
KL_Sarnd2=true)
if KL_initoW==5 do(if cc then(KF_AKOutFBLUpden KL_initW KL_initH
KR_Render_Flow.KC_Sp2BB.value=KL_initW
KR_Render_Flow.KC_Sp2BC.value=KL_initH)
else(KR_Render_Flow.KC_Sp2BE.value=KL_initH
KR_Render_Flow.KC_Sp2BD.value=KL_initW)
viewport.setBlowupRect viewport.activeViewport AK_Blowup
messageBox "当前渲染尺寸和分块数无法获得均匀尺寸的最终渲染块,请调整相关参数!" title:"渲染流程配置警告--阿酷提示"
KL_Sarnd=false
KL_Sarnd2=false)))
#(KL_Sarnd,KL_Sarnd2))          ----第一个变量定义是否自动调节结果,输入false表示无法完成;第二个表示完成了自动调节的情况是否有真正编辑过像素和渲染框参数,提示后续操作保存场景
fn KF_XuhaoZHFN aa XXX=
(KL_ChuShiJH=#()
for bb in (filterString aa ",") do
(if (filterString bb "-").count==2 do
(if ((filterString bb "-")[1] as Integer)!=undefined and ((filterString bb "-")[2] as Integer)!=undefined do
(for aa=((filterString bb "-")[1] as Integer) to ((filterString bb "-")[2] as Integer) do if findItem KL_ChuShiJH aa==0 and aa<=(XXX^2) do append KL_ChuShiJH aa))
if findString bb "-"==undefined do if (bb as Integer)!=undefined do
(if (bb as Integer)<=(XXX^2) do if findItem KL_ChuShiJH (bb as Integer)==0 do append KL_ChuShiJH  (bb as Integer)))
KL_ChuShiJH)
fn KF_RenderOutLOg aa bb cc=
(if aa.count>0 do
(KL_OUtlogfi=bb+"AKOORenderLog.txt"
if not (doesFileExist KL_OUtlogfi)then KL_JYWYHff=createFile KL_OUtlogfi
else KL_JYWYHff=openFile KL_OUtlogfi mode:"a+"
for m in aa do(KL_ppm=m[2]
if classof KL_ppm==Integer do(KL_XunHUannum=KL_ppm
if KL_ppm<cc do KL_ppm+=86400
KL_ppm-=cc
KGL_OOOTimeI2=KL_ppm/3600   ----获得小时整数
aa1=(replace "00" (3-(KGL_OOOTimeI2 as string).count) (KGL_OOOTimeI2 as string).count (KGL_OOOTimeI2 as string))+"时"
KGL_OOOTimeI3=(KL_ppm-(3600*KGL_OOOTimeI2))/60 ----获得分钟整数
aa2=(replace "00" (3-(KGL_OOOTimeI3 as string).count) (KGL_OOOTimeI3 as string).count (KGL_OOOTimeI3 as string))+"分"
KGL_OOOTimeI4=KL_ppm-(3600*KGL_OOOTimeI2)-(60*KGL_OOOTimeI3) ----获得秒钟整数
aa3=(replace "00" (3-(KGL_OOOTimeI4 as string).count) (KGL_OOOTimeI4 as string).count (KGL_OOOTimeI4 as string))+"秒"
KL_ppm=aa1+aa2+aa3
cc=KL_XunHUannum)
format (m[1]+"%\n") KL_ppm to:KL_JYWYHff)
close KL_JYWYHff))
fn KF_VR_GISave aaa=                      ---写存光子和关闭渲染图像
(KGL_GIPre=#()
renderers.current.options_dontRenderImage=true
if renderers.current.gi_on do
(case renderers.current.gi_primary_type of
(
0:(KL_AA1=aaa+".AKIRmap"
if doesFileExist KL_AA1 do deleteFile KL_AA1
renderers.current.adv_irradmap_mode=0
renderers.current.adv_irradmap_autoSave=true
renderers.current.adv_irradmap_autoSaveFileName=KL_AA1
renderers.current.adv_irradmap_switchToSavedMap=false
if findItem KGL_GIPre KL_AA1==0 do append KGL_GIPre KL_AA1)
1:(renderers.current.photonMap_mode=0
renderers.current.photonMap_autoSave=true
KL_AA1=aaa+".AKPHmap"
if doesFileExist KL_AA1 do deleteFile KL_AA1
renderers.current.photonMap_autoSaveFileName=KL_AA1
renderers.current.photonMap_switchToSavedMap=false
if findItem KGL_GIPre KL_AA1==0 do append KGL_GIPre KL_AA1)
3:(if hasProperty renderers.current "lightcache_mode" do
(renderers.current.lightcache_mode=0                                         
renderers.current.lightcache_autoSave=true
KL_AA1=aaa+".AKLCmap"
if doesFileExist KL_AA1 do deleteFile KL_AA1
renderers.current.lightcache_autoSaveFileName=KL_AA1
renderers.current.lightcache_switchToSavedMap=false
if findItem KGL_GIPre KL_AA1==0 do append KGL_GIPre KL_AA1))
)
if renderers.current.gi_secondary_type!=0 do
(case renderers.current.gi_secondary_type of
(
1:(renderers.current.photonMap_mode=0
renderers.current.photonMap_autoSave=true
KL_AA1=aaa+".AKPHmap"
if doesFileExist KL_AA1 do deleteFile KL_AA1
renderers.current.photonMap_autoSaveFileName=KL_AA1
renderers.current.photonMap_switchToSavedMap=false
if findItem KGL_GIPre KL_AA1==0 do append KGL_GIPre KL_AA1)
3:(if hasProperty renderers.current "lightcache_mode" do
(renderers.current.lightcache_mode=0                                         
renderers.current.lightcache_autoSave=true
KL_AA1=aaa+".AKLCmap"
if doesFileExist KL_AA1 do deleteFile KL_AA1
renderers.current.lightcache_autoSaveFileName=KL_AA1
renderers.current.lightcache_switchToSavedMap=false
if findItem KGL_GIPre KL_AA1==0 do append KGL_GIPre KL_AA1))
)
))
if renderers.current.caustics_on do
(renderers.current.caustics_mode=0 
renderers.current.casutics_autoSave=true
KL_AA1=(aaa+".AKCAmap")
if doesFileExist KL_AA1 do deleteFile KL_AA1
renderers.current.caustics_autoSaveFileName=KL_AA1
renderers.current.caustics_switchToSavedMap=false
if findItem KGL_GIPre KL_AA1==0 do append KGL_GIPre KL_AA1)
KGL_GIPre)
fn KF_VR_GIread aaa=                                 ---读取光子和打开渲染图像
(renderers.current.options_dontRenderImage=false
if renderers.current.gi_on do
(case renderers.current.gi_primary_type of
(
0:(if doesFileExist (aaa+".AKIRmap") do
(renderers.current.adv_irradmap_loadFileName=aaa+".AKIRmap"
renderers.current.adv_irradmap_mode=2
renderers.current.adv_irradmap_autoSave=false
renderers.current.adv_irradmap_autoSaveFileName=""))
1:(if doesFileExist (aaa+".AKPHmap") do
(renderers.current.photonMap_loadFileName=aaa+".AKPHmap"
renderers.current.photonMap_mode=1
renderers.current.photonMap_autoSave=false
renderers.current.photonMap_autoSaveFileName=""))
3:(if hasProperty renderers.current "lightcache_mode" do
(if doesFileExist (aaa+".AKLCmap") do
(renderers.current.lightcache_loadFileName=aaa+".AKLCmap"
renderers.current.lightcache_mode=2
renderers.current.lightcache_autoSave=false
renderers.current.lightcache_autoSaveFileName="")))
)
if  renderers.current.gi_secondary_type!=0 do
(case renderers.current.gi_secondary_type of
(
1:(if doesFileExist (aaa+".AKPHmap") do
(renderers.current.photonMap_loadFileName=aaa+".AKPHmap"
renderers.current.photonMap_mode=1
renderers.current.photonMap_autoSave=false
renderers.current.photonMap_autoSaveFileName=""))
3:(if hasProperty renderers.current "lightcache_mode" do
(if doesFileExist (aaa+".AKLCmap") do
(renderers.current.lightcache_loadFileName=aaa+".AKLCmap"    
renderers.current.lightcache_mode=2
renderers.current.lightcache_autoSave=false
renderers.current.lightcache_autoSaveFileName="")))
)
))
if renderers.current.caustics_on do
(if doesFileExist (aaa+".AKCamap") do
(renderers.current.caustics_loadFileName=(aaa+".AKCamap")
renderers.current.caustics_mode=1
renderers.current.casutics_autoSave=false
renderers.current.caustics_autoSaveFileName="")))
fn KF_AKVRCHanneoOFF aa bb cc=             ----渲染通道前的工作,其中除可能存在的曝光参数外,其它都直接可以用恢复渲染备份设置进行恢复原样,就相机曝光要另外进行恢复;
(KL_ZXCV=#()
while numAtmospherics!=0 do deleteAtmospheric 1
while numEffects!=0 do deleteEffect 1
ambientColor=(color 0 0 0)   ---环境颜色
backgroundColor=(color 0 0 0)  ---背景颜色
useEnvironmentMap=false   ---环境贴图
if not (matchPattern (renderers.current as string) pattern:"*Ray*" ignoreCase:false) do try(renderpresets.LoadAll 0 KGL_RenFlowtempfile
if cc!=undefined do(if isProperty environmentMap "sun_node" do environmentMap.sun_node=cc
if isProperty environmentMap "阳光节点" do environmentMap.阳光节点=cc)
if bb!=undefined do meditMaterials[bb]=environmentMap)catch() 
renderers.current.gi_on=false  ---GI
renderers.current.environment_gi_on=false
renderers.current.dof_on=false   ----景深
renderers.current.caustics_on=false   ----焦散
renderers.current.moblur_on=false     ----运动模糊
