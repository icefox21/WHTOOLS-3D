KHF_CollToArray KL_Bfij1 XXX[1] XXX[2]  XXX[3] XXX[4] "WEB  " AKu2[j] "webFile" KL_FFF)   ---B12.灯光光域网文件
if isProperty AKu2[j] "projectorMap" do KHF_CollToArray AKu2[j].projectorMap XXX[1] XXX[2]  XXX[3] XXX[4] "PRO  " AKu2[j].projectorMap 0 false  --B13.灯光投影贴图	 
if isProperty AKu2[j] "shadowProjectorMap"do KHF_CollToArray AKu2[j].shadowProjectorMap XXX[1] XXX[2] XXX[3] XXX[4] "SHA  " AKu2[j].shadowProjectorMap 0 false) --B14.灯光阴影投影贴图	
(AKu2[j].classID as string=="#(-1834306676, 0)"):
