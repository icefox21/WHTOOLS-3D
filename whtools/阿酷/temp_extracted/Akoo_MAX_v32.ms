join KL_MaxVrccMY Kl_MaxNewVrcoll
if(KL_Bfij=mapPaths.getFullFilePath AKu2[j].fileName)!="" then(KL_Bfij1=KL_Bfij
if AKu2[j].fileName!=KL_Bfij1 do AKu2[j].fileName=KL_Bfij1
KL_FFF=false)
