fn KLF_MBLupdate ZZ=   -----装载素材管理面板函数:参数1:ZZ.所有当前类当前子路径(可以是子路径也可以是根路径)可加载素材数组;
(KL_ZS=ZZ.count      ---统计当前所有可加载素材总数;
KL_DetNum=(ceil(KL_ZS/(KGLH_AKHeightNumber*1.0*KG_ModeBankLS)))as Integer   ----求得当前界面设置最大屏数;
if KG_ModeBankPS>KL_DetNum do KG_ModeBankPS=1                                ----如果当前屏数不合格(大于最大屏数),则直接复位为1;
KR_MoBankTVRoll3.KC_LB1.text=(KG_ModeBankPS as string)+"/"+KL_DetNum as string --求得几/几表达字符串;并分配给命令面板上的指示标数;
KL_Oncet=(KGLH_AKHeightNumber*KG_ModeBankLS)   --求得当前屏数真正的素材节点序(每屏实际序号数不一样)号起点数;
for a=1 to KL_Oncet do                        --逐一装载处理;
(KR_MoBankTVRoll3.KL_AAA1.value=a*100.0/KL_Oncet    ----刷新进度条;
KL_PP1X=a+(KL_Oncet*(KG_ModeBankPS-1))           ----根据实际的序号起点数加上当前迭代数获得当前的序号节点数;
if KL_PP1X<=KL_ZS then(if KCG_ConLIstIT[a].Image!=undefined do KCG_ConLIstIT[a].Image.Dispose()   ----这里也一定是要释放掉图片,再去重新定义,否则原来的对象就会锁死文件!!!
KCG_ConLIstIT[a].Image=(dotNetClass "System.Drawing.Image").FromFile(dotNetObject"System.String" ZZ[KL_PP1X]))  ----获得实际序号数的小样图片;
else(if KCG_ConLIstIT[a].Image!=undefined do(KCG_ConLIstIT[a].Image.Dispose()   ----这里一定要先释放图片,再进行去除,否则缩略图文件将被锁死,不好删除和更新;
KCG_ConLIstIT[a].Image=null)))   ----已经到节点数最大值的情况下开始禁止小样图的加载
KL_AAA1.value=0) 	    -----清零进度条;							

fn KLF_FillSubTree ZZ XX aa bb=	   --装载子路径素材函数;参数1输入对应当前根路径的本机路径,,参数2输入当前根路径对象;参数3输入当前支路径激活序号,参数4为返回上次函数的有效对象节点数组;
(KL_FBI=getINISetting KGL_MankPathInIFile "akoo2011" "SUCAIType_M"            -----获得当前库类型全局ini设置;且取得路径段;  
KL_SCTyN=findItem KGL_ResPaterType KL_FBI    ---获得当前素材库状态编号数:1:模型/2:材质/3:贴图
KL_IniDir=getDirectories(ZZ+"*")         ---初始获得本机根路径所有的子路径;
KL_ZJD=for gh in KL_IniDir where(getFiles(gh+"*.bmp")).count>0 collect gh    ---获得该根路径下的所有有效支路径;
if aa>KL_ZJD.count do(setINISetting KGL_MankPathInIFile KL_FBI XX "0"   ----首先第一步:检测是否存在不合法的支路径激活序号;如果存在,复位为0
aa=0)  
if aa<1 do join bb(getFiles(ZZ+"*.bmp"))   ----如果支路径激活序号为0,则追加所有根路径下的节点对象(否则仅追加对应支路径下的所有节点对象);
for yy=1 to KGL_AKHeitNum2 do if yy<=KL_ZJD.count                         ----遍寻每个有效支路径对象(最大数量为KGL_AKHeitNum2);
then(KL_Curet=(yy==aa)
KL_PathMeh=filterString KL_ZJD[yy] "\\:"       ----在实际根目录的数量范围内进行迭代处理;首先取得当前路径对象的分节;这里注意过滤分区根目录的冒号,在座位其它用时可能会出错;
KCG_ConUUTLIst[yy].text=KL_PathMeh[KL_PathMeh.count]     ----给当前根路径控件命名;
if aa<1 or KL_Curet do join bb (getFiles(KL_ZJD[yy]+"*.bmp"))
KCG_ConUUTLIst[yy].checked=KL_Curet
KCG_ConUUTLIst[yy].visible=true)
else KCG_ConUUTLIst[yy].visible=false)


fn KLF_FillRootTree=     ----装载主路径素材函数
(KL_FBI=getINISetting KGL_MankPathInIFile "akoo2011" "SUCAIType_M"            -----获得当前库类型全局ini设置;且取得路径段;  
KL_SCTyN=findItem KGL_ResPaterType KL_FBI    ---获得当前素材库状态编号数:1:模型/2:材质/3:贴图
KL_MMT2=(getINISetting KGL_MankPathInIFile "akoo2011" KGL_ResTaNTypeXH[KL_SCTyN])as integer      ---获得当前库类型的上次根路径序号;
KGL_ModeBanKNodeLI=#()                 -----这里传递到下一个函数的节点数组;
KGP_ModePathlib=getINISetting KGL_MankPathInIFile KL_FBI          ----取得当前库的所有已登记路径对象;
if KL_MMT2<1 or KL_MMT2>KGP_ModePathlib.count do(setINISetting KGL_MankPathInIFile "akoo2011" KGL_ResTaNTypeXH[KL_SCTyN] "1"
KL_MMT2=1)           ----如果根路径的激活序号为空或不合法,则初始化变量值和全局设置均为1;
for yy=1 to KGL_AKHeitNum2 do if yy<=KGP_ModePathlib.count                         ----遍寻每个有效根路径对象(数量为KGL_AKHeitNum2);
then(KL_Curet1=(yy==KL_MMT2)
KL_PathMeh=filterString KGP_ModePathlib[yy] "\\:"       ----在实际根目录的数量范围内进行迭代处理;首先取得当前路径对象的分节;这里注意过滤分区根目录的冒号,在座位其它用时可能会出错;
KL_Ab3b=KGL_MankPathInI+KL_FBI+KL_PathMeh[KL_PathMeh.count]+"\\"           -----本机素材库路径+当前素材库子路径+当前根路径最后路径节+路径符号,取得对应素材路径的本机路径;
KCG_ConUTLIst[yy].text=KL_PathMeh[KL_PathMeh.count]     ----给当前根路径控件命名;
if((getFiles(KGP_ModePathlib[yy]+"*.*")).count>0 or(getDirectories(KGP_ModePathlib[yy]+"*")).count>0)  ---如果目标路径存在文件内容或子路径文件夹,则继续往里进行处理;
then(KCG_ConUTLIst[yy].enabled=true
if KL_Curet1 do(KL_CMD=(getINISetting KGL_MankPathInIFile KL_FBI KGP_ModePathlib[yy])as integer   
KLF_FillSubTree KL_Ab3b KGP_ModePathlib[yy] KL_CMD KGL_ModeBanKNodeLI))       ----如果此路径有效,总是保证恢复其可用状态;
else KCG_ConUTLIst[yy].enabled=false        ----如果可见,但没有文件内容也没有子文件夹,则定义为冻结(灰色)状态
KCG_ConUTLIst[yy].checked=KL_Curet1  ----定义可见根路径对象的按下状态;
KCG_ConUTLIst[yy].visible=true)           ----在实际的根路径数以内,则将这些对应的控件显示为可见;
else(KCG_ConUTLIst[yy].visible=false      ----如果超过实际的根路径数,则这些对应的控件不可视;
if yy==1 do KLF_FillSubTree "" "" 0 KGL_ModeBanKNodeLI)
KLF_MBLupdate KGL_ModeBanKNodeLI                     -----正式进行小样图片控件的初始化和装载;
freeSceneBitmaps()
try(gc light:true)catch())
fn KF_BigTyeQH aa=
(KL_Once=KCG_ConDTypLI.count
for m=1 to KL_Once do if m!=aa then KCG_ConDTypLI[m].checked=false
else KCG_ConDTypLI[m].checked=true
setINISetting KGL_MankPathInIFile "akoo2011" "SUCAIType_M" KGL_ResPaterType[aa]
KLF_FillRootTree())
on KC_STbu1 pressed do                           ---输出素材库整个内容;
(KL_Q1RR=getSavePath caption:"输出当前素材库缩略图路径" initialDir:KGL_MankPathInI
if KL_Q1RR!="" and KL_Q1RR!=undefined do
(KL_Q1RR+="\\DIYModeBankPath\\" 
makeDir KL_Q1RR      ---先保证创建目录(自建本地缩略图路径名);
KHF_CopyAllNestFile KGL_MankPathInI KL_Q1RR))
on KC_STbu2 pressed do
(KL_Q1RR=getSavePath caption:"切换本地素材库缩略图路径" initialDir:KGL_MankPathInI  
if KL_Q1RR!="" and KL_Q1RR!=undefined do
(if(findString KL_Q1RR "\\")!=1 then(KL_Q1RR+="\\" 
setINISetting (getMAXIniFile())"akoo2009" "DIYModeBankPath" KL_Q1RR
KGL_MankPathInI=getINISetting (getMAXIniFile()) "akoo2009" "DIYModeBankPath"
KGL_MankPathInIFile=KGL_MankPathInI+"AK_MaterialBank.ini"
cui.UnRegisterDialogBar KR_MoBankTVRoll3
DestroyDialog KR_MoBankTVRoll3)
else messageBox "本地素材库缩略图路径不支持网络路径!" title:"阿酷素材库管理--阿酷提示"))
on KL_AAAT1 changed aa do if aa do KF_BigTyeQH 1
on KL_AAAT2 changed aa do if aa do KF_BigTyeQH 2
on KL_AAAT3 changed aa do if aa do KF_BigTyeQH 3  
on KC_DL2 changed aa do(KL_BankDrapGravity  =aa
if aa then setINISetting AK_INIT_File "akoo2011" "BankDrapGravity" "1"
else setINISetting AK_INIT_File "akoo2011" "BankDrapGravity" "0") 				
on KC_STbu3 changed aa do(KG_MatRESEPrevier=aa
if aa then setINISetting KGL_MankPathInIFile "akoo2011" "MatRESEPrevier" "1"  ---更改素材预览开关;
else setINISetting KGL_MankPathInIFile "akoo2011" "MatRESEPrevier" "0")

fn KHL_SUCAIPathAR ZZ=
(KL_FBI=getINISetting KGL_MankPathInIFile "akoo2011" "SUCAIType_M"    -----获得当前素材库类型;
KL_SCTyN=findItem KGL_ResPaterType KL_FBI                               -----取得当前素材库编号(用来取得对应素材库的对应根支路径对应激活序号)
for DJ in ZZ while(not keyboard.escPressed)do                    -----逐个处理数组中的每个路径
(KGP_ModePathlib=getINISetting KGL_MankPathInIFile KL_FBI             -----首先获得当前全局ini设置中的总路径集合数组
if KGP_ModePathlib.count<KGL_AKHeitNum2 do               -----必须还存在容量才能再添加,否则必须先删除一些路径再添加;
(KL_Once=KGP_ModePathlib.count                  ----统计已存在路径数
notfound=false                                -----初始化路径已存在检测的触发变量为false
for m in KGP_ModePathlib while notfound do notfound=(m==DJ)   -----逐个匹配比较和触发;
if not notfound do                                               -----如果未有存在,则进行加载处理,否则进行提示并退出处理;
(KL_Oncet=(KGLH_AKHeightNumber*KG_ModeBankLS)   --求得当前屏数真正的素材节点序(每屏实际序号数不一样)号起点数;
for a=1 to KL_Oncet do if KCG_ConLIstIT[a].Image!=undefined do(KCG_ConLIstIT[a].Image.Dispose()   ----这里一定要先释放图片,再进行去除,否则缩略图文件将被锁死,不好删除和更新;
KCG_ConLIstIT[a].Image=null) 
KL_P1=filterString DJ "\\:"               ----先肢解目标路径的所有路径段;
KL_ZJD=getDirectories(DJ+"*")            ----先统计目标路径所有的子路径;
KL_SnbDD=for pp in KL_ZJD where(getFiles(pp+"*.*")).count>0 collect pp  --重新收捡有效子路径;
KL_NodeCollPa=join #(DJ) KL_SnbDD   ----汇总根路径和所有子路径,之前要进行整体依次转换;
KL_PPmg=#(KGL_MankPathInI+KL_FBI+KL_P1[KL_P1.count]+"\\")      -----转换得到当前根路径的对应本机路径;
for pp in KL_SnbDD do(KL_P1X=filterString pp "\\"              -----逐个处理每个子路径,首先肢解路径段;
append KL_PPmg(KL_PPmg[1]+KL_P1X[KL_P1X.count]+"\\"))  ----逐个收集所有子路径的对应本机子路径;
for pp in KL_PPmg do(makeDir pp all:true
KL_On=getFiles(pp+"*.*")
for m in KL_On do deleteFile m)    ----逐个保证本机对应路径的创立和已有文件的检测和删除;
KL_Snumb11=0                  -----巨大进度条处理时分段回收内存的分节数值;         
case KL_SCTyN of             -----根据当前库类型来定义下面的处理规则;
(
1:(KL_WC=KL_NodeCollPa.count
for pp=1 to KL_WC while(not keyboard.escPressed)do      ------为每一个路径对象依次进行转换处理;
(KL_ReNodeAR=getFiles(KL_NodeCollPa[pp]+"*.max")                            ----收集每路径的节点对象;
KL_Once=KL_ReNodeAR.count                                  ----统计总数(主要用来定义进度条的重点值);
for m=1 to KL_Once while(not keyboard.escPressed)do      ------在没有ESC取消的情况下始终循环处理直至结束;
(KL_AAA1.value=m*100.0/KL_Once                          -----更新进度条;
KL_YJPGT=(getFilenamePath KL_ReNodeAR[m])+(getFilenameFile KL_ReNodeAR[m])+".jpg"   ----优先尝试访问jpg格式的大样图片;
if not(doesFileExist KL_YJPGT)do KL_YJPGT=(getFilenamePath KL_ReNodeAR[m])+(getFilenameFile KL_ReNodeAR[m])+".bmp"  ----接着尝试访问bmp格式的大样图片;
KHF_SamBitmConver KL_YJPGT KL_PPmg[pp] KL_NullBit2		-----根据大样图转换输出小样文件的函数;				 
if m-KL_Snumb11>20 do(KL_Snumb11+=20              -----检测是否达到了每个强制回收内存的节点,如果达到了,首先将基数提升上去,然后回收内存;
freeSceneBitmaps()
try(gc())catch()))
pushPrompt ((KL_WC as string)+"个路径"+":当前加载["+(pp as string)+"]    "+KL_NodeCollPa[pp])     ---状态栏进行总的路径处理进度提示;
KL_AAA1.value=0))     ----清零进度条;
2:(KL_WC=KL_NodeCollPa.count            -----统计总路径数量;
for pp=1 to KL_WC while(not keyboard.escPressed)do   ---迭代转换处理,除非按Esc键退出
(KL_ReNodeAR=#()                                    ---初始化数组,准备收集所有材质对象(文件名+对象名)
KL_Once=#()
KL_NodeMax=getFiles(KL_NodeCollPa[pp]+"*.mat.max")                ---集合当前目录下的所有材质场景文件对象;
KL_MatMax=getFiles(KL_NodeCollPa[pp]+"*.mat")  
for mq in KL_NodeMax do(KL_Once=getMAXFileObjectNames mq quiet:true           -----遍寻每一个材质场景文件对象,取得每个材质场景文件里面的对象集合;
for mm in KL_Once where not(matchPattern mm pattern:"Mathelp_*")do if findItem KL_ReNodeAR #(mq,mm)==0 do append KL_ReNodeAR #(mq,mm))  ----遍寻每个场景对象,如果不为辅助对象,则收集数组;
for mq in KL_MatMax do(KL_Once=loadTempMaterialLibrary mq
if KL_Once!=undefined and KL_Once.count!=0 do for mm in KL_Once do if findItem KL_ReNodeAR #(mq,mm.name)==0 do append KL_ReNodeAR #(mq,mm.name))  ----遍寻每个场景对象,如果不为辅助对象,则收集数组;
KL_Once=KL_ReNodeAR.count           ---统计所有材质对象总数;
for m=1 to KL_Once do              ---遍寻处理;
(KL_AAA1.value=m*100.0/KL_Once    ---刷新进度条;
KL_ppname=getFilenameFile KL_ReNodeAR[m][1]    ---取得当前场景材质对象的文件名
if(matchPattern KL_ppname pattern:"*.mat")then KL_Zuname=substring KL_ppname 1 (KL_ppname.count-4)   ----截取已经获得文件名的点缀部分".mat";
else KL_Zuname=KL_ppname
KL_YJPGT=(getFilenamePath KL_ReNodeAR[m][1])+KL_Zuname+"{}"+KL_ReNodeAR[m][2]+".jpg"  ----优先尝试访问jpg格式的大样图片;
if not(doesFileExist KL_YJPGT)do KL_YJPGT=(getFilenamePath KL_ReNodeAR[m][1])+KL_Zuname+"{}"+KL_ReNodeAR[m][2]+".bmp" ----接着尝试访问bmp格式的大样图片;
KHF_SamBitmConver KL_YJPGT KL_PPmg[pp] KL_NullBit2
if m-KL_Snumb11>20 do(KL_Snumb11+=20              -----检测是否达到了每个强制回收内存的节点,如果达到了,首先将基数提升上去,然后回收内存;
freeSceneBitmaps()
try(gc())catch()))
pushPrompt ((KL_WC as string)+"个路径"+":当前加载["+(pp as string)+"]    "+KL_NodeCollPa[pp])     ---状态栏进行总的路径处理进度提示;
KL_AAA1.value=0))
3:(KL_WC=KL_NodeCollPa.count
for pp=1 to KL_WC while(not keyboard.escPressed)do
(KL_ReNodGD=getFiles(KL_NodeCollPa[pp]+"*.*")                            ----收集每路径的节点对象;
KL_ReNodeAR=for tt in KL_ReNodGD where findItem KGM_BitmapFormat(KHF_StringUpperL(getFilenameType tt))!=0 collect tt
KL_Once=KL_ReNodeAR.count  
for m=1 to KL_Once while(not keyboard.escPressed)do
(KL_AAA1.value=m*100.0/KL_Once
KHF_SamBitmConver KL_ReNodeAR[m] KL_PPmg[pp] KL_NullBit2	
if m-KL_Snumb11>20 do(KL_Snumb11+=20              -----检测是否达到了每个强制回收内存的节点,如果达到了,首先将基数提升上去,然后回收内存;
freeSceneBitmaps()
try(gc())catch()))
pushPrompt ((KL_WC as string)+"个路径"+":当前加载["+(pp as string)+"]    "+KL_NodeCollPa[pp])     ---状态栏进行总的路径处理进度提示;
KL_AAA1.value=0))
) 
)
setINISetting KGL_MankPathInIFile KL_FBI DJ "0"   ----初始化当前根路径的支路径初始激活值为0;
freeSceneBitmaps()
try(gc())catch())))   

fn KHF_HBCMNBfn aa cc bb=
(undo off(KL_OJCAr=#()  
for m in aa do(KL_sum1=objects.count
mergeMAXFile m #mergeDups cc quiet:true
if objects.count-KL_sum1>0 do(KL_Oncecoun2=objects.count
for j=(KL_sum1+1) to KL_Oncecoun2 do(if objects[j].material!=undefined do append KGL_MTaestArFI objects[j].material
append KL_OJCAr objects[j])))
undo off(delete KL_OJCAr)
append KGL_MatFillXH #(KGL_MTaestArFI,bb)
if KGL_MTaestArFI.count>0 do kugeMaterialsED KGL_MTaestArFI))

fn KCR_NodeLiFN ZZ Sater=        -----根路径控件按下响应函数;
(if Sater then(KG_ModeBankLS=(getINISetting KGL_MankPathInIFile "akoo2011" "MoBaSPeeLNum")as integer    ----获得当前素材管理命令面板整屏列数;
KL_FBI=getINISetting KGL_MankPathInIFile "akoo2011" "SUCAIType_M" 
KL_SCTyN=findItem KGL_ResPaterType KL_FBI 
KGP_ModePathlib=getINISetting KGL_MankPathInIFile KL_FBI
KL_MMT2=(getINISetting KGL_MankPathInIFile "akoo2011" KGL_ResTaNTypeXH[KL_SCTyN])as integer      ---获得当前库类型的上次根路径序号;
if KCG_ConUTLIst[ZZ]!=KCG_ConUTLIst[KL_MMT2] do KCG_ConUTLIst[KL_MMT2].checked=false         ----如果不是同一控件,直接释放原控件;
KGL_ModeBanKNodeLI=#()                      ----初始化图片控件对象数组,用来给根支路径处理函数返回节点数组;
if KGP_ModePathlib[ZZ]!=undefined do    -----如果当前的根路径对象不为空;
(KG_ModeBankPS=1                 -----总是恢复屏数为1
setINISetting KGL_MankPathInIFile "akoo2011" KGL_ResTaNTypeXH[KL_SCTyN] (ZZ as string) 
KL_PathMeh=filterString KGP_ModePathlib[ZZ] "\\:"       ----在实际根目录的数量范围内进行迭代处理;首先取得当前路径对象的分节;这里注意过滤分区根目录的冒号,在座位其它用时可能会出错;
KL_Ab3b=KGL_MankPathInI+KL_FBI+KL_PathMeh[KL_PathMeh.count]+"\\"       ----获得对应本机路径
KL_CMD=(getINISetting KGL_MankPathInIFile KL_FBI  KGP_ModePathlib[ZZ])as integer    ----取得当前根路径对象的子路径激活序号数;
KLF_FillSubTree KL_Ab3b KGP_ModePathlib[ZZ] KL_CMD KGL_ModeBanKNodeLI    ----调用子路径处理函数进行对应的处理;
KLF_MBLupdate KGL_ModeBanKNodeLI))
else KCG_ConUTLIst[ZZ].checked=true)
fn KLF_UUSubFill aa bb=   ----支路径控件响应函数:参数1:aa.控件通断状态;参数2:bb.当前控件序号数;
(KL_FBI=getINISetting KGL_MankPathInIFile "akoo2011" "SUCAIType_M"            -----获得当前库类型全局ini设置;且取得路径段;  
KL_SCTyN=findItem KGL_ResPaterType KL_FBI    ---获得当前素材库状态编号数:1:模型/2:材质/3:贴图
KL_MMT2=(getINISetting KGL_MankPathInIFile "akoo2011" KGL_ResTaNTypeXH[KL_SCTyN])as integer      ---获得当前库类型的上次根路径序号;
KGL_ModeBanKNodeLI=#()                 -----这里传递到下一个函数的节点数组;	
KGP_ModePathlib=getINISetting KGL_MankPathInIFile KL_FBI          ----取得当前库的所有已登记路径对象;
if KL_MMT2<1 or KL_MMT2>KGP_ModePathlib.count do(setINISetting KGL_MankPathInIFile "akoo2011" KGL_ResTaNTypeXH[KL_SCTyN] "1"
KL_MMT2=1)           ----如果根路径的激活序号为空或不合法,则初始化变量值和全局设置均为1;
if KGP_ModePathlib[KL_MMT2]!=undefined do
(KL_PathMeh=filterString KGP_ModePathlib[KL_MMT2] "\\:"       ----在实际根目录的数量范围内进行迭代处理;首先取得当前路径对象的分节;这里注意过滤分区根目录的冒号,在座位其它用时可能会出错;
KL_Ab3b=KGL_MankPathInI+KL_FBI+KL_PathMeh[KL_PathMeh.count]+"\\"           -----本机素材库路径+当前素材库子路径+当前根路径最后路径节+路径符号,取得对应素材路径的本机路径;       
if aa then setINISetting KGL_MankPathInIFile KL_FBI  KGP_ModePathlib[KL_MMT2] (bb as string)   ----如果当前为控件关闭状态,则设置当前根路径的支路径序号为0
else setINISetting KGL_MankPathInIFile KL_FBI  KGP_ModePathlib[KL_MMT2] "0"
KL_CMD=(getINISetting KGL_MankPathInIFile KL_FBI KGP_ModePathlib[KL_MMT2])as integer ---读取当前根路径的激活序号数,用来传递给支路径加载函数进行进一步处理;  
KLF_FillSubTree KL_Ab3b KGP_ModePathlib[KL_MMT2] KL_CMD KGL_ModeBanKNodeLI
KLF_MBLupdate KGL_ModeBanKNodeLI                     -----正式进行小样图片控件的初始化和装载;
freeSceneBitmaps()
try(gc light:true)catch()))       ----如果此路径有效,总是保证恢复其可用状态;

---------3.5OK			   
on KC_CH1 pressed do       ----当前选择路径装载处理事件;
(KL_Q222=#()             ----路径装入的源路径数组变量;
KL_FBI=getINISetting KGL_MankPathInIFile "akoo2011" "SUCAIType_M"   ----当前库类型;
KL_SCTyN=findItem KGL_ResPaterType KL_FBI                              ----当前库类型的序号:1.模型库;2.材质库;3.贴图库
if keyboard.shiftPressed                                  ----安装Shift键为强制更新模式,否则为正常加载模式;
then(KL_MMT2=(getINISetting KGL_MankPathInIFile "akoo2011" KGL_ResTaNTypeXH[KL_SCTyN])as integer    ----获得当前库类型根目录的激活序号(刷新此号);
KGP_ModePathlib=getINISetting KGL_MankPathInIFile KL_FBI         -----获得当前类型库的总根目录数组;
if KGP_ModePathlib.count>=KL_MMT2 do 
(KL_B1=KGP_ModePathlib[KL_MMT2]         ----获得当前激活的根目录对象(需要进行更新);	 这里不需要进行删除,后面加载路径那里进行统一删除;
if(getFiles(KL_B1+"*.*")).count>0 or(getDirectories(KL_B1+"*")).count>0 do append KL_Q222 KL_B1))
else(KL_Q1RR=getSavePath caption:"添加单个选择的路径对象"         ----路径方式获取路径,会有三种结果,路径/未定义/空字符串
if KL_Q1RR!="" and KL_Q1RR!=undefined do
(KL_Q1RR+="\\"  ----追加为完整路径名;
if(getFiles(KL_Q1RR+"*.*")).count>0 or(getDirectories(KL_Q1RR+"*")).count>0 do append KL_Q222 KL_Q1RR)) ---如果不为空,返回当前路径
if KL_Q222.count>0 do(KHL_SUCAIPathAR KL_Q222     ---如果路径数组不为空,则进行目标路径下素材文件的小样转换处理;
KLF_FillRootTree()))             ---然后再去进行路径素材的加载;
on KC_CH3 pressed do        ----当前目录所有子路径装载处理事件;
(KL_Q222=#()               ----路径装入的源路径数组变量;
KL_FBI=getINISetting KGL_MankPathInIFile "akoo2011" "SUCAIType_M"       ----当前库类型;
KL_SCTyN=findItem KGL_ResPaterType KL_FBI                                   ----当前库类型的序号:1.模型库;2.材质库;3.贴图库
if keyboard.shiftPressed  
then(KGP_ModePathlib=getINISetting KGL_MankPathInIFile KL_FBI   ----获得当前所有路径对象;
if KGP_ModePathlib.count>0 do
(rollout lcl_SUCaiSel "批量更新素材库路径面板"
(local KL_AA1=#()
local KL_F1=getINISetting KGL_MankPathInIFile "akoo2011" "SUCAIType_M"       ----当前库类型;
MultiListBox KC_MB items:KGP_ModePathlib height:KGP_ModePathlib.count   ----刚好排满路径对象就可以了;
button KC_MB1 "批量更新素材库路径"
on KC_MB1 pressed do undo off
(KL_BDN=KC_MB.selection as array            ----集合所有列表项选中的序号数
KL_DelSUcaiPB=for m in KL_BDN collect KGP_ModePathlib[m]   ----按序号数集合对应的目标路径数组;
for tt in KL_DelSUcaiPB do if((getFiles(tt+"*.*")).count>0 or(getDirectories(tt+"*")).count>0)do append KL_AA1 tt
if KL_AA1.count>0 do(KHL_SUCAIPathAR KL_AA1   -----首先进行目标路径素材文件的转换处理(小样转换);
KLF_FillRootTree())            -----进行素材面板的加载;
KC_MB.selection=#()
DestroyDialog lcl_SUCaiSel)    -----清空选择集和崩溃对话框;
on lcl_SUCaiSel rbuttondown xs do DestroyDialog lcl_SUCaiSel)
CreateDialog lcl_SUCaiSel width:500))
else(KL_Q1RR=getSavePath caption:"添加单个选择路径的所有子路径"   ----添加父路径
if KL_Q1RR!=""and KL_Q1RR!=undefined do                   ----如果父路径真是有效
(KL_Q1RR+="\\"  ----追加为完整路径名;
Kl_NewDir=getDirectories(KL_Q1RR+"*")           ----获得所有子路径,(材质库要求名字)
for m in Kl_NewDir where((getFiles(m+"*.*")).count>0 or(getDirectories(m+"*")).count>0)do append KL_Q222 m
KHL_SUCAIPathAR KL_Q222 
KLF_FillRootTree())))	     -----加载路径+装载素材

on KC_CH2 pressed do
(KL_FBI=getINISetting KGL_MankPathInIFile "akoo2011" "SUCAIType_M" 
KL_SCTyN=findItem KGL_ResPaterType KL_FBI  
KGP_ModePathlib=getINISetting KGL_MankPathInIFile KL_FBI
KL_MMT2=(getINISetting KGL_MankPathInIFile "akoo2011" KGL_ResTaNTypeXH[KL_SCTyN])as integer
if KGP_ModePathlib.count>=KL_MMT2 and KL_MMT2>0
do(KL_QQ=queryBox("你确定要删除当前素材路径吗?")title:"外部文件处理警告--阿酷提示"
if KL_QQ do(KL_Oncet=(KGLH_AKHeightNumber*KG_ModeBankLS)   --求得当前屏数真正的素材节点序(每屏实际序号数不一样)号起点数;
for a=1 to KL_Oncet do if KCG_ConLIstIT[a].Image!=undefined do(KCG_ConLIstIT[a].Image.Dispose()   ----这里一定要先释放图片,再进行去除,否则缩略图文件将被锁死,不好删除和更新;
KCG_ConLIstIT[a].Image=null)
KL_B1=KGP_ModePathlib[KL_MMT2]
KL_P1=filterString KL_B1 "\\"
KL_PPmg=(KGL_MankPathInI+KL_FBI+KL_P1[KL_P1.count])+"\\"
KHF_DeleteNestFile KL_PPmg
delIniSetting KGL_MankPathInIFile KL_FBI KL_B1)
try(gc())catch())
if KGP_ModePathlib.count==KL_MMT2 or KL_MMT2==0 do setINISetting KGL_MankPathInIFile "akoo2011" KGL_ResTaNTypeXH[KL_SCTyN] "1"
KLF_FillRootTree())
on KC_CH4 pressed do
(KL_FBI=getINISetting KGL_MankPathInIFile "akoo2011" "SUCAIType_M" 
KL_SCTyN=findItem KGL_ResPaterType KL_FBI  
KGP_ModePathlib=getINISetting KGL_MankPathInIFile KL_FBI
if KGP_ModePathlib.count>0 do
(rollout lcl_SUCaiSel "批量删除素材路径面板"
(local KL_F1=getINISetting KGL_MankPathInIFile "akoo2011" "SUCAIType_M"       ----当前库类型;
local KL_F3=findItem KGL_ResPaterType KL_F1
local KL_F2=getINISetting KGL_MankPathInIFile KL_F1
MultiListBox KC_MB items:KL_F2 height:KL_F2.count
button KC_MB1 "删除选中路径"
on KC_MB1 pressed do(KL_Oncet=(KGLH_AKHeightNumber*KG_ModeBankLS)   --求得当前屏数真正的素材节点序(每屏实际序号数不一样)号起点数;
for a=1 to KL_Oncet do if KCG_ConLIstIT[a].Image!=undefined do(KCG_ConLIstIT[a].Image.Dispose()   ----这里一定要先释放图片,再进行去除,否则缩略图文件将被锁死,不好删除和更新;
KCG_ConLIstIT[a].Image=null)
KL_BDN=lcl_SUCaiSel.KC_MB.selection as array
KL_DelPB=for m in KL_BDN collect KL_F2[m]
for tt in KL_DelPB do(KL_P1=filterString tt "\\"
KL_PPmg=KGL_MankPathInI+KL_F1+KL_P1[KL_P1.count]+"\\"
KHF_DeleteNestFile KL_PPmg
delIniSetting KGL_MankPathInIFile KL_F1 tt)
try(gc())catch()
setINISetting KGL_MankPathInIFile "akoo2011" KGL_ResTaNTypeXH[KL_F3] "1"
KC_MB.selection=#()
DestroyDialog lcl_SUCaiSel
KLF_FillRootTree())
on lcl_SUCaiSel rbuttondown xs do DestroyDialog lcl_SUCaiSel)
CreateDialog lcl_SUCaiSel width:500))
on KC_FP2 entered do
(if KC_FP2.value!=KG_ModeBankLS do
(KG_ModeBankLS=KC_FP2.value
setINISetting KGL_MankPathInIFile "akoo2011" "MoBaSPeeLNum" (KG_ModeBankLS as string)
KG_ModeBankPS=1
try(DestroyDialog KR_MaterialBankSet)catch()
try(KL_vvv=(GetDialogPos KR_MoBankTVRoll3)[2]
cui.UnRegisterDialogBar KR_MoBankTVRoll3
DestroyDialog KR_MoBankTVRoll3
global KGL_ToolVBM=(KL_vvv-83)as Integer)catch()
KGLH_AKHeight=((getMAXWindowSize())[2]-746-KGL_ToolVBM)as Integer
if KGLH_AKHeight<0 do KGLH_AKHeight=0
global KGLH_AKHeightNumber=10+(KGLH_AKHeight/56)    ----最大列数量
global KGL_AKHeitNum2=22+(KGLH_AKHeight/23)    ----最大列数量
KL_Asdfgh=26                                        ----列块起始Y点坐标
KL_hgfdsa=91                                        ----行块起始X点坐标   
KL_hgfdsa2=129                                       ----行块起始X点坐标                                  
global KGLH_AKHeightArray=for jj=0 to 67 collect [(KL_hgfdsa+((jj/KGLH_AKHeightNumber)*56)),(KL_Asdfgh+(((mod jj KGLH_AKHeightNumber)as Integer)*56))]
global KGLH_AKHeightArray2=for jj=0 to 67 collect [(KL_hgfdsa2+((jj/KGLH_AKHeightNumber)*56)),(KL_Asdfgh+(((mod jj KGLH_AKHeightNumber)as Integer)*56))]
createDialog KR_MoBankTVRoll3 (90+(KG_KongJKG2*KG_ModeBankLS)) 2000 pos:[3000,200] style:#(#style_border,#style_sunkenedge)  
cui.RegisterDialogBar KR_MoBankTVRoll3 style:#(#cui_dock_left) 
cui.DockDialogBar KR_MoBankTVRoll3 #cui_dock_left))
fn KL_PNQieHuan aa=
(if classof KGL_ModeBanKNodeLI==Array do(KL_CC1=(ceil(KGL_ModeBanKNodeLI.count/(KGLH_AKHeightNumber*1.0*KG_ModeBankLS)))as Integer  ---获得屏数;
if (KG_ModeBankPS+aa)>0 and (KG_ModeBankPS+aa)<=KL_CC1 do(KG_ModeBankPS+=aa
KLF_FillRootTree())))
on KC_bta1 pressed do(KL_PNQieHuan -1)
on KC_bta2 pressed do(KL_PNQieHuan 1)	

rollout NodeSIGIFNBitShow "阿酷素材资源预览窗口" width:404 height:404   ---预览窗口控件,这里并不需要动作,而是通过函数外部来打开面板和更新控件内容;
(button KC_IT57 pos:[2,2]  width:400 height:400 
---dotNetControl KC_IT57 "PictureBox" pos:[2,2]  width:400 height:400   ---这里该用图片盒控件模式,用来提高精度和自动缩放,不用原来的复制模式,减轻负担;
----dotNetControl KC_IT57  "Button" pos:[2,2]  width:400 height:400
timer KL_MMP interval:200 active:false    ----时间控件用来缓冲关闭,不至于在不用图像控件之间移动的时候开关频繁(足够快的话就不开关了)
on KL_MMP tick do(----NodeSIGIFNBitShow.KC_IT57.Image=Dispose
DestroyDialog NodeSIGIFNBitShow)
on NodeSIGIFNBitShow close do(KGL_MuteBitmap=true
KL_MMP.active=false
freeSceneBitmaps())
on NodeSIGIFNBitShow open do(---NodeSIGIFNBitShow.KC_IT57.sizemode=(dotNetClass "System.Windows.Forms.PictureBoxSizeMode").Zoom   ----非常完美,缩放至刚好需要的大小;
KGL_MuteBitmap=false))   

fn KCR_NodeBitClose zz=(if zz then(---NodeSIGIFNBitShow.KC_IT57.Image=Dispose
try(DestroyDialog NodeSIGIFNBitShow)catch())
else if not KGL_MuteBitmap do NodeSIGIFNBitShow.KL_MMP.active=true)		

fn KCR_NodeSIGIFNBit aaa=             ----鼠标覆盖素材节点控件时的动作处理函数;参数1:aaa,输入当前素材控件的序号数;
(KL_FBI=getINISetting KGL_MankPathInIFile "akoo2011" "SUCAIType_M"   ----当前素材库类型;
KL_SCTyN=findItem KGL_ResPaterType KL_FBI                           ----当前素材库编号;用来获取当前根路径序号的标题名;
KL_MMT2=(getINISetting KGL_MankPathInIFile "akoo2011" KGL_ResTaNTypeXH[KL_SCTyN])as integer      ---获得当前库类型的上次根路径序号;
KGP_ModePathlib=getINISetting KGL_MankPathInIFile KL_FBI          ----取得当前库的所有已登记路径对象;
if KGL_ModeBanKNodeLI!=undefined do                 ----如果当前预览模式为开启状态,且素材节点数组不为空;
(KL_PP1X=aaa+((KGLH_AKHeightNumber*KG_ModeBankLS)*(KG_ModeBankPS-1))      ----当前真正素材节点序号数;
if doesFileExist KGL_ModeBanKNodeLI[KL_PP1X]do 
(KL_Pathaa=filterString KGL_MankPathInI "\\:"                        ----取得素材库根路径的分解数组;
KL_PathDD=filterString KGL_ModeBanKNodeLI[KL_PP1X] "\\:"            ----取得当前缩略图节点的分解数组;
for Vg=(KL_Pathaa.count+4)to KL_PathDD.count do KL_PathDD[(KL_Pathaa.count+3)]+=("\\"+KL_PathDD[Vg])	    ----组拼出可能存在的支路径部分对象和素材名;
KL_VV1=getFilenameFile KGL_ModeBanKNodeLI[KL_PP1X]        ----取得该数位节点的名字部分; 
KL_TruePath=KGP_ModePathlib[KL_MMT2]+KL_PathDD[(KL_Pathaa.count+3)]   ---取得当前素材节点对象的真正完整路径名;
kl_B1=KL_PP1X as string
kl_B1=replace "000" (4-kl_B1.count) kl_B1.count kl_B1
case KL_SCTyN of 
(
1:(pushPrompt ("当前素材:["+kl_B1+"]"+(getFilenameFile KL_TruePath)+".max"))  ---这里不管预览窗口,总是实时指示当前素材节点信息	
2:(pushPrompt ("当前素材:["+kl_B1+"]"+(getFilenameFile KL_TruePath)))  ---这里不管预览窗口,总是实时指示当前素材节点信息	
3:(KL_PPP=getFiles((getFilenamePath KL_TruePath)+KL_VV1+".*")    --- 收集符合真实素材条件的所有文件(仅扩展名不同)
KL_PPPXX=for m in KL_PPP where findItem KGM_BitmapFormat(KHF_StringUpperL(getFilenameType m))!=0 collect m   ----进一步过滤收集图像格式的目标文件集;
if KL_PPPXX.count>0 then KL_MUbiaoMax=KL_PPPXX[1]  
else KL_MUbiaoMax=""                 ---如果有,则赋值,否则赋空值;
if doesFileExist KL_MUbiaoMax do pushPrompt ("当前素材:["+kl_B1+"]"+(getFilenameFile KL_MUbiaoMax)+(getFilenameType KL_MUbiaoMax)))  ---这里不管预览窗口,总是实时指示当前素材节点信息	   
)
if KG_MatRESEPrevier do
(case KL_SCTyN of 
(
1:(KL_Tpfile=(getFilenamePath KL_TruePath)+(getFilenameFile KGL_ModeBanKNodeLI[KL_PP1X])+".jpg"   ---优先加载jpg大样图;
if not(doesFileExist KL_Tpfile)do KL_Tpfile=(getFilenamePath KL_TruePath)+(getFilenameFile KGL_ModeBanKNodeLI[KL_PP1X])+".bmp") ---jpg大样不存在的情况下再尝试加载bmp大样图
2:(KL_Tpfile=(getFilenamePath KL_TruePath)+(getFilenameFile KGL_ModeBanKNodeLI[KL_PP1X])+".jpg"
if not(doesFileExist KL_Tpfile)do KL_Tpfile=(getFilenamePath KL_TruePath)+(getFilenameFile KGL_ModeBanKNodeLI[KL_PP1X])+".bmp")  
3:(Kl_Objfi=getFiles((getFilenamePath KL_TruePath)+(getFilenameFile KGL_ModeBanKNodeLI[KL_PP1X])+".*") 
KL_Tpfileold=for m in Kl_Objfi where findItem KGM_BitmapFormat(KHF_StringUpperL(getFilenameType m))!=0 collect m
if KL_Tpfileold.count>0 then KL_Tpfile=KL_Tpfileold[1]
else KL_Tpfile="")
)
if doesFileExist KL_Tpfile do
(try(KGL_PPJHBit=openBitMap KL_Tpfile)catch(KGL_PPJHBit=undefined)   ---如果小样图内容加载有效;
if KGL_PPJHBit!=undefined 
then(freeSceneBitmaps()
NodeSIGIFNBitShow.KL_MMP.active=false
KL_DJYQL=mouse.screenpos              ----如果有效,则首先取得当前鼠标位置值;
KL_DJYQG=getMAXWindowSize()           ----获得Max窗口大小;
if KL_DJYQL[2]<175 do KL_DJYQL[2]=175   ----钳位当前鼠标位置的Y值最小值,避免预览窗口钻出屏幕;
if KL_DJYQL[2]>(KL_DJYQG[2]-320)do KL_DJYQL[2]=(KL_DJYQG[2]-320)  ----钳位当前鼠标位置的Y值最大值,避免预览窗口落出屏幕;
KL_DJYQL+=[55,-150]				   ----求得预览窗口即将出现在屏幕上的位置;	    
if KGL_MuteBitmap then CreateDialog NodeSIGIFNBitShow pos:KL_DJYQL  ---如果当前未预览,则开始预览窗口;
else SetDialogPos NodeSIGIFNBitShow KL_DJYQL
if KGL_PPJHBit.width>KGL_PPJHBit.height then(KL_VV1B=400
KL_VV2B=(KGL_PPJHBit.height*1.0/KGL_PPJHBit.width)*400)
else(KL_VV2B=400
KL_VV1B=400/(KGL_PPJHBit.height*1.0/KGL_PPJHBit.width))           
KL_Ca2=bitmap KL_VV1B KL_VV2B
copy KGL_PPJHBit KL_Ca2
NodeSIGIFNBitShow.KC_IT57.images=#(KL_Ca2,(bitmap 400 400 color:white),1,1,1,1,1,true))
--NodeSIGIFNBitShow.KC_IT57.Image=Dispose
--NodeSIGIFNBitShow.KC_IT57.Image=(dotNetClass "System.Drawing.Image").FromFile(dotNetObject"System.String" KL_Tpfile)
--NodeSIGIFNBitShow.KC_IT57.Image=FromFile(dotNetObject"System.String" KL_Tpfile)
---- catch(NodeSIGIFNBitShow.KC_IT57.Text=(dotNetObject"System.String" "图片异常,不能预览!"))  ---加载图片内容;
---NodeSIGIFNBitShow.KC_IT57.bitmap=openBitMap KL_Tpfile
else KCR_NodeBitClose false)))))
fn KL_NeibuFNObj ZZ XX cc=    ----调用材质库函数:两个参数:1:ZZ.材质场景文件名;2:XX.材质场景对象名,3:cc.同名材质处理选项;
( KL_Coll1=#()
KL_Coll2=#()
KL_Coll3=#()
KL_Coll4=#()
KL_Coll5=#()  
KL_MergMat=undefined              ----初始化定义并入材质;
KL_MergModify=#()           ----初始化定义并入材质的修改器;
KL_Onff=#()
aa=objects.count
undo "赋材质" on(if(matchPattern ZZ pattern:"*.mat.*")then(mergeMAXFile ZZ #(XX) #mergeDups cc quiet:true
Kl_GuoK=objects[objects.count]
if objects.count-aa>0 and Kl_GuoK.material!=undefined do(KL_MergMat=copy Kl_GuoK.material
KL_MergModify=join #() Kl_GuoK.modifiers)
delete Kl_GuoK)	
else(KL_Onff=loadTempMaterialLibrary ZZ
if KL_Onff!=undefined and KL_Onff.count!=0 do for mm in KL_Onff where mm.name==XX do KL_MergMat=mm)
if KL_MergMat!=undefined  
then(setWaitCursor()                        
if keyboard.shiftPressed and keyboard.controlPressed and MatEditor.isOpen()             ---如果Ctrl+Shift键同时按下;并且材质编辑器开着的情况下;
then(KL_MatAR=getMeditMaterial(medit.GetActiveMtlSlot())     ---获得材质编辑器当前激活材质球
for m in objects where kugegeoFilt m and m.material==KL_MatAR do(m.material=KL_MergMat
m.name=KL_MergMat.name)   ----搜索场景所有该材质对象进行附材质和同步改名字;
setMeditMaterial(medit.GetActiveMtlSlot())KL_MergMat  ----更换这个材质到材质编辑器激活埠口;
medit.UpdateMtlEditorBrackets())
else if keyboard.controlPressed and not keyboard.altPressed    ---仅按住Ctrl键仅用来将该材质加载到材质编辑器激活埠口;
then (setMeditMaterial(medit.GetActiveMtlSlot())KL_MergMat
medit.UpdateMtlEditorBrackets())
else if keyboard.shiftPressed and not keyboard.altPressed     ----如果仅按住Shift键,将置换选择对象的场景材质;
then(KL_MatAR=#()
for nn in selection where kugegeoFilt nn and nn.material!=undefined and findItem KL_MatAR nn.material==0 do append KL_MatAR nn.material	---收集选择对象的所有材质;    
for m in objects where kugegeoFilt m and findItem KL_MatAR m.material!=0 do(m.material=KL_MergMat
m.name=KL_MergMat.name))
else if keyboard.altPressed then(if(matchPattern ZZ pattern:"*.mat.*")then ShellLaunch("\""+((GetDir #maxroot)+"3dsmax.exe")+"\"")("\""+ZZ+"\"")
else(loadMaterialLibrary ZZ
mtlBrowser.browseFrom #mtlLibrary))
else(if getCommandPanelTaskMode()!=#create do setCommandPanelTaskMode mode:#create
for m in selection where kugegeoFilt m do(m.material=KL_MergMat
m.name=KL_MergMat.name)
KL_MergModify=for jh in KL_MergModify where findItem KGL_AKOOMapModifyAR jh.classID[1]!=0	collect jh		----过滤非贴图坐标修改器;
KL_CCCG=KL_MergModify.count
if KL_CCCG>0 do
(if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify
KL_FFy=modPanel.getCurrentObject()		
if KL_FFy==undefined or findItem KGL_AKOOMapModifyAR KL_FFy.classID[1]==0 do for uu=1 to KL_CCCG do modPanel.addModToSelection KL_MergModify[(KL_CCCG+1-uu)]))
setArrowCursor()
KM_MoKUthA1=getINISetting AK_INIT_File "MaterialBankSet" "KR_MatBankPath1"
KM_MoKUthA2=getINISetting AK_INIT_File "MaterialBankSet" "KR_MatBankPath2"
KM_MoKUthA3=getINISetting AK_INIT_File "MaterialBankSet" "KR_MatBankPath3" 
if KM_MoKUthA1!="" do KM_MoKUthA1+="\\"
if KM_MoKUthA2!="" do KM_MoKUthA2+="\\"
if KM_MoKUthA3!="" do KM_MoKUthA3+="\\"                                     -----依次获得和修复三个预定义的资源搜索路径;
NF_Render_SceneBitMan KR_MoBankTVRoll3.KL_AAA1 (selection as array) #(KL_Coll1,KL_Coll2,KL_Coll3,KL_Coll4,KL_Coll5) #()   ---自动集合装入模型的所有引用资源;
KL_CFH=KL_Coll1.count
KL_BDNGG=for GH=1 to KL_CFH collect GH           -----收集处理成员的序号数组(所有的);
if KL_BDNGG.count>0 do KHF_SertchFN KL_Coll1 KL_Coll2 KL_Coll3 KR_MoBankTVRoll3.KL_AAA1 #((getFilenamePath ZZ),KM_MoKUthA1,KM_MoKUthA2,KM_MoKUthA3) KL_BDNGG false  ----搜索指定处理;	  
showTextureMap KL_MergMat on)
else messageBox "调入材质球无效,请检查源文件版本和文件场景以及源材质!" title:"阿酷素材库管理--阿酷提示"))


-----3.5OK
fn KCR_NodeSIGIFN aa=                 -----图样控件响应函数;参数1:aa.对应控件序号数
(global KGL_GronoffNmae,KL_A11
KL_Coll1=#()
KL_Coll2=#()
KL_Coll3=#()
KL_Coll4=#()
KL_Coll5=#()  
KCR_NodeBitClose true               ----按下图像控件时首先需要关闭可能存在的预览窗口;
KL_FBI=getINISetting KGL_MankPathInIFile "akoo2011" "SUCAIType_M"    ----获得当前素材库类型;
KL_SCTyN=findItem KGL_ResPaterType KL_FBI                               ----获得当前素材库序号数(获取对应激活序号数值用);
KL_MMT2=(getINISetting KGL_MankPathInIFile "akoo2011" KGL_ResTaNTypeXH[KL_SCTyN])as integer      ---获得当前库类型的上次根路径序号;
KGP_ModePathlib=getINISetting KGL_MankPathInIFile KL_FBI          ----取得当前库的所有已登记路径对象;
try(DestroyDialog NodeSIGIFNBitShow)catch()                        ----尝试关闭可能打开着的小样预览窗口;
KL_PP1X=aa+((KGLH_AKHeightNumber*KG_ModeBankLS)*(KG_ModeBankPS-1))    -----算出当前控件真正的节点数位;
if doesFileExist KGL_ModeBanKNodeLI[KL_PP1X] do               ----如果该数位节点对象真正存在;
(KL_Pathaa=filterString KGL_MankPathInI "\\:"
KL_PathDD=filterString KGL_ModeBanKNodeLI[KL_PP1X] "\\:"
for Vg=(KL_Pathaa.count+4)to KL_PathDD.count do KL_PathDD[(KL_Pathaa.count+3)]+=("\\"+KL_PathDD[Vg])
KL_VV1=getFilenameFile KGL_ModeBanKNodeLI[KL_PP1X]        ----取得该数位节点的名字部分;
KL_TruePath=KGP_ModePathlib[KL_MMT2]+KL_PathDD[(KL_Pathaa.count+3)]          ----还原出真是的大样图路径;
case KL_SCTyN of
(
1:(KL_MUbiaoMax=(getFilenamePath KL_TruePath)+KL_VV1+".max"                      ----合成出真正素材源文件的节点对象;
if doesFileExist KL_MUbiaoMax                                                  ----检测是否存在配套的MAX文件;如果存在,继续深入处理;
then if keyboard.altPressed 
then(ShellLaunch("\""+((GetDir #maxroot)+"3dsmax.exe")+"\"")("\""+KL_MUbiaoMax+"\""))
else(setWaitCursor()
thawSelection()
clearSelection()       ----退出当前选择状态,设置光标为等待状态;
undo off(mergeMAXFile KL_MUbiaoMax #mergeDups #select #useSceneMtlDups quiet:true 
KL_DelObj=for ll in selection where SuperClassOf ll==camera or SuperClassOf ll==light or classof ll==Targetobject collect ll
if KL_DelObj.count!=selection.count do delete KL_DelObj
for gf in selection do(if gf.wireColor==(color 0 0 0) do gf.wireColor=random (color 15 15 15) (color 240 240 240)  ----防止导入的素材线框全黑看不见
if isOpenGroupHead gf do setGroupOpen gf false)   ----保证关闭所有打开着的组头;
KL_GroCt=for m in selection where not(isGroupMember m)collect m    ----统计独立物体个数(组头,不是组成员的对象),单个情况就不需要结组处理了;
if KL_GroCt.count>1 then KGL_GronoffNmae=group selection name:KL_VV1 select:true   ----保证选中的组合组头
else KGL_GronoffNmae=selection[1]
KHF_ProxyScale KGL_GronoffNmae)  ----并入模型素材并保持选中状态;
if selection.count>0                                                                   ----如果导入有效,继续进行操作;
then(KM_MoKUthA1=getINISetting AK_INIT_File "MaterialBankSet" "KR_MatBankPath1"
KM_MoKUthA2=getINISetting AK_INIT_File "MaterialBankSet" "KR_MatBankPath2"
KM_MoKUthA3=getINISetting AK_INIT_File "MaterialBankSet" "KR_MatBankPath3" 
if KM_MoKUthA1!="" do KM_MoKUthA1+="\\"
if KM_MoKUthA2!="" do KM_MoKUthA2+="\\"
if KM_MoKUthA3!="" do KM_MoKUthA3+="\\"                                     -----依次获得和修复三个预定义的资源搜索路径;
NF_Render_SceneBitMan KR_MoBankTVRoll3.KL_AAA1 (selection as array) #(KL_Coll1,KL_Coll2,KL_Coll3,KL_Coll4,KL_Coll5) #()   ---自动集合装入模型的所有引用资源;
KL_CFH=KL_Coll1.count
KL_BDNGG=for GH=1 to KL_CFH collect GH           -----收集处理成员的序号数组(所有的);
if KL_BDNGG.count>0 do KHF_SertchFN KL_Coll1 KL_Coll2 KL_Coll3 KR_MoBankTVRoll3.KL_AAA1 #((getFilenamePath KL_MUbiaoMax),KM_MoKUthA1,KM_MoKUthA2,KM_MoKUthA3) KL_BDNGG false  ----搜索指定处理;
snapMode.active=false   ----为了置入性能,总是关闭捕捉模式;
setArrowCursor()
startTool KHTOOL_ModMerTools)
else messageBox "并入模型素材无效,,请核对文件版本和对应图层是否关闭!" title:"阿酷素材库管理--阿酷提示"
setArrowCursor())           ------恢复光标状态;
else messageBox "模型库对应文件访问无效,请检查路径和文件是否存在!" title:"阿酷素材库管理--阿酷提示")
2:(if selection.count>0 do
(KL_Once=#()
KL_MatLibLI=#()
KL_MUbiaoMax=(getFilenamePath KL_TruePath)+(filterString KL_VV1 "{}")[1]+".mat.max"  ----取得素材源路径+源名字(分解大括号里面的第一部分)+".mat.max"
if doesFileExist KL_MUbiaoMax then KL_Once=getMAXFileObjectNames KL_MUbiaoMax quiet:true 
else(KL_MUbiaoMax=(getFilenamePath KL_TruePath)+(filterString KL_VV1 "{}")[1]+".mat"  
if doesFileExist KL_MUbiaoMax do(KL_MatLibLI=loadTempMaterialLibrary KL_MUbiaoMax
if KL_MatLibLI!=undefined and KL_MatLibLI.count!=0 do KL_Once=for tt in KL_MatLibLI collect tt.name))
KL_MUbiaoname=(filterString KL_VV1 "{}")[2]      ----取得当前材质对象名字(也即材质素材名字);
if doesFileExist KL_MUbiaoMax and(findItem KL_Once KL_MUbiaoname)!=0     -----必须存在材质场景和该场景存在该材质场景对象(对应该材质的存在);                                     
then(KL_SceneMatobj=#()         ----场景所有材质的名字集合
KL_SceneMat=#()            ----场景所有材质集合(根据材质名字的多维数组);
for m in objects where kugegeoFilt m and m.material!=undefined and not m.isSelected do 
if(KL_ppu=findItem KL_SceneMat m.material.name)==0 then(append KL_SceneMat m.material.name
append KL_SceneMatobj #(m.material))
else append KL_SceneMatobj[KL_ppu] m.material  ---依次检测和收集场景材质名字和对应的材质对象多维数组;
KL_CVF=KL_SceneMat.count
KL_CCMatOBJ=for m=1 to KL_CVF where KL_SceneMat[m]==KL_MUbiaoname collect KL_SceneMatobj[m]    ----收集所有与即将并入对象同名的场景对象材质;
if KL_CCMatOBJ.count>0 
then(rollout lcl_DuNameJG "材质名冲突!"
(button KC_MB1 "使用并入材质" width:100 pos:[5,5]
button KC_MB2 "使用场景材质" width:100 pos:[5,30]
button KC_MB3 "重命名场景材质" width:100 pos:[5,55]
on KC_MB1 pressed do(DestroyDialog lcl_DuNameJG
KL_NeibuFNObj KL_MUbiaoMax KL_MUbiaoname #useMergedMtlDups)
on KC_MB2 pressed do(DestroyDialog lcl_DuNameJG
KL_NeibuFNObj  KL_MUbiaoMax KL_MUbiaoname #useSceneMtlDups)
on KC_MB3 pressed do(DestroyDialog lcl_DuNameJG
KL_MMM=1
kl_NM=KL_MUbiaoname+(KL_MMM as string)
while findItem KL_SceneMat kl_NM!=0 do(KL_MMM+=1
kl_NM=KL_MUbiaoname+(KL_MMM as string))
for u in KL_CCMatOBJ do for uu in u do uu.name=kl_NM
KL_NeibuFNObj  KL_MUbiaoMax KL_MUbiaoname #useMergedMtlDups))
CreateDialog lcl_DuNameJG width:110 pos:[mouse.screenpos.x,mouse.screenpos.y])
else KL_NeibuFNObj  KL_MUbiaoMax KL_MUbiaoname #useMergedMtlDups)
else messageBox "材质库对应MAX文件访问无效,核对文件版本和检查路径文件是否存在!" title:"阿酷素材库管理--阿酷提示"))
3:(KL_PPP=getFiles((getFilenamePath KL_TruePath)+KL_VV1+".*")    --- 收集符合真实素材条件的所有文件(仅扩展名不同)
KL_PPPXX=for m in KL_PPP where findItem KGM_BitmapFormat(KHF_StringUpperL(getFilenameType m))!=0 collect m   ----进一步过滤收集图像格式的目标文件集;
if KL_PPPXX.count>0 then KL_MUbiaoMax=KL_PPPXX[1]  
else KL_MUbiaoMax=""                 ---如果有,则赋值,否则赋空值;
if doesFileExist KL_MUbiaoMax               ----如果存在目标贴图素材文件,则继续进行操作
then if keyboard.altPressed then(KL_pshop=CreateOLEObject"Photoshop.Application" 
KL_pshop.Visible=true
KL_pshop.open KL_MUbiaoMax)
else undo on(KL_MatARA=#()
KL_MatARB=#()      
KF_SceneUnitsJC()	
kugeVW=(((getINISetting AK_INIT_File "akoo2011" "KUGEUVWmapSIZE") as Integer)*Syun) 
KL_A11=uvwmap maptype:4 length:kugeVW width:kugeVW height:kugeVW	
if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify   				
if keyboard.controlPressed and MatEditor.isOpen()                -----收集可能的材质编辑器激活材质或当前选择对象的材质;
then append KL_MatARA meditMaterials[activeMeditSlot]
else for nn in selection where isProperty nn "material" and nn.material!=undefined and findItem KL_MatARA nn.material==0 do append KL_MatARA nn.material
join KL_MatARB KL_MatARA
for m in KL_MatARA do KHF_SubMatColl KL_MatARB m                       -----迭代处理收集所有可能包含的嵌套子材质;
if KL_MatARB.count==0 do(KL_NewBit=standardMaterial diffuseMap:(BitmapTexture filename:KL_MUbiaoMax name:(uniqueName "Map#")) name:(getFilenameFile KL_MUbiaoMax)
for nn in selection where isProperty nn "material" do(nn.material=KL_NewBit
nn.name=KL_NewBit.name)
if not(keyboard.controlPressed and MatEditor.isOpen())do if modPanel.validModifier KL_A11 do modPanel.addModToSelection KL_A11
KL_MatARB=#(KL_NewBit))
KL_newport=KL_MatARB.count
for r=1 to KL_newport do(KL_XXH=getNumSubTexmaps KL_MatARB[r]
for jA=1 to KL_XXH do(kugeA=getSubTexmap KL_MatARB[r] jA    ----对每一材质的子贴图通道进行检测和收集;
KHF_CollToArray kugeA KL_Coll1 KL_Coll2 KL_Coll3 KL_Coll4 "MAT  " KL_MatARB[r] jA false))
KL_AAA1.value=0
case of                                                                ----根据各种情况进行一一处理;
(
(KL_Coll1.count==1):    ----如果仅引用了一个图片文件,则直接替换这个图片文件,
(KL_Ont=KL_Coll3.count
for u=1 to KL_Ont do for ff in KL_Coll3[u] do (KL_ONoff=getSubTexmap ff[1] ff[2]
setProperty KL_ONoff "filename" KL_MUbiaoMax
KL_On3=refs.dependents KL_ONoff
KL_PPPm=for m in KL_On3 where SuperClassOf m==material collect m
for mg in KL_PPPm do showTextureMap mg KL_ONoff on))
(KL_Coll1.count>1):       ----如果引用了多个图片文件,则统计其贴图对象,罗列出来,选中需要替换的贴图对象进行替换(取代其文件名)
(global KGL_ObjAr=#()
global KGL_ObjStrAr=#()
for pp in KL_Coll3 do for ll in pp do 
(KL_BBB=getSubTexmap ll[1] ll[2]
KL_Ewf=(getFilenameFile KL_BBB.filename)+(getFilenameType KL_BBB.filename)
if(KL_DDD=findItem KGL_ObjAr KL_BBB)==0 
then(append KGL_ObjAr KL_BBB    ----根据资源收集到的父对象+通道序号信息转换出
append KGL_ObjStrAr (KL_BBB.name+"  "+KL_Ewf+"  \""+ll[1].name+"\"["+(getSubTexmapSlotName ll[1] ll[2])+"]"))
else KGL_ObjStrAr[KL_DDD]+="  \""+ll[1].name+"\"["+(getSubTexmapSlotName ll[1] ll[2])+"]")
if KGL_ObjAr.count>0 do
(rollout lcl_SUCaiFileTH "选择替换贴图通道"
(MultiListBox KC_MB items:KGL_ObjStrAr height:KGL_ObjStrAr.count
button KC_MB1 "替换选择贴图通道"
on KC_MB1 pressed do(KL_BDN=KC_MB.selection as array
for m in KL_BDN do ---undo on
(setProperty KGL_ObjAr[m] "filename" KL_MUbiaoMax                ----设置其文件名属性;
KL_On3=refs.dependents KGL_ObjAr[m]                       ----统计所有引用对象
KL_PPPm=for m in KL_On3 where SuperClassOf m==material collect m   ----引出所有关系材质
for mg in KL_PPPm do showTextureMap mg KGL_ObjAr[m] on)  ---显示每材质的对应贴图对象(实时显示)
KC_MB.selection=#()
DestroyDialog lcl_SUCaiFileTH)
on lcl_SUCaiFileTH rbuttondown xs do DestroyDialog lcl_SUCaiFileTH)
CreateDialog lcl_SUCaiFileTH width:500 pos:[mouse.screenpos.x,mouse.screenpos.y]))
(KL_Coll1.count==0):
(global KL_OP1=#()
global KL_OP2=#()
for m in KL_MatARB do(KL_Onc=getNumSubTexmaps m
for t=1 to KL_Onc do(KL_ASD=getSubTexmapSlotName m t
if KL_ASD!=""do if(KL_TTT=findItem KL_OP1 KL_ASD)==0 then(append KL_OP1 KL_ASD
append KL_OP2 #(#(m,t)))
else append KL_OP2[KL_TTT] #(m,t))) ---集合所有贴图通道对象,待分析
if KL_OP1.count>0 do
(global KGL_GoBitTextSI=BitmapTexture filename:KL_MUbiaoMax name:(uniqueName "Map#")
rollout lcl_SUCaiBitTH "选择目标贴图通道"
(MultiListBox KC_MB items:KL_OP1 height:KL_OP1.count
button KC_MB1 "赋给选择贴图通道"
on KC_MB1 pressed do(KL_BDN=KC_MB.selection as array
if KL_BDN.count>0 do (if not(keyboard.controlPressed and MatEditor.isOpen())do if modPanel.validModifier KL_A11 do modPanel.addModToSelection KL_A11
for m in KL_BDN do for n in KL_OP2[m] do(setSubTexmap n[1] n[2] KGL_GoBitTextSI
KL_On3=refs.dependents KGL_GoBitTextSI
KL_PPPm=for m in KL_On3 where SuperClassOf m==material collect m
for m in KL_PPPm do showTextureMap m on))
KC_MB.selection=#()
DestroyDialog lcl_SUCaiBitTH)
on lcl_SUCaiBitTH rbuttondown xs do DestroyDialog lcl_SUCaiBitTH)
CreateDialog lcl_SUCaiBitTH width:220 pos:[mouse.screenpos.x,mouse.screenpos.y]))
)	
)
else messageBox "贴图库对应文件访问无效,请检查路径和文件是否存在!" title:"阿酷素材库管理--阿酷提示")
)
))



