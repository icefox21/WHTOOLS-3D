KRFL_PSLapp1JG=(timeStamp())/1000)
else if KL_Lapp2>=600 and KR_PSSCZSGCOK do(if KR_PSSCZSGCOK do if not(KC_CV104.checked and KC_CV104.enabled)do messageBox "Photoshop处理过程被取消或停止响应!" title:"阿酷渲染流程配置警告--阿酷提示"
append KReF_RendOKARFKUI #("PS合成时出现异常,这一步骤有被跳过:",((timeStamp())/1000)) 
KF_KFAfterPro false)
else(KGC_PStimeLb3.active=false
renameFile KL_GGG1 KL_GGG2
if KR_PSSCZSGCOK do KF_KFAfterPro true))
else(if KL_Lapp2>=60 and KR_PSSCZSGCOK do(if not(KC_CV104.checked and KC_CV104.enabled)do messageBox "Photoshop软件未能正常启动,请检查相关设置!" title:"阿酷渲染流程配置警告--阿酷提示"
append KReF_RendOKARFKUI #("PS合成时出现异常,这一步骤有被跳过:",((timeStamp())/1000)) 
