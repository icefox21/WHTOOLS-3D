KC_DL11X.text="对象层选择"
KC_ET14.text=""
KC_CB13.checked=false
KC_OutBack1.text=getFilenamePath rendOutputFilename
KC_CB18X.enabled=KG_SirenFileExist
KC_CB22.enabled=(KC_ET21.text!="" and(for m in(filterString KC_ET21.text ",")where findString m "@"==undefined or findString m "."==undefined collect m).count==0))
on KC_CB17X1 pressed do
(setINISetting (getMAXIniFile()) "akoo2009" "RendSampRO2" "1"
KG_KCRenA1=KC_RenA1.checked=true
setINISetting (getMAXIniFile()) "akoo2009" "KG_KCRenA4" "2"
KG_KCRenA4=KC_RenA4.selection=2
setINISetting (getMAXIniFile()) "akoo2009" "KG_KCRenA6" "3"
KG_KCRenA6=KC_RenA6.selection=3                                  -----IM预设选择控件
setINISetting (getMAXIniFile()) "akoo2009" "RendSampR40" "45"
KG_KCRenA7=KC_RenA7.value=45                                     -----IM细分值控件
setINISetting (getMAXIniFile()) "akoo2009" "RendSaRenA7F" "1200"
KG_KCRenA7F=KC_RenA7F.value=1200                                 -----LC细分值控件
setINISetting (getMAXIniFile()) "akoo2009" "RendSampR46" "0.6"
KG_KCRenA11=KC_RenA11.value=0.6                                   ----环境亮度控件;
setINISetting (getMAXIniFile()) "akoo2009" "RendSampR47" "1"
setINISetting (getMAXIniFile()) "akoo2009" "RendSampR48" "2"
KG_KCRenA12=KC_RenA12.checked=true
KG_KCRenA13=KC_RenA13.value=2
setINISetting (getMAXIniFile()) "akoo2009" "KG_KCRenC1" "1.0"
KG_KCRenC1=KC_RenC1.value=1.0
setINISetting (getMAXIniFile()) "akoo2009" "RendSampR45" "(color 204 229 255)"
KG_KCCP2=KC_CP2.color=(color 204 229 255)
setINISetting (getMAXIniFile()) "akoo2009" "KG_KCCP3" "0.9"
KG_KCCP3=KC_CP3.value=0.9                                         ----主光源亮度控件
setINISetting (getMAXIniFile()) "akoo2009" "KG_AKfilteron" "1"
setINISetting (getMAXIniFile()) "akoo2009" "KG_AKrefRefon" "1"
setINISetting (getMAXIniFile()) "akoo2009" "KG_AKglossyEffon" "1"
KG_AKfilteron=KG_AKrefRefon=KG_AKglossyEffon=KC_RenB1.checked=KC_RenB2.checked=KC_RenB3.checked=true
setINISetting (getMAXIniFile()) "akoo2009" "RendSampRO1" "3.0"
setINISetting (getMAXIniFile()) "akoo2009" "RendSampR53" "1.0"
R_S_GO1=KC_SN31.value=3.0                        -----预渲光子图大小;
R_S_G53=KC_SN53.value=1.0)
------这里开始为四个模版设置按钮;
on KC_RenA15 pressed do
(setINISetting (getMAXIniFile()) "akoo2009" "KG_KCRenA4" "1"
KG_KCRenA4=KC_RenA4.selection=1
setINISetting (getMAXIniFile()) "akoo2009" "KG_KCRenA6" "1"
KG_KCRenA6=KC_RenA6.selection=1
setINISetting (getMAXIniFile()) "akoo2009" "RendSampR40" "35"
KG_KCRenA7=KC_RenA7.value=35
setINISetting (getMAXIniFile()) "akoo2009" "RendSaRenA7F" "600"
KG_KCRenA7F=KC_RenA7F.value=600)
on KC_RenA16 pressed do
(setINISetting (getMAXIniFile()) "akoo2009" "KG_KCRenA4" "2"
KG_KCRenA4=KC_RenA4.selection=2
setINISetting (getMAXIniFile()) "akoo2009" "KG_KCRenA6" "2"
KG_KCRenA6=KC_RenA6.selection=2
setINISetting (getMAXIniFile()) "akoo2009" "RendSampR40" "40"
KG_KCRenA7=KC_RenA7.value=40
setINISetting (getMAXIniFile()) "akoo2009" "RendSaRenA7F" "900"
KG_KCRenA7F=KC_RenA7F.value=900)
on KC_RenA17 pressed do
(setINISetting (getMAXIniFile()) "akoo2009" "KG_KCRenA4" "2"
KG_KCRenA4=KC_RenA4.selection=2
setINISetting (getMAXIniFile()) "akoo2009" "KG_KCRenA6" "3"
KG_KCRenA6=KC_RenA6.selection=3
setINISetting (getMAXIniFile()) "akoo2009" "RendSampR40" "45"
KG_KCRenA7=KC_RenA7.value=45
setINISetting (getMAXIniFile()) "akoo2009" "RendSaRenA7F" "1200"
KG_KCRenA7F=KC_RenA7F.value=1200)
on KC_RenA18 pressed do
(setINISetting (getMAXIniFile()) "akoo2009" "KG_KCRenA4" "2"
KG_KCRenA4=KC_RenA4.selection=2
