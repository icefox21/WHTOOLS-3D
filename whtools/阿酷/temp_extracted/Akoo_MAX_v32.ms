if hasProperty renderers.current "options_mtl_filterMaps_indirect" do renderers.current.options_mtl_filterMaps_indirect=true
KF_LightStateFN aa true false ""
if hasProperty  (viewport.getCamera()) "exposure" do(KG_CamerasExposVR=(viewport.getCamera()).exposure
(viewport.getCamera()).exposure=false
append KL_ZXCV #((viewport.getCamera()),"exposure",KG_CamerasExposVR))
if hasProperty  (viewport.getCamera()) "vignetting" do(KG_CamerasExposVR=(viewport.getCamera()).vignetting
(viewport.getCamera()).vignetting=false
append KL_ZXCV #((viewport.getCamera()),"vignetting",KG_CamerasExposVR))
KL_ZXCV)
RenderMulCamera=attributes Akooattributes2
(parameters main 
(KP_Mulallow type:#boolean
KP_MulMode type:#string
KP_MulDimen type:#string
KP_MulReg type:#string
KP_MulLightType type:#string
KP_MulLightGro type:#string
KP_MulObjectGro type:#string))
fn KF_MulRenInit aa=
(local KL_MB=(getINISetting (getMAXIniFile()) "akoo2009" "NewCamLightGro")=="1"
if not(isProperty aa "KP_Mulallow")do
(custAttributes.add aa RenderMulCamera
aa.KP_Mulallow=true
if (KL_CMD=getUserProp aa "KUGE_RT")=="blowUp" or KL_CMD=="B" then aa.KP_MulMode="B"
else if KL_CMD=="view" or KL_CMD=="V" then aa.KP_MulMode="V"
else aa.KP_MulMode="C"
if getUserProp aa "KUGE_V"!=undefined then aa.KP_MulDimen=(((getUserProp aa "KUGE_V")as string)+"X"+((getUserProp aa "KUGE_H")as string))
else aa.KP_MulDimen="C"
if (KL_CMD=getUserProp aa "KUGE_BR")!=undefined then aa.KP_MulReg=KL_CMD
else aa.KP_MulReg=""
if KL_MB then aa.KP_MulLightType="A"
else aa.KP_MulLightType="C"
aa.KP_MulLightGro=""
aa.KP_MulObjectGro=""))
fn KR_Render_MulCam_Init=
(KG_RenCamlName=#()
kugeKG_CamYYLI=for pp in cameras where not pp.isTarget collect pp
if kugeKG_CamYYLI.count>0 do
(KG_RenCamlName[kugeKG_CamYYLI.count]=0
for u=1 to kugeKG_CamYYLI.count do
(KF_MulRenInit kugeKG_CamYYLI[u]
if kugeKG_CamYYLI[u].KP_Mulallow then KL_F1="[+]"
else KL_F1="[--]"
KL_F2="["+kugeKG_CamYYLI[u].KP_MulMode+"]"
KL_F3=kugeKG_CamYYLI[u].name
KL_F4="["+kugeKG_CamYYLI[u].KP_MulDimen+"]"
if kugeKG_CamYYLI[u].KP_MulLightType=="A"
then KL_F6="["+"A"+"]"
else if kugeKG_CamYYLI[u].KP_MulLightType=="C" 
then KL_F6="[C]" 
else if (KL_GGGG=kugeKG_CamYYLI[u].KP_MulLightGro)!=undefined and KL_GGGG!=""  then KL_F6="["+KL_GGGG+"]" 
else KL_F6="[C]"
if (KL_GGGG=kugeKG_CamYYLI[u].KP_MulObjectGro)!=undefined and KL_GGGG!=""  then KL_F7="["+KL_GGGG+"]"
else KL_F7="[C]"
KG_RenCamlName[u]=(KL_F1+KL_F2+KL_F3+KL_F4+KL_F6+KL_F7)))
#(kugeKG_CamYYLI,KG_RenCamlName))
fn KF_OBjectsStateFN aa ggg hhh=    ---对象层关闭开启函数,参数1为场景对象状态集合,参数2为true时恢复所有场景对象状态,为false时根据对象层来定义,参数3为对象层名字
(for p=1 to aa[1].count where IsValidNode aa[1][p] do if ggg then aa[1][p].isNodeHidden=aa[2][p]
else(KL_CLname=filterString hhh ","
if findItem KL_CLname aa[1][p].layer.name!=0 then aa[1][p].isNodeHidden=false
else aa[1][p].isNodeHidden=true))
fn KF_CamAutoLIGHT cam1 Llgtype bbb ccc ddd eee start=
(if getCommandPanelTaskMode()!=#create do setCommandPanelTaskMode mode:#create
KF_SceneUnitsJC()
KL_m2=[cam1.target.pos.x,cam1.target.pos.y,0]
KL_CamAbS=(KF_LineABSAngle cam1.target.pos cam1.pos #view_top)as Integer
if KL_CamAbS<0 do KL_CamAbS+=360
if KL_CamAbS>1 and KL_CamAbS<=91 then(KL_Rotare=135
KL_RotareB=45)
else if KL_CamAbS<179 or KL_CamAbS<2 or KL_CamAbS>358 then(KL_Rotare=45
KL_RotareB=135)
else if KL_CamAbS>181 and KL_CamAbS<=271 then(KL_Rotare=315
KL_RotareB=225)
else(KL_Rotare=225
KL_RotareB=315)
undo off(if Llgtype then(KGL_DEFLIGD=directionalLight pos:([1000000*Syun,0,1000000*Syun]+KL_m2) rgb:(color 255 245 219) multiplier:bbb name:cam1.name
KGL_DEFLIGD.type=#targetDirect
KGL_DEFLIGD.target.pos=KL_m2
about KL_m2 rotate KGL_DEFLIGD KL_Rotare z_axis)
else(KG_CamALigDEFLI=omnilight  rgb:(color 250 250 250) multiplier:ccc pos:([1000000*Syun,0,1000000*Syun]+KL_m2)  
about KL_m2 rotate KG_CamALigDEFLI KL_Rotare z_axis
KG_CamALigDEFLI2=omnilight affectSpecular:false rgb:(color 250 250 250) multiplier:ddd pos:([1000000*Syun,0,500000*Syun]+KL_m2)
about KL_m2 rotate KG_CamALigDEFLI2 KL_RotareB z_axis)
if Llgtype then(if start then(KGL_DEFLIGD.falloff=1000000*Syun
KGL_DEFLIGD.hotspot=800000*Syun)
else(KGL_DEFLIGD.falloff=10000000*Syun
KGL_DEFLIGD.hotspot=8000000*Syun)
if (try(SuperClassOf (VRay_阴影()))catch())==Shadow do KGL_DEFLIGD.shadowGenerator=VRay_阴影()
if (try(SuperClassOf (VRay阴影()))catch())==Shadow  do KGL_DEFLIGD.shadowGenerator=VRay阴影()   
if (try(SuperClassOf (VRayShadow()))catch())==Shadow do KGL_DEFLIGD.shadowGenerator=VRayShadow()
KGL_DEFLIGD.baseobject.castshadows=true
#(KGL_DEFLIGD))
else(KG_CamALigDEFLI3=omnilight affectSpecular:false rgb:(color 250 250 250) multiplier:eee pos:([0,0,-500000]+KL_m2)
#(KG_CamALigDEFLI,KG_CamALigDEFLI2,KG_CamALigDEFLI3))))
