fn lcl_SelByNameRo=
(if (KL_JianCLigObj aaa:1 bbb:3 ccc:2) do(
local KL_Mode=""
Kl_OldFile=#(((GetDir #maxroot)+"Defaults\\"),(KGXL_ZongMJLLCT[1][10]+"Defaults\\"))
KL_Old=(getINISetting AK_INIT_File "MiscellSetting" "SelectMatMode")=="1"
KL_PathAR=#()
for m in Kl_OldFile do KHF_SubfolderColl m KL_PathAR 5 0         ----调用子路径嵌套收集函数收集所有相关路径;
for m in KL_PathAR where doesFileExist(KL_CMD=(m+"CurrentDefaults.ini")) do 
(if KL_Old then(setINISetting KL_CMD "Scene Explorer" "SelectByNameUsesSceneExplorer" "0"
if (maxVersion())[1]/1000>=14 do MatEditor.mode=#basic
setINISetting AK_INIT_File "MiscellSetting" "SelectMatMode" "0"
KL_Mode="老版")
else(setINISetting KL_CMD "Scene Explorer" "SelectByNameUsesSceneExplorer" "1"
