if KGL_PlantScattObj.count!=0 do
(KL_CBa=KL_ML1.SelectedIndices.count
for m=1 to KL_CBa do deleteItem KGL_PlantScattObj (KL_ML1.SelectedIndices.item[(KL_CBa-m)]+1)
KF_RefreshList undefined))
on KC_JJKj2B pressed do
(max move 
KGL_PlantScattObj=#()
KF_RefreshList undefined)

on KC_BT6 pressed do
(PrevScatterObjTarget=for nn in selection where kugegeoFilt nn collect nn 
KC_BT6.text="目标:["+PrevScatterObjTarget.count as string+"]") 

fn KFInitupoa aa bb cc dd ee=                      
(if cc then if aa then dd[bb]="1"
else dd[bb]="0"
else dd[bb]=aa.value as string
KL_mmm="#("+dd[1]
for yy=2 to dd.count do KL_mmm+=","+dd[yy]
KL_mmm+=")"
setINISetting AK_INIT_File "AI_PlantTool" ee KL_mmm)
