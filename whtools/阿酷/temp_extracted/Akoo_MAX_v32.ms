lelmesh.mesh=newMesh
kugenew=mesh lengthsegs:1 widthsegs:1 position:lelmesh.center wireColor:kugecolor11 material:kugemat11 name:kugegrn11            
meshop.attach kugenew.mesh lelmesh.mesh targetNode:kugenew sourceNode:lelmesh
meshop.deleteFaces kugenew.mesh #{1..2} delIsoVerts:true
append kugewwwff11 kugenew
if KL_UUU1-KL_UUU2>20 do(KL_UUU2=KL_UUU1
try(gc())catch()))
delete kugeExpobj[kk]
gc())
progressEnd()
messageBox ("顺利完成按面数拆分"+(kl_ppp as string)+"个对象为"+(kugewwwff11.count as string)+"个新对象!") title:"按面数拆分场景结果--阿酷提示"))
