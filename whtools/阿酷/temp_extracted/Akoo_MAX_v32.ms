if aa then setINISetting (getMAXIniFile()) "akoo2009" "KG_AKglossyEffon" "1"
else setINISetting (getMAXIniFile()) "akoo2009" "KG_AKglossyEffon" "0")						   
on KC_SN31 changed aa do(R_S_GO1=aa
setINISetting (getMAXIniFile()) "akoo2009" "RendSampRO1" (aa  as string))	
on KC_SN53 changed aa do(R_S_G53=aa
setINISetting (getMAXIniFile()) "akoo2009" "RendSampR53" (aa as string))  
