if KL_BDN.count>0 do KL_QQ=queryBox "将清除掉所有路径缺失的外部文件,确定继续吗!"  title:"废弃缺失外部文件警告--阿酷提示")
else(KL_BDN=KCXMLB1.selection as array  
if KL_BDN.count>0 do KL_QQ=queryBox "将清除掉选择的资源条目,确定继续吗!"  title:"废弃资源文件警告--阿酷提示")
if KL_QQ do(KL_FFJ=KL_BDN.count                                      ----如果确认且有项目需要处理,则统计条目数;
for m=1 to KL_FFJ do(KL_Zonnum=KL_BDN[(KL_FFJ+1-m)]     -----获得当前条目数,注意这里是从数组的后面开始往前处理,保证不会因为删除前面成员影响整个数组的问题;
KHF_VrBitmapLightShu KL_Zonnum "" KGM_StyPeiNa KGM_MMTTFiNa   ----废弃条目处理
deleteItem KGM_BitmFiNa KL_Zonnum
deleteItem KGM_StyPeiNa KL_Zonnum
deleteItem KGM_MMTTFiNa KL_Zonnum
deleteItem KGM_DestNoNa KL_Zonnum
deleteItem KGM_ShortBitNa KL_Zonnum)    ----删除所有全局收集数组里的对应条目,以使后面不需要重新收集也能重新统计;
