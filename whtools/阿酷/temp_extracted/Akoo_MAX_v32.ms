for m in KL_KongJAr do m.visible=(KL_RuBu1.state==1)))
createDialog KR_ModuleDriveLine))
global KR_FitTerrain
if PrevGravityObjTarget==undefined do global PrevGravityObjTarget=#()
fn lcl_Advan_FitTerrain=      ---地形草地拟合工具,针对整个选择对象或选择顶点;
(if (KL_JianCLigObj aaa:1 bbb:3 ccc:2)do(
try(DestroyDialog KR_FitTerrain)catch()
rollout KR_FitTerrain "阿酷--地形拟合工具" width:200 height:80
(spinner KC_YUZHI "偏移:" pos:[10,10] fieldWidth:50 type:#float scale:(10*Syun) range:[(10*Syun),(1000*Syun),(100*Syun)]    ---缺省值应该大一点;
progressBar KC_ProTiao ""  width:80 pos:[108,10]
button KC_BT6 "载入选择"  width:80  pos:[10,38]
button KC_StartJC "开始计算"  width:80 pos:[108,38]
on KC_BT6 pressed do
(PrevGravityObjTarget=for nn in selection where kugegeoFilt nn collect nn 
KC_BT6.text="目标:["+PrevGravityObjTarget.count as string+"]") 
on KC_StartJC pressed do	  
(PrevGravityObjTarget=for m in PrevGravityObjTarget where IsValidNode m collect m    ---避免开始处理前,目标物体已有不存在的;
KC_BT6.text="目标:["+PrevGravityObjTarget.count as string+"]"
KL_CCtv=    ----必须将子层级数继承在前,否则后面转换后识别不到子层级数(转换操作会退出所有子层级)
if Selection.count==1 and PrevGravityObjTarget.count>0 and classof selection[1]==Editable_Poly 
then undo off
(KL_ConditionObj=selection[1]
Kl_TopPit=selection.max.z+10  
if(subObjectLevel==1)then KL_PolyVetLI=(polyop.getVertSelection KL_ConditionObj)as array    ---优先获取当前对象的选择顶点,否则处理所有顶点(注意必须当前处于顶点层级)
else KL_PolyVetLI=(#{1..(polyop.getNumVerts KL_ConditionObj)})as array   
thawSelection()
clearSelection() 
flagForeground KL_ConditionObj true
maxOps.CloneNodes PrevGravityObjTarget newNodes:&KL_InitSel
KL_Temp1=convertTo KL_InitSel[1](Editable_Poly)
KL_CCm=KL_InitSel.count   
for m=2 to KL_CCm do polyop.attach KL_Temp1 KL_InitSel[m]						   
KL_Facen=polyop.getNumFaces  KL_Temp1               
KL_DelFac=for m=1 to KL_Facen where(polyop.getFaceNormal KL_Temp1 m).z<0.5 collect m     ----收集所有面不向上的面序号数组  ---0.5为什么等于60度了呢?可以是跟数学函数有关系 ；
polyop.deleteFaces KL_Temp1 KL_DelFac delIsoVerts:true							    -----删除这些面;将这个作为定位对象;	   
KL_Temp2=copy  KL_Temp1
convertToMesh KL_Temp1            -----转换为可编辑网格,保证性能;
polyop.moveVertsToPlane KL_Temp2 #{1..(polyop.getNumVerts KL_Temp2)} [0,0,1] 0.0           ----复制出来投射对象,然后进行压平;
convertToMesh KL_Temp2            -----转换为可编辑网格,保证性能;
KL_RayMesh=RayMeshGridIntersect()          --创建射线网格计算对象;
KL_RayMesh.Initialize 10                   --初始化计算密度大小
KL_RayMesh.addNode KL_Temp2      --添加源对象到计算列表(所有要落的对象);
KL_RayMesh.buildGrid()                      --正式创建射线网格计算流;
KL_Normal=[0,0,-1]
KL_GSMesh=snapshotasmesh KL_ConditionObj    --首先打印目标条件对象为内部Tri网格数据(应该更优良);
KL_JSQnum=KL_PolyVetLI.count 
KL_SoftVetAr=#()                           ---预置当前对象的有效面收集数组变量;
for tt=1 to KL_JSQnum while not keyboard.escPressed do
(KR_FitTerrain.KC_ProTiao.value=100.0*tt/KL_JSQnum
KL_Pos=getVert KL_GSMesh KL_PolyVetLI[tt]                                   ----获得当前顶点位置;
KL_Newpos=[KL_Pos.x,KL_Pos.y,Kl_TopPit]          ----重新求得新位置,保证始终处于最高处,保证能相交到;
KL_HitsCount=KL_RayMesh.intersectRay KL_Newpos KL_Normal false   ----正式基于当前顶点和射线进行相交计算(双向检测)
if KL_HitsCount>0 do append KL_SoftVetAr KL_PolyVetLI[tt])
KL_RayMesh.free()		
delete KL_Temp2    -----删除压平了的网格射线流辅助对象;
polyop.setVertSelection KL_ConditionObj KL_SoftVetAr	                      ----KL_SoftVetAr:激活刚才求得的原始完全落点; 322
KL_ConditionObj.ConvertSelection #Vertex #Face                               ----将当前顶点选择转换成面选择,以待后面面元素的收缩并删除;
KL_ConditionObj.GrowSelection selLevel:#Vertex
KL_ConditionObj.GrowSelection selLevel:#Vertex                                -----这里肯定需要增加两次,才能将四边形只有一条边
KL_VerNumFF=(polyop.getVertSelection KL_ConditionObj)as array                ----- KL_VerNumFF:获得最大范围顶点  794
KL_ConditionObj.ShrinkSelection selLevel:#Face
KL_ConditionObj.ShrinkSelection selLevel:#Face					
Kl_DeleteFace=polyop.getFaceSelection KL_ConditionObj		                   ----获得最终删除面数;
KL_ConditionObj.ShrinkSelection selLevel:#Face	                               ----不参与落地计算的顶点必须要比删除面更小一圈;
KL_ConditionObj.ConvertSelection #Face #Vertex		
KL_VerNuXXX=(polyop.getVertSelection KL_ConditionObj)as array 	 ------这里一定要过滤一下,不然有洞的结构子元素先扩展再收缩会导致跳出完全落点的范畴了;
KL_VerNumDe=for m in KL_VerNuXXX where findItem KL_SoftVetAr m!=0 collect m	   -----KL_VerNumDe:获得绝对删除顶点;   11
--         KL_ConditionObj.ShrinkSelection selLevel:#Vertex                              -----收缩一下,恢复到删面后的完全落点;
--         KL_SoftVetAr=(polyop.getVertSelection KL_ConditionObj)as array               -----重新收集完全落点数组
KL_VerNum=for m in KL_VerNumFF where findItem KL_SoftVetAr m==0 collect m  -----KL_VerNum:利用最大范围和完全落点两个数组的关系取得外挂落点;  472
KL_SoftVetArOn=for m in KL_SoftVetAr where findItem KL_VerNumDe m==0 collect m  -----KL_SoftVetArOn:利用完全落点和呆删落点两个数组的关系取得最终落点; 311
KL_JSQnum=KL_SoftVetArOn.count       ----Ian统计其数量,然后利用进度条指示进行操作;
for tt=1 to KL_JSQnum while not keyboard.escPressed do                                              -----首先逐一定位完全落点;
(KR_FitTerrain.KC_ProTiao.value=100.0*tt/KL_JSQnum
KL_Pos=polyop.getVert KL_ConditionObj KL_SoftVetArOn[tt]                                  ----获得当前顶点位置;
KL_Newpos=[KL_Pos.x,KL_Pos.y,Kl_TopPit]  
KL_Modept=(intersectRay KL_Temp1(ray KL_Newpos KL_Normal))     ----射线相交检测最好还是用可编辑网格,更可靠一点,多边形有时处理不到   
if KL_Modept!=undefined do polyop.setVert KL_ConditionObj KL_SoftVetArOn[tt] (KL_Modept.pos-[0,0,KR_FitTerrain.KC_YUZHI.value]))   
delete KL_Temp1    -----删除落点计算辅助物;	
KL_JSQnum=KL_VerNum.count
KL_Paichu=#()             ---定义一个排除数组,用来累积已经处理过的目标顶点数组;
for tt=1 to KL_JSQnum while not keyboard.escPressed do      ---遍寻每个边界顶点(如果没有被排除[有可能会被旁边的顶点参与面提前计算和处理]);
(KR_FitTerrain.KC_ProTiao.value=100.0*tt/KL_JSQnum
KL_VerFace=(polyop.getFacesUsingVert KL_ConditionObj #(KL_VerNum[tt]))as array   ---获得当前最终顶点所有参与的面元素;
for m in KL_VerFace do  ---遍寻每个参与面进行它所有顶点的匹配计算;                       分完全落点和挑出落点分别集合;
(KL_S1=#()                ---初始化一个空数组,用来收集核对当前面是否有完全落点
KL_S2=#()                ---初始化一个空数组,用来收集核对当前面是否有挑出落点
KL_FacVer=polyop.getFaceVerts KL_ConditionObj m   ---折回收集到当前参与面的所有顶点;
for mm in KL_FacVer do if findItem KL_SoftVetArOn mm!=0 then append KL_S1 mm   ---收集完全落点的数量;
else if findItem KL_VerNum mm!=0 do append KL_S2 mm   ---收集未排除最终点数组;
if KL_S1.count>0 and KL_S2.count>0 do
(KL_AApo=for tb in KL_S1 collect(polyop.getVert KL_ConditionObj tb)
if KL_S1.count>1 do(KL_S1Z=for tb in KL_AApo collect tb.z
KL_AApo=KHF_CondiSortSH KL_AApo KL_S1Z)   ---如果有完全落点且有需要处理最终点;则首先获取完全落点的坐标值;     
for nn in KL_S2 do(KL_AApos2=polyop.getVert KL_ConditionObj nn   ---批处理最终落点(首先取得自身坐标值)
if findItem KL_Paichu nn==0 or KL_AApos2.z>KL_AApo[1].z do polyop.setVert KL_ConditionObj nn [KL_AApos2.x,KL_AApos2.y,KL_AApo[1].z]  ----设置最终顶点的坐标(组合自身XY和完全落点的Z值)
append KL_Paichu nn))))      ----追加处理过最终落点到排除数组;
polyop.setVertSelection KL_ConditionObj KL_VerNumFF                  ---最后选中最大范围落点,
polyop.deleteFaces KL_ConditionObj Kl_DeleteFace delIsoVerts:true	  ----把删除面放在最后面步骤,为了不影响前面的顶点数组序号处理;
flagForeground KL_ConditionObj false
KC_ProTiao.value=0
select KL_ConditionObj
if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify
subObjectLevel=1
completeRedraw())
else messageBox "请核对是否已经添加了目标对象以及当前草地对象是否为单个Editable_Poly对象!" title:"地形拟合工具警告--阿酷提示")
on KR_FitTerrain open do(
KF_SceneUnitsJC()
PrevGravityObjTarget=for m in PrevGravityObjTarget where IsValidNode m collect m
KC_BT6.text="目标:["+PrevGravityObjTarget.count as string+"]"))      ---重新建立所有处理过后顶点的选择集(可以进一步进行上下微调)
CreateDialog KR_FitTerrain))
if (getINISetting AK_INIT_File "akoo2011" "OnlyNotVRay")=="" do setINISetting AK_INIT_File "akoo2011" "OnlyNotVRay" "1"
if (getINISetting AK_INIT_File "akoo2011" "SceBitthA1")=="" do setINISetting AK_INIT_File "akoo2011" "SceBitthA1" ""
