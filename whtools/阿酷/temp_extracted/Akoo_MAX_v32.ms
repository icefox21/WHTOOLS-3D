on KC_XXType changed aa do(KC_CP2.visible=(aa!=3)
KC_CP3.visible=KC_SN31.visible=(aa!=1)
KGL_RenderTyp=aa
setINISetting (getMAXIniFile()) "akoo2009" "KGL_RenderTyp" (aa as string)
for m=1 to KCL_RendTyCJColl.count do if m==aa then for n in KCL_RendTyCJColl[m] do n.visible=true
else for n in KCL_RendTyCJColl[m] do n.visible=false
if not(hasProperty renderers.current "lightcache_mode") do KC_RenA7F.visible=false
if not(hasProperty renderers.current "options_glossyEffects") do KC_RenB3.visible=KC_RenB6.visible=false)
on KC_CP2 changed aa do(KG_KCCP2=aa
setINISetting (getMAXIniFile()) "akoo2009" "RendSampR45" (aa as string))			   	
on KC_CP3 changed aa do(KG_KCCP3=aa
setINISetting (getMAXIniFile()) "akoo2009" "KG_KCCP3" (aa as string))  
on KC_DL24 selected aa do(if aa==1 then KC_SN16.visible=true
else KC_SN16.visible=false
KG_samperFormat=aa 
setINISetting (getMAXIniFile()) "akoo2009" "samperFormat" (aa as string))														  
