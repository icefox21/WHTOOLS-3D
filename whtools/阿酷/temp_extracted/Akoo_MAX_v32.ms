fn KHF_UIVersion=                        -----对应UI版本获取函数;自动基于当前版本数读取等于或最接近它的低版本UI文件
(Kl_Curbb=(maxVersion())[1]/1000       -----获取当前MAX版本数;
Kl_UI=getFiles(KGXL_ZongMJLLCT[1][1]+"AK_*.*")             -----获得所有新AKUI文件;
KL_bbNumAr=for m in Kl_UI where(KL_Num=(substring(getFilenameFile m)4 -1)as Integer)!=undefined and KL_Num<=Kl_Curbb collect KL_Num       ----集合所有小于等于的UI版本数;
sort KL_bbNumAr
(KL_bbNumAr[KL_bbNumAr.count])as string)            -----排序并获得最大数
