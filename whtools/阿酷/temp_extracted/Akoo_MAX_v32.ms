fff=kugeMESH.numverts
lclvert1=distance (getVert kugeMESH 1) (getVert kugeMESH fff)
lclvert2=distance (getVert kugeMESH 1) (getVert kugeMESH (fff/2))
lclvert3=distance (getVert kugeMESH fff) (getVert kugeMESH (fff/2))
lclvert4=(lclvert1+lclvert2+lclvert3)as string
lclvertB=(substring lclvert4 1 (lclvert4.count-2))as Float 
