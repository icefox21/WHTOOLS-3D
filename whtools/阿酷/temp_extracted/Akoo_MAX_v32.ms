global KL_Fir1,kuge_singleshape
global KG_AuCoMode=1
global KG_AuCoXZMode=1
global KG_AuCoJuLi=10000
global KG_AuCoXZJuLi=100
fn kuge_CompFN v1 v2 =
(KL_BT=(distance KL_Fir1 V1[1])-(distance KL_Fir1 V2[1])
case of
(
(KL_BT<0.):-1
(KL_BT>0.):1
default:0
)
)
fn KF_AuotConnFN =
(undo on(if kuge_singleshape selection do(KL_Shap=selection[1]
if numSubObjectLevels==0 do convertToSplineShape KL_Shap
KL_A1=numsplines KL_Shap				     
akk=#()                      
kugeakk=#()     
if subObjectLevel==1 do(for p=1 to KL_A1 where(KL_ASC=getKnotSelection KL_Shap p).count>0 do(KL_KnN=numKnots KL_Shap p
if (findItem KL_ASC 1)!=0 do(lclp1=getKnotPoint KL_Shap p 1
append akk #(lclp1,p))
if (findItem KL_ASC KL_KnN)!=0 do(lclp1=getKnotPoint KL_Shap p KL_KnN
append akk #(lclp1,p))))
if  akk.count<2 do(akk=#() 
for p=1 to KL_A1 do(if not isClosed KL_Shap p do(KL_KnN=numKnots KL_Shap p
lclp1=getKnotPoint KL_Shap p 1
lclp2=getKnotPoint KL_Shap p KL_KnN
append akk #(lclp1,p)
append akk #(lclp2,p))))
if akk.count>1 do 
(if KG_AuCoMode==2 do(append akk akk[1]
deleteItem akk 1)
KL_CCC=1
while akk.count>1 do(KL_TR1=#()
if KG_AuCoMode==2 then(KII=for g=1 to akk.count where akk[g][2]==KL_CCC collect g
if KII.count>0 then KL_DDD=KII[1]
else KL_DDD=1)
else KL_DDD=1
global KL_Fir1=akk[KL_DDD][1]
KL_A2=akk.count
for m=1 to KL_A2 do(if KG_AuCoXZMode==1 then(if (distance KL_Fir1 akk[(KL_A2+1-m)][1])>(KG_AuCoJuLi+0.01)do(append KL_TR1 akk[(KL_A2+1-m)]
deleteItem akk (KL_A2+1-m)))
else(KL_ML9=distance KL_Fir1 akk[(KL_A2+1-m)][1]
if (KL_ML9>(KG_AuCoJuLi+KG_AuCoXZJuLi) or KL_ML9<(KG_AuCoJuLi-KG_AuCoXZJuLi))and KL_ML9!=0 do
(append KL_TR1 akk[(KL_A2+1-m)]
deleteItem akk (KL_A2+1-m))))
KL_rrr=1
KL_ZJ1=KL_TR1
KL_ZJ2=akk
if KG_AuCoXZMode==1 do(while akk.count>10 do(KL_ZJ1=KL_TR1
KL_ZJ2=akk
KL_A2=akk.count			   
for m=1 to KL_A2 where (distance KL_Fir1 akk[(KL_A2+1-m)][1])>((KG_AuCoJuLi+0.01)/(4*KL_rrr)) do(append KL_TR1 akk[(KL_A2+1-m)]
deleteItem akk (KL_A2+1-m))
KL_rrr+=1))
if akk.count<2 do(KL_TR1=KL_ZJ1
akk=KL_ZJ2)
if akk.count>2 do qsort akk kuge_CompFN  
if akk.count>1 then   
(if akk[1][2]==akk[2][2] and akk.count>2 then(KL_UY=akk[3][1]
KL_ZJ1=KL_TR1
KL_ZJ2=akk
global KL_Fir1=akk[2][1]
qsort akk kuge_CompFN 
if (distance akk[3][1] KL_UY)<0.001 then(if (distance akk[3][1] akk[1][1])>(distance akk[3][1] akk[2][1]) then(append kugeakk #(akk[2][1],akk[3][1]) 
KL_CCC=akk[3][2]
deleteItem akk 3
deleteItem akk 2
join akk KL_TR1
if KG_AuCoMode==2 do(append akk akk[1]
deleteItem akk 1))
else(append kugeakk #(akk[1][1],akk[3][1]) 
KL_CCC=akk[3][2]
deleteItem akk 3
deleteItem akk 1
join akk KL_TR1
if KG_AuCoMode==2 do(append akk akk[1]
deleteItem akk 1)))
else(KL_TR1=KL_ZJ1
akk=KL_ZJ2
append kugeakk #(akk[1][1],akk[3][1]) 
KL_CCC=akk[3][2]
deleteItem akk 3
deleteItem akk 1
join akk KL_TR1
if KG_AuCoMode==2 do(append akk akk[1]
deleteItem akk 1)))       
else(append kugeakk #(akk[1][1],akk[2][1]) 
KL_CCC=akk[2][2]
deleteItem akk 1
deleteItem akk 1
join akk KL_TR1))
else(for m=1 to akk.count do deleteItem akk (akk.count+1-m)
join akk KL_TR1)))
if kugeakk.count>0 do(kugeShape=splineShape() 
for hp=1 to kugeakk.count do(addnewSpline kugeShape
addKnot kugeShape hp #corner #line kugeakk[hp][1]
addKnot kugeShape hp #corner #line kugeakk[hp][2])
updateShape kugeShape))))
