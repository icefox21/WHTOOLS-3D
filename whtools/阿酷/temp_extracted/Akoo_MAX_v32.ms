checkbutton KC_CT2 "交互指定" pos:[114,137] width:60 height:17
label KBC_Lab1A "奇数中心偏:" pos:[77,51] align:#left
radiobuttons KBC_RuBu5  labels:#("左","右") default:DriveLDouCentLeft pos:[149,51]  enabled:((mod KC_SP8Sumber.value 2)>0)
button KL_BTFF "清除" pos:[114,193] 
button KL_BT1 "生成" pos:[164,184] width:50 height:30

fn KF_PPPFN aa=
(KF_SceneUnitsJC()
if aa then(if KC_RuBu2.state==1 then(KL_VVVs=((((KL_SP7.value-KBC_SP6.value)/KC_SP5Width.value)as Integer)/2)*2
if KL_VVVs<=10 then KC_SP8Sumber.value=KL_VVVs
else KC_SP8Sumber.value=10
KGL_DriveLineLSHU=KC_SP8Sumber.value
KL_VVVss=(KL_SP7.value-KBC_SP6.value)/KC_SP8Sumber.value
if KL_VVVss<=15000*Syun then KC_SP5Width.value=KL_VVVss
else KC_SP5Width.value=15000*Syun
KL_FFF=KC_SP5Width.value/Syun
if KL_FFF<=15000 and KL_FFF>=1500 then setINISetting (getMAXIniFile()) "akoo2009" "DriveLineWidth" (KL_FFF as string)
else messageBox "面板数值异常,请检查场景单位或刷新面板!" title:"阿酷车道线生成工具--阿酷提示")
else(if KC_SP8Sumber.value<2 do KC_SP8Sumber.value=2
KL_VVVs=(KL_SP7.value-KBC_SP6.value)/KC_SP8Sumber.value
if KL_VVVs>=2500*Syun then KC_SP5Width.value=KL_VVVs
else KC_SP5Width.value=2500*Syun
DriveLineWidth=KC_SP5Width.value/Syun
KL_VVVs=((((KL_SP7.value-KBC_SP6.value)/KC_SP5Width.value)as Integer)/2)*2
if KL_VVVs<=10 then KC_SP8Sumber.value=KL_VVVs
else KC_SP8Sumber.value=10
KGL_DriveLineLSHU=KC_SP8Sumber.value
KL_VVVs=(KL_SP7.value-KBC_SP6.value)/KC_SP8Sumber.value
if KL_VVVs>=2500*Syun then KC_SP5Width.value=KL_VVVs
else KC_SP5Width.value=2500*Syun
KL_FFF=KC_SP5Width.value/Syun
if KL_FFF<=15000 and KL_FFF>=1500 then(DriveLineWidth=KL_FFF
setINISetting (getMAXIniFile()) "akoo2009" "DriveLineWidth" (KL_FFF as string))
else messageBox "面板数值异常,请检查场景单位或刷新面板!" title:"阿酷车道线生成工具--阿酷提示"))
else(if KC_RuBu2.state==1 then(KL_VVVs=((KL_SP7.value-KBC_SP6.value)/KC_SP5Width.value)as Integer
if KL_VVVs<=10 then KC_SP8Sumber.value=KL_VVVs
else KC_SP8Sumber.value=10
KGL_DriveLineLSHU=KC_SP8Sumber.value
KL_VVVss=(KL_SP7.value-KBC_SP6.value)/KC_SP8Sumber.value
if KL_VVVss<=15000*Syun then KC_SP5Width.value=KL_VVVss
else KC_SP5Width.value=15000*Syun
KL_FFF=KC_SP5Width.value/Syun
if KL_FFF<=15000 and KL_FFF>=1500 then setINISetting (getMAXIniFile()) "akoo2009" "DriveLineWidth" (KL_FFF as string)
else messageBox "面板数值异常,请检查场景单位或刷新面板!" title:"阿酷车道线生成工具--阿酷提示")
else(KL_VVVs=(KL_SP7.value-KBC_SP6.value)/KC_SP8Sumber.value
if KL_VVVs>=2500*Syun then KC_SP5Width.value=KL_VVVs
else KC_SP5Width.value=2500*Syun
DriveLineWidth=KC_SP5Width.value/Syun
KL_VVVs=((KL_SP7.value-KBC_SP6.value)/KC_SP5Width.value)as Integer
if KL_VVVs<=10 then KC_SP8Sumber.value=KL_VVVs
else KC_SP8Sumber.value=10
KGL_DriveLineLSHU=KC_SP8Sumber.value
KL_VVVs=(KL_SP7.value-KBC_SP6.value)/KC_SP8Sumber.value
if KL_VVVs>=2500*Syun then KC_SP5Width.value=KL_VVVs
else KC_SP5Width.value=2500*Syun
KL_FFF=KC_SP5Width.value/Syun
if KL_FFF<=15000 and KL_FFF>=1500 then(DriveLineWidth=KL_FFF
setINISetting (getMAXIniFile()) "akoo2009" "DriveLineWidth" (KL_FFF as string))
else messageBox "面板数值异常,请检查场景单位或刷新面板!" title:"阿酷车道线生成工具--阿酷提示"))
if (mod KC_SP8Sumber.value 2)>0 then(KBC_RuBu5.enabled=KBC_Lab1A.enabled=true
KBC_SP6.enabled=KBC_CT1.enabled=false
setINISetting (getMAXIniFile()) "akoo2009" "DriveLineSiCenter" "1")
else(KBC_RuBu5.enabled=KBC_Lab1A.enabled=false
KBC_SP6.enabled=KBC_CT1.enabled=true))
on KBC_CT1 changed a do(KAP1=pickPoint "起点:" snap:#3D 
if (classOf KAP1)==Point3 do KAP2=pickPoint "终点:" snap:#3D rubberBand:KAP1
if (classOf KAP2)==Point3 do(KBC_SP6.value=distance KAP1 KAP2
KGL_DriveLVireSC=(KBC_SP6.value/Syun)
KF_PPPFN (KBC_RuBu.state==2))
KBC_CT1.checked=false)
on KC_CT2 changed a do(KAP1=pickPoint "起点:" snap:#3D 
if (classOf KAP1)==Point3 do KAP2=pickPoint "终点:" snap:#3D rubberBand:KAP1
if (classOf KAP2)==Point3 do(KL_SP7.value=distance KAP1 KAP2
KGL_DriveLGZwid=(KL_SP7.value/Syun)
KF_PPPFN (KBC_RuBu.state==2))
KC_CT2.checked=false)
on KBC_SP6 changed aa do(KGL_DriveLVireSC=aa
KF_PPPFN (KBC_RuBu.state==2))
on KL_SP7 changed aa do(KGL_DriveLGZwid=(aa/Syun)
KF_PPPFN (KBC_RuBu.state==2))
on KC_SP5Width changed aa do(KF_SceneUnitsJC()
KL_FFF=aa/Syun
if KL_FFF<=15000 and KL_FFF>=1500 then(DriveLineWidth=KL_FFF
setINISetting (getMAXIniFile()) "akoo2009" "DriveLineWidth" (KL_FFF as string)
KF_PPPFN (KBC_RuBu.state==2))
else messageBox "面板数值异常,请检查场景单位或刷新面板!" title:"阿酷车道线生成工具--阿酷提示")
on KC_SP8Sumber changed aa do(KGL_DriveLineLSHU=aa
KF_PPPFN false)
on KBC_RuBu changed aa do(DriveLineDouS=aa  
setINISetting (getMAXIniFile()) "akoo2009" "DriveLineDouS" (aa as string)
if aa==1 then KF_PPPFN (KBC_RuBu.state==2)
else KF_PPPFN false)   
on KL_RuBu1 changed aa do(DriveLineMode=aa  
setINISetting (getMAXIniFile()) "akoo2009" "DriveLineMode" (aa as string)
for m in KL_KongJAr do m.visible=(aa==1))   
on KC_RuBu2 changed aa do(DriveLineNumber=aa
setINISetting (getMAXIniFile()) "akoo2009" "DriveLineNumber" (aa as string)
KC_SP5Width.enabled=(aa==1)
KC_SP8Sumber.enabled=(aa==2))      
on KL_BTFF pressed do(KL_QQ=queryBox "你确定要删除最后创建的车道线对象吗?"  title:"阿酷车线生成工具提示--阿酷提示"
if KL_QQ do(KGL_CreateObjColl=for m in KGL_CreateObjColl where IsValidNode m collect m
undo off(delete KGL_CreateObjColl)))
on KL_BT1 pressed do if selection.count==1 do if SuperClassOf selection[1]==shape do undo off
(KF_SceneUnitsJC()
KL_DouSignLine=true                             ----单双中心线   
KGL_WhiteMaterial=standardMaterial diffuse:(color 255 255 255) name:"WhiteMaterial"   ---白色材质
KGL_YellowColor=(color 255 255 0)                                                   ---黄色颜色
KGL_YellowMaterial=standardMaterial diffuse:KGL_YellowColor name:"YellowMaterial"   ---黄色材质
KL_DriShLength=(4000*Syun)*KBC_SP1.value             ----车道线实线部分长度
KL_DriXuLength=KL_DriShLength*KBC_SP2.value   ----车道线虚线部分长度
KL_DrSignWidth=(200*Syun)*KBC_SP1.value              ----车道线线条宽度
KL_ZjDist=(KL_SP7.value-KBC_SP6.value)*1.0/KC_SP8Sumber.value   ----每车道宽度
KL_HenDDistNum=KL_SP7.value/(KL_DrSignWidth*4)             ----人行横道数量    
KL_FinLineOff=#()                               ----车道线复制数组
KL_FinLineCarOff=#()                            ----车轨迹复制数组
KL_HenDineOff=#()                               ----人行横道线数组
KL_CenterDineOff=#()   							----中心线复制数组	
KL_ZuZHIXianOff=#() 	                        ----阻止线起点坐标   
KL_ZuZHIXianOffAng=#() 	                        ----阻止线起点角度  
KL_ZuZHIXianOffDist=#()                           ----阻止线推量  
KL_ZuZHIBCCOffDist=#()                           ----阻止线反方向补偿
KGL_CreateObjColl=#()                             ----创建容器集合      
if (mod KC_SP8Sumber.value 2)==0 
then(if not KBC_Box41.checked and KBC_SP6.value==0 do append KL_FinLineOff (KL_DrSignWidth/2)
KL_MMedge=(KC_SP8Sumber.value/2)
for m=1 to KL_MMedge do(append KL_FinLineCarOff ((KBC_SP6.value/2)+(m*KL_ZjDist)-(KL_ZjDist/2))
append KL_FinLineCarOff (-(KBC_SP6.value/2)-(m*KL_ZjDist)+(KL_ZjDist/2)))
KL_MMedge1=((KC_SP8Sumber.value/2)-1)
for m=1 to KL_MMedge1 do(append KL_FinLineOff ((KBC_SP6.value/2)+(m*KL_ZjDist)+(KL_DrSignWidth/2))
append KL_FinLineOff (-(KBC_SP6.value/2)-(m*KL_ZjDist)-(KL_DrSignWidth/2))))
else(append KL_FinLineCarOff (10*Syun)
KL_MMedge=(KC_SP8Sumber.value/2)
for m=1 to KL_MMedge do(append KL_FinLineCarOff (m*KL_ZjDist)
append KL_FinLineCarOff -(m*KL_ZjDist))
KL_MMedge1=(KC_SP8Sumber.value/2)
for m=1 to KL_MMedge1 do(if not(m==1 and KBC_Box41.checked and (KBC_RuBu5.state==2))do append KL_FinLineOff ((KL_ZjDist/2)+((m-1)*KL_ZjDist)+(KL_DrSignWidth/2))
if not(m==1 and KBC_Box41.checked and (KBC_RuBu5.state==1))do append KL_FinLineOff (-(KL_ZjDist/2)-((m-1)*KL_ZjDist)-(KL_DrSignWidth/2))))

append KL_HenDineOff KL_DrSignWidth  
KL_MMedge=((KL_HenDDistNum/2)+2)                       
for m=1 to KL_MMedge do(append KL_HenDineOff ((m*(KL_DrSignWidth*4))+KL_DrSignWidth) 
append KL_HenDineOff (-(m*(KL_DrSignWidth*4))-KL_DrSignWidth))   
if (mod KC_SP8Sumber.value 2)==0 then if KL_DouSignLine then(append KL_CenterDineOff (KL_DrSignWidth*1.75)
append KL_CenterDineOff -(KL_DrSignWidth*1.75)) 
else append KL_CenterDineOff (KL_DrSignWidth/2)   
else if KBC_RuBu5.state==2 then if KL_DouSignLine then(append KL_CenterDineOff ((KL_ZjDist/2)-(KL_DrSignWidth*0.75))
append KL_CenterDineOff ((KL_ZjDist/2)+(KL_DrSignWidth*1.75)))
else append KL_CenterDineOff ((KL_ZjDist/2)+(KL_DrSignWidth/2))  
else if KL_DouSignLine then(append KL_CenterDineOff -((KL_ZjDist/2)-(KL_DrSignWidth*0.75))
append KL_CenterDineOff -((KL_ZjDist/2)+(KL_DrSignWidth*1.75))) 
else append KL_CenterDineOff -((KL_ZjDist/2)+(KL_DrSignWidth/2))  	
if KBC_Box3.checked do(append KL_CenterDineOff ((KL_SP7.value/2)+(KL_DrSignWidth/2))
append KL_CenterDineOff -((KL_SP7.value/2)+(KL_DrSignWidth/2)))
if subObjectLevel==3 then KL_mmcx=getSplineSelection selection[1]	
else KL_mmcx=#()
ResetXForm selection[1]
convertToSplineShape selection[1]		 
if KL_mmcx.count>0  then KL_SplinEnml=KL_mmcx
else(KL_MMedge=numSplines selection[1]
KL_SplinEnml=for n=1 to KL_MMedge collect n)
setCommandPanelTaskMode mode:#create
KL_NewSp=copy selection[1]
KL_NewRXHD=#()           ---人行横道端点和角度(单对点)
KL_NewRXHDAng=#()
KL_NewCHDX=#()           ---车行线顶点和角度(多对点)
KL_NewCHDXAng=#()
KL_NewCHDXBB=#()           ---车行线顶点和角度(多对点)
KL_NewCHDXAngBB=#()
KL_CenterLine=#()        ---中心线顶点和角度(规格点系列和角度)
KL_CenterLineAng=#()
KL_MapCenterLine=#()        ---贴图模式的中心线,贴图模式直接用挤压+加壳,所以不用角度信息,至于贴图模式的横道线公用实建模式的源线
worldUpVector=[0,0,1] 
KL_MMedge=KL_SplinEnml.count
for m=1 to KL_MMedge do
(KL_AA1=curveLength KL_NewSp KL_SplinEnml[m]
KL_AAnum=(KL_AA1/(KL_DriShLength+KL_DriXuLength))as Integer 
if KL_AAnum>29 then KL_LuLengMode=3
else KL_LuLengMode=2
if KL_AAnum>3 and KL_AAnum<300 do
(KL_SHiJiKx=(KL_AA1-(KL_AAnum*KL_DriXuLength))/(KL_AAnum+1)         ----调正后的车道虚线实线部分长度
KGL_XUPathLeng=KL_DriXuLength/KL_AA1                                     ----虚线部分路径参数单位
KGL_ShiPathLeng=KL_SHiJiKx/KL_AA1                                         ----实线部分路径参数单位
append KL_NewRXHD #((interpCurve3D KL_NewSp KL_SplinEnml[m] 0.0),(interpCurve3D KL_NewSp KL_SplinEnml[m] KGL_ShiPathLeng))
append KL_NewRXHD #((interpCurve3D KL_NewSp KL_SplinEnml[m] (1.0-KGL_ShiPathLeng)),(interpCurve3D KL_NewSp KL_SplinEnml[m] 1.0))
append KL_NewRXHDAng #(normalize(cross worldUpVector (tangentCurve3D KL_NewSp KL_SplinEnml[m] KGL_ShiPathLeng)),normalize(cross worldUpVector(tangentCurve3D KL_NewSp KL_SplinEnml[m] KGL_ShiPathLeng)))
append KL_NewRXHDAng #(normalize(cross worldUpVector (tangentCurve3D KL_NewSp KL_SplinEnml[m] (1.0-KGL_ShiPathLeng))),normalize(cross worldUpVector(tangentCurve3D KL_NewSp KL_SplinEnml[m] (1.0-KGL_ShiPathLeng))))   ---获得横道线位置和角度
if KL_AA1-(distance (getKnotPoint KL_NewSp KL_SplinEnml[m] 1) (getKnotPoint KL_NewSp KL_SplinEnml[m] (numKnots KL_NewSp KL_SplinEnml[m])))>10*Syun then KL_MMedge1=KL_AAnum*KBC_SP4.value
else KL_MMedge1=2
KL_CenterInp=(1.0-((KGL_XUPathLeng+KGL_ShiPathLeng)*2))/(KL_MMedge1-1)   ---除去横道线部分的分段路径参数单位
KL_CenterLiaa=#()
KL_CenterLiaaAng=#()
for a=1 to  KL_MMedge1 do(append KL_CenterLiaa (interpCurve3D KL_NewSp KL_SplinEnml[m] (((a-1)*KL_CenterInp)+(KGL_XUPathLeng+KGL_ShiPathLeng)))
append KL_CenterLiaaAng (normalize(cross worldUpVector(tangentCurve3D KL_NewSp KL_SplinEnml[m] (((a-1)*KL_CenterInp)+(KGL_XUPathLeng+KGL_ShiPathLeng))))))   ---获得中心线位置和角度
append KL_CenterLine KL_CenterLiaa
append KL_CenterLineAng KL_CenterLiaaAng
if KL_RuBu1.state==2 then(KL_CenterInpB=(1.0-(KGL_XUPathLeng+(KGL_ShiPathLeng*2)))/(KL_MMedge1-1)   ---除去横道线部分的分段路径参数单位(贴图模式用)
KL_CenterLiaaB=#()
for a=1 to KL_MMedge1 do append KL_CenterLiaaB (interpCurve3D KL_NewSp KL_SplinEnml[m] (((a-1)*KL_CenterInpB)+((KGL_XUPathLeng/2)+KGL_ShiPathLeng)))
append KL_MapCenterLine KL_CenterLiaaB) 
else(KL_MMedge3=KL_AAnum-1        
if KL_AAnum<7 then(for n=1 to KL_MMedge3 do(KL_Cm1=n*(KGL_XUPathLeng+KGL_ShiPathLeng)
KL_NewCHDXTemp1=#((interpCurve3D KL_NewSp KL_SplinEnml[m] KL_Cm1))
KL_NewCHDXAngTemp1=#((normalize(cross worldUpVector(tangentCurve3D KL_NewSp KL_SplinEnml[m] KL_Cm1)))) 
for bb=1 to KBC_SP4.value do(append KL_NewCHDXTemp1 (interpCurve3D KL_NewSp KL_SplinEnml[m] (KL_Cm1+(bb*(KGL_ShiPathLeng/KBC_SP4.value))))
append KL_NewCHDXAngTemp1 (normalize(cross worldUpVector(tangentCurve3D KL_NewSp KL_SplinEnml[m] (KL_Cm1+(bb*(KGL_ShiPathLeng/KBC_SP4.value)))))))
append KL_NewCHDX KL_NewCHDXTemp1
append KL_NewCHDXAng KL_NewCHDXAngTemp1)
KL_NewCHDXBB=KL_NewCHDX
KL_NewCHDXAngBB=KL_NewCHDXAng)
else(KL_MMedge4=KL_LuLengMode*KBC_SP4.value
KL_CenterInp5=(((KGL_XUPathLeng+KGL_ShiPathLeng)*(KL_LuLengMode-1))+KGL_ShiPathLeng)/(KL_MMedge4-1)   ---起始结束连线部分的段数
KL_NewCHDXTemp1=#()
KL_NewCHDXAngTemp1=#() 
for a=1 to KL_MMedge4 do(append KL_NewCHDXTemp1 (interpCurve3D KL_NewSp KL_SplinEnml[m] (((a-1)*KL_CenterInp5)+(KGL_XUPathLeng+KGL_ShiPathLeng)))
append KL_NewCHDXAngTemp1 (normalize(cross worldUpVector(tangentCurve3D KL_NewSp KL_SplinEnml[m] (((a-1)*KL_CenterInp5)+(KGL_XUPathLeng+KGL_ShiPathLeng))))))   ---获得中心线位置和角度
append KL_NewCHDX KL_NewCHDXTemp1
append KL_NewCHDXAng KL_NewCHDXAngTemp1
KL_MMedge5=KL_MMedge3-KL_LuLengMode
for n=1 to KL_MMedge5 do(KL_Cm1=n*(KGL_XUPathLeng+KGL_ShiPathLeng)+(KL_LuLengMode*(KGL_XUPathLeng+KGL_ShiPathLeng))
KL_NewCHDXTemp1=#((interpCurve3D KL_NewSp KL_SplinEnml[m] KL_Cm1))
KL_NewCHDXAngTemp1=#((normalize(cross worldUpVector(tangentCurve3D KL_NewSp KL_SplinEnml[m] KL_Cm1)))) 
for bb=1 to KBC_SP4.value do(append KL_NewCHDXTemp1 (interpCurve3D KL_NewSp KL_SplinEnml[m] (KL_Cm1+(bb*(KGL_ShiPathLeng/KBC_SP4.value))))
append KL_NewCHDXAngTemp1 (normalize(cross worldUpVector(tangentCurve3D KL_NewSp KL_SplinEnml[m] (KL_Cm1+(bb*(KGL_ShiPathLeng/KBC_SP4.value)))))))
append KL_NewCHDX KL_NewCHDXTemp1
append KL_NewCHDXAng KL_NewCHDXAngTemp1)
for n=1 to KL_MMedge5 do(KL_Cm1=(n-1)*(KGL_XUPathLeng+KGL_ShiPathLeng)+(KGL_XUPathLeng+KGL_ShiPathLeng)
KL_NewCHDXTemp1=#((interpCurve3D KL_NewSp KL_SplinEnml[m] KL_Cm1))
KL_NewCHDXAngTemp1=#((normalize(cross worldUpVector(tangentCurve3D KL_NewSp KL_SplinEnml[m] KL_Cm1)))) 
for bb=1 to KBC_SP4.value do(append KL_NewCHDXTemp1 (interpCurve3D KL_NewSp KL_SplinEnml[m] (KL_Cm1+(bb*(KGL_ShiPathLeng/KBC_SP4.value))))
append KL_NewCHDXAngTemp1 (normalize(cross worldUpVector(tangentCurve3D KL_NewSp KL_SplinEnml[m] (KL_Cm1+(bb*(KGL_ShiPathLeng/KBC_SP4.value)))))))
append KL_NewCHDXBB KL_NewCHDXTemp1
append KL_NewCHDXAngBB KL_NewCHDXAngTemp1)
KL_NewCHDXTemp1=#()
KL_NewCHDXAngTemp1=#() 
for a=1 to KL_MMedge4 do(append KL_NewCHDXTemp1 (interpCurve3D KL_NewSp KL_SplinEnml[m] (((a-1)*KL_CenterInp5)+((KL_AAnum-KL_LuLengMode)*(KGL_XUPathLeng+KGL_ShiPathLeng))))
append KL_NewCHDXAngTemp1 (normalize(cross worldUpVector(tangentCurve3D KL_NewSp KL_SplinEnml[m] (((a-1)*KL_CenterInp5)+((KL_AAnum-KL_LuLengMode)*(KGL_XUPathLeng+KGL_ShiPathLeng)))))))   ---获得中心线位置和角度
append KL_NewCHDXBB KL_NewCHDXTemp1                      ----其中KL_NewCHDXAA为头实部分,KL_NewCHDXBB为尾实部分
append KL_NewCHDXAngBB KL_NewCHDXAngTemp1))))			  ----获得车道虚线点和角度复合数组
KL_MMedge8=KL_NewRXHD.count
if KL_MMedge8==0 then(messageBox "当前选择图形或选择的子样条线长度太短或太长,请检查场景单位!" title:"阿酷车道线生成工具--阿酷提示"
undo off(delete KL_NewSp))
else(KL_NewSplineA=SplineShape()
for m=1 to KL_MMedge8 do(addNewSpline KL_NewSplineA
KL_MMedge9=KL_NewRXHD[m].count
for n=1 to KL_MMedge9 do addKnot KL_NewSplineA m #corner #line KL_NewRXHD[m][n])
updateShape KL_NewSplineA             ----人行横道源样条线(单对点)
KL_NewSplineC=SplineShape()
KL_MMedge10=KL_CenterLine.count
for m=1 to KL_MMedge10 do(addNewSpline KL_NewSplineC
KL_MMedge11=KL_CenterLine[m].count
for n=1 to KL_MMedge11 do addKnot KL_NewSplineC m #corner #line KL_CenterLine[m][n])
updateShape KL_NewSplineC             ---中心线源样条线(规格化连续点),将派生车流线,中心线
if KL_RuBu1.state==2 then(KL_NewSplineD=SplineShape()
KL_MMedge12=KL_MapCenterLine.count
for m=1 to KL_MMedge12 do(addNewSpline KL_NewSplineD
KL_MMedge13=KL_MapCenterLine[m].count
for n=1 to KL_MMedge13 do addKnot KL_NewSplineD m #corner #line KL_MapCenterLine[m][n])
updateShape KL_NewSplineD             ---贴图模式需要用到的中心线部分(比实建的多出半个空档长度)
KL_HHHSpline=copy KL_NewSplineA	   
addModifier KL_HHHSpline (Extrude amount:(-200*Syun))
addModifier KL_HHHSpline (Shell innerAmount:((KL_SP7.value/2)+KL_DriXuLength) outerAmount:((KL_SP7.value/2)+KL_DriXuLength))
convertToMesh KL_HHHSpline
KL_MMedge14=getNumFaces KL_HHHSpline
KL_NewSel=for m=1 to KL_MMedge14 where (acos(dot [0,0,1] (getFaceNormal KL_HHHSpline m)))>45 collect m
meshop.deleteFaces KL_HHHSpline KL_NewSel delIsoVerts:true
KL_opEd=meshop.getOpenEdges KL_HHHSpline
KL_opVerter=((meshop.getVertsUsingEdge KL_HHHSpline KL_opEd)as array).count
setNumTVerts KL_HHHSpline KL_opVerter
KL_ZongNum=KL_opVerter/2
buildTVFaces KL_HHHSpline
KL_MMedge33=getNumFaces  KL_HHHSpline
for m=1 to getNumFaces  KL_HHHSpline do setTVFace KL_HHHSpline m (getFace KL_HHHSpline m)
KL_MMp=0
for aa=1 to KL_ZongNum by 2 do(setTVert KL_HHHSpline aa [0,0,0]
setTVert KL_HHHSpline (aa+1) [1,0,0]
KL_MidDistInit=KL_SP7.value/(distance(getVert KL_HHHSpline aa) (getVert KL_HHHSpline (aa+1)))
