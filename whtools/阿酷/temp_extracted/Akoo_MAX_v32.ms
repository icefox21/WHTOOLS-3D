on lcl_RanMSR_roll open do(KLSel=for i in selection where not(isGroupMember i and not isOpenGroupMember i) and isProperty i "rotation" collect i
for m in KLSel do(for r=1 to 3 do(setUserProp m ("Move"+(r as string)) m.pos[r]
setUserProp m ("Scale"+(r as string)) m.scale[r])
setUserProp m "Rotate1" m.rotation.x_rotation
setUserProp m "Rotate2" m.rotation.y_rotation
setUserProp m "Rotate3" m.rotation.z_rotation))
on lcl_RanMSR_roll rbuttondown vvdd do DestroyDialog lcl_RanMSR_roll
)
CreateDialog lcl_RanMSR_roll width:223 height:446 pos:[(mouse.screenpos[1]-223),mouse.screenpos[2]])
if (getINISetting (getMAXIniFile()) "akoo2009" "GetInstanModify")=="" do setINISetting (getMAXIniFile()) "akoo2009" "GetInstanModify" "0"
if (getINISetting (getMAXIniFile()) "akoo2009" "GetInstanModMAT")=="" do setINISetting (getMAXIniFile()) "akoo2009" "GetInstanModMAT" "1"
if (getINISetting (getMAXIniFile()) "akoo2009" "ByMatNameHouZ")=="" do setINISetting (getMAXIniFile()) "akoo2009" "ByMatNameHouZ" "1"
fn ModifyObj kk=(kk.modifiers.count>0)
global PivotTransform
fn lcl_PRO_GetMat=
(undo on(	
kugegetM=for i in selection where ViewgeoFilt i collect i  
if kugegetM.count>0 do(if findItem (gw.getRndLimits()) #wireFrame!=0 do max wire facet
lclMatpik=pickObject message:"点击材质获取对象:" filter:ViewgeoFilt)
if lclMatpik!=undefined then(for uu in kugegetM do(uu.Material=lclMatpik.Material
if displayColor.shaded==#object do uu.wireColor=lclMatpik.wireColor))
else(for uu in kugegetM do(uu.Material=kugegetM[1].Material
if displayColor.shaded==#object do uu.wireColor=kugegetM[1].wireColor))))
fn lcl_PRO_GetCol=
(undo on(	
if selection.count>0 do(if findItem (gw.getRndLimits()) #wireFrame==0 do max wire facet
lclColpik=pickObject message:"点击线框颜色获取对象:")
if lclColpik!=undefined then for uu in selection do uu.wireColor=lclColpik.wireColor
else for uu in selection do uu.wireColor=selection[1].wireColor))
fn lcl_PRO_GetModify=
(undo on(	
kugemkse=#()
lclMatpik=undefined
kugegetM=getCurrentSelection()
if kugegetM.count>0 do
(lclMatpik=pickObject message:"点击修改器获取对象:" filter:ModifyObj
if lclMatpik!=undefined then
(lclj1=for jj in lclMatpik.modifiers  collect jj
lclj1=for kk=1 to lclj1.count collect lclj1[lclj1.count+1-kk]
lclKm=for m in lclj1 collect m.name
for f in kugegetM do(lclj2=for jj in f.modifiers  collect jj
lclj2=for kk=1 to lclj2.count collect lclj2[lclj2.count+1-kk]
lclKm2=for m in lclj2 collect m.name
KlModinu=try(findItem lclKm lclKm2[(lclKm2.count)])catch(0)
for ff=(KlModinu+1) to lclj1.count do if validModifier f lclj1[ff] do
(addModifier f lclj1[ff]
if (getINISetting (getMAXIniFile()) "akoo2009" "GetInstanModify")=="0" do InstanceMgr.MakeModifiersUnique f lclj1[ff] #individual)
if(getINISetting (getMAXIniFile()) "akoo2009" "GetInstanModMAT")=="1" do try(if lclMatpik.Material!=undefined then f.Material=lclMatpik.Material
else f.wireColor=lclMatpik.wireColor)catch()))

else (if ModifyObj kugegetM[1] do(
lclj1=for jj in kugegetM[1].modifiers  collect jj
lclj1=for kk=1 to lclj1.count collect lclj1[lclj1.count+1-kk]
lclKm=for m in lclj1 collect m.name
for f in kugegetM do(lclj2=for jj in f.modifiers  collect jj
lclj2=for kk=1 to lclj2.count collect lclj2[lclj2.count+1-kk]
lclKm2=for m in lclj2 collect m.name
KlModinu=try(findItem lclKm lclKm2[(lclKm2.count)])catch(0)
for ff=(KlModinu+1) to lclj1.count do if validModifier f lclj1[ff] do
(addModifier f lclj1[ff]
if (getINISetting (getMAXIniFile()) "akoo2009" "GetInstanModify")=="0" do InstanceMgr.MakeModifiersUnique f lclj1[ff] #individual)
if(getINISetting (getMAXIniFile()) "akoo2009" "GetInstanModMAT")=="1" do try(if kugegetM[1].Material!=undefined then f.Material=kugegetM[1].Material
else f.wireColor=kugegetM[1].wireColor)catch()))))))
fn lcl_PRO_NameBymat=
(KL_ByMatName=(getINISetting (getMAXIniFile()) "akoo2009" "ByMatNameHouZ")=="1"
undo on(if KL_ByMatName then(KL_Rel7=#()
KL_Rel7obj=#()
for o in objects where kugegeoFilt o do if (KL_GGGB=findItem KL_Rel7 o.material)==0 then(append KL_Rel7 o.material
append KL_Rel7obj #(o))
else append KL_Rel7obj[KL_GGGB] o
for m=1 to KL_Rel7obj.count do for n=1 to  KL_Rel7obj[m].count do if KL_Rel7[m]!=undefined then KL_Rel7obj[m][n].name=KL_Rel7[m].name+(n as string)
else KL_Rel7obj[m][n].name="Undefined"+(n as string))
else for o in objects where kugegeoFilt o do if o.Material!=undefined then o.name=o.Material.name
else o.name="Undefined"))
fn lcl_PRO_SelColRandom=
(undo on(	
kugerancol=random black white 
for i in selection do i.wireColor =kugerancol))
fn lcl_PRO_ColBymat=
(undo on(	
KL_MoucMat=#()
KL_MoucCol=#()
for m in objects where kugegeoFilt m do if (KL_PUTR=findItem KL_MoucMat m.Material)==0 then(KL_color=random black white
m.wireColor=KL_color
append KL_MoucCol KL_color
append KL_MoucMat m.Material)
else m.wireColor=KL_MoucCol[KL_PUTR]))
fn lcl_PRO_ColByGroup=
(undo on(	
lclbygroHead=for ggg in objects where isGroupHead ggg collect ggg
lclbygroram=(for h=1 to lclbygroHead.count collect(random black white))
for o in objects  where isGroupMember o do o.wireColor=lclbygroram[findItem lclbygroHead o.parent]))		
fn lcl_PRO_CastWhite=
(undo on(	
lcl_Colcol=#()
lcl_Colobj=#()
for o in objects where (o.wireColor.r==o.wireColor.g and o.wireColor.r==o.wireColor.b and o.wireColor.r+o.wireColor.g+o.wireColor.b>=675)or(o.wireColor.r+o.wireColor.g+o.wireColor.b>=735)do 
(if (kugenum=findItem lcl_Colcol o.wireColor)==0 then(append lcl_Colcol o.wireColor
append lcl_Colobj #(o))
else append lcl_Colobj[kugenum] o)
for gg=1 to lcl_Colobj.count do(kugerancol=random black white 
for i in lcl_Colobj[gg] do i.wireColor =kugerancol)))
fn lcl_PRO_ColBlack=
(undo on(for o in objects where kugegeoFilt o do o.wireColor=black))
global KHT_PivotTools,KGL_RootobjColl
tool KHT_PivotTools      -----鼠标定位场景对象工具函数:全局变量KGL_GronoffNmae,用来定义多选择复制时的组结构名字;
(on freeMove do(if(KL_CSD=snapMode.worldHitpoint)!=undefined then  PoAP1=KL_CSD    ----这里要保证第一和第二次鼠标动作都能定义到第一个落点(鼠标位置点或精确捕捉点)
else PoAP1=worldPoint
print PoAP1
for m in KGL_RootobjColl do m.pivot=PoAP1)         ----调用命令自动进入面定位模式,右键退出
on mousePoint abc do(if abc==1 then PivotTransform.KL_VV3.checked=false
else #stop)   ----如果不为多个放置模式,则停止移动和创建;
on mouseAbort aa do(#stop))   ----如果右键退出取消命令:停止工具,寄存选择,禁止选择,删除选择对象;	 
fn lcl_PRO_CenPivot=
(try(DestroyDialog PivotTransform)catch()	
rollout PivotTransform "轴点定位" width:180 height:40
(button KL_VV1 "归中" pos:[10,10]
button KL_VV2 "归底" pos:[70,10]	
checkbutton KL_VV3 "捕捉" pos:[130,10]	
on KL_VV1 pressed do for m in selection do m.pivot=m.center
on KL_VV2 pressed do for m in selection do m.pivot=[m.center.x,m.center.y,m.min.z]
on KL_VV3 changed aa  do if aa do
(snapMode.active=true
if selection.count>0 do
(KGL_RootobjColl=#()
KHF_CollSrcRootNodes selection KGL_RootobjColl
if KGL_RootobjColl.count>1 then KL_QQ=queryBox "当前选择有多组对象,确定要将轴心点对齐到当前捕捉点吗?"  title:"轴点定位工具警告--阿酷提示"
else KL_QQ=true
print KL_QQ 
if KL_QQ do startTool KHT_PivotTools snap:#3D numPoints:2))
on PivotTransform open do maxOps.pivotMode=#pivotOnly
on PivotTransform close do(maxOps.pivotMode=#none
completeRedraw())
on PivotTransform a do DestroyDialog PivotTransform)
CreateDialog PivotTransform pos:[(mouse.screenpos[1]-230),mouse.screenpos[2]])		
global  lcl_OverObj_Nor
fn lcl_Purge_ZeroFace=
(undo on(PU_NullOBJ=0
KL_111=#()
kugeselect=getCurrentSelection()
if getCommandPanelTaskMode()!=#create do setCommandPanelTaskMode mode:#create
thawSelection()
clearSelection()     
kugeZFdel=for t in geometry where((getPolygonCount t)[1]==0 and canConvertTo t Mesh)or classof t==LinkComposite collect t 
KUgefff=for h in shapes where classof h==PolymorphicGeomshape or classof h==LinkCompositeshape collect h
join kugeZFdel KUgefff
for m in kugeZFdel do(if m.children!=undefined do for o in m.children do deleteItem m.children o
if m.parent!=undefined do m.parent=undefined)
PU_NullOBJ+=kugeZFdel.count
for u in objects do if isGroupMember u and u.parent==undefined then(setGroupMember u false
PU_NullOBJ+=1)
else if isGroupHead u and u.children.count==0 do(append kugeZFdel u
PU_NullOBJ+=1)
delete kugeZFdel                 
kugeselect=for ji in kugeselect where IsValidNode ji collect ji
select kugeselect
messageBox ("共搜索并删除"+ PU_NullOBJ as string + "个空物体") title:"清理结果--阿酷提示"))					
fn lcl_Purge_AllGroup=
(KL_QQ=queryBox "确定要清除当前场景所有组结构吗?"  title:"阿酷清理工具警告--阿酷提示"
if KL_QQ do(undo on(
local kugeexg
thawSelection()
clearSelection()
for gf in objects where isOpenGroupHead gf do setGroupOpen gf false
kugeexg=for jj in objects where isGroupHead jj and not isGroupMember jj collect jj
explodeGroup kugeexg
gc light:true
messageBox ("场景所有组清除完毕!") title:"清理结果--阿酷提示")))
fn lcl_Purge_NullLayer=
(KL_QQ=queryBox "确定要清除当前场景所有未包含对象的空图层吗?"  title:"阿酷清理工具警告--阿酷提示"
if KL_QQ do(undo on(
local  lclLA,lclLAnum
lclLA=LayerManager.getLayer 0     
lclLA.current=true                  
lclLAnum=LayerManager.count	
KL_VMNB1=lclLAnum-1              
for u=1 to KL_VMNB1 do(xyjLA=LayerManager.getLayer (lclLAnum-u)     
xyjLA.nodes &kugelayer                     
if kugelayer.count==0 do LayerManager.deleteLayerByName xyjLA.name) 
gc light:true
messageBox ("场景所有空层清除完毕!") title:"清理结果--阿酷提示")))
fn lcl_Purge_AllLayer=
(KL_QQ=queryBox "确定要清除场景所有图层吗?"  title:"阿酷清理工具警告--阿酷提示"
if KL_QQ do(undo on(
lclAllLA=LayerManager.getLayer 0     
lclAllLA.current=true                
for i in objects do lclAllLA.addnode i    
lcl4=LayerManager.count	
KL_VMNB1=lcl4-1             
for u=1 to KL_VMNB1 do(xyj1=LayerManager.getLayer (lcl4-u)     
LayerManager.deleteLayerByName xyj1.name) 
gc light:true
messageBox ("场景所有图层清除完毕!") title:"清理结果--阿酷提示")))
fn lcl_Purge_ViewShape=
(KL_QQ=queryBox "确定要清除所有未被隐藏或冻结的图形对象吗?"  title:"阿酷清理工具警告--阿酷提示"
if KL_QQ do(undo on(
local kugeVIshape
kugeVIshape=#()
kugeselect=getCurrentSelection()
thawSelection()
clearSelection()               
for ii in objects where ViewshapeFilt ii do
(kugeAA=#()
KL_nnnnb1=refs.dependents ii
for lp in KL_nnnnb1 where IsValidNode lp do if kugegeoFilt lp or kugeshapeFilt lp do append kugeAA lp
if kugeAA.count==0 do append kugeVIshape ii)                                             
delete kugeVIshape     
messageBox ("共搜索并清除"+ kugeVIshape.count as string + "个可视图形对象") title:"清理结果--阿酷提示"                   
kugeselect=for ji in kugeselect where IsValidNode ji collect ji
select kugeselect
gc light:true)))							
fn lcl_Purge_AllShape=
(KL_QQ=queryBox "确定要清除所有图形对象吗?"  title:"阿酷清理工具警告--阿酷提示"
if KL_QQ do(undo on(
kugeselect=getCurrentSelection()
thawSelection()
clearSelection()
kugergary=#()
kugeVIshape1=for ii in objects where kugeshapeFilt ii collect ii
KL_nnnnb1=kugeVIshape1.count
for kk=1 to KL_nnnnb1 do(KL_nnnnb2=refs.dependents kugeVIshape1[kk]
for lpm in KL_nnnnb2 where IsValidNode lpm do append kugergary lpm)
for tt in shapes where classof tt!=PolymorphicGeomshape and classof tt!=LinkCompositeshape do if tt.baseobject.renderable do append kugergary tt
kugerefO=for kk in kugergary where kugegeoFilt kk collect kk
convertToMesh kugerefO
kugeVIshape=for ii in objects where kugeshapeFilt ii collect ii                                                             
delete kugeVIshape     
messageBox ("共搜索并清除"+ kugeVIshape.count as string + "个图形对象") title:"清理结果--阿酷提示"                   
kugeselect=for ji in kugeselect where IsValidNode ji collect ji
select kugeselect
gc light:true)))
fn lcl_Purge_UVWMap=
(KL_QQ=queryBox "确定要清除选择对象的贴图坐标吗?"  title:"阿酷清理工具警告--阿酷提示"
if KL_QQ do(undo on(kugehga=getCurrentSelection()
thawSelection()
clearSelection()
KL_nnnnb2=kugehga.count
for i=1 to KL_nnnnb2 do(kugeMOFnum=kugehga[i].modifiers.count   
for uu=1 to kugeMOFnum where findItem kugeMapModAr kugehga[i].modifiers[kugeMOFnum+1-uu].name!=0 do deleteModifier kugehga[i] (kugeMOFnum+1-uu))
kugehga=for ji in kugehga where IsValidNode ji collect ji
select kugehga
gc light:true
messageBox ("选择对象贴图坐标修改器清理完毕!") title:"清理结果--阿酷提示")))
fn  lcl_Purge_LoseTexmap=
(local KL_Coll1=#(),KL_Coll2=#(),KL_Coll3=#(),KL_Coll4=#(),KL_Coll5=#()
KL_QQ=queryBox "你确定要清除当前场景所有丢失路径的材质贴图吗?"  title:"阿酷清理工具警告--阿酷提示"
if KL_QQ do
(thawSelection()
clearSelection()  
renderSceneDialog.close()   ---关闭渲染设置面板以防更新问题;
NF_Render_SceneBitMan undefined selection #(KL_Coll1,KL_Coll2,KL_Coll3,KL_Coll4,KL_Coll5) #()  ----收集场景资源处理;
KL_GGH=KL_Coll4.count                                           ----统计是否丢失状态数组;
KL_BDN=for j=1 to KL_GGH where KL_Coll4[j] collect j         ----统计已经丢失的条目
KL_FFJ=KL_BDN.count
for m=1 to KL_FFJ do(KL_Zonnum=KL_BDN[(KL_FFJ+1-m)]     -----获得当前条目数,注意这里是从数组的后面开始往前处理,保证不会因为删除前面成员影响整个数组的问题;
KHF_VrBitmapLightShu KL_Zonnum "" KL_Coll2 KL_Coll3   ----废弃条目处理
deleteItem KL_Coll1 KL_Zonnum
deleteItem KL_Coll2 KL_Zonnum
deleteItem KL_Coll3 KL_Zonnum
deleteItem KL_Coll4 KL_Zonnum
deleteItem KL_Coll5 KL_Zonnum) 
messageBox ("场景丢失贴图("+KL_FFJ as string +"个)清理完毕") title:"清理结果--阿酷提示"))
fn  lcl_Purge_AllTexmap=
(KL_QQ=queryBox "你确定要清除当前场景所有材质贴图吗?"  title:"阿酷清理工具警告--阿酷提示"
if KL_QQ do(KL_Missexist=0
KL_lclarray=#()
if environmentMap!=undefined do(environmentMap=undefined  
useEnvironmentMap=false
KL_Missexist+=1)
if backgroundImageFileName!="" do(backgroundImageFileName="" 
completeRedraw()
KL_Missexist+=1)
for o in objects where kugegeoFilt o and o.Material!=undefined and (findItem KL_lclarray o.material)==0 do(append KL_lclarray o.material 
lcl_subMatcoll KL_lclarray o.material)

for w in KL_lclarray do(KL_nnnnb5=getNumSubTexmaps w
for y=1 to KL_nnnnb5 do if getSubTexmap w y !=undefined do(setSubTexmap w y None
KL_Missexist+=1)
showTextureMap w on)
messageBox ("场景所有贴图("+KL_Missexist as string +"个)清理完毕") title:"清理结果--阿酷提示"))
