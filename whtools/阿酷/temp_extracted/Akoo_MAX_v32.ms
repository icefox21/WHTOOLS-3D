KF_KLMN "A" ""
DestroyDialog KR_SceObjGroSel3)
on KC_BT1 pressed do(KC_DL11.text="灯光层选择"
KF_KLMN "C" ""
DestroyDialog KR_SceObjGroSel3))
on KC_DL11 pressed do(KL_MBselCd=KC_MB15.selection as array
if KL_MBselCd.count>0 do
(KL_CCCt=(KF_SceneLIghtGro false)[1]
if KL_CCCt.count>-1 do(KLN_LigGroNmeColl=KL_CCCt
try(DestroyDialog KR_SceObjGroSel3)catch()
CreateDialog KR_SceObjGroSel3)))
rollout KR_SceGroSel3 "对象层选择"  width:127
