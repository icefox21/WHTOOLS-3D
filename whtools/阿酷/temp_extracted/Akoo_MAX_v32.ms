)
if YY!=undefined then YY.value=j*100.0/KL_CCpu
else progressUpdate(j*100.0/KL_CCpu))
if KG_DiagnoseMode do print "其它条目收集完成,下面开始收集材质......"
KL_newport=YYY.count
