button KC_BU1 "随机种子" enabled:KC_CB1.state pos:[55,50]
edittext KC_BU2 "实际" text:KL_TruDirN enabled:false pos:[140,56] fieldWidth:40 visible:(KC_Sub1.enabled and not KC_BU1.enabled)
button KC_BUA "结组" pos:[10,77] width:35
button KC_BUB "全选" pos:[54,77] width:35
