local DriveLineWidth=(getINISetting (getMAXIniFile()) "akoo2009" "DriveLineWidth")as float
local DriveLineItem1=(getINISetting (getMAXIniFile()) "akoo2009" "DriveLineItem1")=="1"
local DriveLineItem2=(getINISetting (getMAXIniFile()) "akoo2009" "DriveLineItem2")=="1"
local DriveLineItem3=(getINISetting (getMAXIniFile()) "akoo2009" "DriveLineItem3")=="1"
local DriveLineDouS=(getINISetting (getMAXIniFile()) "akoo2009" "DriveLineDouS")as Integer
