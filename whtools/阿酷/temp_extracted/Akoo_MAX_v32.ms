on KC_MBA pressed do
(renderSceneDialog.close()   ---关闭渲染设置面板以防更新问题;
---KL_BDN=KCXMLB1.selection as array      这里到时需要考虑是不是需要仅处理选择,还是总是全部;
KL_MMMPP5=KGM_BitmFiNa.count
if KL_MMMPP5>0 do   ----如果存在外部资源数组集合;
(KL_Q11=getSavePath caption:"设置归档路径" initialDir:maxFilePath   ---设置归档路径;
if KL_Q11!="" and KL_Q11!=undefined do     -----如果归档目标路径有效的情况下;注意存在""和undefined两种无效的情况;
(KL_CUOWU=#()          ----初始化归引未成功条目收集数组变量(不同的目标文件已存在或复制处理失败[如无权限])
for m=1 to  KL_MMMPP5 do(if KC_CollFCoMR.checked then KL_State=KHF_UpperLcase(getFilenameType KGM_BitmFiNa[m])!=".vrmesh"    
else KL_State=true
if KL_State do KHF_CollExfFileSub(KL_Q11+"\\")m KL_CUOWU KC_PGB1 m KL_MMMPP5 KC_CollFCoDP 1)  ----为每一个资源条目进行归引处理;
try(gc())catch()
KGM_ShortBitNa=#()
KHF_LongNaShor KGM_BitmFiNa KGM_ShortBitNa KGM_StyPeiNa 6   -----重新初始化和调用函数转换集合短路径名数组,将加载到资源面板列表框;
KHF_ASSMAUinitFN false KR_SceneBitlist.KC_PGB1 true ----重新刷新资源收集面板;
KL_Netname=""            ----初始化归引变量字符串;
if KC_CollFCoRR.checked do(if(KL_Q11+"\\")!=maxFilePath do if maxFileName!=""then KL_Netname=(KL_Q11+"\\")+maxFileName  ---如果需要收集MAX,则检测MAX文件是否当前已在那目录,如果不在则组出目标路径名;
else KL_Netname=(KL_Q11+"\\")+"Untitled.max"
if KL_Netname!=""and not(doesFileExist KL_Netname)then saveMaxFile KL_Netname useNewFile:false  ---如果Max不已在那目录,则检测是否目标路径已存在,不存在的话进行保存副本;
else messageBox ("目标路径已存在同名Max文件,请核对后再手动处理!") title:"资源收集警告--阿酷提示")
ShellLaunch KL_Q11 ""
messageBox ("成功收集"+((KL_MMMPP5-KL_CUOWU.count)as string)+"个外部文件(失败"+(KL_CUOWU.count as string)+"个,请检查权限或重名冲突!)") title:"资源收集警告--阿酷提示")))    ----处理结果提示;

on KC_MBE pressed do
(KL_BDN=KCXMLB1.selection as array   ---所有选择条目;
KL_VCX1=#()  ---初始化材质或贴图收集数组;
for m in KL_BDN do for n in KGM_MMTTFiNa[m] do(if(SuperClassOf n[1]==material or SuperClassOf n[1]==textureMap)and findItem KL_VCX1 n[1]==0 do append KL_VCX1 n[1]  ----如果是材质或贴图对象类型直接收集;
if isProperty n[1] "material" and(findItem KL_VCX1 n[1].material==0)do append KL_VCX1 n[1].material)   ----如果是几何体对象类型直接收集其材质;
if KL_VCX1.count>0 do KHF_KGMaterialsED KL_VCX1)	  ----如果收集得有材质,将对其进行装载;
on KC_MBF pressed do
(KL_Sty1=#("VPR  ","XRO  ","XPR  ")
KL_Sty2=#("IRR  ","PHO  ","LIC  ","CAU  ","VENV  ","VREL  ","VRER  ")
KL_Sty3=#("WEB  ","PRO  ","SHA  ","SUN  ","VSUN  ")             ----预定义好大类的对象类型名,好用在后面进行整体的匹配检查;
KL_BDN=KCXMLB1.selection as array
kughtrue=true
KL_ObjEctColl=#()         ----初始化相关对象集合数组
KL_XfeEctColl=false       ----初始化参考场景管理状态
KL_BJfioll=false          ----初始化视口背景面板状态
KL_Renderoll=false        ----初始化渲染设置面板状态
KL_ENVeroll=false         ----初始化环境效果面板状态
KL_MPBN1A=KL_BDN.count
for ii=1 to KL_MPBN1A do     ----遍寻所有条目;
(X=KL_BDN[ii]            ----获得当前具体序号数(资源条目数组序号)
KL_MMMPP8=KGM_StyPeiNa[X].count    ----为每一个引用对象进行遍寻处理;
for Z=1 to KL_MMMPP8 do
case of
(    
((findItem KL_Sty1 KGM_StyPeiNa[X][Z])!=0):(if IsValidNode KGM_MMTTFiNa[X][Z][1] and findItem KL_ObjEctColl KGM_MMTTFiNa[X][Z][1]==0 do(InstanceMgr.GetInstances KGM_MMTTFiNa[X][Z][1] &KV_BBGch    ---Vray代理保证是删除所有关联对象;
join KL_ObjEctColl KV_BBGch))
(KGM_StyPeiNa[X][Z]=="XRS  "):(KL_XfeEctColl=true)
(KGM_StyPeiNa[X][Z]=="VBA  "):(KL_BJfioll=true)
((findItem KL_Sty2 KGM_StyPeiNa[X][Z])!=0):(KL_Renderoll=true)
(KGM_StyPeiNa[X][Z]=="ENV  "):(KL_ENVeroll=true)	  
((findItem KL_Sty3 KGM_StyPeiNa[X][Z])!=0):(KL_MMMPP10=refs.dependents KGM_MMTTFiNa[X][Z][1]
for n in KL_MMMPP10 where IsValidNode n and SuperClassOf n==light and findItem KL_ObjEctColl n==0 do append KL_ObjEctColl n)
(KGM_StyPeiNa[X][Z]=="MAT  "):(KL_MMMPP10=refs.dependents KGM_MMTTFiNa[X][Z][1]
for n in KL_MMMPP10 where IsValidNode n and(SuperClassOf n==GeometryClass or SuperClassOf n==shape)and findItem KL_ObjEctColl n==0 do append KL_ObjEctColl n)
)
)
if KL_XfeEctColl do max file xref scene
if KL_BJfioll do max background
if KL_Renderoll do(renderSceneDialog.close()
renderSceneDialog.open())
if KL_ENVeroll do envEffectsDialog.Open()
if KL_ObjEctColl.count>0 do
(thawSelection()
clearSelection()
lcl_AAA=for gg in KL_ObjEctColl where gg.isHiddenInVpt==true or gg.isFrozen==true collect gg
if lcl_AAA.count>0 do kughtrue=queryBox "新选择集中包含有不可选对象,选择操作:\n是：强制选择.\n否:取消选择!"title:"不可选对象选择警告--阿酷提示"
if kughtrue then Groupfiltrate KL_ObjEctColl true
else Groupfiltrate KL_ObjEctColl false
))		


on KC_MBS pressed do
(KL_BDN=KCXMLB1.selection as array
if KL_BDN.count>0 do
(KL_QQ=queryBox "此操作将原地修改外部源文件的文件名并更新引用,确定继续吗!"  title:"资源文件处理警告--阿酷提示"
if KL_QQ do
(KL_NEWnameAR=#()   ----新自动文件名列表,必须预统计进行检测是否存在冲突;
KL_t1=(KL_Edit3C1.selected as integer)     -----获得选择自动文件名字符数量;
if (KL_CCp1=KL_Edit1.text)=="" do KL_CCp1="Akoo"  ----赋值自定义前缀给变量KL_CCp1;
KL_MA1=substring(replace "0000000000" 1 KL_CCp1.count KL_CCp1)1 KL_t1   ----钳位计算出指定数量的文件名前缀;
KL_MMMPP5=KL_BDN.count
for p=1 to KL_MMMPP5 do(KL_FFpa=p as string           
KL_new=replace KL_MA1 (KL_t1+1-KL_FFpa.count) KL_FFpa.count KL_FFpa   ----按序号依次替换更新出符合规格的新文件名;
append KL_NEWnameAR KL_new)        -----集合指定数量的新文件名;
KL_KKK=for t=1 to KL_MMMPP5 collect (getFilenamePath KGM_BitmFiNa[(KL_BDN[t])]+KL_NEWnameAR[t]+toLower(getFilenameType KGM_BitmFiNa[(KL_BDN[t])])) ----转算出所有完整的目标路径名;
KL_CUOWU=#()
KL_old=for m in KL_KKK where doesFileExist m collect m
if KL_old.count==0 
then(for m=1 to  KL_MMMPP5 do KHF_CollExfFileSub KL_KKK[m] KL_BDN[m] KL_CUOWU KC_PGB1 m KL_MMMPP5 KC_CollFCoDP 2
try(gc())catch()
KGM_ShortBitNa=#()
KHF_LongNaShor KGM_BitmFiNa KGM_ShortBitNa KGM_StyPeiNa 6   -----重新初始化和调用函数转换集合短路径名数组,将加载到资源面板列表框;
KHF_ASSMAUinitFN false KR_SceneBitlist.KC_PGB1 true ----重新刷新资源收集面板;
KL_Netname=""            ----初始化归引变量字符串;
KL_FVF=KL_MMMPP5-KL_CUOWU.count
messageBox ((KL_FVF as string)+"个文件重命名成功!("+(KL_CUOWU.count as string)+"个文件重命名无效)!") title:"资源文件重命名警告--阿酷提示")
else messageBox "已存在目标文件名,请重新定义新前缀!" title:"资源文件重命名警告--阿酷提示")))												 
on KC_MBI2 pressed do
(KL_BDN1=KCXMLB1.selection as array   ----集合选择条目;
if KL_BDN1.count>0 do
(KL_QQ=queryBox "此操作将原地修改外部源文件的格式并更新引用,确定继续吗!" title:"资源文件处理警告--阿酷提示"
if KL_QQ do
(KL_t1=KL_Edit3C2.selected     ----获取目标格式名;
KL_BDN=for oo in KL_BDN1 where(toLower(getFilenameType KGM_BitmFiNa[oo]))!=KL_t1 collect oo   ----重新收集格式名不一样的选择条目(一样的就不需要转换了)
if KL_BDN.count>0 do        ----如果还是有需要转换的选择条目,继续处理;
(KL_MMMPP5=KL_BDN.count
KL_KKK=for t=1 to KL_MMMPP5 collect(getFilenamePath KGM_BitmFiNa[(KL_BDN[t])]+getFilenameFile KGM_BitmFiNa[(KL_BDN[t])]+KL_t1)
KL_CUOWU=#()
KL_old=for m in KL_KKK where doesFileExist m collect m
if KL_old.count==0 
then(for m=1 to  KL_MMMPP5 do KHF_CollExfFileSub KL_KKK[m] KL_BDN[m] KL_CUOWU KC_PGB1 m KL_MMMPP5 KC_CollFCoDP 3
freeSceneBitmaps()
try(gc())catch()
KGM_ShortBitNa=#()
KHF_LongNaShor KGM_BitmFiNa KGM_ShortBitNa KGM_StyPeiNa 6   -----重新初始化和调用函数转换集合短路径名数组,将加载到资源面板列表框;
KHF_ASSMAUinitFN false KR_SceneBitlist.KC_PGB1 true ----重新刷新资源收集面板;
KL_Netname=""            ----初始化归引变量字符串;
KL_FVF=KL_MMMPP5-KL_CUOWU.count
messageBox ((KL_FVF as string)+"个文件转换格式成功!("+(KL_CUOWU.count as string)+"个文件转换格式无效)!") title:"资源文件重命名警告--阿酷提示")
else messageBox "已存在目标文件名,请先核对处理!" title:"引用资源转换格式警告--阿酷提示"))))	
on KR_SceneBitlist open do KHF_ASSMAUinitFN true KR_SceneBitlist.KC_PGB1 true    
on KR_SceneBitlist lbuttondown aa do KCXMLB1.selection=#()            -----点击面板空白区域取消列表所有选择;
on KR_SceneBitlist rbuttondown fdsf do(DestroyDialog KR_SceneBitlist
try(DestroyDialog KR_CustBitSeR)catch())
on KR_SceneBitlist close do(try(DestroyDialog KR_CustBitSeR)catch()))   
CreateDialog KR_SceneBitlist style:#(#style_titlebar,#style_border,#style_sysmenu,#style_minimizebox)
)
)
