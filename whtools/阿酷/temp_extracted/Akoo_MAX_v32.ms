if (classOf KAP2)==Point3 do KC_Sub1.value=KG_AuCoJuLi=distance KAP1 KAP2)
on KC_Sub1 changed a do(KG_AuCoJuLi=a)
on KC_Sub2 changed a do(KG_AuCoXZJuLi=a)
on KC_RA1 changed a do(KG_AuCoMode=a)
on KC_RA2 changed a do(KG_AuCoXZMode=a
if a==1 then(KC_Sub2.enabled=false
KC_Sub1.caption="最大距离")
else(KC_Sub2.enabled=true
KC_Sub1.caption="限制距离"))
on KC_BU3 pressed do(KF_AuotConnFN()) 
on KC_BU2 pressed do(if kuge_singleshape selection do
(KL_Shap=selection[1]
KL_AA1=for p=1 to numsplines KL_Shap where (getKnotSelection KL_Shap p).count==1 collect p
if KL_AA1.count==1 do(KL_nn=(getKnotSelection KL_Shap KL_AA1[1])[1]
setFirstSpline KL_Shap KL_AA1[1]
updateShape KL_Shap
setKnotSelection KL_Shap 1 #(KL_nn)
splineOps.makeFirst KL_Shap)))
