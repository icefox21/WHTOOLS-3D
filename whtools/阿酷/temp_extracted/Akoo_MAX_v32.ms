on KC_MB15 selectionEnd do
(KL_A1=KC_MB15.selection as array
if KL_A1.count>0 do
(if KL_A1.count>1 
then(KC_ET14.text=(KL_A1.count as string)+"个相机选择"
KC_ET14.enabled=false
KC_DL11.text="灯光层选择"
KC_DL11X.text="对象层选择"
KC_CB13.checked=false)
else(KL_selCam=kugeKG_CamYYLI[(KL_A1[1])]
KC_ET14.enabled=true
KC_ET14.text=KL_selCam.name
if KL_selCam.KP_MulLightType=="A" then(KC_DL11.text="A")  
else if (KL_GGGG=KL_selCam.KP_MulLightGro)!=undefined and KL_GGGG!="" then KC_DL11.text=KL_GGGG
else KC_DL11.text="灯光层选择"
if (KL_GGGG=KL_selCam.KP_MulObjectGro)!=undefined and KL_GGGG!="" then KC_DL11X.text=KL_GGGG
else KC_DL11X.text="对象层选择"
KC_CB13.checked=KL_selCam.KP_Mulallow))) 
on KC_MB15 doubleClicked aa do(KF_SwitchCamObj kugeKG_CamYYLI[aa] 4 true XX1 XX2 XX3 XX4 #() #())
on KC_CB13 changed a do(KL_A1=KC_MB15.selection as array
for m in KL_A1 do kugeKG_CamYYLI[m].KP_Mulallow=a
Kl_CCmo=KR_Render_MulCam_Init()
kugeKG_CamYYLI=Kl_CCmo[1]
KG_RenCamlName=Kl_CCmo[2]
KC_MB15.items=KG_RenCamlName)	
on KC_ET14 entered p do(KL_SRStr=trimLeft p
if KL_SRStr!="" do(dd=(KC_MB15.selection as array)[1]
KL_oldname=kugeKG_CamYYLI[dd].name
kugeKG_CamYYLI[dd].name=KL_SRStr
KL_new=replace KG_RenCamlName[dd] 7 KL_oldname.count KL_SRStr
Kl_CCmo=KR_Render_MulCam_Init()
kugeKG_CamYYLI=Kl_CCmo[1]
KG_RenCamlName=Kl_CCmo[2]
KC_MB15.items=KG_RenCamlName))  
on KC_DL1X41 pressed do 
(KL_A1=KC_MB15.selection as array
if KL_A1.count>0 do                            
(for m in KL_A1 where kugeKG_CamYYLI[m].KP_MulLightType=="A" do
(undo off(if (KL_Layar=LayerManager.getLayerFromName kugeKG_CamYYLI[m].name)!=undefined then(KL_Layar.nodes &KL_CurLayObj
for nm in KL_CurLayObj do (LayerManager.getLayer 0).addnode nm)
else(KL_Layar=LayerManager.newLayerFromName kugeKG_CamYYLI[m].name)
KL_PPPLight=KF_CamAutoLIGHT kugeKG_CamYYLI[m] true KC_CP3.value (KC_RenC1.value*0.9) (KC_RenC1.value*0.6) (KC_RenC1.value*0.2) true
KL_Layar.addnode KL_PPPLight[1]
kugeKG_CamYYLI[m].KP_MulLightType=kugeKG_CamYYLI[m].name
kugeKG_CamYYLI[m].KP_MulLightGro=kugeKG_CamYYLI[m].name))
Kl_CCmo=KR_Render_MulCam_Init()
kugeKG_CamYYLI=Kl_CCmo[1]
KG_RenCamlName=Kl_CCmo[2]
KC_MB15.items=KG_RenCamlName))
rollout KR_SceObjGroSel3 "灯光层选择"  width:127 
(listbox KC_MB items:KLN_LigGroNmeColl height:KLN_LigGroNmeColl.count selection:0 pos:[5,5] width:117
button KC_BT1 "当前"  across:3 width:35 align:#left
