Kl_MNUpX=""
for m=1 to 8 do for n=1 to KGL_YouZFNum.count where KGL_YouZFNum[n]==m and KGL_YouxiaoKJO[n].checked and KGL_YouxiaoKJO[n].enabled do Kl_MNUpX+=KGL_YouZF[n]
KR_Render_Flow.KL_XRSX.text=substring Kl_MNUpX 1 (Kl_MNUpX.count-1)
KR_Render_Flow.KC_Cb5.enabled=KR_Render_Flow.KC_Yuyan5.enabled=KR_Render_Flow.KC_Bu551.enabled=KX_ReFl6B
KR_Render_Flow.KC_Cb8.enabled=KR_Render_Flow.KC_Bu91.enabled=KR_Render_Flow.KC_Sp9.enabled=KX_ReFl9B
KR_Render_Flow.KC_Cb7.enabled=KR_Render_Flow.KC_Yuyan7.enabled=KR_Render_Flow.KC_Sp8A.enabled=KX_ReFl8B
