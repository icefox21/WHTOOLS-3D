(radiobuttons KC_RA1 "" labels:#("最近连接","顺连模式") pos:[12,8] default:KG_AuCoMode
radiobuttons KC_RA2 "" labels:#("最大","范围") pos:[85,32] default:KG_AuCoXZMode
button KC_BU1 "交互指定" pos:[12,27] width:60
button KC_BU2 "设置始点" pos:[12,83] 
button KC_BU3 "自动连接处理" pos:[100,83] width:80
spinner KC_Sub1 "最大距离" range:[(100*Syun),(50000*Syun),(KG_AuCoJuLi*Syun)] type:#Float scale:(100*Syun) fieldWidth:45  pos:[12,58]
spinner KC_Sub2 "偏差" range:[(10*Syun),(1000*Syun),(KG_AuCoXZJuLi*Syun)] type:#Float scale:(10*Syun) fieldWidth:35  pos:[120,58] enabled:(KC_RA2.state==2)
on KC_BU1 pressed do(KAP1=pickPoint "起点:" snap:#3D 
