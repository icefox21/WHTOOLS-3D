KL_MMMP5=KGM_RIMatArray.count
if KL_MMMP5>24 then(KL_Qmenu=menuMan.createQuadMenu "AkooMatMenu" KL_RMname KL_RMname KL_RMname KL_RMname
KL_Qmenu_a=KL_Qmenu.getMenu 2
for m=1 to 24 do(KL_MM=menuMan.createActionItem ("AKRmmat"+(m as string)) "阿酷右键材质"
if KL_MM==undefined do(filein (KGXL_ZongMJLLCT[1][2]+"Akoo_PRO2009_STA.mcr")
