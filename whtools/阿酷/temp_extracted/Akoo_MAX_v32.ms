fn KF_TempMat_Fileserial=             -------临时材质库文件识别机制,检查缺少的或刷新追加至最末端;更新替换保存临时场景右键文件;
(local KL_CCC=""
local KL_TempMatLib=materialLibrary()
for m=1 to KGM_RIMatArray.count do append  KL_TempMatLib KGM_RIMatArray[m]
KL_TempMatName=(filterString AK_LegalityUser "_")[1]
KL_KCV=try(fileProperties.getPropertyValue #custom(fileProperties.findProperty #custom "KugeMat_Temp"))catch("")  ----文件属性读取是如果空值时直接出错,所以需要try为""
if KL_KCV!="" then KL_CCC=((GetDir #maxroot)+"materiallibraries")+"\\"+KL_KCV+".mat"
else(KL_BVa=KL_TempMatName+"TempM" 
if doesFileExist(KL_CCC=((GetDir #maxroot)+"materiallibraries")+"\\"+KL_BVa+".mat") do deleteFile KL_CCC)
fileProperties.addProperty #custom "KugeMat_Temp" (getFilenameFile KL_CCC)
saveTempMaterialLibrary  KL_TempMatLib  KL_CCC
KL_TempMatLib=undefined
KL_CCC)
fn KF_compareFN v1 v2 valArray: =    -----右键材质排序计算函数;
(KL_Bv1i=valArray[v1]     -----注意这里一定是要这种格式,这里的V1和V2只是表示目标数组里的序号而非数组元素
KL_Bv2i=valArray[v2]
KL_BJJGd=KL_Bv1i-KL_Bv2i
case of
(
(KL_BJJGd<0.):(-1)
(KL_BJJGd>0.):(1)
(default):(0)
)
)
RenderMatPro=attributes Akooattributes3   ----右键材质球自定义属性容器;
(parameters main 
(KP_MatSequ type:#Integer 
KP_MatExtr type:#float 
KP_MatCaps type:#boolean))
fn KF_MatPar_Init aa bb cc=                      ----原始材质球添加到右键材质面板时的初始化操作,保证足够的可用参数;
(KF_SceneUnitsJC()
local kugXinit3=((getINISetting (getMAXIniFile()) "akoo2009" "KUGEExtrudeAmout2")as Float)
local bbFFF=#()
if cc do(local KL_Temp=join #() aa
local KL_CBV=for m=1 to KL_Temp.count collect (KL_Temp[m].name+"="+(m as string))   -----收集数组元素的名字和序号
sort KL_CBV  
KL_PXArray=for t in KL_CBV collect ((filterString t "=")[2]as Integer)
aa=for m=1 to KL_Temp.count collect KL_Temp[(KL_PXArray[m])])    ------材质球加载到右键材质设置面板时按正常的字母排序规格排序处理
for m=1 to aa.count where not(isProperty aa[m] "KP_MatSequ") do(custAttributes.add aa[m] RenderMatPro
aa[m].KP_MatSequ=m
aa[m].KP_MatExtr=kugXinit3
aa[m].KP_MatCaps=true)
if bb do(KL_Temp=join #() aa
KL_PXArray=for m=1 to KL_Temp.count collect m
KL_CBV=for nn in KL_Temp collect nn.KP_MatSequ
qsort KL_PXArray KF_compareFN valArray:KL_CBV         -----前面位需要排序定位的数组,后面变量为对应数量的比较规则数组
aa=for m=1 to KL_Temp.count collect KL_Temp[(KL_PXArray[m])])    ----如果是处理菜单部分,总是排序计算原有的顺序量,
for nn in aa do(if nn.KP_MatCaps then Kl_CXc="+"
else Kl_CXc="-"
if (mod nn.KP_MatExtr 1==0) then KL_Mmct=(nn.KP_MatExtr as Integer)as string
else KL_Mmct=nn.KP_MatExtr as string
if nn.KP_MatExtr!=undefined and nn.KP_MatExtr!="" then Kl_CXd="["+KL_Mmct+Kl_CXc+"]"
else Kl_CXd="["+Kl_CXc+"]"
append bbFFF ((substring nn.name 1 8)+Kl_CXd))   ----将材质球本身名字钳位到8个字符(避免出现太长的情况)
#(aa,bbFFF))
fn KF_FillRightMat aa XY bbbb=       ------装载指定材质库材质球对象至全局材质菜单变量数组,用来给菜单调用和访问
(local KL_NBW
local GGL_RightPerYS1=getINISetting (getMAXIniFile()) "akoo2009" "INI_RightPerYS1"
local GGL_RightPerYS2=getINISetting (getMAXIniFile()) "akoo2009" "INI_RightPerYS2"
local KR_MatBankfff=(getINISetting (getMAXIniFile()) "akoo2009" "KR_MatBankBitmap")=="1"   
if KR_MatBankfff and doesFileExist (KL_Tempa=((GetDir #maxroot)+"materiallibraries")+"\\"+GGL_RightPerYS1+"_M.mat") do GGL_RightPerYS1=(getFilenameFile KL_Tempa)
if KR_MatBankfff and doesFileExist (KL_Tempb=((GetDir #maxroot)+"materiallibraries")+"\\"+GGL_RightPerYS2+"_M.mat") do GGL_RightPerYS2=(getFilenameFile KL_Tempb)
KGL_SceneMatLIB=#(GGL_RightPerYS1,GGL_RightPerYS2)	
local KL_ZuiFill=join #(aa) KGL_SceneMatLIB
local KL_ZuiFillAR=#()	 
for m in KL_ZuiFill where m!=""and doesFileExist(KL_GGG=((GetDir #maxroot)+"materiallibraries")+"\\"+m+".mat") and findItem KL_ZuiFillAR KL_GGG==0 do append KL_ZuiFillAR KL_GGG
KGM_RIMatArray=#()
KGM_RIMatArrayNam=#()         -----首先复位这两个全局变量,基于当前材质库重新收录;
if KL_ZuiFillAR.count>0 do
(for m in KL_ZuiFillAR do
(try(KL_OPenM=loadTempMaterialLibrary m
KGL_CurerMatLIB=getFilenameFile m
for o=1 to KL_OPenM.count do if o<=48 do append KGM_RIMatArray KL_OPenM[o] 
if KGM_RIMatArray.count>0 do
(if XY do(KL_SceMatCill=#()    ----仅需要时才这么处理,因为在右键材质定制界面中的模版切换和面板打开时装载材质库的材质本省不希望任何被替换,而只回到场景才需要
KL_SceMatNameCill=#()
if bbbb
then(for oo in KGM_RIMatArray where(findItem KL_SceMatNameCill oo.name)==0 do(append KL_SceMatNameCill oo.name
append KL_SceMatCill oo)
undo on(for i in objects where kugegeoFilt i do if(KL_CVBN=findItem KL_SceMatNameCill i.material.name)!=0 do i.material=KL_SceMatCill[KL_CVBN]))
else(for o in objects where kugegeoFilt o do if o.Material!=undefined do if (findItem KL_SceMatNameCill o.material.name)==0 do(append KL_SceMatNameCill o.material.name
append KL_SceMatCill o.material)
for m=1 to KGM_RIMatArray.count where(KL_HHH=findItem KL_SceMatNameCill KGM_RIMatArray[m].name)!=0 do
(if not(isProperty KL_SceMatCill[KL_HHH] "KP_MatSequ") do custAttributes.add KL_SceMatCill[KL_HHH] RenderMatPro   ----仅没有序号时才补上右键材质属性;
KL_SceMatCill[KL_HHH].KP_MatSequ=KGM_RIMatArray[m].KP_MatSequ  
KL_SceMatCill[KL_HHH].KP_MatExtr=KGM_RIMatArray[m].KP_MatExtr
KL_SceMatCill[KL_HHH].KP_MatCaps=KGM_RIMatArray[m].KP_MatCaps   
KGM_RIMatArray[m]=KL_SceMatCill[KL_HHH]))   ----因为牵涉到使用当前场景同名材质替换,但对方没有序号属性,所以先检测并继承源对象的右键属性后再替换,避免丢失序号信息;
KL_SceMatCill=undefined
KL_SceMatNameCill=undefined)
KL_NBW=KF_MatPar_Init KGM_RIMatArray true true
KGM_RIMatArray=KL_NBW[1]
KGM_RIMatArrayNam=KL_NBW[2])
exit)catch(deleteFile m
KGM_RIMatArray=#()
KGM_RIMatArrayNam=#()))))
fn KF_RightMenuInit=(KF_UnRightMenu()     	-----右键材质菜单初始化函数(三个地方用得着:1.启动时加载阿酷UI;2.手动加载阿酷UI;3.文件改变自动回调函数)
KL_KCV=try(fileProperties.getPropertyValue #custom(fileProperties.findProperty #custom "KugeMat_Temp"))catch("")   ---优先检测当前场景材质模版
KF_FillRightMat KL_KCV true false
KF_CreatRightMenu())	       ------如果装载成功,则按其两个变量创建右键材质菜单;													   
fn KF_CustomViewCreat aa bb=       ----创建自定义视图系统函数,参数1为创建标头名,参数2为创建系统名    ---创建自定义视图系统函数
(activegrid=undefined
toolMode.coordsys #view
if viewport.getType()!=#view_top do(viewport.setType #view_top
max tool zoomextents)
if not snapMode.active do snapMode.active=true   ----防止主工具栏异常的情况下报错;
snapMode.type=#2_5D
kugesnapt=snapMode.type
snapMode.type=#3D
KG_PoinA=pickPoint snap:#3D              ----点击第一个点击点;
if classof KG_PoinA==Point3 do    ---如果第一个点击点合法,则进行下一步;
(KG_PoinB=pickPoint snap:#3D rubberBand:KG_PoinA         
if classof KG_PoinB==Point3 do   ---如果第二个点击点合法,则进行下一步;
(KL_Lftu=normalize(KG_PoinB-KG_PoinA)     ----计算两点矢量
KL_Upsos=[0,0,1]
KL_FrontVet=normalize(cross KL_Lftu KL_Upsos)   ----求得正面矢量(前视图)
fileProperties.addProperty #custom aa (bb+(KL_FrontVet as string))
KF_CustomView aa 1))
snapMode.type=kugesnapt)          ----切换到对应的前视图(还是顶视图)																				   
fn KF_Uninstall= 
(KL_1=queryBox "您确定现在卸载阿酷MAX插件吗?"title:"卸载插件警告--阿酷提示"
if KL_1 do(KL_DeleteFil=(KF_CollAkooFile true)
KL_ppp=0
KL_ppp1=KL_DeleteFil[2].count
for m in KL_DeleteFil[2] do if(deleteFile m) do KL_ppp+=1
try(KL_vvv=(GetDialogPos KR_MoBankTVRoll3)[2]
cui.UnRegisterDialogBar KR_MoBankTVRoll3
DestroyDialog KR_MoBankTVRoll3
global KGL_ToolVBM=(KL_vvv-83)as Integer)catch()
try(KL_vvv=(GetDialogPos KFR_ToolBar1F)[2]
cui.UnRegisterDialogBar KFR_ToolBar1F
DestroyDialog KFR_ToolBar1F
global KGL_ToolVBM=(KL_vvv-83)as Integer)catch()
try(DestroyDialog KR_Host)catch()
if doesFileExist (KL_CCC=KL_DeleteFil[1][1]+"DefaultUI.mnu") do menuMan.loadMenuFile KL_CCC
if doesFileExist (KL_CCC=KL_DeleteFil[1][1]+"DefaultUI.kbd") do actionMan.loadKeyboardFile KL_CCC
try(KF_UnRightMenu())catch()
delIniSetting (getMAXIniFile()) "akoo2009"
deleteFile AK_INIT_File
if KL_ppp==KL_ppp1 then messageBox "阿酷MAX插件卸载顺利完成!" title:"卸载阿酷MAX插件"
else messageBox "部分插件文件没有顺利卸载,请检查权限或注销系统再试!" title:"卸载阿酷MAX插件"))	
