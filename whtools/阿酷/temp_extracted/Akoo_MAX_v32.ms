KHF_LongNaShor XXX[1] XXX[5] XXX[2] 6
gc light:true)----钳位KGM_BitmFiNa完全路径集合数组;
fn KHF_DaForMatCO ZZ aa=   ----时间格式转换函数,参数1:ZZ,为输入的源时间格式,参数2:aa,为处理时间源格式的模式(True为localtime本机当前系统时间类型,false为getFileModDate获取文件时间属性模式);
(KL_LTXY=#()                     ----新时间单元数组变量初始化;
KL_FFFF=false                  ----下午状态变量,正常为false,为True时必须给小时时间单元追加12;
KL_LT0=#("2000","00","00","00","00","00")   ----时间完整格式初始化源数组;年/月/日/时/分/秒
KL_LT1=filterString ZZ ".,/,-, ,:"   ----按规则拆解当前系统时间,aa为true时上下午的默认或自定义字符总是出现在中间的时间节;可以是任意多个;aa为false时缺省总是"月/日/年/时/分/秒/上下午"格式一种模式;
if aa then(if KL_LT1.count>6 do(if KL_LT1[(KL_LT1.count-2)]=="12" do KL_LT1[(KL_LT1.count-2)]=(execute(KL_LT1[(KL_LT1.count-2)]+"-12"))as string  
--如果上下午格式,则首先检测小时是否为12点,因为好像系统时间的计算方法上下午都是从12点开始然后才是1点的,就是说上下午模式没有0点之说;只有24制才有0点(24点)之说;
for n=4 to(KL_LT1.count-3)do if(matchPattern KL_LT1[n] pattern:"*PM*" ignoreCase:true)or(matchPattern KL_LT1[n] pattern:"*下午*" ignoreCase:true)do KL_FFFF=true)
---如果为上下午格式,且上下午时间节为下午状态,则更改下午状态变量为true
if KL_FFFF do KL_LT1[(KL_LT1.count-2)]=(execute(KL_LT1[(KL_LT1.count-2)]+"+12"))as string   ----如果下午状态变量为True,则刷新新变量的小时单元为下午状态(+12);
KL_LTXY=#(KL_LT1[1],KL_LT1[2],KL_LT1[3],KL_LT1[(KL_LT1.count-2)],KL_LT1[(KL_LT1.count-1)],KL_LT1[KL_LT1.count]))  ----移位赋值输出的时间格式为目标变量;保证正确的六个时间节;  
else(if KL_LT1[4]=="12" do KL_LT1[4]=(execute(KL_LT1[4]+"-12"))as string   ---如果第四节为12,则减为0(这里因为总是上下午格式,所以没有设置条件);
if "下午"==KL_LT1[7] or "PM"==KL_LT1[7] do KL_LT1[4]=(execute(KL_LT1[4]+"+12"))as string  ----检测是否为下午状态,如果是,为第四节累计12个小时;
KL_LTXY=#(KL_LT1[3],KL_LT1[1],KL_LT1[2],KL_LT1[4],KL_LT1[5],KL_LT1[6]))   ----移位赋值输出的时间格式为目标变量;保证正确的六个时间节;
for m=1 to KL_LTXY.count do KL_LTXY[m]=replace KL_LT0[m]((KL_LT0[m].count+1)-KL_LTXY[m].count) KL_LTXY[m].count KL_LTXY[m]   ----依次替换六个时间单元为完成格式;
return KL_LTXY)    ---返回转换过的时间格式;
fn KHF_DDttBIJI aa bb CC DX=   ----时间比较函数:用来比较输入的两个时间数组变量的时间先后顺序(标准六字节时间格式),参数1:aa.为时间标准;参数2:bb.为比较时间; 如果有超时的返回False,否则返回True;										
(ZZ=join #() aa                                                                          ------------参数3:CC.为允许日期差;参数4:DX为比较模式,true为不得大于日期差;false为不得小于日期差
XX=join #() bb
for m=1 to ZZ.count do ZZ[m]=ZZ[m] as Integer
for m=1 to XX.count do XX[m]=XX[m] as Integer	 ----先将这两个输入数组转换为整数形式,方便后面进行数字模式的大小比较;
KL_TimeJG=((XX[1]-ZZ[1])*12*31)+((XX[2]-ZZ[2])*31)+(XX[3]-ZZ[3])    ----累计出两个日期的天数差;  ----这里只能是31,否则有可能出现减为0的情况,跨年的时候;
if DX then if KL_TimeJG>CC then false	 ---如果为模式1,则大于0天的文件收集为目标文件(如不合法)
else true
else if KL_TimeJG<CC then false	 ---如果为模式2,则小于N天的文件收集为目标文件(如超过一定期限)
else true)	
fn KHF_ProxyScale ZZ=          -----Vray代理并入代理强制检测缩放函数;参数1:ZZ.当前选择集,逐一检测和强制核对Vray代理的比例大小;  更新VRay代理缩放比例全局变量值
(for m in ZZ where m.classid as string=="#(1828010099, 536368280)"do
(KL_Fcd=#("0.001","0.01","1.0","10.0","1000.0","0.0393","0.3937","39.3700","0.0254","2.54","25.4") 
if isProperty m.baseObject "proxy_scale" do
(if m.baseObject.proxy_scale>1000.0 do m.baseObject.proxy_scale=1000.0
KL_ScaleStr=m.baseObject.proxy_scale as string
if findItem KL_Fcd(substring KL_ScaleStr 1((findString KL_ScaleStr ".")+4))!=0 then KGL_VrayProxyScale=m.baseObject.proxy_scale
else m.baseObject.proxy_scale=KGL_VrayProxyScale)
if isProperty m.baseObject "scale" do
(if m.baseObject.scale>1000.0 do m.baseObject.scale=1000.0
KL_ScaleStr=m.baseObject.scale as string
if findItem KL_Fcd(substring KL_ScaleStr 1((findString KL_ScaleStr ".")+4))!=0 then KGL_VrayProxyScale=m.baseObject.scale
else m.baseObject.scale=KGL_VrayProxyScale))) 
fn KHF_MergeObjShow ZZ YY aa bb cc dd ee=    ----自动搜索选择对象材质贴图且渲染出带水印的bmp小样;参数1:ZZ.当前素材文件名(用来截取当前路径);参数2:YY.当前材质名;
(local KL_Coll1=#(),KL_Coll2=#(),KL_Coll3=#(),KL_Coll4=#(),KL_Coll5=#()
KM_MoKUthA1=getINISetting AK_INIT_File "MaterialBankSet" "KR_MatBankPath1"
KM_MoKUthA2=getINISetting AK_INIT_File "MaterialBankSet" "KR_MatBankPath2"
KM_MoKUthA3=getINISetting AK_INIT_File "MaterialBankSet" "KR_MatBankPath3" 
if KM_MoKUthA1!="" do KM_MoKUthA1+="\\"
if KM_MoKUthA2!="" do KM_MoKUthA2+="\\"
if KM_MoKUthA3!="" do KM_MoKUthA3+="\\"                                     -----依次获得和修复三个预定义的资源搜索路径;
NF_Render_SceneBitMan undefined selection #(KL_Coll1,KL_Coll2,KL_Coll3,KL_Coll4,KL_Coll5) #()  ---自动集合装入模型的所有引用资源;
KL_CFH=KL_Coll1.count
KL_BDNGG=for GH=1 to KL_CFH collect GH           -----收集处理成员的序号数组(所有的);
if KL_BDNGG.count>0 do KHF_SertchFN KL_Coll1 KL_Coll2 KL_Coll3 undefined #((getFilenamePath ZZ),KM_MoKUthA1,KM_MoKUthA2,KM_MoKUthA3) KL_BDNGG false  ----搜索指定处理;			  
if YY==undefined  do(Kl_near=#()                                  -----初始化根对象收集数组变量;
KHF_CollSrcRootNodes selection Kl_near       -----排除当前选择中的子继承变换对象;保证只针对一个对象处理,所以会强制性打组(会跟忽略组模式有点冲突)
kl_cHONGsEL=splineShape pos:selection.center          ----新建空辅助物体,这里用空样条线,保证任何修改器都合适;并且需要定位到选择对象的中心点(牵涉定位)
for oo in Kl_near do oo.parent=kl_cHONGsEL                     
KL_Max=selection.max                                 ----选择集的最大点;
KL_Min=selection.min                                 ----选择集的最小点;
KL_Num=#((KL_Max.x-KL_Min.x),(KL_Max.y-KL_Min.y),(KL_Max.z-KL_Min.z))   ----集合选择集的三个纬度尺寸
sort KL_Num                                                                 ----排序数组,以方便找出最大纬度尺寸;
KL_Scal=4000.0/KL_Num[KL_Num.count]                                         ----计算出需要拟合缩放的值(按最大纬度值来计算);
scale kl_cHONGsEL [KL_Scal,KL_Scal,KL_Scal]                       ----缩放选择集至目标比例;
move kl_cHONGsEL ([0,0,2000]-kl_cHONGsEL.pos)                    ----移动选择集至目标位置;
ee.pos=[0,0,selection.min.z])         ----移动参考地板至目标位置;
KL_ZtimeBJ1=(timeStamp())/1000                                ---标记时间计算起点;
KL_BGHF=filterString(getFilenameFile aa)"_"
if KL_BGHF.count>1 then KL_ZZwidth=KL_BGHF[2] as Integer
else KL_ZZwidth=800
Kl_Old=render outputSize:[KL_ZZwidth,KL_ZZwidth]          ----渲染出小样位图对象;
KL_ZtimeBJ2=(timeStamp())/1000                                    
KL_TimeStr=KHF_RenderTimeCal KL_ZtimeBJ2 KL_ZtimeBJ1             ----求得当前时间点并调用函数处理
KL_ZtimeBJ1=KL_ZtimeBJ2                                         -----更新时间计算起点;
pasteBitmap bb Kl_Old [0,0] [0,0] type:#blend              ----植入Logo底图;
Kl_Old.filename=(getFilenamePath cc)+(getFilenameFile cc)+".bmp"       ----定义好小样位图的文件名(总是bmp格式);
save Kl_Old                                                   -----保存好小样图;
try(freeSceneBitmaps() 
gc())catch()
if YY!=undefined then format"\"%\":渲染时间:%\n"(ZZ+"["+YY+"]") KL_TimeStr to:dd
else(delete kl_cHONGsEL
format"\"%\":渲染时间:%\n" ZZ KL_TimeStr to:dd))                 ----释放位图和回收内存
fn KHF_ChannelCreat aa bb=    ----渲染流程各种通道材质创建函数,一个参数:1.通道材质模数,对应模数对应处理模式;2.AO污垢贴图对象; 
(case of
(
(aa==2 or aa==3):(SL_lclIDCo=random black white
standard selfIllumAmount:100 twoSided:true opacity:100 ambient:SL_lclIDCo diffuse:SL_lclIDCo specular:SL_lclIDCo)   ----材质和组通道,随机的彩色自发光材质球
(aa==4 or aa==5):(standard twoSided:true opacity:100  ambient:white diffuse:white  specular:white)                                                   ----阴影和正侧通道,白色材质球(不发光);
(aa==6):(standard twoSided:true opacity:100  ambient:white diffuse:white  specular:white selfIllumAmount:100)                               ----雾通道,白色自发光材质球;
(aa==7):(SL_lclIDCo=standard twoSided:true opacity:100  ambient:white diffuse:white  specular:white selfIllumAmount:100                     ----AO通道,设置了污垢贴图的白色自发光材质球;
if bb!=undefined do SL_lclIDCo.diffuseMap=bb
SL_lclIDCo)
)
)																		
fn KHF_MatChannelCon num yy aa ff jj bb cc ee=          
(local KL_GuMap=(getINISetting (getMAXIniFile()) "akoo2009" "KL_GuSubBlenMap")=="1"    ------取得是否保留混合材质遮罩效果的开关;
if superClassOf aa==material and((aa.classid as string)=="#(512, 0)"or(aa.classid as string)=="#(592, 0)")   -----检测时候多维材质或混合材质,因为这两种材质需要迭代检测和处理材质的透明效果;
then(if not KL_GuMap do for mp=1 to getNumSubTexmaps aa do setSubTexmap aa mp undefined    ----如果禁止检测混合材质的贴图通道则直接禁止;
KL_Count1=getNumSubMtls aa    ----获得该材质的子材质数
for kA=1 to KL_Count1 do(KL_Snm1=getSubMtl aa kA     ----获得对应的子材质
if superClassOf KL_Snm1==material do KHF_MatChannelCon num yy KL_Snm1 false jj aa kA ee))   ----子材质为合法材质的情况下迭代深入检测和处理;
else(if KL_ChannelMatBL==undefined or num==2 then(zz=KHF_ChannelCreat num ee  ---如果通道模数为2或通道材质寄存变量为无定义,直接创建通道材质且寄存材质寄存变量;
KL_ChannelMatBL=copy zz)                 ---寄存通道材质;
else zz=copy KL_ChannelMatBL                 ---取回寄存的通道材质;
if(KL_CMD1=findItem yy[1] aa)==0 then(if isProperty aa "opacityMapEnable" then if aa.opacityMapEnable and classof aa.opacityMap==Bitmaptexture do if aa.opacityMap.filename!=undefined and mapPaths.getFullFilePath aa.opacityMap.filename!="" do zz.opacityMap=aa.opacityMap   ----不再为多维或混合的情况下检测时候已处理过,否则新处理,首先检测时候存在透明通道(文件有效)并继承;
else if isProperty aa "texmap_opacity_on"  then if aa.texmap_opacity_on and classof aa.texmap_opacity==Bitmaptexture do if aa.texmap_opacity.filename!=undefined and mapPaths.getFullFilePath aa.texmap_opacity.filename!="" do zz.opacityMap=aa.texmap_opacity
else if isProperty aa "opacity_texmap_on"  do if aa.opacity_texmap_on and classof aa.opacity_texmap==Bitmaptexture do if aa.opacity_texmap.filename!=undefined and mapPaths.getFullFilePath aa.opacity_texmap.filename!="" do zz.opacityMap=aa.opacity_texmap
if ff then if superClassOf aa==material and (aa.classid as string)=="#(2, 0)" then for m in (getPropNames zz) do setProperty aa m(getProperty zz m) ---如果为标准材质的情况下直接复制通道材质的属性(非常快);
else for m in jj where m.material==aa do m.material=zz    -----如果为顶级材质则需要按对象更换材质处理(非常慢)
else setSubMtl bb cc zz     -----当前不为顶材质时直接设置其父材质对应的子材质序号为通道材质即可(非常快)
append yy[1] aa     
append yy[2] zz)    -----收集处理过的材质累积多维数组,统一不同深度和位置的重复材质;
else(if ff then if superClassOf aa==material and (aa.classid as string)=="#(2, 0)" then for m in (getPropNames yy[2][KL_CMD1]) do setProperty aa m(getProperty yy[2][KL_CMD1] m)  ---如果为标准材质的情况下直接复制对应已产生的通道材质的属性(非常快);
else for m in jj where m.material==aa do m.material=yy[2][KL_CMD1]    ----如果此材质已处理过,仍按是否为顶材质按规则进行对应已产生通道材质的分别处理;
else setSubMtl bb cc yy[2][KL_CMD1])))	
fn KHF_UpperLcase ZZ=       -----字符串大写转小写处理函数,参数1:ZZ.输入字符串;函数返回处理后的小写字符串;
(local KL_On
local KL_upper="ABCDEFGHIJKLMNOPQRSTUVWXYZ"
local KL_lower="abcdefghijklmnopqrstuvwxyz"
KL_On=ZZ.count
for i=1 to KL_On where(KL_aa1=findString KL_upper ZZ[i])!=undefined do ZZ[i]=KL_lower[KL_aa1]
ZZ)       
fn lcl_Rmmat BG=             ------赋材质菜单处理函数
(undo on(KF_SceneUnitsJC()
local kugXinit3=((getINISetting (getMAXIniFile()) "akoo2009" "KUGEExtrudeAmout2")as Float)
local lcl_kugeSubMatarray=#()
local KL_FVtemp1=#()
local KL_FVtemp2=#()
local KL_FVtemp3=#()
kugemapUVW=(((getINISetting AK_INIT_File "akoo2011" "KUGEUVWmapSIZE") as Integer)*Syun) 
kugegroup= for p in selection where isGroupHead p and not isOpenGroupHead p collect p
KL_SceMatCill=#()
KL_SceMatNameCill=#()
for o in objects where kugegeoFilt o do if o.Material!=undefined do if findItem KL_SceMatNameCill o.material.name==0 do(append KL_SceMatNameCill o.material.name
append KL_SceMatCill o.material)
if(KL_HHH=findItem KL_SceMatNameCill BG.name)!=0 do BG=KL_SceMatCill[KL_HHH]
KL_SceMatCill=undefined	
KL_SceMatNameCill=undefined					-----处理掉场景已有同名材质																										  
if kugegroup.count<1 
then(if kuge_singleshape selection do
(if classof selection[1]!=line and classof selection[1]!=SplineShape do convertToSplineShape selection[1]
if BG.KP_MatExtr!=undefined and BG.KP_MatExtr!="" then(if BG.KP_MatExtr==0 then addModifier selection[1] (edit_mesh())     
else addModifier selection[1] (Extrude amount:(BG.KP_MatExtr*Syun) capStart:BG.KP_MatCaps))
else addModifier selection[1] (Extrude amount:(kugXinit3*Syun)))
for i in selection where ViewgeoFilt i do(i.material=BG
i.name=BG.name)

append lcl_kugeSubMatarray BG
lcl_subMatcoll lcl_kugeSubMatarray BG
for r in lcl_kugeSubMatarray do for jA=1 to getNumSubTexmaps r do(kugeA=getSubTexmap r jA
lcl_SMapcoll KL_FVtemp1 kugeA r KL_FVtemp2 jA KL_FVtemp3)
if KL_FVtemp1.count>0 do(KL_PPPmaod=#()          -----如果目标材质中包含有任何图片贴图,则----
for m in selection where ViewgeoFilt m do(KL_initNumM=m.modifiers.count
for tt=1 to KL_initNumM where m.modifiers[KL_initNumM+1-tt].classID[1]==229485990 or m.modifiers[KL_initNumM+1-tt].classID[1]==229485986 or m.modifiers[KL_initNumM+1-tt].classID[1]==1012401 
do append KL_PPPmaod m.modifiers[KL_initNumM+1-tt])    -----收集选择对象中所有的贴图坐标修改器;
if KL_PPPmaod.count==0 do(if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify				
KL_A1=uvwmap maptype:4 length:kugemapUVW width:kugemapUVW height:kugemapUVW
if modPanel.validModifier (uvwmap())do modPanel.addModToSelection KL_A1))  ---如果材质有贴图而对象无任何坐标,则整体添加一个贴图坐标修改器;
if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify)
else messageBox "当前选择含有组对象,很可能不是你希望的操作,请重新操作!" title:"不允许的赋材质警告--阿酷提示"))
fn lcl_RmRmat BG=               ------材质置换函数
