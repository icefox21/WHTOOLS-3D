fn KF_TabNum bb aa=                         -----命令面板子页面切换函数,需要四个参数,1.所有子页面控件集合(控制按下);2,所有子页面的子参数控件集合(控制可视)
-----bb参数:当前子页面的序号字符;aa参数:当前子页面控件的响应状态;
(thePainterInterface.endPaintSession()
max move
for mm in KLC_Cont1 do if mm.name!=("KC_BTZZ"+bb) do mm.checked=not aa
for mm in KLC_Cont2 do if (matchPattern mm.name pattern:("KC_XXY"+bb+"*")) then mm.visible=aa
else(mm.visible=not aa
if classof mm==CheckButtonControl do mm.checked=false)
setINISetting AK_INIT_File "AI_PlantTool" "PlantState" bb
if bb=="5" or bb=="3" then KC_VBC31.visible=KC_VBC32.visible=KC_VBC34.visible=KC_VBC319.visible=KC_BT6.visible=not aa
else KC_VBC31.visible=KC_VBC32.visible=KC_VBC34.visible=KC_VBC319.visible=KC_BT6.visible=aa)
on KC_BTZZ2 changed aa do if aa do KF_TabNum "2" aa
on KC_BTZZ3 changed aa do if aa do KF_TabNum "3" aa
on KC_BTZZ4 changed aa do if aa do KF_TabNum "4" aa
on KC_BTZZ5 changed aa do if aa do KF_TabNum "5" aa
on KC_BTZZ6 changed aa do if aa do KF_TabNum "6" aa
on KC_BTZZ7 changed aa do if aa do KF_TabNum "7" aa    -----给每个子页面控件添加响应事件,控制其它子页面控件的按下状态,所有子页面子参数的可视状态切换;
fn initListView ax=(ax.view=(dotNetClass "System.Windows.Forms.View").Details    ----定义列表视窗控件的展示模式;
ax.checkBoxes=true
ax.gridLines=true
ax.fullRowSelect=false
ax.labelEdit=false
ax.hideSelection=false
ax.multiSelect=true
ax.Sorting=(dotNetClass "System.Windows.Forms.SortOrder").None
ax.HeaderStyle=(dotNetClass "System.Windows.Forms.ColumnHeaderStyle").Nonclickable   ---显示没有关联动作的列标头;
ax.Alignment=(dotNetClass "System.Windows.Forms.ListViewAlignment").Left
ax.ShowItemToolTips=true     ----允许列表条目显示工具提示的总开关;
ax.FullRowSelect=true 
ax.Columns.add "源对象" 87    ----注意这里关系真正的列数,跟标头的显示类型无关,后面数字表示宽度;
ax.Columns.add "份" 20   ----定义各个列标头;
ax.Columns.add "间隔" 30
ax.Columns.add "高度" 54)   ----继续定义列表视窗控件的各种展示特征;)  
fn KF_RefreshList FFF=
(KGL_PlantScattObj=for m in KGL_PlantScattObj where IsValidNode m collect m                 ----过滤掉已经无效的场景源节点
if FFF==undefined do FFF=for aa in KGL_PlantScattObj collect #(false,true)
if KGL_PlantScattObj.count>0 
then(for m in KGL_PlantScattObj where not(isProperty m "KP_PlantScale") do
(custAttributes.add m PlantObjparameters #unique     ---注意这里一定要添加独立的自定义属性,否则关联出来的物体即使塌陷了也会保持自定义属性之间的关联;
m.KP_PlantPercent=(getINISetting AK_INIT_File "AI_PlantTool" "InitiaPercent")as integer  
m.KP_PlantDist=(getINISetting AK_INIT_File "AI_PlantTool" "InitiaDist")as float
m.KP_PlantScale=m.scale.x)    -----如果源对象还没有自定义种植参数,按缺省值进行预置;
KL_ML1.Items.clear()                                 -----初始化列表视窗控件的元素集合
i=0
theRange=#() 
for obj in KGL_PlantScattObj do(i+=1
KL_lItem=dotNetObject "System.Windows.Forms.ListViewItem" obj.name
KL_lItem.tag=dotNetMXSValue obj
KL_lItem.SubItems.add (obj.KP_PlantPercent as string)
KL_lItem.SubItems.add (obj.KP_PlantDist as string)  
KL_lItem.SubItems.add ((obj.max-obj.min).z as string)  ---追加每行参数格(出生率,最小间距,当前高度;
KL_lItem.checked=FFF[i][2]
KL_lItem.Selected=FFF[i][1]
---KL_CMD=dotNetObject "System.String" (obj.name+"  "+(obj.KP_PlantPercent as string)+"  "+(obj.KP_PlantDist as string)+"  "+((obj.max-obj.min).z as string))
KL_lItem.ToolTipText=obj.name
---KL_lItem.ToolTipText=obj.name+" "+(obj.KP_PlantPercent as string)+" "+(obj.KP_PlantDist as string)+" "+((obj.max-obj.min).z as string)
append theRange KL_lItem)
KL_ML1.Items.AddRange theRange)        ------根据种植源对象数组,逐个添加为对应对象的列表视窗控件元素(名字,关联对象,标记))
else KL_ML1.Items.clear())       -----出错提示进行操作;
fn KF_RefreshMatList=	 
(KC_VBC31.items=for oo in AKPaitnodeListMat collect oo.name)
on KC_JJKj3 entered do
(KL_C1=#()     ----选择条目序号收集恢复数组;
KGL_PlantScattObj=for m in KGL_PlantScattObj where IsValidNode m collect m
for m=1 to KGL_PlantScattObj.count do if (KL_ML1.Items.Item(m-1)).Selected then(KGL_PlantScattObj[m].KP_PlantPercent=KC_JJKj3.value
append KL_C1 #(true,(KL_ML1.Items.Item(m-1)).checked))
else append KL_C1 #(false,(KL_ML1.Items.Item(m-1)).checked)
KF_RefreshList KL_C1)   ----完成选择条目对象比率值的修改和列表的刷新;
on KC_LBrb3 entered do
(KL_C1=#()         ----选择条目序号收集恢复数组;
KGL_PlantScattObj=for m in KGL_PlantScattObj where IsValidNode m collect m
for m=1 to KGL_PlantScattObj.count do if (KL_ML1.Items.Item(m-1)).Selected then(KGL_PlantScattObj[m].KP_PlantDist=KC_LBrb3.value
append KL_C1 #(true,(KL_ML1.Items.Item(m-1)).checked))
else append KL_C1 #(false,(KL_ML1.Items.Item(m-1)).checked)
KF_RefreshList KL_C1)    ----完成选择条目对象最小间距值的修改和列表的刷新;
on KC_LBrC3 entered do
(undo on(
KL_C1=#()         ----选择条目序号收集恢复数组;
KGL_PlantScattObj=for m in KGL_PlantScattObj where IsValidNode m collect m
for m=1 to KGL_PlantScattObj.count do if (KL_ML1.Items.Item(m-1)).Selected 
then(Kl_NewHeight=KC_LBrC3.value/(KGL_PlantScattObj[m].max-KGL_PlantScattObj[m].Min).z
Scale KGL_PlantScattObj[m] [Kl_NewHeight,Kl_NewHeight,Kl_NewHeight]
KGL_PlantScattObj[m].KP_PlantScale=KGL_PlantScattObj[m].scale.x
append KL_C1 #(true,(KL_ML1.Items.Item(m-1)).checked))
else append KL_C1 #(false,(KL_ML1.Items.Item(m-1)).checked)
KF_RefreshList KL_C1))    ----完成选择条目对象最小间距值的修改和列表的刷新;
on KL_ML1 SelectedIndexChanged aa do
(KL_Sel=#() 
if KL_ML1.SelectedIndices.count==1 then(try(KL_VBA=KL_ML1.SelectedIndices.Item[0]+1    --列表选择状态的变化,检测当前是否单个选择,单个选择就更新对应的比率和最小间距
KC_JJKj3.value=KGL_PlantScattObj[KL_VBA].KP_PlantPercent
KC_LBrb3.value=KGL_PlantScattObj[KL_VBA].KP_PlantDist
KC_LBrC3.value=(KGL_PlantScattObj[KL_VBA].max-KGL_PlantScattObj[KL_VBA].min).z)catch())
else(KC_JJKj3.indeterminate=KC_LBrB3.indeterminate=KC_LBrC3.indeterminate=true)
for m=1 to KGL_PlantScattObj.count do if (KL_ML1.Items.Item(m-1)).Selected and IsValidNode KGL_PlantScattObj[m] do append KL_Sel KGL_PlantScattObj[m]
if KL_Sel.count>0 do(if getCommandPanelTaskMode!=#create do setCommandPanelTaskMode mode:#create
thawSelection()
clearSelection()
select KL_Sel))  ---多个选择时禁止比率和最小间距控件;

on KC_JJKj1 changed aa do
(max move                    --切换到这个工具可以保证退出任何的点选对象拾取函数,相对源对象列表和表面材质列表两个连续添加控件的释放;
While (KL_Select=pickObject pickFrozen:false forceListenerFocus:false)!=undefined do ---拣选多个且允许透明支持"H"选择模式,注意这里可以不用过滤函数,可以针对任何物体类型
(KHF_CollSrcRootNodes KL_Select KGL_PlantScattObj  -----过滤追加选择  仅收集所有的无父级对象,到时候方便来继承层级进行复制关联;
KF_RefreshList undefined)
KC_JJKj1.checked=false)
on KC_JJKj1B pressed do
(max move 
KHF_CollSrcRootNodes selection KGL_PlantScattObj  -----过滤追加选择  仅收集所有的无父级对象,到时候方便来继承层级进行复制关联;
KF_RefreshList undefined)
on KC_JJKj2 pressed do
