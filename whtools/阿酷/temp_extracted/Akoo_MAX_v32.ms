fn KF_TabNum aa bb=
(if not bb do aa="00"
Kl_ZCCooO=for m in KFGlo_AkSeTTFN.controls where (matchPattern m.name pattern:"AKTab*") collect m
Kl_ZCCooM=for m in KFGlo_AkSeTTFN.controls where (matchPattern m.name pattern:"kuge_AK*") collect m
for mm in Kl_ZCCooO do if mm.name!=("AKTab"+aa) do mm.checked=false
for mm in Kl_ZCCooM do if (matchPattern mm.name pattern:("kuge_AK"+aa+"*")) then mm.visible=true
else mm.visible=false)
on AKTab01 changed aa do KF_TabNum "01" aa 
on AKTab02 changed aa do KF_TabNum "02" aa 
on AKTab03 changed aa do KF_TabNum "03" aa 
on AKTab04 changed aa do KF_TabNum "04" aa 
on AKTab05 changed aa do KF_TabNum "05" aa 
on AKTab06 changed aa do KF_TabNum "06" aa 
on AKTab07 changed aa do KF_TabNum "07" aa 
on AKTab08 changed aa do KF_TabNum "08" aa 
on AKTab09 changed aa do KF_TabNum "09" aa 
on AKTab10 changed aa do KF_TabNum "10" aa 
on AKTab11 changed aa do KF_TabNum "11" aa 
on AKTab12 changed aa do KF_TabNum "12" aa 
on AKTab13 changed aa do KF_TabNum "13" aa
on AKTab14 changed aa do KF_TabNum "14" aa 
on AKTab15 changed aa do KF_TabNum "15" aa 
on AKTab16 changed aa do KF_TabNum "16" aa 

