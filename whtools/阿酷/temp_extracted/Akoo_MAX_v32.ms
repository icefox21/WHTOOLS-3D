local KX_ReFl6B=doesFileExist ((GetDir #help)+"\\"+"AKSIXNOR.max")
local KX_ReFl9B=doesFileExist ((GetDir #help)+"\\"+"AKHEIREF.max") 
local KX_ReFl8B=(VRayDirt!=undefined or VR灰尘!=undefined or VR污垢!=undefined)
local KX_Pspath=getINISetting (getMAXIniFile()) "akoo2009" "Photoshoppath"
