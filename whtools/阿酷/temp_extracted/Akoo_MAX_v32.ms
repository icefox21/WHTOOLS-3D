KL_LYH=false
in coordsys KL_W (KL_A3=getFaceNormal KL_Ob1 m)
for y in KL_SelvsCen do(KL_W.translation=y            
append KL_A3P (in coordsys KL_W meshop.getFaceCenter KL_Ob1 m))
if A1 and A2 then(for i in KL_A3P where (abs i[1])<(10*Syun) and (abs i[2])<(10*Syun) and (abs i[3])<(10*Syun) do KL_LYH=true)
else(if A1 then(for i in KL_A3P where (abs i[1])<(10*Syun) and (abs i[2])<(10*Syun) do KL_LYH=true)
else(if A2 then(for i in KL_A3P where (abs i[3])<(10*Syun) do KL_LYH=true)
else KL_LYH=true))
if KL_A3.z>((90.0-KG_DirFAng)*(1.0/90.0))and findItem KL_Selvs m==0 and KL_LYH do append KL_Selvs m))
setFaceSelection KL_Ob1 KL_Selvs))
)
)
2:(KL_Ob1=selection[1]
KL_SelvsN=#()       
case (classof (modPanel.getCurrentObject())) of
(
Edit_Poly:(for m in selection where ViewgeoFilt m do(KLII=(getFaceSelection m (modPanel.getCurrentObject()))as array
KL_MMMMMB3=KLII.count
for ff=1 to KL_MMMMMB3 where(findItem KL_SelvsN (KL_SelFNc=polyOp.getFaceArea m KLII[ff]))==0 do append KL_SelvsN KL_SelFNc)
KL_MMMMMB5=KL_SelvsN.count  
if KL_MMMMMB5>0 and KL_MMMMMB5<4 do(for m in selection where ViewgeoFilt m do(KL_Selvs=#() 
KL_MMMMMB4=getNumFaces m
for j=1 to KL_MMMMMB4 do(for k=1 to KL_MMMMMB5 do
(KL_A3=polyOp.getFaceArea m j
if abs(KL_A3-KL_SelvsN[k])<(KL_SelvsN[k]*KG_DirFAng2) and findItem KL_Selvs j==0 do append KL_Selvs j))
setFaceSelection m (modPanel.getCurrentObject()) KL_Selvs keep:true))) 
Edit_Mesh:(for m in selection where ViewgeoFilt m do(KLII=(getFaceSelection m (modPanel.getCurrentObject()))as array
KL_MMMMMB3=KLII.count
for ff=1 to KL_MMMMMB3 where(findItem KL_SelvsN (KL_SelFNc=meshop.getFaceArea m KLII[ff]))==0 do append KL_SelvsN KL_SelFNc)
KL_MMMMMB5=KL_SelvsN.count  
if KL_MMMMMB5>0 and KL_MMMMMB5<4 do(for m in selection  where ViewgeoFilt m do(KL_Selvs=#()  
KL_MMMMMB4=getNumFaces m
for j=1 to KL_MMMMMB4 do(for k=1 to KL_MMMMMB5 do
(KL_A3=meshop.getFaceArea m j
if abs(KL_A3-KL_SelvsN[k])<(KL_SelvsN[k]*KG_DirFAng2) and findItem KL_Selvs j==0 do append KL_Selvs j))
setFaceSelection m (modPanel.getCurrentObject()) KL_Selvs keep:true)))         
Editable_Poly:(KL_Selvs=#()
KL_A1=(polyOp.getFaceSelection KL_Ob1)as array
KL_MMMMMB7=KL_A1.count
for u=1 to KL_MMMMMB7 where(findItem KL_SelvsN (KL_SelFNc=polyOp.getFaceArea KL_Ob1 KL_A1[u]))==0 do append KL_SelvsN KL_SelFNc  
KL_MMMMMB5=KL_SelvsN.count  
if KL_MMMMMB5>0 and KL_MMMMMB5<4 do(KL_MMMMMB6=KL_Ob1.GetNumFaces()
for m=1 to KL_MMMMMB6 do(for t in KL_SelvsN do
(KL_A3=polyOp.getFaceArea KL_Ob1 m
if abs(KL_A3-t)<(t*KG_DirFAng2) and findItem KL_Selvs m==0 do append KL_Selvs m))
polyOp.setFaceSelection KL_Ob1 KL_Selvs))
Editable_mesh:(KL_Selvs=#()
KL_A1=(getFaceSelection KL_Ob1)as array
KL_MMMMMB7=KL_A1.count
for u=1 to KL_MMMMMB7 where(findItem KL_SelvsN (KL_SelFNc=meshop.getFaceArea KL_Ob1 KL_A1[u]))==0 do append KL_SelvsN KL_SelFNc
KL_MMMMMB5=KL_SelvsN.count 
if KL_MMMMMB5>0 and KL_MMMMMB5<4 do(KL_MMMMMB8=GetNumFaces KL_Ob1
for m=1 to KL_MMMMMB8 do(for t in KL_SelvsN do
(KL_A3=meshop.getFaceArea KL_Ob1 m
if abs(KL_A3-t)<(t*KG_DirFAng2) and findItem KL_Selvs m==0 do append KL_Selvs m))
setFaceSelection KL_Ob1 KL_Selvs))
)
)  
)
)
fn lcl_Tools_ByDirFace=
(if (KL_JianCLigObj aaa:1 bbb:3 ccc:2) do(
try(DestroyDialog Tools_ByDirFaceroll)catch()
rollout Tools_ByDirFaceroll "阿酷_扩展选择面工具" width:178 height:113
(checkbox KC_CB1 "同位置" checked:KG_DirSta1 pos:[10,12]
checkbox KC_CB2 "同平面" checked:KG_DirSta2 pos:[95,12]
button KC_BU1 "按方向扩展" pos:[10,36]
spinner KL_YZ "角度:" range:[1,90,KG_DirFAng] type:#integer fieldWidth:32 scale:1 pos:[93,38]
groupBox group1 "" pos:[5,0] width:168 height:64 
button KC_BU2 "按面积扩展" align:#left pos:[10,78]
spinner KL_YZ2 "偏差:" range:[0.01,0.1,KG_DirFAng2] type:#Float scale:0.01 fieldWidth:32  pos:[93,80]
groupBox group2 "" pos:[5,64] width:168 height:40 
on KL_YZ changed vv do global KG_DirFAng=vv     
on KL_YZ2 changed vv do global KG_DirFAng2=vv                      
on KC_CB1 changed p do(global KG_DirSta1=p
if p and KC_CB2.state do KC_CB2.state=KG_DirSta2=false)
on KC_CB2 changed p do(global KG_DirSta2=p
if p and KC_CB1.state do KC_CB1.state=KG_DirSta1=false)
on KC_BU1 pressed do undo on(lcl_DirFaceFN KC_CB1.state KC_CB2.state 1)
on KC_BU2 pressed do undo on(lcl_DirFaceFN KC_CB1.state KC_CB2.state 2)
on KC_BU3 pressed do undo on(lcl_DirFaceFN KC_CB1.state KC_CB2.state 3)
on KC_BU4 pressed do undo on(lcl_DirFaceFN KC_CB1.state KC_CB2.state 4)
