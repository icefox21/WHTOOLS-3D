fn KF_StartDetect=
(KL_DFR=true   
if KC_CB62.checked then(KL_A1=KC_MB15.selection as array
kuge_CamSC11=for hh in KL_A1 where kugeKG_CamYYLI[hh].KP_Mulallow collect kugeKG_CamYYLI[hh])
else kuge_CamSC11=for m=1 to kugeKG_CamYYLI.count  where kugeKG_CamYYLI[m].KP_Mulallow collect kugeKG_CamYYLI[m]
if kuge_CamSC11.count<1 then
(if kugeKG_CamYYLI.count>0 do if KC_CB62.checked then messageBox "你勾选了“仅渲染选择相机”选项,请先选择可渲相机!" title:"多相机小样警告--阿酷提示"
else messageBox "先确定您场景是否存在可渲相机!" title:"多相机小样警告--阿酷提示"
KL_DFR=false)
else(KL_PPPObj=#()
KL_PPPLig=#()
KL_DiushiObj=#()
KL_DiushiLig=#()
for m in kuge_CamSC11 where m.KP_MulObjectGro!=undefined and m.KP_MulObjectGro!="" do join KL_PPPObj (filterString m.KP_MulObjectGro ",")
for m in kuge_CamSC11 where m.KP_MulLightGro!=undefined and m.KP_MulLightType!="" and m.KP_MulLightType!="A" and m.KP_MulLightType!="C" do join KL_PPPLig (filterString m.KP_MulLightGro ",")
KN_GrnnCl=(KF_SceneObjGro false false  false true rendHidden)[3][1]
if KL_PPPObj.count>0 do(if KN_GrnnCl.count>0 then for m in KL_PPPObj where findItem KN_GrnnCl m==0 and findItem KL_DiushiObj m==0 do append KL_DiushiObj m
else KL_DiushiObj=KL_PPPObj)
KN_GrnnCl=(KF_SceneLIghtGro false)[1]
if KL_PPPLig.count>0 do(if KN_GrnnCl.count>0 then for m in KL_PPPLig where findItem KN_GrnnCl m==0 and findItem KL_DiushiLig m==0 do append KL_DiushiLig m
else KL_DiushiLig=KL_PPPLig)
if KL_DiushiObj.count>0 do messageBox ("对象组"+(KL_DiushiObj as string)+"图层有被删除或关闭,请重新设置相机参数!") title:"多相机小样警告--阿酷提示"
if KL_DiushiLig.count>0 do messageBox ("灯光组"+(KL_DiushiLig as string)+"图层有被删除或关闭,请重新设置相机参数!") title:"多相机小样警告--阿酷提示"
if (KL_DiushiObj.count+KL_DiushiLig.count)>0 do KL_DFR=false
if KL_DFR and KC_CB17.checked do(KL_QQ=queryBox "你确定需要渲染完成后自动关机吗?"  title:"多相机小样命令警告--阿酷提示"
if not KL_QQ do KC_CB17.checked=false))
if KL_DFR and renderers.current.output_on do
(messageBox "渲染流程命令暂不支持VRay自身的帧缓冲窗口,请重新设置!" title:"阿酷渲染流程配置警告--阿酷提示"
KL_DFR=false)
if KL_DFR do(if KC_LB25.state==1 or rendOutputFilename=="" then KG_SampPathDir=KF_AutoPathFile KC_ET26 KC_ET28 maxFilePath
else KG_SampPathDir=getFilenamePath rendOutputFilename
Kl_CC1=KG_SampPathDir+"\AK.akoo"
try(close(createFile Kl_CC1))catch()
if not(doesFileExist Kl_CC1) then(messageBox "渲染输出路径不可用,请重新设置!" title:"阿酷渲染流程配置警告--阿酷提示"
KL_DFR=false)
else undo off(deleteFile Kl_CC1))
if not KL_DFR do KC_CKO5.checked=false
KL_DFR)
fn KGF_RollInit=
(global KG_SirenFileExist=doesFileExist ((GetDir #help)+"\\"+"akoo2008_6.vbs")
Kl_CCmo=KR_Render_MulCam_Init()
kugeKG_CamYYLI=Kl_CCmo[1]
KG_RenCamlName=Kl_CCmo[2]
KC_MB15.items=KG_RenCamlName
