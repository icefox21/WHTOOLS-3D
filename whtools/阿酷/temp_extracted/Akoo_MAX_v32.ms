rotateX KGL_CustVTransform  90)
else(rotateY KGL_CustVTransform  -90)))
5:(if KL_PointNor.y<=0.707107 then(if KL_PointNor.x<=0.707107 and KL_PointNor.x>=-0.707107 then(rotateZ KGL_CustVTransform  90
rotateX KGL_CustVTransform  180)
else(rotateY KGL_CustVTransform  180))
