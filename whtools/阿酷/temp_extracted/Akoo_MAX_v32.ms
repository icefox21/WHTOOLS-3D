fn ViewgeoFilt o=
(((superclassof o==GeometryClass and classof o!=LinkComposite and not o.isTarget)or(findItem KGL_ProxyXRefID(o.classid as string)==0 and superclassof o==Shape and classof o!=PolymorphicGeomshape and classof o!=LinkCompositeshape and o.baseobject.renderable))and o.isHiddenInVpt==false and o.isFrozen==false and IsValidNode o)
fn kugegeoFilt o=
(((superclassof o==GeometryClass and classof o!=LinkComposite and not o.isTarget)or(findItem KGL_ProxyXRefID(o.classid as string)==0 and superclassof o==Shape and classof o!=PolymorphicGeomshape and classof o!=LinkCompositeshape and o.baseobject.renderable))and IsValidNode o)
fn kugeshapeFilt o=
(superclassof o==Shape and classof o!=PolymorphicGeomshape and classof o!=LinkCompositeshape and findItem KGL_ProxyXRefID(o.classid as string)==0 and not o.baseobject.renderable and IsValidNode o)
fn kuge_singleshape x=
(x.count==1 and superclassof x[1]==Shape and classof x[1]!=PolymorphicGeomshape and classof x[1]!=LinkCompositeshape and  findItem KGL_ProxyXRefID(x[1].classid as string)==0 and not x[1].baseobject.renderable and x[1].modifiers.count==0 and IsValidNode x[1])
fn ViewshapeFilt o=
(o.isHiddenInVpt==false and o.isFrozen==false and superclassof o==Shape and classof o!=PolymorphicGeomshape and classof o!=LinkCompositeshape and  findItem KGL_ProxyXRefID(o.classid as string)==0 and not o.baseobject.renderable and IsValidNode o)
fn Groupfiltrate vvvaaa addsdsd=           
(local lcl_groupcol,kugegroup,lvlcount
lcl_groupcol=#()
kugegroup=#yes
for pp in vvvaaa where isGroupMember pp and not isOpenGroupMember pp do
(if (lvlcount=findItem lcl_groupcol pp.parent)== 0 then(append lcl_groupcol pp.parent
append lcl_groupcol 1)
else lcl_groupcol[lvlcount+1]+=1)
for y=1 to lcl_groupcol.count by 2 do(if lcl_groupcol[y].children.count!=lcl_groupcol[y+1] do
(kugegroup=yesNoCancelBox"新选择集中将包含有部分组,选择操作:\n是:整个选择.\n否:取消选择.\n取消:退出操作!"title:"部分组对象选择警告--阿酷提示"
exit))
if kugegroup==#yes do(thawSelection()
select vvvaaa
if addsdsd==true do for yy in selection do(if yy.isFrozen==true do unfreeze yy doLayer:true
if yy.isHiddenInVpt==true do unhide yy doLayer:true))
if kugegroup==#no do(thawSelection()
clearSelection()))
fn KF_ExperFRest aa=(kugegrn=aa.name
kugecolor=aa.wireColor
kugecenter=aa.center
kugeparent=aa.parent
kugeGroup=isGroupMember aa
kugenew=mesh lengthsegs:1 widthsegs:1 position:kugecenter wireColor:kugecolor name:kugegrn
kugenew.parent=kugeparent
setGroupMember kugenew kugeGroup
meshop.attach kugenew.mesh aa.mesh targetNode:kugenew sourceNode:aa
meshop.deleteFaces kugenew.mesh #{1..2} delIsoVerts:true
return kugenew)
fn KF_SwitchCamObj aa bb cc XX1 XX2 XX3 XX4 ff1 ff2=
(viewport.setCamera aa
if cc then(if bb<5 do(if bb==1 then KL_AutoLight=KF_CamAutoLIGHT aa false KR_Render_MulCam.KC_CP3.value (KR_Render_MulCam.KC_RenC1.value*0.9) (KR_Render_MulCam.KC_RenC1.value*0.6) (KR_Render_MulCam.KC_RenC1.value*0.2) false
else(case aa.KP_MulLightType  of
(
"A":(if bb<4 do KL_AutoLight=KF_CamAutoLIGHT aa true KR_Render_MulCam.KC_CP3.value (KR_Render_MulCam.KC_RenC1.value*0.9)(KR_Render_MulCam.KC_RenC1.value*0.6) (KR_Render_MulCam.KC_RenC1.value*0.2) false)
"C":(if bb<4 do KF_LightStateFN ff1 false true "")
default:(KF_LightStateFN ff1 false false aa.KP_MulLightGro)
)
)
if (KL_LLname=aa.KP_MulObjectGro)!="C" and KL_LLname!="" then(KF_OBjectsStateFN ff2 false KL_LLname)
else(if bb<4 do KF_OBjectsStateFN ff2 true ""))
if (KL_BB1=aa.KP_MulMode)!="C" and KL_BB1!="" then(if KL_BB1!="V" then setrendertype #blowUp
else setrendertype #view)
else if bb<4 do setrendertype XX1
if (KL_BB1=aa.KP_MulDimen)!="C" and KL_BB1!="" then(KL_CCS=filterString KL_BB1 "X"
KL_renderHeight=KL_CCS[2] as Integer
KL_renderWidth=KL_CCS[1] as Integer
renderHeight=KL_renderHeight
renderWidth=KL_renderWidth)
else(if bb<4 do(KL_renderHeight=XX2
KL_renderWidth=XX3
renderHeight=KL_renderHeight
renderWidth=KL_renderWidth))
if (KL_BB1=aa.KP_MulReg)!="C" and KL_BB1!=""then(kugeRR=filterString KL_BB1 "  ( ) "
viewport.setBlowupRect viewport.activeViewport (Box2 (kugeRR[2] as integer) (kugeRR[3] as integer) (kugeRR[4] as integer) (kugeRR[5] as integer)))
else if bb<4 do viewport.setBlowupRect viewport.activeViewport XX4
if bb>=4 do renderSceneDialog.update()
#(KL_renderHeight,KL_renderWidth,KL_AutoLight))
else #(undefined,undefined,#()))
