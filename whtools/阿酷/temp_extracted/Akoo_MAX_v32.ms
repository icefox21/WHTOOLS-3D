on KC_BU51 pressed do
(local lcl_kugeSubMatarray=#(),KL_VBFG
local KL_FVtemp1=#()     -------贴图对象集合 #(Map #0:Bitmap, Map #2:Bitmap, Map #1:Bitmap)
local KL_FVtemp2=#()     -------对应贴图对象的材质球集合(多维数组,每个贴图对象所有拥有的材质球集合) #(#(色块:Standard, 色块:Standard), #(色块:Standard), #(色块:Standard))
local KL_FVtemp3=#()     -------对应贴图对象的材质球+贴图通道编号集合(多多维数组,每个贴图对象所有拥有的材质球+贴图通道编号集合) #(#(#(色块:Standard, 2), #(色块:Standard, 7)), #(#(色块:Standard, 4)), #(#(色块:Standard, 9)))
KL_TempMatLib=materialLibrary()
for m=1 to lclRightarray.count do append  KL_TempMatLib lclRightarray[m]
for m in lclRightarray do(append lcl_kugeSubMatarray m
lcl_subMatcoll lcl_kugeSubMatarray m)   -----累计收集材质集合的所有子材质
for r in lcl_kugeSubMatarray do for jA=1 to getNumSubTexmaps r do(kugeA=getSubTexmap r jA
lcl_SMapcoll KL_FVtemp1 kugeA r KL_FVtemp2 jA KL_FVtemp3)  -----累计收集材质集合的所有子贴图;
if lclRightarray.count>0 do
(KL_CCC=getSaveFileName caption:"输出右键材质文件:" filename:(((GetDir #maxroot)+"materiallibraries")+"\\") types:"右键菜单材质文件(*.mat)|*.mat|"
if KL_CCC!=undefined do
(KL_CC1=0
KL_CC2=0
for m in KL_FVtemp1 do
(KL_Ba1=mapPaths.getFullFilePath m.filename
if doesFileExist KL_Ba1    -----这里必须用到mapPaths.getFullFilePath函数,用来检测文件是否真的存在;
then(KL_Ba2=((GetDir #maxroot)+"maps\\")+(filenameFromPath KL_Ba1)
if not doesFileExist KL_Ba2 then(KL_Ba5=copyFile KL_Ba1 KL_Ba2
if KL_Ba5 then(m.filename=filenameFromPath KL_Ba1      -----将贴图文件名修改成相对文件名
KL_CC1+=1)
else(KL_CC2+=1
m.filename=filenameFromPath m.filename))
else(if getFileModDate KL_Ba1==getFileModDate KL_Ba2 and getFileSize KL_Ba1==getFileSize KL_Ba2
then(m.filename=filenameFromPath KL_Ba1      -----将贴图文件名修改成相对文件名
KL_CC1+=1)
else(messageBox("目前路径已存在重复贴图文件名:"+(filenameFromPath KL_Ba1)+"--阿酷提示")
KL_CC2+=1
m.filename=filenameFromPath m.filename)))
else(KL_CC2+=1
m.filename=filenameFromPath m.filename))   ----即使文件不存在,也进行截取无路径文件名的工作;
saveTempMaterialLibrary  KL_TempMatLib  ((getFilenamePath KL_CCC)+(getFilenameFile KL_CCC)+"_M.mat")
KL_VBFG=Join #() lcl_kugeSubMatarray
for w in KL_VBFG do(KL_nnnnb5=getNumSubTexmaps w
for y=1 to KL_nnnnb5 do if getSubTexmap w y !=undefined do setSubTexmap w y None)
saveTempMaterialLibrary  KL_TempMatLib  KL_CCC
KL_TempMatLib=undefined
messageBox("输出右键材质贴图收集:"+KL_CC1 as string+"个成功!"+KL_CC2 as string+"个失败!") title:"输出右键材质提示--阿酷提示")))
on KC_DL1 selected aa do(KGL_RightPos=aa            -----材质菜单组合键
setINISetting (getMAXIniFile()) "akoo2009" "KUGERightMenu" (aa as string)
KF_RightMenuInit())    -----这里仅需要更新材质菜单,而不需要保存临时材质库
