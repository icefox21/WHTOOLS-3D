on KBC_Box1 changed aa do(DriveLineItem1=aa
if aa then setINISetting (getMAXIniFile()) "akoo2009" "DriveLineItem1" "1"
else setINISetting (getMAXIniFile()) "akoo2009" "DriveLineItem1" "0")
on KC_Box2path changed aa do(DriveLineItem2=aa
if aa then setINISetting (getMAXIniFile()) "akoo2009" "DriveLineItem2" "1"
else setINISetting (getMAXIniFile()) "akoo2009" "DriveLineItem2" "0")
on KBC_Box3 changed aa do(DriveLineItem3=aa
if aa then setINISetting (getMAXIniFile()) "akoo2009" "DriveLineItem3" "1"
else setINISetting (getMAXIniFile()) "akoo2009" "DriveLineItem4" "0")
on KBC_SP1 changed aa do(DriveLineScal=aa
setINISetting (getMAXIniFile()) "akoo2009" "DriveLineScal" (aa as string))
on KBC_SP2 changed aa do(DriveLineDash=aa
setINISetting (getMAXIniFile()) "akoo2009" "DriveLineDash" (aa as string))
on KBC_SP4 changed aa do(DriveLineSeg=aa
setINISetting (getMAXIniFile()) "akoo2009" "DriveLineSeg" (aa as string))
on KBC_Box41 changed aa do(DriveLineSiCenter=aa
if aa then setINISetting (getMAXIniFile()) "akoo2009" "DriveLineSiCenter" "1"
else setINISetting (getMAXIniFile()) "akoo2009" "DriveLineSiCenter" "0")
on KBC_RuBu5 changed aa do(DriveLDouCentLeft=aa
