global KL_FillArrY=#()
global KL_FillArrN=5
global KL_FillDirN=1000
global KL_TruDirN=""
global KL_FillSat=2
global KL_RamerSat=false
global lcl_FiArray_roll
global lcl_FiArrayPath
global lcl_JianshiArray=#()
fn lcl_FiArrayFN KL_PathSat KV4 KV5=
(local KL_Sel2,KL_SelA,KL_GroSta,KL_Pivot,KL_QieDir,KL_Int2,KL_Int1,KL_pos1,KL_pos2
delete (for m in KL_FillArrY where IsValidNode m collect m)
global KL_FillArrY=#()
KL_SelA=for k in selection where not(isGroupMember k and not isOpenGroupMember k) collect k
if KL_SelA.count==2 do
(setCommandPanelTaskMode mode:#create
KL_SelA[1].wireColor=KL_SelA[2].wireColor=(random white black)
KL_pos1=KL_SelA[1].center
KL_pos2=KL_SelA[2].center
if KL_PathSat then(KL_Int1=pathToLengthParam KV4 1(nearestPathParam KV4 1 KL_pos1)
KL_Int2=pathToLengthParam KV4 1(nearestPathParam KV4 1 KL_pos2)
if KL_Int1>KL_Int2 do(reverse KV4 1
KL_Int1=1-KL_Int1
KL_Int2=1-KL_Int2)
KL_QieDir=pathTangent KV4 1 (nearestPathParam KV4 1 KL_pos1)
KL_Pivot=pathInterp KV4 1(nearestPathParam KV4 1 KL_pos1))
else(KL_Tem1=SplineShape()
addNewSpline KL_Tem1
addKnot KL_Tem1 1 #corner #line KL_pos1
addKnot KL_Tem1 1 #corner #line KL_pos2)
if (KL_FillSat==1) and KV5 then(if KL_PathSat then(KL_T1=getSegLengths KV4 1  
N1=floor ((KL_T1[KL_T1.count])*(1-KL_Int1+1-KL_Int2)/(KL_FillDirN*Syun)))
else(KL_T1=getSegLengths KL_Tem1 1  
N1=floor ((KL_T1[KL_T1.count])/(KL_FillDirN*Syun)))) 
else(N1=KL_FillArrN
if KL_PathSat do(KL_T1=getSegLengths KV4 1
KL_TrLen=(KL_T1[KL_T1.count])*(1-KL_Int1+1-KL_Int2)/N1*1.0))
if N1>=2 and N1<=100 do(thawSelection()
clearSelection() 
delete KL_SelA[2] 
KL_Objaa=for j in KL_SelA[1] where not isGroupHead j collect j
if KL_PathSat do(KL_MMMMMB9=join #() KL_SelA[1]
for j in KL_MMMMMB9 do j.pivot=KL_Pivot)
KL_GroSta=false
if isGroupHead KL_SelA[1] do(KL_GroSta=true
KL_Grname=KL_SelA[1].name
explodeGroup KL_SelA[1])
if not KL_RamerSat then if KL_PathSat then(KL_AD=for m=1 to (N1-1) collect (KL_Int1+(KL_Int2-KL_Int1)/N1*m)
append KL_AD KL_Int2
KL_MMMMMB10=KL_AD.count
KL_posAR=for m=1 to KL_MMMMMB10 collect (interpCurve3D KV4 1 KL_AD[m])
KL_LenAR=for m=1 to KL_MMMMMB10 collect (lengthTangent KV4 1 (KL_Int1+(KL_Int2-KL_Int1)/N1*m)))
else KL_posAR=for m=1 to N1 collect (interpCurve3D KL_Tem1 1 (1.0/N1*m))     
else if KL_PathSat then(KL_AD=for m=1 to (N1-1) collect (KL_Int1+((KL_Int2-KL_Int1)/N1*m)+(random (-(KL_Int2-KL_Int1)/N1/3) ((KL_Int2-KL_Int1)/N1/3)))
append KL_AD KL_Int2
KL_MMMMMB10=KL_AD.count
KL_posAR=for m=1 to KL_MMMMMB10 collect (interpCurve3D KV4 1 KL_AD[m])
KL_LenAR=for m=1 to KL_MMMMMB10 collect (lengthTangent KV4 1 KL_AD[m]))
else(KL_AD=for m=1 to (N1-1) collect (1.0/N1*m+(random (-1.0/N1/3) (1.0/N1/3)))
append KL_AD 1	
KL_MMMMMB10=KL_AD.count
KL_posAR=for m=1 to KL_MMMMMB10 collect (interpCurve3D KL_Tem1 1 KL_AD[m]))							        
for m=1 to N1 do( if KL_PathSat then maxOps.CloneNodes KL_Objaa cloneType:#instance newNodes:&kuge offset:(KL_posAR[m]-KL_Pivot)
else maxOps.CloneNodes KL_Objaa cloneType:#instance newNodes:&kuge offset:(KL_posAR[m]-KL_pos1)
if KL_GroSta do (kuge=group kuge name:KL_Grname).Pivot=KL_posAR[m]
if KL_PathSat do(case kugepp=viewport.getType() of
(
#view_top:(kugevet3=normalize [100,0,0]
kugevet4=normalize [0,-100,0])
#view_bottom:(kugevet3=normalize [100,0,0]
kugevet4=normalize [0,100,0])
#view_front:(kugevet3=normalize [100,0,0]
kugevet4=normalize [0,0,-100])
#view_back:(kugevet3=normalize [-100,0,0]
kugevet4=normalize [0,0,-100])
#view_left:(kugevet3=normalize [0,-100,0]
kugevet4=normalize [0,0,-100])
#view_right:(kugevet3=normalize [0,100,0]
kugevet4=normalize [0,0,-100])
default:(kugevet3=normalize [100,0,0]
kugevet4=normalize [0,-100,0])
)
kugeRoAngle1=acos(dot KL_QieDir KL_LenAR[m])
kugeRoAngle2=acos(dot KL_QieDir kugevet3)
kugeRoAngle3=acos(dot KL_LenAR[m] kugevet3)
kugeRoAngle4=acos(dot KL_QieDir kugevet4)
kugeRoAngle5=acos(dot KL_LenAR[m] kugevet4)
if (kugeRoAngle2<kugeRoAngle3 and (kugeRoAngle4+kugeRoAngle5)/2<=90)or(kugeRoAngle2>kugeRoAngle3 and (kugeRoAngle4+kugeRoAngle5)/2>90)then KL_ang=-kugeRoAngle1
else KL_ang=kugeRoAngle1  
selectionSets[""]=kuge
case kugepp=viewport.getType() of
(
#view_top:(about KL_posAR[m] rotate selectionSets[""] KL_ang Z_axis)
#view_bottom:(about KL_posAR[m] rotate selectionSets[""] -KL_ang Z_axis)
#view_front:(about KL_posAR[m] rotate selectionSets[""] -KL_ang y_axis)
#view_back:(about KL_posAR[m] rotate selectionSets[""] KL_ang y_axis)
#view_left:(about KL_posAR[m] rotate selectionSets[""] -KL_ang x_axis)
#view_right:(about KL_posAR[m] rotate selectionSets[""] KL_ang x_axis)
default:(about KL_posAR[m] rotate selectionSets[""] KL_ang Z_axis)
)
)
if m==N1 then(KL_Sel2=#()
join KL_Sel2 kuge)
else join KL_FillArrY kuge)
if KL_PathSat then(global KL_FillArrN=N1
if not KL_RamerSat do if (KL_FillSat==2) then(KL_T1=getSegLengths KV4 1  
global KL_FillDirN=(KL_T1[KL_T1.count])*(KL_AD[2]-KL_AD[1]))
else(KL_T1=getSegLengths KV4 1  
global KL_TruDirN=((KL_T1[KL_T1.count])*(KL_AD[2]-KL_AD[1]))as string))
else(global KL_FillArrN=N1
if not KL_RamerSat do if (KL_FillSat==2) then global KL_FillDirN=distance KL_posAR[1] KL_pos1
else global KL_TruDirN=(distance KL_posAR[1] KL_pos1)as string)
if KL_GroSta do(KL_Objaa=group KL_Objaa name:KL_Grname
if KL_PathSat do KL_Objaa.Pivot=KL_Pivot)  
selectMore KL_Objaa
selectMore KL_Sel2
global lcl_JianshiArray=for k in selection where not(isGroupMember k and not isOpenGroupMember k) collect k)
if not KL_PathSat do delete KL_Tem1
setCommandPanelTaskMode mode:#modify)
gc light:true)
fn lcl_Tools_FiArray=
(if (KL_JianCLigObj aaa:1 bbb:3 ccc:2) do(
KL_SelA=for k in selection where not(isGroupMember k and not isOpenGroupMember k) collect k
if KL_SelA.count==2 then
(global KL_FillArrY=#()
KF_SceneUnitsJC()		
rollout lcl_FiArray_roll "阿酷_填充阵列工具"
(checkbutton KC_BU4 "路径排列"  checked:false align:#left  width:60  across:2 pos:[15,14]
radiobuttons KC_RA1 "" labels:#("距离","数量") default:KL_FillSat columns:1 pos:[90,9]
spinner KC_Sub1 "距离" range:[(20*Syun),(50000*Syun),(KL_FillDirN*Syun)] type:#Float scale:(100*Syun) fieldWidth:45 align:#left enabled:(KL_FillSat==1) pos:[140,10]
spinner KC_Sub2 "等分数" range:[2,100,KL_FillArrN] type:#integer scale:1 fieldWidth:30 align:#left  enabled:(KL_FillSat==2) pos:[143,33]
