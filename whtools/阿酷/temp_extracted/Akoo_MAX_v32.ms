KL_Qmenu_a.addItem KL_MM -1
KL_Qmenu_a=KL_Qmenu.getMenu 3
for m=25 to KL_MMMP5 do(KL_MM=menuMan.createActionItem ("AKRmmat"+(m as string)) "阿酷右键材质"
if KL_MM!=undefined do(KL_Qmenu_a.addItem KL_MM -1
if findString KGM_RIMatArrayNam[m] "dx-"==1 or findString KGM_RIMatArrayNam[m] "jz-"==1 
then KL_MM.setTitle (substring KGM_RIMatArrayNam[m] 4 -1)
else KL_MM.setTitle KGM_RIMatArrayNam[m]
KL_MM.setUseCustomTitle true))
KL_Qmenu_a=KL_Qmenu.getMenu 4
KL_MM=menuMan.createActionItem "Material_MLSHouse" "阿酷"
KL_Qmenu_a.addItem KL_MM -1
KL_MM=menuMan.createActionItem "Material_MLSPublic" "阿酷"
KL_Qmenu_a.addItem KL_MM -1
KL_MM=menuMan.createActionItem "Material_RightKey" "阿酷"
KL_Qmenu_a.addItem KL_MM -1)
else(KL_Qmenu=menuMan.createQuadMenu "AkooMatMenu" KL_RMname KL_RMname "" ""
KL_Qmenu_a=KL_Qmenu.getMenu 2
for m=1 to KL_MMMP5 do(KL_MM=menuMan.createActionItem ("AKRmmat"+(m as string)) "阿酷右键材质"
if KL_MM==undefined do(filein (KGXL_ZongMJLLCT[1][2]+"Akoo_PRO2009_STA.mcr")
KL_MM=menuMan.createActionItem ("AKRmmat"+(m as string)) "阿酷右键材质")
if KL_MM!=undefined do(KL_Qmenu_a.addItem KL_MM -1
if findString KGM_RIMatArrayNam[m] "dx-"==1 or findString KGM_RIMatArrayNam[m] "jz-"==1 
then KL_MM.setTitle (substring KGM_RIMatArrayNam[m] 4 -1)
else KL_MM.setTitle KGM_RIMatArrayNam[m]
KL_MM.setUseCustomTitle true))
KL_Qmenu_a=KL_Qmenu.getMenu 1
KL_MM=menuMan.createActionItem "Material_MLSHouse" "阿酷"
KL_Qmenu_a.addItem KL_MM -1
KL_MM=menuMan.createActionItem "Material_MLSPublic" "阿酷"
KL_Qmenu_a.addItem KL_MM -1
KL_MM=menuMan.createActionItem "Material_RightKey" "阿酷"
