(KL_KCV=try(fileProperties.getPropertyValue #custom(fileProperties.findProperty #custom "KugeMat_Temp"))catch("")
KC_M2.selection=#{}
KL_FFbMatARFF=for n in(getFiles(((GetDir #maxroot)+"materiallibraries")+"\\"+"*.mat"))where not(matchPattern n pattern:"*TempM*" ignoreCase:false) and not(matchPattern n pattern:"*_M.mat" ignoreCase:true)collect(getFilenameFile n)
KL_FFbMatAR=for n in(getFiles(((GetDir #maxroot)+"materiallibraries")+"\\"+"*.mat"))collect(getFilenameFile n)
-----KF_FillRightMat KGL_CurerMatLIB false false                  -----总是加载当前材质库这里并不需要这个函数,而仅仅收集右键材质集合就OK了
lclRightarray=join #() KGM_RIMatArray
lclRightarrayNam=join #() KGM_RIMatArrayNam
KC_M2.items=lclRightarrayNam
KC_DL2.items=KL_FFbMatAR                                     -----这个用两个数组来收集材质库文件菜单,主要是用来区分切换预设下拉框和定制全局下拉框的内容;
KC_DL2.selection=findItem KL_FFbMatAR  KL_KCV
KC_DLF1.items=KC_DLF2.items=KL_FFbMatARFF
KC_DLF1.selection=findItem KL_FFbMatARFF  (getINISetting (getMAXIniFile()) "akoo2009" "INI_RightPerYS1")
KC_DLF2.selection=findItem KL_FFbMatARFF  (getINISetting (getMAXIniFile()) "akoo2009" "INI_RightPerYS2"))
on KR_RightMRoll close do(KGM_RIMatArray=join #() lclRightarray
KGM_RIMatArrayNam=join #() lclRightarrayNam
KL_CCC=KF_TempMat_Fileserial()   ---刷新临时右键材质记录文件,将当前状态的KGM_RIMatArray材质球保存起来
KF_RightMenuInit())
---on KR_RightMRoll rbuttondown vvdd do(DestroyDialog KR_RightMRoll)    取消这个功能,以免右键复位数值为0时不小心关闭了面板
)
createdialog KR_RightMRoll))
fn lcl_Material_Switch aa bbbb=               ----在自定义材质库之间切换
(KF_UnRightMenu()
local GGL_RightPerYS1=getINISetting (getMAXIniFile()) "akoo2009" "INI_RightPerYS1"
local GGL_RightPerYS2=getINISetting (getMAXIniFile()) "akoo2009" "INI_RightPerYS2"
local KR_MatBankfff=(getINISetting (getMAXIniFile()) "akoo2009" "KR_MatBankBitmap")=="1"   
if KR_MatBankfff and doesFileExist (KL_Tempa=((GetDir #maxroot)+"materiallibraries")+"\\"+GGL_RightPerYS1+"_M.mat") do GGL_RightPerYS1=(getFilenameFile KL_Tempa)
if KR_MatBankfff and doesFileExist (KL_Tempb=((GetDir #maxroot)+"materiallibraries")+"\\"+GGL_RightPerYS2+"_M.mat") do GGL_RightPerYS2=(getFilenameFile KL_Tempb)
KGL_SceneMatLIB=#(GGL_RightPerYS1,GGL_RightPerYS2)
local Kl_F111111=false
case  aa  of
(
1:(KF_FillRightMat KGL_SceneMatLIB[1] true bbbb)
2:(KF_FillRightMat KGL_SceneMatLIB[2] true bbbb)
)
KF_TempMat_Fileserial()                    ---刷新临时右键材质记录文件,将当前状态的KGM_RIMatArray材质球保存起来
try(KR_RightMRoll.KC_M2.items=lclRightarrayNam)catch()
KF_CreatRightMenu())
