fn	lcl_collapse_Reset=
(if (KL_JianCLigObj aaa:1 bbb:3 ccc:2) do(
undo on(kuge33=for i in selection where ViewgeoFilt i and (canConvertTo i Mesh) collect i
if kuge33.count>0 do
