fn KHF_CollToArray aa bb1 bb2 bb3 bb4 cc dd ee xx=     ---资源集合归类处理函数:1.处理对象;2-5.对应全局资源收集函数;6.类型名;7.父对象;8.当前对象在父对象的子序号;9.资源是否存在的状态值传递;
(if(superclassof aa)==textureMap    ----如果还是纹理或位图纹理对象,还需要迭代深入检测收集,否则表示已经为路径对象,按后面的方式进行拆分处理收集;
then if(classof aa)==Bitmaptexture then(if aa.fileName!=undefined and(KL_HZJ1=mapPaths.getFullFilePath aa.fileName)!=""   ---必须先考虑文件名为空的情况,否则会报错;
then(KL_Bfij1=KL_HZJ1             -----收集真正路径之前必须同步切换为真正路径,否则后面搜索或切换有问题
if aa.fileName!=KL_Bfij1 do aa.fileName=KL_Bfij1
xx=false)
else(KL_Bfij1=aa.fileName
xx=true)
KHF_CollToArray KL_Bfij1 bb1 bb2 bb3 bb4 cc dd ee xx)
else(KL_OncecouA=getNumSubTexmaps aa
for jB=1 to KL_OncecouA do(kugeB=getSubTexmap aa jB
KHF_CollToArray kugeB bb1 bb2 bb3 bb4 cc aa jB false))
else if aa!="" and aa!=undefined do if(KL_tr=(findItem bb1 aa))==0 then(append bb1 aa    ---排除所有出错情况,进行收集,根据路径字符串进行新收或追加收集;
append bb2 #(cc) --新追加类型名多维数组
append bb3 #(#(dd,ee))   --新追加父对象+子序号的多级多维数组
append bb4 xx)           --配套追加路径是否存在;
else(append bb2[KL_tr] cc           ---路径字符串重复的情况下追加收集类型名多维数组;
append bb3[KL_tr] #(dd,ee)))  ---路径字符串重复的情况下追加父对象+子序号的多级多维多维数组;
