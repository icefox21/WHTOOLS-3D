dropdownlist KC_DL1 "" items:#("SHIFT+","ALT+","CTRL+","SHIFT+ALT+","SHIFT+CTRL+","CTRL+ALT+","SHIFT+CTRL+ALT+") height:8  pos:[255,388] width:95 selection:KGL_RightPos
label KL_Lbba "移动至" pos:[318,136]
spinner KC_SP2 range:[1,48,1] type:#integer scale:1 fieldWidth:22 pos:[316,154]
button KC_BU12 "删除" pos:[318,230] width:35
button KC_BU13 "清空" pos:[318,255] width:35
dropdownlist KC_DLF1 "" pos:[173,413] width:85 height:16
dropdownlist KC_DLF2 "" pos:[265,413] width:85 height:16
fn KF_RightMat_Itemserial abc abd abe=     -------这个函数将指定数组集合里的选择项目移动指定数量的位置:需要三个参数 
----1.最小选择序号数要移动至的目标位置;2.选择序号集合数组;3.要处理的数组集合(多维数组)
(KL_XUJQN=0                               -----初始化最终移位变量
if abc.value!=abd[1] and abc.value>0 do    -----如果目标序号数不为原数且大于0
(if abc.value<abd[1] then if (KL_VFA=abd[1]-abc.value)>=1 then KL_XUJQN=-KL_VFA           -----如果是减序,如果大于0,则最终变量直接减得,否则钳位到最大可减数
else(KL_XUJQN=-(abd[1]-1)
abc.value=abd[1]+KL_XUJQN)
else if abd[abd.count]+(KL_VFA=abc.value-abd[1])<=abe[1].count then KL_XUJQN=KL_VFA   -----如果是加序,如果小等于最大数,则最终变量直接减得,否则钳位到最大可减数
else(KL_XUJQN=abe[1].count-abd[abd.count]
abc.value=abd[1]+KL_XUJQN))
KL_NewA=for m in abd collect #((m+KL_XUJQN),abe[1][m],abe[2][m])
for m=1 to abd.count do for n in abe do deleteItem n abd[(abd.count+1-m)]
for m=1 to KL_NewA.count do for n=1 to abe.count do(KL_VFC=KL_NewA[m]
insertItem KL_VFC[(1+n)] abe[n] KL_VFC[1])
for m in KL_NewA collect m[1])
on KC_ED2 entered aa do
(KL_Item3=KC_M2.selection as array
if KL_Item3.count==1 then lclRightarray[(KL_Item3[1])].name=aa   -----这里仅允许一次更改一个材质对象的名字;
else KC_ED2.text=""
KL_NBW11=KF_MatPar_Init lclRightarray false  false
lclRightarray=KL_NBW11[1]
KC_M2.items=lclRightarrayNam=KL_NBW11[2])
on KC_SP2 changed bb do                           -----上下移动条目控件
(KL_Item3=KC_M2.selection as array
KL_CCtv=KF_RightMat_Itemserial KC_SP2 KL_Item3 #(lclRightarrayNam,lclRightarray)
for mm=1 to lclRightarray.count do try(lclRightarray[mm].KP_MatSequ=mm)catch(mm)
KC_M2.selection=KL_CCtv
KL_NBW11=KF_MatPar_Init lclRightarray false false
lclRightarray=KL_NBW11[1]
KC_M2.items=lclRightarrayNam=KL_NBW11[2])
on KC_SP1 changed bb do                        ----挤出量控件
(KL_Item3=KC_M2.selection as array
for m in KL_Item3 do lclRightarray[m].KP_MatExtr=bb
KL_NBW11=KF_MatPar_Init lclRightarray false false
lclRightarray=KL_NBW11[1]
KC_M2.items=lclRightarrayNam=KL_NBW11[2])
on KC_CB1 changed aa do                                   -----去掉底盖控件;
(KL_Item3=KC_M2.selection as array
for m in KL_Item3 do lclRightarray[m].KP_MatCaps=aa
KL_NBW11=KF_MatPar_Init lclRightarray  false false
lclRightarray=KL_NBW11[1]
KC_M2.items=lclRightarrayNam=KL_NBW11[2])	 
on KC_M2 selectionEnd do(KL_Item3=KC_M2.selection as array
KC_SP2.value=KL_Item3[1] 
if KL_Item3.count==1 then(KC_ED2.text=lclRightarray[(KL_Item3[1])].name 
KC_CB1.checked=lclRightarray[(KL_Item3[1])].KP_MatCaps
KC_SP1.value=lclRightarray[(KL_Item3[1])].KP_MatExtr)
else(KC_ED2.text=(KL_Item3.count as string)+"材质选中"
KC_CB1.checked=false
KC_SP1.value=kugXinit3))
on KC_BU11 pressed do                    ----可选列表往材质列表添加条目(到之前);
(KL_Item3=KC_M2.selection as array 
KL_Item=KC_M1.selection as array      ----获得两个列表中的选择序号集合
KL_Tnjklo=for t in lclRightarray collect t.name		------收集已有材质的名字集合
if KL_Item3.count>0                                    -----如果目标集合有选择,则插入指定位置,否则从集合的开头开始插入;
then for m=1 to KL_Item.count where(findItem KL_Tnjklo lclLeftarray[(KL_Item[m])].name)==0 and lclRightarray.count<48 do insertItem lclLeftarray[(KL_Item[m])] lclRightarray (KL_Item3[1]+m-1) 
