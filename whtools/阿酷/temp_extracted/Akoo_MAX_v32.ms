fn KF_CutrQiehuan cc aa bb XX=
(for ig in #(KC_CU116,KC_CU117,KC_CU118) where ig!=cc do ig.checked=false
if aa then(KCVCC3=try(fileProperties.getPropertyValue #custom(fileProperties.findProperty #custom bb)!=undefined)catch(false)
if keyboard.controlPressed or (not KCVCC3)then(KF_CustomViewCreat bb "AKOOSystem:"
XX[1].text=XX[2])
else KF_CustomView bb  undefined)
else if KGL_CurrentCustview!=undefined do(if viewport.getType()!=#view_top do(viewport.setType #view_top
max zoomext sel)
activegrid=undefined
toolMode.coordsys #view
KGL_CurrentCustview=undefined
KGL_CurrentCustviewSer=0))
on KC_CU116 changed aa do KF_CutrQiehuan KC_CU116 aa "AKOOViewCUSTOM1" #(KC_CU116,"A+")
on KC_CU117 changed aa do KF_CutrQiehuan KC_CU117 aa "AKOOViewCUSTOM2" #(KC_CU117,"B+")
on KC_CU118 changed aa do KF_CutrQiehuan KC_CU118 aa "AKOOViewCUSTOM3" #(KC_CU118,"C+")

fn KF_MConQieH aa=
(KGL_ToolBalNum=aa
setINISetting (getMAXIniFile()) "akoo2009" "ToolBalNum" (aa as string)
KL_MMMP1=Kl_ZCCooM.count
for m=1 to KL_MMMP1 where m!=aa do Kl_ZCCooM[m].checked=false
KL_MMMP2=Kl_ZCCool.count
for m=1 to KL_MMMP2 do if m<=KCOM_BU01_LI[aa].count then(Kl_ZCCool[m].text=KCOM_BU01_LI[aa][m]
Kl_ZCCool[m].visible=true)
else Kl_ZCCool[m].visible=false)
