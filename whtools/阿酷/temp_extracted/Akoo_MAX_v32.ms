if hasProperty KL_TempMod "封闭底部" then(KL_TempMod.封闭底部=0
KL_TempMod.封闭顶部=0
if KL_TempMod.级别_1_高度==0 do KL_TempMod.级别_1_高度=kugeEXt)
else(KL_TempMod.Cap_Bottom=0
KL_TempMod.Cap_Top=0
if KL_TempMod.Level_1_Height==0 do KL_TempMod.Level_1_Height=kugeEXt))
if validModifier selection (Shell()) do(if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify
modPanel.addModToSelection (Shell straightenCorners:true))))
fn lcl_Modifier_MapScaler=
(if subObjectLevel==0 or subObjectLevel==undefined then
(undo on(kugecom=for i in selection where ViewgeoFilt i collect i 
if kugecom.count>0 do
(KF_SceneUnitsJC()		
if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify
kugemapUVW=((getINISetting AK_INIT_File "akoo2011" "KUGEUVWmapSIZE") as Integer)*Syun
kugecomAA=getCurrentSelection()
thawSelection()
clearSelection() 
if kugecomAA.count>kugecom.count do(kugegshapeobj=for i in kugecomAA where not(ViewgeoFilt i or isGroupHead i)collect i
for jk in kugegshapeobj do(if isGroupMember jk do setGroupMember jk false
if jk.parent!=undefined do jk.parent=undefined
deleteItem kugecomAA (findItem kugecomAA jk)))
for ss in kugecom do(kugemodcount=ss.modifiers.count 
for kk=1 to kugemodcount do if (kugemm=findItem kugeMapModAr ss.modifiers[kugemodcount+1-kk].name)!=0 and kugemm>2 do
deleteModifier ss (kugemodcount+1-kk))
select kugecomAA
if modPanel.validModifier (MapScalerSpacewarpModifier()) do modPanel.addModToSelection (MapScalerSpacewarpModifier scale:kugemapUVW upDirection:0))))
else messageBox "这个修改器只能添加在对象层级，请先退出当前子层级再操作!" title:"整体贴图警告--阿酷提示")
global lcl_UVWmap_Direction
fn lcl_UVWmap_Direction=
(if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify             ---保证切换到修改命令面板;
global KL_UVWDirection=modPanel.getCurrentObject()
if KL_UVWDirection!=undefined and KL_UVWDirection.classid as string=="#(1012401, 0)" do
(startTool KHTOOL_UVWDirectionalTools snap:#3D numPoints:2))
fn lcl_UVWmap_Zoom ZZ aa=
(if isCreatingObject line then if ZZ then max izoom in
else max izoom out
else(KL_Modept=KHF_SceneRayNor (mapScreenToWorldRay mouse.pos)   ----这里输入肯定最大角度值,忽略掉出射角度限制;
if KL_Modept!=undefined do(KG=KL_Modept[1].modifiers
KL_Colluvw=for m in KG where findItem KGL_MapModifiersID (m.classid as string)!=0 collect m
for m in KL_Colluvw do(m.length=m.length*aa
m.width=m.width*aa
m.height=m.height*aa))))       ----只有在定向模式才旋转,避免在缩放模式或操作上弄乱朝向;
fn lcl_Modifier_uvwmap=
(global lcl_UVWmap_Direction
KF_SceneUnitsJC()	
KL_WvwSize=(((getINISetting AK_INIT_File "akoo2011" "KUGEUVWmapSIZE") as Integer)*Syun)   ----重算系统单位比率和取得全局变量的贴图坐标大小;
KL_A1=uvwmap maptype:4 length:KL_WvwSize width:KL_WvwSize height:KL_WvwSize
KL_UvwObj=getCurrentSelection()
if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify             ---保证切换到修改命令面板;
snapMode.active=true             ----最好保证开启捕捉设置,帮助捕捉对准和鼠标移动提示反馈;
if KL_UvwObj.count>0 do undo on                                                                   ----如果有选择对象才进行;
(if(subObjectLevel==0 or subObjectLevel==undefined)and not(KL_UvwObj.count==1 and superClassOf KL_UvwObj[1]==shape)    ----如果处于对象层级才进行图像排除和
then(thawSelection
clearSelection()                    ----先临时取消当前选择集;
KL_TrueObj=#()
for i in KL_UvwObj do if KHF_NValidModObj i KL_A1   ---检测过滤选择对象中所有的真图形,Vray对象,不允许添加修改器类对象;
then(setGroupMember i false            
i.parent=undefined)               -----遍寻每个真图形对象,去除组包裹和父对象定义;
else(KG=i.modifiers
kl_MM=KG.count
for m=1 to kl_MM where(KL_Num=findItem KGL_MapModifiersID(KG[(kl_MM+1-m)].classid as string))!=0 and(getProperty KG[(kl_MM+1-m)] KGL_MapModifiersCS[KL_Num])==1 do deleteModifier i KG[(kl_MM+1-m)]
append KL_TrueObj i)
select KL_TrueObj
modPanel.addModToSelection KL_A1)
else(modPanel.addModToSelection KL_A1))
lcl_UVWmap_Direction())
fn lcl_Modifier_EditMesh=
(KL_A1=(edit_mesh())
KL_UvwObj=getCurrentSelection()
if getCommandPanelTaskMode()!=#modify do setCommandPanelTaskMode mode:#modify             ---保证切换到修改命令面板;
if KL_UvwObj.count>0 do undo on                                                                   ----如果有选择对象才进行;
(if(subObjectLevel==0 or subObjectLevel==undefined)and not(KL_UvwObj.count==1 and superClassOf KL_UvwObj[1]==shape)    ----如果处于对象层级才进行图像排除和
then(thawSelection
clearSelection()                    ----先临时取消当前选择集;
KL_TrueObj=#()
for i in KL_UvwObj do if KHF_NValidModObj i KL_A1   ---检测过滤选择对象中所有的真图形,Vray对象,不允许添加修改器类对象;
then(setGroupMember i false            
i.parent=undefined)               -----遍寻每个真图形对象,去除组包裹和父对象定义;
else append KL_TrueObj i
select KL_TrueObj
modPanel.addModToSelection KL_A1)
else(modPanel.addModToSelection KL_A1)))
/*存在两个参数关系到精度:
1.标准平面检测用法线偏移量,理论标准为<1,这里精度值为"KL_FaceNorYZ"变量值;
2.允许挤出最小值定义,理论标准为==0,这里精度值为"KL_ExtrMinYZ"变量值;注意这里是负值,应是大于一个负值;
*/

fn lcl_Modifier30_RetoreExtrude=
(local KL_ModiObj,SyunLc,KL_FaceNorYZ,KL_ExtrMinYZ,KL_PPaa,KL_Edg,KL_PUto,KL_FaceAr,KL_FaceArJL,KL_JCSX,KL_emesh,KL_Filrt
if (KL_JianCLigObj aaa:1 bbb:3 ccc:2) do(
KF_SceneUnitsJC()
KL_FaceNorYZ=0.95
KL_ExtrMinYZ=-(10*Syun)
KL_ModiObj=classof(modPanel.getCurrentObject()) 
if (KL_ModiObj==Edit_Mesh or KL_ModiObj==Editable_mesh)and(subObjectLevel==3 or subObjectLevel==4) do  ---命令处理条件:必须为编辑网格且处于3或4层级才有效;
(case units.SystemType of           -----根据当前场景系统单位转换对应的精度值(小数点后面的位数)
(
#inches:(SyunLc=3)       ---英寸
#feet:(SyunLc=4)          ---英尺
#miles:(SyunLc=-3)            ---微米
#millimeters:(SyunLc=1)       ---毫米
#centimeters:(SyunLc=2)       ---厘米
#meters:(SyunLc=4)          ---米
#kilometers:(SyunLc=7)   ---千米
default:(SyunLc=1)       ---毫米
)
KL_PPaa=for i in selection where ViewgeoFilt i collect i              -----集合当前选择集;
subObjectLevel=0
thawSelection()                           -----确保没有被锁定,否则会不能更换显示;
clearNodeSelection redraw:false            ----清除选择,保证处理效率,
for KL_seme in KL_PPaa do                 ----批处理每个初选对象
(KL_Edg=((getFaceSelection KL_seme)as array)[1]         ----获得当前对象第一个选择面;
if KL_Edg!=undefined do
(KL_PUto=matrixFromNormal(getFaceNormal KL_seme KL_Edg)   ----获得标准面矩阵(首次相关到坐标系原点),注意这里的面方向是相反的;
translate KL_PUto(meshop.getFaceCenter KL_seme KL_Edg)   ----移动矩阵至面中心点(真正关注到自身系统)
KL_FaceAr=#()                                                ----初始化平面收集数组变量
KL_FaceArJL=0                                                ----初始化厚度值为0
for m=1 to KL_seme.numfaces do(in coordsys KL_PUto KL_111=getFaceNormal KL_seme m             -----基于标准矩阵获取所有面法线;
in coordsys KL_PUto KL_222=meshop.getFaceCenter KL_seme m      -----基于标准矩阵获取所有面中心;
if KL_111[3]<KL_FaceNorYZ do append KL_FaceAr m                        -----收集所有法线不统一与标准面法线(准备到删除)
if KL_222[3]<KL_FaceArJL do KL_FaceArJL=KL_222[3])            -----累计检测负方向(标准面法线负方向)上的最大值并收获;
for m=1 to KL_seme.numverts do(in coordsys KL_PUto KL_222=getVert KL_seme m      -----基于标准矩阵获取所有面中心;
if KL_222[3]<KL_FaceArJL do KL_FaceArJL=KL_222[3])            -----累计检测负方向(标准面法线负方向)上的最大值并收获;
----setFaceSelection KL_seme KL_FaceAr
-----遍寻所有面,取得每个面的法线和中心点,将面法线统一(面法线第3个元素为1)和同平面(面中心第3个元素为0)的面收集起来
-----取得最大的厚度值;

KL_JCSX=#(KL_seme.material,KL_seme.wireColor,KL_seme.layer)     ---预先收集源对象的材质,线框颜色,图层状态)
KL_emesh=snapshot KL_seme		                                  -----复制源对象当前状态,准备提炼出目标平面面集合;					  
meshop.deleteFaces KL_emesh KL_FaceAr delIsoVerts:true          -----删除并更新多余的面;
update KL_emesh               
KL_Filrt=#()                                                   -----初始化对应开放边的点对数组
KL_DDD=(meshop.getOpenEdges KL_emesh)as array                  ----获得这个平面上所有的打开边
for m in KL_DDD do join KL_Filrt(meshop.getVertsUsingEdge KL_emesh m)   ----收集开放边对应点序号对,跟打开边数组呈倍数关系,边数==点序号对数==等于2倍点序号数
KL_NewSpineAR=#()           ----准备收集每圈边界边的顶点坐标位置集合,多维数组(每个子元素为一根线条的所有点坐标值);
while KL_Filrt.count>0 do(KJ_11=KL_Filrt[1]        
KJ_12=KL_Filrt[2]           ------从第一条开放边的两个点序号开始检测和收集完整有序的整圈点序号数;
KL_AA1=#(KJ_12)             -----新建一个当前线条的点序号收集数组,并放入第二个点序号(因为最后一个序号就是第一个序号,所以这里不用放首点);
deleteItem KL_Filrt 1 
deleteItem KL_Filrt 1        ----删除掉处理过后的数组元素;注意这里是从前数位删,重复两次相当于删掉这一组点序号对;
KL_CCDW=findItem KL_Filrt KJ_12    -----获得下一顶点对的顺接点序号,只要有顺接点,就迭代进行处理,直至没有了顺接点,就结束当前边界圈
while KL_CCDW!=0 do(if(mod KL_CCDW 2)==0 then(KL_CCDWB=-1         ----如果偶数序号,对点序号为前面一个,删除元素时重复前面数位两次;
KL_DelNum=KL_CCDW-1)   
else(KL_CCDWB=1           ----如果偶数序号,对点序号为后面一个,删除元素时重复当前数位两次;
KL_DelNum=KL_CCDW)   ----检测顺接点时处于奇数还是偶数位,以定义对点是后一位还是前一位,且定义出前面位,供后面删除数组元素用;
KL_13=KL_Filrt[(KL_CCDW+KL_CCDWB)]      
append KL_AA1 KL_13                        -----获得和收集好顺接过来的对点
deleteItem KL_Filrt KL_DelNum
deleteItem KL_Filrt KL_DelNum
KL_CCDW=findItem KL_Filrt KL_13)          -----重新进行下一顺接点的搜索,给KL_CCDW赋值,进入下一While循环                                
append KL_NewSpineAR KL_AA1)                                   ------至上面While循环结束,整理出当前样条的完整顺序顶点序号,用于后面获取坐标进行创建样条线;
KL_VerNAR=for m in KL_NewSpineAR collect(for n in m collect(in coordsys KL_PUto getVert KL_emesh n))   ----in coordsys KL_PUto 将整圈顶点序号转化为整圈点坐标多维数组;
delete KL_emesh
-----到这一步为止,利用中间对象取得完整的样条线对象所需的所有点坐标数据,
for aa=1 to KL_VerNAR.count do for ab=1 to KL_VerNAR[aa].count do         -----逐一进行顶点坐标值的精度转换
(KL_CMb=KL_VerNAR[aa][ab].x as string           
KL_CMC=KL_VerNAR[aa][ab].y as string         -----首先转换X Y坐标值为字符串;
KL_Ditnum=findString KL_CMb "."
KL_Ditnun=findString KL_CMc "."               -----检测字符串中小数点的位置;
if KL_Ditnum!=undefined do KL_VerNAR[aa][ab].x=(substring KL_CMb 1(KL_Ditnum+SyunLc))as Float
if KL_Ditnun!=undefined do KL_VerNAR[aa][ab].y=(substring KL_CMc 1(KL_Ditnun+SyunLc))as Float) 	 ------根据当前场景单位截取对应的小数位数后返回给原坐标值;	
-----这一步将获得的所有顶点坐标数据进行精度转换处理,避免挤出坏面等情况,下面就进行挤出结构的再生处理;				 

KL_NewSPG=splineShape()      -----创建样条线对象; transform:KL_PUto
for m=1 to KL_VerNAR.count do(addnewSpline KL_NewSPG                               -----添加所有线条
for n in KL_VerNAR[m] do addKnot KL_NewSPG m #Corner #line [n.x,n.y,0]        -----为每个线条添加所有顶点; in coordsys KL_PUto 
close KL_NewSPG m)                                                   -----闭合每一线条
updateShape KL_NewSPG
KL_PPPcv=convertToSplineShape(rectangle material:KL_JCSX[1] wireColor:KL_JCSX[2])
addAndWeld KL_PPPcv KL_NewSPG 0
deleteSpline KL_PPPcv 1
updateShape KL_PPPcv                             -----将新建的样条线对象进行再复位处理;
KL_PPPcv.transform=KL_PUto
KL_JCSX[3].addnode KL_PPPcv                         -----将新对象继承到源对象所在的图层 
print KL_FaceArJL
if KL_FaceArJL>KL_ExtrMinYZ then addModifier KL_PPPcv (edit_mesh())                       ------如果厚度值几乎忽略时直接添加edit_mesh修改器;
else(in coordsys KL_PUto move KL_PPPcv [0,0,KL_FaceArJL]  ------将新对象退后,留出基出厚度位置;
addModifier KL_PPPcv (Extrude amount:-KL_FaceArJL))
))
select KL_PPaa)))           
if (getINISetting (getMAXIniFile()) "akoo2009" "RanMSRMoveD")=="" do setINISetting (getMAXIniFile()) "akoo2009" "RanMSRMoveD" "1000"
if (getINISetting (getMAXIniFile()) "akoo2009" "RanMSRRotaD")=="" do setINISetting (getMAXIniFile()) "akoo2009" "RanMSRRotaD" "30"
if (getINISetting (getMAXIniFile()) "akoo2009" "RanMSRScaleD")=="" do setINISetting (getMAXIniFile()) "akoo2009" "RanMSRScaleD" "0.75"
