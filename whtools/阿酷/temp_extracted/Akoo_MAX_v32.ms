fn KFREG_ZHUCEBJ aa bb=   ---机器码比较函数;参数1:aa,为当前机器的机器码;参数2:bb,为当前安装包注册了的机器码;
(KL_BBDD=false         ---初始化比较状态变量为false,只要检测到有一个机器码匹配,马上退出迭代且标记为true,否则始终为false(返回到调用函数处);
ZX=0                  ---迭代计数器清零
KL_BB=bb.count        ---迭代计数最大值(所有注册码);
KL_A=filterString aa "-"   ----肢解本机机器码;
while ZX<KL_BB and not KL_BBDD do(ZX+=1               ----只要未达到迭代最大值且比较状态变量未检测到有效的机器码,始终迭代处理;
KL_B=filterString bb[ZX] "-"    ----获得当前机器码数组里对应序号的机器码并肢解;
KL_C=0                          ----按位比较计数器;
for m=4 to 5 do if KL_A[m]==KL_B[m] and KL_A[m]!="0" and KL_C<1 do KL_C+=1  ---首先检测4和5节,如果有匹配则加1(两码节最大得到1)
for m=1 to 3 do if KL_A[m]==KL_B[m] and KL_A[m]!="0" do KL_C+=1              ---依次检测所有的码节,有匹配的码节均加1;
KL_BBDD=(KL_C>=3))            ---如果任一次机器码合法(大于等于3),则变更状态变量为True,这时将退出迭代
KL_BBDD)	    ----将状态变量返回给总检测函数,是否有匹配到的机器码;



