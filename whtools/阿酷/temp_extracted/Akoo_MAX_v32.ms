on KC_DL11X	pressed do(KL_MBselCd=KC_MB15.selection as array
if KL_MBselCd.count>0 do
(KL_FOGG=(KF_SceneObjGro false false false true rendHidden)[3][1]
if KL_FOGG.count>-1 do(KLN_GroNmeColl=KL_FOGG
try(DestroyDialog KR_SceGroSel3)catch()
CreateDialog KR_SceGroSel3)))	
fn KF_VrResumeDefa aa=
(print aa
if aa<3 then(if classof renderers.current.options_defaultLights==Integer then renderers.current.options_defaultLights=0
else renderers.current.options_defaultLights=false    -----解决VRay2.0这个属性值类型不同引起的报错;
renderers.current.system_vrayLog_show=false
if hasProperty renderers.current "gi_saturation" do renderers.current.gi_saturation=0
if hasProperty renderers.current "options_glossyEffects" do renderers.current.options_glossyEffects=false
KL_RayGlbal=RaytraceGlobalSettings()
KL_RayGlbal.enable_raytracing=KL_RayGlbal.enable_self_reflect_refract=KL_RayGlbal.enable_atmosphere=KL_RayGlbal.enable_material_id_rendering_support=false
KL_RayGlbal.showMessages=KL_RayGlbal.showProgressDlg=false
backgroundColor=KC_CP2.color
useEnvironmentMap=false
ambientColor=(color 0 0 0)
if aa==2 then(renderers.current. filter_on=KC_RenA1.checked
renderers.current.filter_kernel=(Catmull_Rom())
renderers.current.imageSampler_type=(KC_RenA4.selection-1)
renderers.current.gi_on=true
renderers.current.gi_primary_type=0 
renderers.current.gi_primary_multiplier=0.9
renderers.current.gi_secondary_multiplier=0.95          -----印象书上阐述这样可以充分控制过度曝光;
if hasProperty renderers.current "lightcache_mode" do(renderers.current.gi_secondary_type=3
renderers.current.lightcache_subdivs=KC_RenA7F.value)
renderers.current.gi_irradmap_preset=0
renderers.current.gi_irradmap_minRate=#(-4,-3,-2,-1)[KC_RenA6.selection]
renderers.current.gi_irradmap_maxRate=#(-3,-2,-1,0)[KC_RenA6.selection]  ----根据印象书上调节,大图设置为-3,-2
renderers.current.gi_irradmap_subdivs=KC_RenA7.value
renderers.current.environment_gi_on=true
renderers.current.environment_gi_color_multiplier=KC_RenA11.value
renderers.current.options_reflectionRefraction=KC_RenA12.checked
renderers.current.options_limitDepth=true
renderers.current.options_maxDepth=KC_RenA13.value) 	
else(renderers.current.gi_on=false
renderers.current.dof_on=false
renderers.current.caustics_on=false
renderers.current.moblur_on=false
renderers.current.colorMapping_type=0 
renderers.current.environment_gi_on=false))
else(renderers.current. filter_on=KC_RenB1.checked
renderers.current.options_reflectionRefraction=KC_RenB2.checked
if hasProperty renderers.current "options_glossyEffects" do renderers.current.options_glossyEffects=KC_RenB3.checked)
renderers.current.system_raycaster_maxLevels=100
if hasProperty renderers.current "options_ray_bias" do renderers.current.options_ray_bias=0.001
renderers.current.system_region_sequence=3)
fn KF_MulCamHXHF aa=
(undo off(try(delete KL_UUCC[3])catch())
if KL_MulCamtempfile!=undefined do(try(renderpresets.LoadAll 0 KL_MulCamtempfile
if AKEnvirSunNode!=undefined do(if isProperty environmentMap "sun_node" do environmentMap.sun_node=AKEnvirSunNode
if isProperty environmentMap "阳光节点" do environmentMap.阳光节点=AKEnvirSunNode)
if AKEnvirNode!=undefined do meditMaterials[AKEnvirNode]=environmentMap)catch()
try(deleteFile KL_MulCamtempfile)catch()
