fn SUbfn_Collset BBB KL_WQ1 aa=                              ----目标路径对象的所有子路径集合(嵌套8级) 但限制最大收集数为100,超过则不收集了
(if aa then KL_mmC=100000
else KL_mmC=100
if findItem KL_WQ1 BBB==0 and KL_WQ1.count<KL_mmC do append KL_WQ1 BBB
if (KL_TT1=getDirectories (BBB+"*")).count!=0 do for y1 in KL_TT1 do(if findItem KL_WQ1 y1==0 and KL_WQ1.count<KL_mmC then append KL_WQ1 y1
else exit
if (KL_TT2=getDirectories (y1+"*")).count!=0 do  for y2 in KL_TT2 do(if findItem KL_WQ1 y2==0 and KL_WQ1.count<KL_mmC then append KL_WQ1 y2
else exit
if (KL_TT3=getDirectories (y2+"*")).count!=0 do  for y3 in KL_TT3 do(if findItem KL_WQ1 y3==0 and KL_WQ1.count<KL_mmC then append KL_WQ1 y3
else exit
if (KL_TT4=getDirectories (y3+"*")).count!=0 do  for y4 in KL_TT4 do(if findItem KL_WQ1 y4==0 and KL_WQ1.count<KL_mmC then append KL_WQ1 y4
else exit
if (KL_TT5=getDirectories (y4+"*")).count!=0 do  for y5 in KL_TT5 do(if findItem KL_WQ1 y5==0 and KL_WQ1.count<KL_mmC then append KL_WQ1 y5
else exit
if (KL_TT6=getDirectories (y5+"*")).count!=0 do  for y6 in KL_TT6 do(if findItem KL_WQ1 y6==0 and KL_WQ1.count<KL_mmC then append KL_WQ1 y6
else exit
if (KL_TT7=getDirectories (y6+"*")).count!=0 do  for y7 in KL_TT7 do(if findItem KL_WQ1 y7==0 and KL_WQ1.count<KL_mmC then append KL_WQ1 y7
else exit
if (KL_TT8=getDirectories (y7+"*")).count!=0 do  for y8 in KL_TT8 do if findItem KL_WQ1 y8==0 do append KL_WQ1 y8))))))))
fn KHF_CollSrcRootNodes ZZ aa=          ------多次迭代追加集合选择对象的所有根对象,考虑组结构和父子关系;参数1:ZZ.输入对象集合(必须是数组,单个时也用数组包含);参数2:aa.最终集合到的根对象数组输出
(local KL_Rol,KL_MMM
for m in ZZ do if m.parent!=undefined then(while(KL_MMM=finditem aa m)!=0 do deleteItem aa KL_MMM  ---如果有父物体,首先检测目录列表是否包含有当前物体,然后再迭代检测父物体
KHF_CollSrcRootNodes #(m.parent) aa)    -----跌代处理向上的父物体;
else if finditem aa m==0 do append aa m)
fn KHF_RenderTimeCal ZZ aa=  -----渲染耗时计数器;输入时间印章,输出耗时:"时;分;秒" 参数1:ZZ为当前时间印章,参数2:aa为起始点时间印章,他们之间的差为耗时;
(if ZZ<aa do ZZ+=86400           -----如果当前计数已经小于起点数,表示已经跨夜了,需要加上24*60*60值(全天秒钟数)
ZZ-=aa                              -----得到时间间距(耗时总秒数);
KGL_OOOTi1=ZZ/3600                   ----获得小时整数
aa1=(replace "00" (3-(KGL_OOOTi1 as string).count) (KGL_OOOTi1 as string).count (KGL_OOOTi1 as string))+"时"  ----小时字符节
KGL_OOOTi2=(ZZ-(3600*KGL_OOOTi1))/60 ----获得分钟整数
aa2=(replace "00" (3-(KGL_OOOTi2 as string).count) (KGL_OOOTi2 as string).count (KGL_OOOTi2 as string))+"分"   ----分钟字符节
KGL_OOOTi3=ZZ-(3600*KGL_OOOTi1)-(60*KGL_OOOTi2) ----获得秒钟整数
aa3=(replace "00" (3-(KGL_OOOTi3 as string).count) (KGL_OOOTi3 as string).count (KGL_OOOTi3 as string))+"秒"   ----秒钟字符节
KL_ppm=aa1+aa2+aa3)                  -----返回得到完整的耗时变量:"时;分;秒"
fn KHF_StringUpperL zifu1=   ---转换输入字符串为小写,然后输出返回值;
(local KL_upper="ABCDEFGHIJKLMNOPQRSTUVWXYZ"
local KL_lower="abcdefghijklmnopqrstuvwxyz"       ---字符串大小写数组;
KL_O=zifu1.count
for i=1 to KL_O do if(KL_aa1=findString KL_upper zifu1[i])!=undefined do zifu1[i]=KL_lower[KL_aa1]   ----逐一替换;
zifu1)                             ----大写转小写函数;
fn KHF_AutoHouZui ZZ aa=   -----自动后缀追加路径,从1开始逐步检查是否存在,不存在时进行累计检查,参数1:输入完全路径名;2.限制文件名字符串个数;
(Z=1                             ----后缀序号变量初始化
KL_NumStr=Z as string           ----后缀序号字符化
KL_Path=getFilenamePath ZZ
KL_Nmae=getFilenameFile ZZ
KL_KuoZ=getFilenameType ZZ      ----分别获得完全路径名的路径,文件名,后缀名部分;
while doesFileExist(XX=KL_Path+(substring KL_Nmae 1(aa-2))+(substring "00" 1(2-KL_NumStr.count))+KL_NumStr+KL_KuoZ)do(Z+=1    --迭代检测是否存在目标文件,否则增1进行循环;
KL_NumStr=Z as string)
XX)	    ----最终返回自动钳位追加后缀的名字;
fn KHF_KGMaterialsED ZZ=     ----装载材质球函数,参数1输入材质集合数组;
(KL_Type1=(getINISetting AK_INIT_File "akoo2011" "FillMEditType")as integer   ----获得当前装载材质编辑器时的缺省材质类型
lclD=(findItem ZZ meditMaterials[24])/(24 as Float)    ----检测当前材编最后一个球的材质在材质集合中的24倍序号(非整数,用来计算材质翻页):可以相等,不相等,为0
for i=1 to 24 do(KL_StrN=i as string
kugematsun=replace "00" (3-KL_StrN.count) KL_StrN.count KL_StrN
case KL_Type1 of
(
1:(meditMaterials[i]=standard name:(kugematsun+" - Default"))
2:(meditMaterials[i]=VRayMtl name:(kugematsun+" - Default"))   
3:(meditMaterials[i]=Architectural name:(kugematsun+" - Default")) 
)
)                               -----根据输入参数类型,首先复位掉材编为各种类型的默认材质球;
mhyu=lclD as Integer                             -----或得非整数序号数的对应整数,这两个值相等表示他们只能是0和24的倍数(这样他们才不会有余数);
if lclD==mhyu and mhyu!=0 and (kugejmnl=ZZ.count-(mhyu*24))>0    ----这里同时满足三个条件才会翻后面的页:1.材质24的24倍序号数为整数,即此数必须是24的倍数;2.材质24必须被包含在材质集合数组;3.材质数组的数量必须大于当前24倍级
then(if kugejmnl>24 then kugejmn=24
else kugejmn=kugejmnl                             ---计算当前34倍级需要装载的材质球数量;
for i=1 to kugejmn do meditMaterials[i]=ZZ[(i+mhyu*24)]     ----逐个装载
medit.SetActiveMtlSlot kugejmn true        -----激活最后一个装载材质球;
global KG_MEditTabNum=mhyu+1)            -----输出当前材质编辑器所处屏数的全局变量
else(if ZZ.count>24 then kugejmn=24
else kugejmn=ZZ.count
for i=1 to kugejmn do meditMaterials[i]=ZZ[i]   ----因为是第一页,所以直接对应加载即可;
medit.SetActiveMtlSlot kugejmn true
global KG_MEditTabNum=1)                   -----输出当前材质编辑器所处屏数的全局变量
MatEditor.Open()
gc light:true)
fn KHF_LongNaShor zz xx cc aa=     
(local KL_M,kl_P1,Kl_ExitA,kl_P2,SLpathM,KL_P3,Kl_Sum
KL_M=zz.count   ----获得目标完全路径名数组,以进行统一管理;
for m=1 to KL_M do(kl_P1=filterString zz[m] "\\"      ----用路径符分隔完全路径名;
Kl_ExitA=zz[m][(zz[m].count)]     ----取得最后一个字符,决定后面是否在转换成的字符串后面加上路径符;
if kl_P1.count>1 then(kl_P2=substring kl_P1[1] 1 aa
SLpathM="\\"+kl_P1[kl_P1.count])  ----如果变量段数两个以上才处理,并预寄存"\\"+最后段;
else(kl_P2=""
SLpathM=kl_P1[kl_P1.count])       ----如果路径段就1个时直接寄存最后段;
if (findString zz[m] "\\")==1 do kl_P2="\\\\"+kl_P2  ---检测当前完全路径名是否为网络路径,如果是的话则增加网络路径的双斜杠；
if (kl_P1.count-1)<(aa-1) then(KL_P3=kl_P1.count-1  ----如果最好追加段数小于钳位数减一,实现相当于必须小于等于钳位数-2的结果;
SLpathM=""+SLpathM)  ----最后段不累加任何字符前缀
else(KL_P3=(aa-2)         ----否则钳位段数最大值到钳位数-2,最后段追加路径符+省略号的前缀;
SLpathM="\\"+"..."+SLpathM)                   
for yy=2 to KL_P3 do kl_P2+=("\\"+(substring kl_P1[yy] 1 aa))  ----累计恢复追加中间路径段,全部被钳位字符数量,可以也被钳位了段的总数(字符数值减去2)；
kl_P2+=SLpathM                                        -----最后累加的路径段追加上最后段;
if Kl_ExitA=="\\" or Kl_ExitA=="/" do kl_P2+="\\"     -----如果当前处理对象为路径符结尾,仍然恢复路径符结尾
if cc[m].count>1 then Kl_Sum="["+(cc[m].count as string)+"]"   ---根据对应数组元素的子元素数量统计引用数,存在多个时追加中括号的引用数量;
else Kl_Sum=""
append xx(cc[m][1]+kl_P2+Kl_Sum)))   ----最后返回数组形式:类型名+钳位路径名+可能存在的多引用数量;
fn KHF_FlipClamppath=   ---从后往前钳位,自动检测max文件对应的贴图路径,避免最高到盘符根目录或桌面路径
(KL_pp1=filterString maxFilePath "\\"    ----用路径符号分隔集合路径段数组;
if(findString maxFilePath "\\")==1 do KL_pp1[1]="\\\\"+KL_pp1[1]   ----如果当前为网路路径名,更正路径段的第一个成员为网路标识;
if KL_pp1.count>3 and KL_pp1[4]=="桌面" then KL_Bnmu2=5
else KL_Bnmu2=2    -----根据是否桌面路径定义多路径段追加时的第二个路径段位置;
KL_ZOngcount=KL_pp1.count   -----获得总路径段数量;
if KL_ZOngcount>KL_Bnmu2 then for ff=2 to (KL_ZOngcount-1) do KL_pp1[1]+=("\\"+KL_pp1[ff]) ---如果相对路径数大于2个时可以进行截取;
else KL_pp1[1]=""  ---如果相对路径数小于等于2时直接输出为空字符串(不进行自动路径检索)											  
KL_pp1[1])
fn KHF_ASSMAUinitFN ZZ aa bb=        ----初始化资源管理面板;收集场景资源,装载资源短文件名至列表框;统计总引用文件数和丢失文件数;选中所有缺失素材条目;参数定义是否需要重新收集还是只需重新统计;
(local KL_dddd,KL_cccc,KL_XXH,KL_DsetSum
if ZZ do(KGM_BitmFiNa=#()     ----对应素材名字的完全路径名;#()       ----这里要注意了,因为如果已经收集好了的,这里不能再清空的了;
KGM_StyPeiNa=#()     ----对应素材名字的所有对象子集合数组的种类名:#(#(),#())
KGM_MMTTFiNa=#()     ----对应素材名字的所有对象集合数组的"对象+属性名"#(#(#(),#()))
KGM_DestNoNa=#()     ----完全路径名数组中丢失路径对象的序号集合数组;#()
KGM_ShortBitNa=#()   ----对应完全路径名的钳位字符串数组;#() 
NF_Render_SceneBitMan KR_SceneBitlist.KC_PGB1 #() #(KGM_BitmFiNa,KGM_StyPeiNa,KGM_MMTTFiNa,KGM_DestNoNa,KGM_ShortBitNa) #())  ----如果初始化,需要新收集
if KG_DiagnoseMode do print "开始统计和加载面板信息......"
if aa!=undefined do aa.value=0    ----复位进度条;
if bb do(KR_SceneBitlist.KCXMLB1.items=KGM_ShortBitNa    ----分配钳位后的条目数组
KL_dddd=#()   ----总共文件名数;
KL_cccc=#()   ----总共丢失文件名数量;
for uu=1 to KGM_BitmFiNa.count do(KL_mBim=(getFilenameFile KGM_BitmFiNa[uu])+(getFilenameType KGM_BitmFiNa[uu])   ----逐一统计和收集总文件和丢失文件(仅按文件名);
if findItem KL_dddd KL_mBim==0 do append KL_dddd KL_mBim
if KGM_DestNoNa[uu] do if findItem KL_cccc KL_mBim==0 do append KL_cccc KL_mBim)
KR_SceneBitlist.KL_AAZ1.text=("文件:"+(KL_dddd.count as string)) 
KR_SceneBitlist.KL_AAZ2.text=("丢失:"+(KL_cccc.count as string))    ----更新显示总文件和缺失文件数量;
KL_XXH=KGM_DestNoNa.count
KL_DsetSum=for m=1 to KL_XXH where KGM_DestNoNa[m] collect m
KR_SceneBitlist.KCXMLB1.selection=KL_DsetSum
KR_SceneBitlist.KL_AAA.text=""))          ----选中缺失素材条目;
fn KHF_VrBitmapLightShu aa bb XY TT=     ----修改外部引用文件名和路径,以及取消等的函数 1.aa:为缺失序号,2.bb:为新指配完全路径;3.XY:为对象类型数组,4.TT:为父对象+子序号数组;
(KL_MPPPP3=XY[aa].count         ---统计对应序号成员的类型名数量(代表着引用次数);  
for xx=1 to KL_MPPPP3 do      ----为每次引用迭代处理;
(case XY[aa][xx] of      ----获得引用类型名,利用下面的条件比较函数进行对应匹配处理;
(
"MAT  ":(if bb==""then setSubTexmap TT[aa][xx][1] TT[aa][xx][2] undefined
-- 					              (case(TT[aa][xx][1].classid as string)of             -----为什么MAX9这里这么大的问题?
-- 										(
-- 								  "#(592, 0)":(TT[aa][xx][1].interactive=0
-- 											   TT[aa][xx][1].maskEnabled=false
-- 											   updateMTLInMedit TT[aa][xx][1]
-- 					                           TT[aa][xx][1].mask=undefined)
-- 								    "#(2, 0)":(TT[aa][xx][1].mapEnables[(TT[aa][xx][2])]=false
-- 											   updateMTLInMedit TT[aa][xx][1]
-- 											   setSubTexmap TT[aa][xx][1] TT[aa][xx][2] undefined)
-- 										)
-- 								  ) ----如果无效,则直接废弃该贴图对象;
else(setProperty (getSubTexmap TT[aa][xx][1] TT[aa][xx][2]) "filename" bb))    ---如果有效,重新指定该贴图对象的文件名;
"VPR  ":(if bb==""then (InstanceMgr.GetInstances TT[aa][xx][1] &KV_BBGch    ---Vray代理保证是删除所有关联对象;注意这里不能被包含在Undo off里,会出错的;
delete KV_BBGch)
else setProperty TT[aa][xx][1] TT[aa][xx][2] bb)  
"XRO  ":(if bb==""then (InstanceMgr.GetInstances TT[aa][xx][1] &KV_BBGch    ---max参照对象保证是删除所有关联对象;注意这里不能被包含在Undo off里,会出错的;
delete KV_BBGch)                      
else setProperty TT[aa][xx][1] TT[aa][xx][2] bb)   
"XPR  ":(if bb==""then (InstanceMgr.GetInstances TT[aa][xx][1] &KV_BBGch    ---max参照对象代理保证是删除所有关联对象;注意这里不能被包含在Undo off里,会出错的;
delete KV_BBGch)                          
else setProperty TT[aa][xx][1] TT[aa][xx][2] bb) 
"XRS  ":(if bb==""then delete TT[aa][xx][1]                                         ---max参考场景
else setProperty TT[aa][xx][1] TT[aa][xx][2] bb)  
"VBA  ":(backgroundImageFileName=bb)
---completeRedraw()) 	
"IRR  ":(setProperty TT[aa][xx][1] TT[aa][xx][2] bb
if bb==""do renderers.current.adv_irradmap_mode=0)
"PHO  ":(setProperty TT[aa][xx][1] TT[aa][xx][2] bb
if bb==""do renderers.current.photonMap_mode=0)		
"LIC  ":(setProperty TT[aa][xx][1] TT[aa][xx][2] bb
if bb==""do renderers.current.lightcache_mode=0)		
"CAU  ":(setProperty TT[aa][xx][1] TT[aa][xx][2] bb
if bb==""do renderers.current.caustics_mode=0)	
"ENV  ":(if bb==""then(environmentMap=undefined
useEnvironmentMap=false) 
else if TT[aa][xx][2]>0 then setProperty(getSubTexmap TT[aa][xx][1] TT[aa][xx][2])"filename" bb
else setProperty  TT[aa][xx][1] "filename" bb)
"VENV  ":(if bb==""then(renderers.current.environment_gi_map=undefined
renderers.current.environment_gi_map_on=false)
else(if TT[aa][xx][2]>0 then setProperty(getSubTexmap TT[aa][xx][1] TT[aa][xx][2])"filename" bb
else setProperty  TT[aa][xx][1] "filename" bb))
"VREL  ":(if bb==""then(renderers.current.environment_rr_map=undefined
renderers.current.environment_rr_map_on=false)
else(if TT[aa][xx][2]>0 then setProperty(getSubTexmap TT[aa][xx][1] TT[aa][xx][2])"filename" bb
else setProperty  TT[aa][xx][1] "filename" bb))
"VRER  ":(if bb==""then(renderers.current.environment_refract_map=undefined
renderers.current.environment_refract_map_on=false)
else(if TT[aa][xx][2]>0 then setProperty(getSubTexmap TT[aa][xx][1] TT[aa][xx][2])"filename" bb
else setProperty  TT[aa][xx][1] "filename" bb))
"WEB  ":(setProperty TT[aa][xx][1] TT[aa][xx][2] bb
if bb=="" do try(TT[aa][xx][1].distribution=2)catch(TT[aa][xx][1].distribution=0)) 

"PRO  ":(if bb==""then(KL_MPPPP4=refs.dependents TT[aa][xx][1]
for mZ in KL_MPPPP4 where (IsValidNode mZ)and isProperty mZ "projectorMap" do mZ.projectorMap=undefined)
else(if TT[aa][xx][2]>0 then setProperty(getSubTexmap TT[aa][xx][1] TT[aa][xx][2])"filename" bb
else setProperty  TT[aa][xx][1] "filename" bb))
"SHA  ":(if bb==""then(KL_MPPPP4=refs.dependents TT[aa][xx][1]
for mZ in KL_MPPPP4 where (IsValidNode mZ)and isProperty mZ "shadowProjectorMap" do mZ.shadowProjectorMap=undefined)
else if TT[aa][xx][2]>0 then setProperty(getSubTexmap TT[aa][xx][1] TT[aa][xx][2])"filename" bb
else setProperty  TT[aa][xx][1] "filename" bb)
"SUN  ":(if bb==""then(KL_MPPPP4=refs.dependents TT[aa][xx][1]
for mZ in KL_MPPPP4 where (IsValidNode mZ)and isProperty mZ "sky_color_map" do(mZ.sky_color_map=undefined
setProperty mZ "sky_color_map_on" false))
else if TT[aa][xx][2]>0 then setProperty(getSubTexmap TT[aa][xx][1] TT[aa][xx][2])"filename" bb
else setProperty  TT[aa][xx][1] "filename" bb)
"VSUN  ":(if bb==""then(KL_MPPPP4=refs.dependents TT[aa][xx][1]
for mZ in KL_MPPPP4 where (IsValidNode mZ)and isProperty mZ "texmap" do(mZ.texmap=undefined
setProperty mZ "texmap_on" false))
else if TT[aa][xx][2]>0 then setProperty(getSubTexmap TT[aa][xx][1] TT[aa][xx][2])"filename" bb
else setProperty  TT[aa][xx][1] "filename" bb)
)
))		
fn KHF_CondiSortSH ZZ aa=     --升序--全局按条件(可比较)排序指定数组,返回排序过后的数组;参数1:ZZ.排序目标数组;参数2:aa.条件数组(数量对应目标数组);
(local KL_CompFN,KL_Front   
KL_Number=ZZ.count             ---获得源集合总数;
KL_Front=for n=1 to KL_Number collect n     ----建立源集合的原始序号数组
fn KL_CompFN v1 v2 KL_Array: =               ----本地比较函数,这里V1和V2总是分配qsort函数处理主数组的成员;
(local da=try(KL_Array[v1]-KL_Array[v2])catch(-1)   -----比较比较数组的两两成员
case of
(
(da<0):-1
(da>0.):1
default:0                                 ----定义匹配规则
)
)
qsort KL_Front KL_CompFN KL_Array:aa   ----调用本地比较函数,根据条件数组,得到要求效果的序号的重排数组;
for m in KL_Front collect ZZ[m])     ----最终输出回排序过后的目标数组;
fn KHF_CondiSortJI ZZ aa=     --降序--全局按条件(可比较)排序指定数组,返回排序过后的数组;参数1:ZZ.排序目标数组;参数2:aa.条件数组(数量对应目标数组);
(local KL_CompFN,KL_Front   
KL_Number=ZZ.count             ---获得源集合总数;
KL_Front=for n=1 to KL_Number collect n     ----建立源集合的原始序号数组
fn KL_CompFN v1 v2 KL_Array: =               ----本地比较函数,这里V1和V2总是分配qsort函数处理主数组的成员;
(local da=try(KL_Array[v1]-KL_Array[v2])catch(-1)   -----比较比较数组的两两成员
case of
(
(da<0):1
(da>0.):-1
default:0                                 ----定义匹配规则
)
)
qsort KL_Front KL_CompFN KL_Array:aa   ----调用本地比较函数,根据条件数组,得到要求效果的序号的重排数组;
for m in KL_Front collect ZZ[m])     ----最终输出回排序过后的目标数组;
fn KHF_SceneRayInter ZZ aa bb=         ----整个场景射线相交检测函数:两个参数:1.ZZ,输入射线值;2.aa.最大允许角基准方向, 3:bb允许最大偏差值
(local KL_Piu,KL_PiCount,KL_Modpt,KL_osAR
KL_Piu=intersectRayScene ZZ
KL_PiCount=for a in KL_Piu where not a[1].isHiddenInVpt and not a[1].isSelected and acos(dot aa a[2].dir)<bb collect a
if KL_PiCount.count>0 then(KL_osAR=for m in KL_PiCount collect m[2].pos.z   ----收集
KL_Modpt=(KHF_CondiSortJI KL_PiCount KL_osAR)[1][2].pos)	 
else KL_Modpt=undefined 
KL_Modpt)
tool KHTOOL_ModMerTools       -----鼠标定位场景对象工具函数:全局变量KGL_GronoffNmae,用来定义多选择复制时的组结构名字;
(fn KL_FreeMove=
(undo off(KL_Modept=undefined               ----初始化落点变量为未定义
if KR_MoBankTVRoll3.KC_DL2.checked do KL_Modept=KHF_SceneRayInter (mapScreenToWorldRay mouse.pos) [0,0,1] 361    ----这里输入肯定最大角度值,忽略掉出射角度限制;
if KL_Modept!=undefined then move KGL_GronoffNmae [KL_Modept.x-KGL_GronoffNmae.center.x,KL_Modept.y-KGL_GronoffNmae.center.y,KL_Modept.z-KGL_GronoffNmae.min.z]
else move KGL_GronoffNmae [worldPoint.x-KGL_GronoffNmae.center.x,worldPoint.y-KGL_GronoffNmae.center.y,0]))
on freeMove do KL_FreeMove()
on mousePoint abc do
(if shiftKey then(if abc!=1 do undo on(maxOps.CloneNodes KGL_GronoffNmae cloneType:#instance expandHierarchy:true newNodes:&bb)) ---鼠标计数方式:A压(1),A放(2),B放(3),C放(4).....))   ---因为连续放置,所以最好多个对象时自动结组;
else #stop)   ----如果不为多个放置模式,则停止移动和创建;
on mouseMove ab1 do KL_FreeMove()
on mouseAbort aa do(undo off(#stop
KL_vvv=getCurrentSelection()
thawSelection()
clearSelection() 
delete KL_vvv)))   ----如果右键退出取消命令:停止工具,寄存选择,禁止选择,删除选择对象;
fn KHF_VectorAngle ZZ XX aa=         ---矢量夹角算法,计算两个矢量的绝对夹角(0-359):参数1:ZZ,输入第一个矢量,参数2:XX,输入第二个矢量,参数3:aa,输入参考矢量(注意正反)
(local KL_HAng,KL_TVec,KL_BJA,KL_N1
KL_HAng=acos(dot ZZ XX)                   ---计算两平面矢量的夹角(0-180)
KL_TVec=normalize(cross ZZ XX)         ---获得两平面矢量的第三方矢量
KL_BJA=acos(dot KL_TVec aa)    ---求得当前视线方向与第三方矢量的夹角;
KL_N1=0                                         ---初始化最终夹角值为,避免两平面矢量夹角为0时得到360度的现象;
if KL_BJA<90 then KL_N1=KL_HAng        ----如果夹角小于90度(表示视线处于上面时,当前两矢量夹角值为真实夹角;
else if KL_HAng!=0 do KL_N1=360-KL_HAng
KL_N1)
global KHF_SceneRayNor
fn KHF_SceneRayNor ZZ=         ----整个场景射线相交检测函数:一个参数:1.ZZ,输入射线值;;(返回#(最前面对象,相交点面法线,面序号,面中心元此次坐标值)
(local KL_Piu,KL_PiCount,KL_Modpt,KL_osAR
---KL_Matart=matrixFromNormal -ZZ.dir               -----求得当前入射线的变换矩阵(注意正反),--------------这个不能这样用
KL_Piu=intersectRayScene ZZ                      ----所有相交计算
KL_PiCount=for a in KL_Piu where not a[1].isHiddenInVpt collect a         ----集合有效相交结果(排除隐藏掉了的对象);
if KL_PiCount.count>0 then(KL_osAR=for m in KL_PiCount collect (distance m[2].pos ZZ.pos)   ----如果存在有效相交对象,首先对应收集所有交点跟射线位置的距离,用来高级查找最近交点
--prin ("----"+(KL_PiCount as string)) 
--prin (KL_osAR as string)
KL_vbc=KHF_CondiSortSH KL_PiCount KL_osAR   ----一定要注意跟落地模式的函数区别开,别老是复制粘贴错了
--prin  (KL_vbc as string) 
KL_Modpt=KL_vbc[1][1])           ----调用自定义排序函数,根据所有相交点的坐标来排序远近(因为是降序,所以最近的值越大)
else KL_Modpt=undefined                       ---相交结果返回空;
if KL_Modpt!=undefined  and(KL_NorO=intersectRay KL_Modpt ZZ)!=undefined
then KL_NorO=#(KL_Modpt,KL_NorO)       ----加入节点对象本身至返回数组的第一位;
else KL_NorO=undefined
KL_NorO)                                                             ----返回最终返回值:数组或未定义
global KL_UVWDirection
tool KHTOOL_UVWDirectionalTools      -----鼠标定位场景对象工具函数:全局变量KGL_GronoffNmae,用来定义多选择复制时的组结构名字;
(local PoAP1,PoAP2,KL_Vert1,KL_Screen1,CoorZC,Ctrstar=true
local KL_InitTran=KL_UVWDirection.Gizmo.transform,KL_initSize=[KL_UVWDirection.length,KL_UVWDirection.width,KL_UVWDirection.height]
fn KL_FreeMove=
(KL_Modept=KHF_SceneRayNor (mapScreenToWorldRay mouse.pos)   ----这里输入肯定最大角度值,忽略掉出射角度限制;
if KL_Modept!=undefined do(KL_TVecA=normalize(cross [0,0,1] KL_Modept[2].dir)         ---获得两平面矢量的第三方矢量
KL_TVecB=normalize(cross KL_TVecA [0,0,1])         ---获得两平面矢量的第三方矢量
KL_A1=KL_UVWDirection.Gizmo.transform.pos
kL_TanJU=matrix3 KL_TVecA KL_TVecB [0,0,1]  KL_A1
if shiftKey do rotateZ kL_TanJU 90
KL_UVWDirection.Gizmo.transform=kL_TanJU))
fn KL_DirecMove=
(KL_TVecA=normalize(cross [0,0,1] KL_Vert1)         ---获得两平面矢量的第三方矢量
KL_TVecB=normalize(cross KL_TVecA [0,0,1])         ---获得两平面矢量的第三方矢量
KL_A1=KL_UVWDirection.Gizmo.transform.pos
kL_TanJU=matrix3 KL_TVecA KL_TVecB [0,0,1]  KL_A1
if shiftKey do rotateZ kL_TanJU 90
KL_UVWDirection.Gizmo.transform=kL_TanJU)
---on start do(KL_UVWDirection.Gizmo.position=gw.mapCPToWorld(gw.getPointOnCP mouse.pos))
on freeMove do(if ctrlKey do KL_FreeMove())         ----调用命令自动进入面定位模式,右键退出
on mousePoint abc do(case abc of
(
1:(if(KL_CSD=snapMode.worldHitpoint)!=undefined then  PoAP1=KL_CSD    ----这里要保证第一和第二次鼠标动作都能定义到第一个落点(鼠标位置点或精确捕捉点)
else PoAP1=worldPoint
KL_Screen1=viewPoint
CoorZC=#(KL_UVWDirection.length,KL_UVWDirection.width,KL_UVWDirection.height))	----否则第一次按下鼠标不松的情况移动时会报错,因为没有预先记录到上一次参考点	
2:(#stop)							
)
)   ----如果不为多个放置模式,则停止移动和创建;
on mouseMove ab1 do
(if(KL_CSD=snapMode.worldHitpoint)!=undefined then PoAP2=KL_CSD
else PoAP2=gw.mapCPToWorld(gw.getPointOnCP mouse.pos)   
if ctrlKey then(if Ctrstar do(KL_Screen1=viewPoint        ----这里要注意过滤掉定向模式和Ctrl键触发器的准备模式,
CoorZC=#(KL_UVWDirection.length,KL_UVWDirection.width,KL_UVWDirection.height)   ----每切换一次状态,都必须重置上一参考点和之前大小;
Ctrstar=false)                          ----切换完以后,Ctrl状态键为False,必须通过一次释放Ctrl键才能重新激活;每次跳转都要记录一次才行;
KL_Screen2=viewPoint
----prin ((KL_Screen2 as string)+(KL_Screen1 as string))
---if altKe then KL_Zoomnum=1000.0
KL_Zoomnum=100.0
Kl_vcgvv=(KL_Screen2.x-KL_Screen1.x)/KL_Zoomnum        ----落点与当前鼠标点的距离值
if Kl_vcgvv>=0 then Kl_vcg=1.0+Kl_vcgvv
else Kl_vcg=1.0/(1.0-Kl_vcgvv)    ----一定要注意这个函数模式0以上为正常1-Base模式,0以下先用1-*进行补偿(去负和大小倒顺),然后1/*进行比例因子的转换;
----#(-10, -5, -2, -1, -0.5, -0.2, -0.1, 0, 0.1, 0.2, 0.5, 1, 2, 5, 10)
----#(0.0909091,0.166667,0.333333,0.5,0.666667,0.833333,0.909091,1.0,1.1,1.2,1.5,2.0,3.0,6.0,11.0)     VeryGood
----prin ((KL_Screen2.x as string)+"  "+(KL_Screen1.x as string)+"  "+(Kl_vcgvv as string)+"  "+(Kl_vcg as string))
KL_UVWDirection.length=(CoorZC[1]*Kl_vcg)
KL_UVWDirection.width=(CoorZC[2]*Kl_vcg)
KL_UVWDirection.height=(CoorZC[3]*Kl_vcg))
else(Ctrstar=true          ----没调用过之前，按键有释放过后,才能恢复true,但每次true状态只能启用一次,否则又需要释放一次按键才能接受下一次检测处理;
KL_Vert1=normalize(PoAP2-PoAP1)
KL_DirecMove()))         ----只有在定向模式才旋转,避免在缩放模式或操作上弄乱朝向;
on mouseAbort aa do(if aa==2 then(KL_UVWDirection.Gizmo.transform=KL_InitTran
KL_UVWDirection.length=KL_initSize[1]
KL_UVWDirection.width=KL_initSize[2]
KL_UVWDirection.height=KL_initSize[3]
#stop)
else #stop)   ----击右键结束工具命令,如果为1，直接退出,如果为2,则根据工具状态恢复预留值
)   ----如果右键退出取消命令:停止工具,寄存选择,禁止选择,删除选择对象;
fn KHF_SamBitmConver ZZ aa bb=       ----根据输入大样一一转换成对应小样的函数,参数1:ZZ.输入大样图文件;2:aa.目标路径;3:bb.替换位图对象(大样图不存在时的替代输出);
(KL_NewSave=(aa+(getFilenameFile ZZ)+".bmp")          ----先预算好即将生成图片的文件名;(目标本地路径+源素材文件名+bmp后缀)
if not(doesFileExist KL_NewSave) do
(KL_Ca1=undefined    ----初始化加载位图节点为未定义
if doesFileExist ZZ do try(KL_Ca1=openBitMap ZZ
if KL_Ca1==undefined do messageBox ("异常大样文件,需要用其它图像软件进行修复!\n文件:"+ZZ) title:"阿酷素材库管理--阿酷提示")
catch(KL_Ca1=undefined
messageBox "异常大样文件,需要用其它图像软件进行修复!" title:"阿酷素材库管理--阿酷提示")  ---如果转换不成功,则警告和提示;) 
if KL_Ca1!=undefined then(KL_Ca2=bitmap 52 52 filename:KL_NewSave  ----只有目标缩略图文件补存在才进行处理,否则直接跳过(用原来的)
copy KL_Ca1 KL_Ca2
close KL_Ca1
save KL_Ca2
close KL_Ca2)
else(KL_NewBit=copy bb   ----复制模版图片文件;
KL_NewBit.filename=KL_NewSave
save KL_NewBit
close KL_NewBit)))
fn KHF_DeleteNestFile ZZ=               ------因为MaxScript暂时没有直接删除文件夹的命令,只能先总是搜集这些文件夹里面的文件进行删除;参数1:ZZ.输入目标路径;
(local KL_Onc
KL_Onc=getFiles(ZZ+"*.*")   -----第一步获得该路径下所有的文件列表;
for m in KL_Onc do deleteFile m      -----逐一删除该文件列表;
KL_Onc=getDirectories(ZZ+"*")        -----第二步获得该路径下所有的子文件夹;
for m in KL_Onc do KHF_DeleteNestFile m)    -----迭代逐个循环处理每个路径对象;
fn KHF_CopyAllNestFile ZZ aa=               ------复制整个路径+文件函数;参数1:ZZ.源路径;2:aa.目标路径
(local KL_Onc
KL_Onc=getFiles(ZZ+"*.*")   -----第一步获得该路径下所有的文件列表;
for m in KL_Onc do copyFile m(aa+(getFilenameFile m)+(getFilenameType m))      -----逐一复制该路径下的所有文件
KL_Onc=getDirectories(ZZ+"*")        -----第二步获得该路径下所有的子文件夹;
for m in KL_Onc do(KL_PPc=filterString m "\\"  
makeDir(aa+KL_PPc[KL_PPc.count]+"\\")
KHF_CopyAllNestFile (ZZ+KL_PPc[KL_PPc.count]+"\\") (aa+KL_PPc[KL_PPc.count]+"\\")))    -----迭代逐个循环处理每个路径对象;
fn KHF_SubfolderColl aa zz Hzj Hzj0=        ----任意嵌套路径收集数组:两个参数:1.单路径对象,注意一定是路径符号结尾;2.集合变量(累加);3.嵌套层级深度限制(数量包括当前级别);4.为检测深度计数器;
(local KL_Pathg           ----注意这里这个变量一定不要跟外面的访问变量起冲突(屏蔽为内部,否则容易干扰造成函数不正常);
Hzj0+=1                   ----迭代计数器;
if aa!=""and aa!="\\"do                       ---这里一定要关闭掉可能似空的路径对象,否则极有可能会无意收集到系统根目录等不希望的成份;
(if(findItem zz aa)==0 do append zz aa    ---先检测重复并添加当前路径;
KL_Pathg=GetDirectories (aa+"*")        ----获得所有子路径对象的集合;
for m in KL_Pathg do if Hzj0<Hzj do KHF_SubfolderColl m zz Hzj Hzj0))   ----在迭代检测每个子路径,直至达到最深限制的子路径;
fn KHF_SertchFN ZZ XX TT VV aa bb HH=   
(global KHF_ASSMAUinitFN,KL_NewLogfile
local KL_PathWQaa,KL_HZJA,KL_NewSel,KL_IniNumJS,KL_XXH,KL_GGH,KL_NameFN
renderSceneDialog.close()    ---关闭渲染设置面板以防更新问题;
KL_PathWQaa=#()    ----收集总数组
for mp in aa do KHF_SubfolderColl mp KL_PathWQaa 11 0  ------调用函数进行子路径收集,这里定义为四级深度(在当前路径允许再深入三个层级的子路径);
if HH do(try(gc())catch())
KL_HZJA=KL_PathWQaa.count   ----获得可供切换处理的总路径数;
if KL_HZJA>0 do    ----如果总路径数不为零,即存在可切换路径;
(renderSceneDialog.close()    ---强制关闭渲染设置面板,避免后面牵涉到渲染面板的素材需要额外的更新处理;
KL_NewSel=#()   ----自定义数组变量用来收集未切换成功的序号;
KL_IniNumJS=0    ----进度条计数变量
KL_XXH=bb.count  ----寄存进度条的最终数量,
for m in bb do(KL_IniNumJS+=1      -----迭代处理每一个输入的切换搜索成员序号;
if VV!=undefined do VV.value=KL_IniNumJS*100.0/KL_XXH
jj=1     ----自定义数字变量,用来针对每成员序号迭代处理每路径,如果中途切换成功或碰到原路径的则直接退出处理循环;
KL_GGH=true   ----是否切换成功检测变量,默认为True,如果迭代搜索处理没有任何变化,将仍保持True,这时将确定为该成员序号切换未成功;
while jj<=KL_HZJA do(if doesFileExist(KL_NameFN=KL_PathWQaa[jj]+((getFilenameFile ZZ[m])+(getFilenameType ZZ[m])))do
(if(getFilenamePath KL_NameFN)!=(getFilenamePath ZZ[m]) do
(KHF_VrBitmapLightShu m KL_NameFN XX TT
ZZ[m]=KL_NameFN)  ---如果存在且不重复,进行切换处理并替换全局变量对应成员;
KL_GGH=false
jj=KL_HZJA+1)   ----如果存在目标路径文件,则直接结束循环,关闭切换无效检测变量;
jj+=1)   ---如果未切出,累加1继续循环;
if KL_GGH do append KL_NewSel m
if HH do(try(gc())catch()))  ---如果切换无果,收集统计无效成员序号;
ATSOps.Refresh()
KGM_ShortBitNa=#()
KHF_LongNaShor KGM_BitmFiNa KGM_ShortBitNa KGM_StyPeiNa 6
KL_GGH=KGM_DestNoNa.count
for mx=1 to KL_GGH do if(finditem KL_NewSel mx)!=0 then KGM_DestNoNa[mx]=true 
else KGM_DestNoNa[mx]=false
if KG_DiagnoseMode do(print("切换处理完成......:结果"+KGM_BitmFiNa as string)
print(KGM_ShortBitNa as string))
KHF_ASSMAUinitFN false undefined HH
if VV!=undefined do VV.value=0
if HH then messageBox ("成功搜索并切换"+((KL_XXH-KL_NewSel.count)as string)+"个文件(无效"+(KL_NewSel.count as string)+"个)") title:"引用资源收集警告--阿酷提示"
else if KL_NewSel.count>0 and classof KL_NewLogfile==FileStream do try(format "____丢失资源:%个     " KL_NewSel.count to:KL_NewLogfile)catch()
)
)
fn KHF_CollExfFileSub aa bb ZZ GG JJ HH QQ WW=      
(if WW==1 then(KL_Nabzx=(getFilenameFile KGM_BitmFiNa[bb])+(getFilenameType KGM_BitmFiNa[bb])   ----奇怪,这里直接用filenameFromPath会出现文件名上带路径段的问题?
Kl_VBC=aa+KL_Nabzx)   ----求得新指向路径的目标完全路径名;   模式1时aa代表路径,需要加上文件名才是完整路径名Kl_VBC,否则直接是完整路径名Kl_VBC了;则后面的单纯文件名就必须额外截取了;
else Kl_VBC=aa
if not(doesFileExist Kl_VBC)then if WW!=3 then KL_CMD=copyFile KGM_BitmFiNa[bb] Kl_VBC    -----如果目标不存在,直接进行复制;如果已存在,则匹配检测,如果大小和修改时间都不相等,识别为不同内容的文件;不进行归引;
else(KL_CMD=true
try(KL_cc1=openBitMap KGM_BitmFiNa[bb]    ----这一步一定要,直接过滤掉不能支持打开的图片文件格式;
KL_cc2=bitmap KL_cc1.width KL_cc1.height filename:Kl_VBC
copy KL_cc1 KL_cc2
save KL_cc2
close KL_cc1
KL_CMD=doesFileExist Kl_VBC)catch(KL_CMD=false))
else if(getFileSize Kl_VBC)!=(getFileSize KGM_BitmFiNa[bb])and(getFileModDate Kl_VBC)!=(getFileModDate KGM_BitmFiNa[bb])then KL_CMD=false
else KL_CMD=true
if KL_CMD then(if WW!=1 or(getFilenamePath Kl_VBC)!=(getFilenamePath KGM_BitmFiNa[bb])do   ----只有在引向模式为1的情况下才需要检测路径是不是一样(那样就不需要归引了),但后面两种模式都是同位置重命名,需要归引
(if not QQ.checked then KL_KFC=Kl_VBC   ---如果源终路径不等,则需要进行归引,需要去路径,则归引为独立文件名;
else if WW==1 then KL_KFC=KL_Nabzx
else KL_KFC=(getFilenameFile aa)+(getFilenameType aa)
KHF_VrBitmapLightShu bb KL_KFC KGM_StyPeiNa KGM_MMTTFiNa   ----归引处理;
KGM_BitmFiNa[bb]=KL_KFC))   ----更新对应的全局资源数值;
else append ZZ bb   ---任一导致归引不成功的操作,收集失败序号数;
if GG!=undefined do GG.value=JJ*100.0/HH)   ----目标对话框的进度条计数处理;
