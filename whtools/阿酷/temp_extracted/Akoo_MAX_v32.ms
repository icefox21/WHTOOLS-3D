local DriveLDouCentLeft=(getINISetting (getMAXIniFile()) "akoo2009" "DriveLDouCentLeft")as Integer
local KL_KongJAr,KL_MergeOBj,KL_MergeOBj11,KL_MergeOBj22,KL_OffectMode,KL_PfrSater,KL_LuLengMode
label KC_Lab1 "创建模式:" pos:[5,5] align:#left
radiobuttons KL_RuBu1  labels:#("实建","贴图") default:DriveLineMode pos:[62,5]
checkbox KBC_Box1 "导向箭头" checked:DriveLineItem1 pos:[5,28]
checkbox KC_Box2path "车流路径" checked:DriveLineItem2 pos:[77,28]
checkbox KBC_Box3 "路肩实线" checked:DriveLineItem3 pos:[149,28]
checkbox KBC_Box41 "中心实线" checked:DriveLineSiCenter pos:[5,51] 
spinner KBC_SP1 "比例:" type:#float range:[0.5,2.0,DriveLineScal] scale:0.1 pos:[5,74] fieldwidth:25
spinner KBC_SP2 "虚实:" type:#float range:[0.5,1.5,DriveLineDash] scale:0.1 pos:[77,74] fieldwidth:25
spinner KBC_SP4 "段数:" type:#integer range:[1,3,DriveLineSeg] fieldwidth:25 pos:[149,74] 

radiobuttons KC_RuBu2  labels:#("条宽:","条数:") default:DriveLineNumber columns:1 pos:[5,162] enabled:(KL_RuBu1.state==1)
spinner KC_SP5Width type:#float range:[(1500*Syun),(15000*Syun),(DriveLineWidth*Syun)] scale:(500*Syun) fieldwidth:42 pos:[52,162] enabled:(KC_RuBu2.state==1)
spinner KC_SP8Sumber type:#integer range:[2,10,KGL_DriveLineLSHU] scale:1 fieldwidth:42 pos:[52,180] enabled:(KC_RuBu2.state==2)
radiobuttons KBC_RuBu  labels:#("单向","双向") default:DriveLineDouS pos:[5,97] 

spinner KBC_SP6 "绿化宽度:" type:#float range:[(0*Syun),(15000*Syun),(KGL_DriveLVireSC*Syun)] scale:(500*Syun) fieldwidth:42 pos:[5,116] 
