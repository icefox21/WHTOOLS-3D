if aa then setINISetting (getMAXIniFile()) "akoo2009" "RendSampOnBuzzer" "1"
else setINISetting (getMAXIniFile()) "akoo2009" "RendSampOnBuzzer" "0")
on KC_BT30 pressed do(CreateDialog KR_MulCamRenSet)
on KC_ET19 changed aa do(KG_SamperName=aa
setINISetting (getMAXIniFile()) "akoo2009" "SamperName" aa)	
on KC_ET21 entered aa do(KM_2=for m in (filterString aa ",") where findString m "@"==undefined or findString m "."==undefined collect m
if KM_2.count>0 then(messageBox "请输入合法的Email地址,一次填入多个地址时中间用逗号隔开!" title:"自动邮件功能警告--阿酷提示"
KC_CB22.enabled=false)
else(setINISetting (getMAXIniFile()) "akoo2009" "AutoEmailPa" aa
KC_CB22.enabled=true))	   
on KC_CB22 changed aa do(if aa do KC_CB18.checked=true)
on KC_CB62 changed aa do(KG_RROnlySelect=aa
if aa then setINISetting (getMAXIniFile()) "akoo2009" "RROnlySelect" "1"   
else setINISetting (getMAXIniFile()) "akoo2009" "RROnlySelect" "0") 	
