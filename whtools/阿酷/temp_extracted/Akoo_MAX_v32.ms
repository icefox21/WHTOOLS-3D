2:(if KL_PointNor.y<=0.707107 then(if KL_PointNor.x<=0.707107 and KL_PointNor.x>=-0.707107 then(rotateZ KGL_CustVTransform  90)
else())
else(if KL_PointNor.x<=0.707107 and KL_PointNor.x>=-0.707107 then(rotateZ KGL_CustVTransform  -90)
else()))
3:(if KL_PointNor.y<=0.707107 then(if KL_PointNor.x<=0.707107 and KL_PointNor.x>=-0.707107 then(rotateZ KGL_CustVTransform  90
rotateX KGL_CustVTransform  90)
else(rotateY KGL_CustVTransform  -90))
else(if KL_PointNor.x<=0.707107 and KL_PointNor.x>=-0.707107 then(rotateZ KGL_CustVTransform  -90
rotateX KGL_CustVTransform  -90)
else(rotateY KGL_CustVTransform  90)))
4:(if KL_PointNor.y<=0.707107 then(if KL_PointNor.x<=0.707107 and KL_PointNor.x>=-0.707107 then(rotateZ KGL_CustVTransform  90
rotateX KGL_CustVTransform  -90)
else(rotateY KGL_CustVTransform  90))
