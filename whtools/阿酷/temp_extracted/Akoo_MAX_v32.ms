KGL_CustVTransform =matrix3 1
case KL_Number of
(
1:(if KL_PointNor.y<=0.707107 then(if KL_PointNor.x<=0.707107 and KL_PointNor.x>=-0.707107 then(rotateZ KGL_CustVTransform  90
