KC_Sub2.value=KL_FillArrN
KC_Sub1.value=(KL_FillDirN*Syun)
KC_BU2.text=KL_TruDirN)
on KC_Sub2 changed Ar do(global KL_FillArrN=Ar
undo on(lcl_FiArrayFN KC_BU4.state lcl_FiArrayPath false)
KC_Sub1.value=(KL_FillDirN*Syun))
