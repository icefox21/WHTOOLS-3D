(KF_SceneUnitsJC()
KL_KL_Road1Vert=#([0,-666.666,0], [1666.67,0,0], [0,666.666,0], [-1666.67,0,0], [-1128.15,-8.64268e-005,0], [8.64266e-005,451.26,0], [1128.11,0.000216096,0], [-7.25984e-005,-451.26,0])
