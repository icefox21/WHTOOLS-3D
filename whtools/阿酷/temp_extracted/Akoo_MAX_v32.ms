KL_viewDir=KL_coordSysTM.row3
KL_viewPt=KL_coordSysTM.row4
Kl_ZUIpos=gw.getVPWorldWidth KL_viewPt
KL_Newcam=freecamera  pos:KL_viewPt  dir:KL_viewDir
KL_Newcam.type=#target
viewport.setCamera KL_Newcam
in coordsys KL_coordSysTM KL_Newcam.pos=KL_Newcam.pos+[0,0,Kl_ZUIpos]
select KL_Newcam)
else macros.run "Lights and Cameras" "Camera_CreateFromView"
selection[1].orthoProjection=KL_ORcam
select selection[1]))
else(KL_QQ=queryBox "你当前已经处于相机视图,你确定要复制当前相机视图吗?" title:"创建相机视图警告--阿酷提示"
if KL_QQ do(thawSelection()
clearSelection() 
select (getActiveCamera())
KL_Cmau=selection[1]
KG_ZHULIYYtdAA=copy KL_Cmau
if KL_Cmau.target!=undefined do(KL_Cmau1=copy KL_Cmau.target
KL_Cmau1.name=KG_ZHULIYYtdAA.name+".Target"
KG_ZHULIYYtdAA.target=KL_Cmau1)
viewport.setCamera KG_ZHULIYYtdAA
select KG_ZHULIYYtdAA))))
