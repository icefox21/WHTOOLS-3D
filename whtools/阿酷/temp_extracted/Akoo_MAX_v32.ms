if KL_BDN.count>0 do KHF_SertchFN KGM_BitmFiNa KGM_StyPeiNa KGM_MMTTFiNa KC_PGB1 #((KC_Ed1.text+"\\"),(KC_Ed2.text+"\\"),(KC_Ed3.text+"\\"),(KC_Ed4.text+"\\"),(KC_Ed5.text+"\\")) KL_BDN true
KC_Ed6CT.checked=false))
on KR_CustBitSeR rbuttondown fdsf do(DestroyDialog KR_CustBitSeR))
CreateDialog KR_CustBitSeR)  
else
(KGM_SceBitthA1=getINISetting AK_INIT_File "akoo2011" "SceBitthA1"
KGM_SceBitthA2=getINISetting AK_INIT_File "akoo2011" "SceBitthA2"
