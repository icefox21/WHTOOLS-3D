fn KF_UnRightMenu=                     -----右键材质卸载函数(3.0)更新;
(local KL_Count=menuMan.numQuadMenus()
local KL_Svat1=true,KL_Svat2=true,KL_Svat3=true,KL_Svat4=true,KL_Svat5=true
for m=1 to KL_Count do(KL_MMM=menuMan.getQuadMenu m 
KL_MMMStr=menuMan.getQuadMenuName KL_MMM
case of
( 
(matchPattern KL_MMMStr pattern:"*[Shift+RMB]*"):(menuMan.setViewportRightClickMenu #shiftPressed KL_MMM)
(matchPattern KL_MMMStr pattern:"*[Alt+RMB]*"):(menuMan.setViewportRightClickMenu #altPressed KL_MMM)
(matchPattern KL_MMMStr pattern:"*[Ctrl+RMB]*"):(menuMan.setViewportRightClickMenu #controlPressed KL_MMM)
(matchPattern KL_MMMStr pattern:"*[Shift+Alt+RMB]*"):(menuMan.setViewportRightClickMenu #shiftAndAltPressed KL_MMM)
(matchPattern KL_MMMStr pattern:"*[Shift+Ctrl+RMB]*"):(menuMan.setViewportRightClickMenu #shiftAndControlPressed KL_MMM)
(matchPattern KL_MMMStr pattern:"*[Ctrl+Alt+RMB]*"):(menuMan.setViewportRightClickMenu #controlAndAltPressed KL_MMM)
(matchPattern KL_MMMStr pattern:"*[Shift+Ctrl+Alt+RMB]*"):(menuMan.setViewportRightClickMenu #shiftAndAltAndControlPressed KL_MMM)
)
)
while (KF_VVF=menuMan.findQuadMenu "AkooMatMenu")!=undefined and KL_Svat1 do if not (menuMan.unRegisterQuadMenu KF_VVF)do KL_Svat1=false
while (KF_VVF=menuMan.findQuadMenu "lclstandMaterialA")!=undefined and KL_Svat2 do if not (menuMan.unRegisterQuadMenu KF_VVF)do KL_Svat2=false
while (KF_VVF=menuMan.findQuadMenu "lclstandMaterialB")!=undefined and KL_Svat3 do if not (menuMan.unRegisterQuadMenu KF_VVF)do KL_Svat3=false
while (KF_VVF=menuMan.findQuadMenu "lclstandMaterialC")!=undefined and KL_Svat4 do if not (menuMan.unRegisterQuadMenu KF_VVF)do KL_Svat4=false
while (KF_VVF=menuMan.findQuadMenu  "阿酷材质菜单")!=undefined and KL_Svat5 do if not (menuMan.unRegisterQuadMenu KF_VVF)do KL_Svat5=false)
fn KF_CreatRightMenu=                    -----右键材质创建函数(3.0)更新;
(local KGL_RightPos=(getINISetting(getMAXIniFile())"akoo2009" "KUGERightMenu")as integer
KL_RMname=(filterString  AK_LegalityUser "_")[1]+"右键材质"
