fn lcl_Tools_RotateALZZ=
(undo on(
if selection.count>0 do 
( kugeINinvv=for i in selection where not(isGroupMember i and not isOpenGroupMember i) collect i 
if findItem lcl_pos_view (viewport.getType())!=0 then(
kugeAApoint=pickPoint "点击角度开始边起点:" snap:#3D 
if (classOf kugeAApoint)==Point3 do kugeABpoint=pickPoint "点击角度开始边终点:" snap:#3D rubberBand:kugeAApoint
if (classOf kugeABpoint)==Point3 do(case kugepp=viewport.getType() of
(
#view_top:(kugeABpoint.z=kugeAApoint.z=0
kugevet3=normalize [100,0,0]
kugevet4=normalize [0,-100,0])
#view_bottom:(kugeABpoint.z=kugeAApoint.z=0
kugevet3=normalize [100,0,0]
kugevet4=normalize [0,100,0])
#view_front:(kugeABpoint.y=kugeAApoint.y=0
kugevet3=normalize [100,0,0]
kugevet4=normalize [0,0,-100])
#view_back:(kugeABpoint.y=kugeAApoint.y=0
kugevet3=normalize [-100,0,0]
kugevet4=normalize [0,0,-100])
#view_left:(kugeABpoint.x=kugeAApoint.x=0
kugevet3=normalize [0,-100,0]
kugevet4=normalize [0,0,-100])
#view_right:(kugeABpoint.x=kugeAApoint.x=0
kugevet3=normalize [0,100,0]
kugevet4=normalize [0,0,-100])
)
kugevet1=normalize (kugeABpoint-kugeAApoint)
kugeRoAngle1=acos(dot kugevet1 kugevet3)
if kugeRoAngle1!=0 and kugeRoAngle1!=90 and kugeRoAngle1!=180 do
(kugeRoAngle2=acos(dot kugevet1 kugevet4)
if(kugeRoAngle2>90 and kugeRoAngle1<90)or(kugeRoAngle2<90 and kugeRoAngle1>90) then kugeRoAngle=-kugeRoAngle1
else kugeRoAngle=kugeRoAngle1  
if kugeRoAngle1>90 do if kugeRoAngle2>90 then kugeRoAngle=(180-kugeRoAngle)
else kugeRoAngle=(-180-kugeRoAngle)
case kugepp=viewport.getType() of
(
#view_top:(in coordsys screen about (selection.center)  rotate kugeINinvv kugeRoAngle z_axis)
#view_bottom:(in coordsys screen about (selection.center) rotate kugeINinvv kugeRoAngle z_axis)
#view_front:(in coordsys screen about (selection.center) rotate kugeINinvv -kugeRoAngle z_axis)
#view_back:(in coordsys screen about (selection.center) rotate kugeINinvv kugeRoAngle z_axis)
#view_left:(in coordsys screen about (selection.center) rotate kugeINinvv kugeRoAngle y_axis)
#view_right:(in coordsys screen about (selection.center) rotate kugeINinvv kugeRoAngle y_axis)
)
)))
else messageBox "请确保当前视图为正视图,否则命令不操作!" title:"旋转对齐警告--阿酷提示")))
