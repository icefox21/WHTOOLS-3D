rollout KR_MulCamRenSet "阿酷_多相机小样设置面板" width:378 height:53
(local KGPath43=(getINISetting (getMAXIniFile()) "akoo2009" "NewCamLightGro")=="1"
checkbox KC_CB18 "新相机总是启用自动灯光" pos:[4,30] checked:KGPath43
on KC_CB18 changed aa do(if aa then setINISetting (getMAXIniFile()) "akoo2009" "NewCamLightGro" "1"
else setINISetting (getMAXIniFile()) "akoo2009" "NewCamLightGro" "0")
on KR_MulCamRenSet rbuttondown fdsf do(DestroyDialog KR_MulCamRenSet))
fn KF_CollToArray aa bb1 bb2 bb3 bb5 bb6 cc dd ee=
(if aa!=""  and aa!=undefined  do if (KL_tr=(findItem bb2 aa))==0 then(if (findItem bb1 (filenameFromPath aa))==0 do append bb1 (filenameFromPath aa)
append bb2 aa
append bb3 #(cc)
append bb5 #(dd)
append bb6 #(#(dd,ee)))
else(append bb3[KL_tr] cc
append bb5[KL_tr] dd
append bb6[KL_tr] #(dd,ee)))
fn lcl_SMapcollEnh kugeA bb1 bb2 bb3 bb5 bb6 cc dd ee=                       ----目标贴图对象的所有子贴图集合(嵌套8级)
(if (superclassof kugeA)==textureMap do if (classof kugeA)==Bitmaptexture
then KF_CollToArray kugeA.fileName bb1 bb2 bb3 bb5 bb6 cc dd ee
else(KL_OncecouA=getNumSubTexmaps kugeA
for jB=1 to KL_OncecouA do
(kugeB=getSubTexmap kugeA jB
if (superclassof kugeB)==textureMap do if (classof kugeB)==Bitmaptexture
then KF_CollToArray kugeB.fileName bb1 bb2 bb3 bb5 bb6 cc kugeA jB
else(KL_OncecouB=getNumSubTexmaps kugeB
for jC=1 to KL_OncecouB do
(kugeC=getSubTexmap kugeB jC
if (superclassof kugeC)==textureMap do if (classof kugeC)==Bitmaptexture
then KF_CollToArray kugeC.fileName bb1 bb2 bb3 bb5 bb6 cc kugeB jC
else(KL_OncecouC=getNumSubTexmaps kugeC
for jD=1 to KL_OncecouC do
(kugeD=getSubTexmap kugeC jD
if (superclassof kugeD)==textureMap do if (classof kugeD)==Bitmaptexture
then KF_CollToArray kugeD.fileName bb1 bb2 bb3 bb5 bb6 cc kugeC jD
else(KL_OncecouD=getNumSubTexmaps kugeD
for jE=1 to KL_OncecouD do
(kugeE=getSubTexmap kugeD jE
if (superclassof kugeE)==textureMap do if (classof kugeE)==Bitmaptexture
then KF_CollToArray kugeE.fileName bb1 bb2 bb3 bb5 bb6 cc kugeD jE
else(KL_OncecouE=getNumSubTexmaps kugeE
for jF=1 to KL_OncecouE do
(kugeF=getSubTexmap kugeE jF
if (superclassof kugeF)==textureMap do if (classof kugeF)==Bitmaptexture
then KF_CollToArray kugeF.fileName bb1 bb2 bb3 bb5 bb6 cc kugeE jF
else(KL_OncecouF=getNumSubTexmaps kugeF
for jG=1 to KL_OncecouF do
(kugeG=getSubTexmap kugeF jG
if (superclassof kugeG)==textureMap do if (classof kugeG)==Bitmaptexture
then KF_CollToArray kugeG.fileName bb1 bb2 bb3 bb5 bb6 cc kugeF jG
else(KL_OncecouG=getNumSubTexmaps kugeG
for jH=1 to KL_OncecouG do
(kugeH=getSubTexmap kugeG jH
if (superclassof kugeH)==textureMap do if (classof kugeH)==Bitmaptexture
do KF_CollToArray kugeH.fileName bb1 bb2 bb3 bb5 bb6 cc kugeG jH)))))))))))))))
fn KF_ExperFRest aa=
(kugegrn=aa.name
kugecolor=aa.wireColor
kugecenter=aa.center
kugeparent=aa.parent
kugeGroup=isGroupMember aa
kugenew=mesh lengthsegs:1 widthsegs:1 position:kugecenter wireColor:kugecolor name:kugegrn
kugenew.parent=kugeparent
setGroupMember kugenew kugeGroup
meshop.attach kugenew.mesh aa.mesh targetNode:kugenew sourceNode:aa
meshop.deleteFaces kugenew.mesh #{1..2} delIsoVerts:true
return kugenew)
fn Groupfiltrate vvvaaa addsdsd=           
(local lcl_groupcol,kugegroup,lvlcount
lcl_groupcol=#()
kugegroup=#yes
for pp in vvvaaa where isGroupMember pp and not isOpenGroupMember pp do
(if (lvlcount=findItem lcl_groupcol pp.parent)== 0 then(append lcl_groupcol pp.parent
append lcl_groupcol 1)
else lcl_groupcol[lvlcount+1]+=1)
for y=1 to lcl_groupcol.count by 2 do(if lcl_groupcol[y].children.count!=lcl_groupcol[y+1] do
(kugegroup=yesNoCancelBox"新选择集中将包含有部分组,选择操作:\n是:整个选择.\n否:取消选择.\n取消:退出操作!"title:"部分组对象选择警告--阿酷提示"
exit))
if kugegroup==#yes do(thawSelection()
select vvvaaa
if addsdsd==true do for yy in selection do(if yy.isFrozen==true do unfreeze yy doLayer:true
if yy.isHiddenInVpt==true do unhide yy doLayer:true))
if kugegroup==#no do(thawSelection()
clearSelection()))
fn KF_SwitchCamObj aa bb cc XX1 XX2 XX3 XX4 ff1 ff2=
(viewport.setCamera aa
if cc then(if bb<5 do(if bb==1 then KL_AutoLight=KF_CamAutoLIGHT aa false KR_Render_MulCam.KC_CP3.value (KR_Render_MulCam.KC_RenC1.value*0.9) (KR_Render_MulCam.KC_RenC1.value*0.6) (KR_Render_MulCam.KC_RenC1.value*0.2) false
else(case aa.KP_MulLightType  of
(
"A":(if bb<4 do KL_AutoLight=KF_CamAutoLIGHT aa true KR_Render_MulCam.KC_CP3.value (KR_Render_MulCam.KC_RenC1.value*0.9) (KR_Render_MulCam.KC_RenC1.value*0.6) (KR_Render_MulCam.KC_RenC1.value*0.2) false)
"C":(if bb<4 do KF_LightStateFN ff1 false true "")
default:(KF_LightStateFN ff1 false false aa.KP_MulLightGro)
)
)
if (KL_LLname=aa.KP_MulObjectGro)!="C" and KL_LLname!="" then(KF_OBjectsStateFN ff2 false KL_LLname)
else(if bb<4 do KF_OBjectsStateFN ff2 true ""))
if (KL_BB1=aa.KP_MulMode)!="C" and KL_BB1!="" then(if KL_BB1!="V" then setrendertype #blowUp
else setrendertype #view)
else if bb<4 do setrendertype XX1
if (KL_BB1=aa.KP_MulDimen)!="C" and KL_BB1!="" then(KL_CCS=filterString KL_BB1 "X"
KL_renderHeight=KL_CCS[2] as Integer
KL_renderWidth=KL_CCS[1] as Integer
renderHeight=KL_renderHeight
renderWidth=KL_renderWidth)
else(if bb<4 do(KL_renderHeight=XX2
KL_renderWidth=XX3
renderHeight=KL_renderHeight
renderWidth=KL_renderWidth))
if (KL_BB1=aa.KP_MulReg)!="C" and KL_BB1!=""then(kugeRR=filterString KL_BB1 "  ( ) "
viewport.setBlowupRect viewport.activeViewport (Box2 (kugeRR[2] as integer) (kugeRR[3] as integer) (kugeRR[4] as integer) (kugeRR[5] as integer)))
else if bb<4 do viewport.setBlowupRect viewport.activeViewport XX4
if bb>=4 do renderSceneDialog.update()
#(KL_renderHeight,KL_renderWidth,KL_AutoLight))
else #(undefined,undefined,#()))
fn KF_UpperLcase zifu1=
