on KR_MoBankTVRoll3 open do
(KL_Oncecoun4=KR_MoBankTVRoll3.controls    ----首先集合对话框所有的控件
for m in KL_Oncecoun4 do(if classof m==dotNetControl do append KCG_ConLIstIT m   
if(matchPattern m.name pattern:"KC_UT*")do append KCG_ConUTLIst m  
if(matchPattern m.name pattern:"KC_UUT*")do append KCG_ConUUTLIst m   
if(matchPattern m.name pattern:"KL_AAAT*")do append KCG_ConDTypLI m)  ---依次归类收集图片控件组,根路径控件组,支路径控件组,库类型控件组;
KLF_FillRootTree())    -----初始化装载素材库;
on KR_MoBankTVRoll3 close do(try(DestroyDialog lcl_SUCaiSel)catch())))
if KR_MoBankTVRoll3!=undefined do
