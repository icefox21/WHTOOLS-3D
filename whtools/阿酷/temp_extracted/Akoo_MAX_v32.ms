global lcl_Slice_roll
global lcl_Slice_Fl
global KH_slicety=2
fn lcl_Tools_SliceTools=
(if (KL_JianCLigObj aaa:1 bbb:3 ccc:2) do(
if validModifier selection (SliceModifier()) do
(rollout lcl_Slice_roll "阿酷_切片工具"
(progressbar kugeSliceprog color:red
pickbutton kugeSlicestrart "点击切片辅助线" width:105 autoDisplay:true filter:kuge_singleFIshape  across:2 
button kugeSlicedel "清除切片" width:68
radiobuttons kugeslicekg "切片方式" labels:#("三角面","多边面") default:2 align:#left across:2
button kugeSlicedelV "切换方式" width:68
on kugeslicekg changed state do(global KH_slicety=state)
on kugeSlicestrart picked KUGEsliceshape do(undo on(
if IsValidNode KUGEsliceshape do(
kugeSlicestrart.text =KUGEsliceshape.name
KL_Vpp1o=(numKnots KUGEsliceshape 1)-1
for k=2 to KL_Vpp1o do(
kugeSliceprog.value = 100.*(k-1)/((numKnots KUGEsliceshape 1)-2)
kugeVER=pathTangent KUGEsliceshape (k*1/(numKnots KUGEsliceshape) as Float)
case kugepp=viewport.getType() of
(
#view_top:(ViewUpVector = [0,0,1])
#view_bottom:(ViewUpVector = [0,0,-1])
#view_front:(ViewUpVector = [0,-1,0])
#view_back:(ViewUpVector = [0,1,0])
#view_left:(ViewUpVector = [-1,0,0])
#view_right:(ViewUpVector = [1,0,0])
default:(ViewUpVector = [0,0,1])
)
kugerightVector = normalize (cross ViewUpVector kugeVER)
kugeyuanVector = normalize (cross ViewUpVector kugerightVector)
kugeTM= matrix3 kugerightVector ViewUpVector kugeyuanVector [0,0,0]
kugecur=selection.center
kugeSL = SliceModifier()
modPanel.addModToSelection kugeSL ui:true
try(kugeSL.Slice_Type = 0
kugeSL.Faces___Polygons_Toggle=(KH_slicety-1)
kugeSL.slice_plane.transform =kugeTM
kugeSL.slice_plane.position=((getKnotPoint KUGEsliceshape 1 k)-kugecur))
catch(kugeSL.切片类型 = 0
kugeSL.面_多边形切换=(KH_slicety-1)
kugeSL.切片平面.transform =kugeTM
kugeSL.切片平面.position=((getKnotPoint KUGEsliceshape 1 k)-kugecur))))
kugeSliceprog.value=0
setCommandPanelTaskMode mode:#create
setCommandPanelTaskMode mode:#modify))
on kugeSlicedel pressed do(undo on(
setCommandPanelTaskMode mode:#create
kugehga=getCurrentSelection()
thawSelection()
clearSelection()
KL_MMMMM1=kugehga.count
for i=1 to KL_MMMMM1 do(kugeMOFnum=kugehga[i].modifiers.count   
kugeSliceprog.value = 100.*i/KL_MMMMM1
for uu=1 to kugeMOFnum where kugehga[i].modifiers[kugeMOFnum+1-uu].name=="Slice" or kugehga[i].modifiers[kugeMOFnum+1-uu].name=="切片" do 
(deleteModifier kugehga[i] (kugeMOFnum+1-uu)))
kugeSliceprog.value=0
setCommandPanelTaskMode mode:#modify
select kugehga))
on kugeSlicedelV pressed do(undo on(
setCommandPanelTaskMode mode:#create
kugehga=getCurrentSelection()
kugeMOFnum=kugehga[1].modifiers.count   
kuglicejh=for uu=1 to kugeMOFnum where kugehga[1].modifiers[uu].name=="Slice" or kugehga[1].modifiers[uu].name=="切片" collect uu
if kugeslicekg.state==1 then(jkgA=2
kugeslicekg.state=2)
else(jkgA=1
kugeslicekg.state=1)
for kk in kuglicejh do(try(kugehga[1].modifiers[kk].Faces___Polygons_Toggle=(jkgA-1))
catch(kugehga[1].modifiers[kk].面_多边形切换=(jkgA-1)))
setCommandPanelTaskMode mode:#modify))
on lcl_Slice_roll rbuttondown a do DestroyDialog lcl_Slice_roll)
CreateDialog lcl_Slice_roll width:230 height:105 pos:[(mouse.screenpos[1]-230),mouse.screenpos[2]])))
global KF_RandomCHFN,KF_RandPerFN
global KGM_RandomObjCol=true
global KGM_RandomObjGro=true
global KGM_RandomObjFS=3
global KGM_RandomObjBFB=33
fn KF_RandomCHFN kuglOB KL_Hggff kugeGT=    
(local Kl_CCC=#()
while kuglOB.count>0 do(kugetemp=#()
if kuglOB.count-(kugeGT*KL_Hggff)>0 then kugeMO=kugeGT+1
else kugeMO=kugeGT
KL_Hggff-=1
for pp=1 to kugeMO do(kugejisuan=kugetemp.count+1
while kugetemp.count<kugejisuan do if findItem kugetemp kuglOB[(kugemm=random 1 kuglOB.count)]==0 do(append kugetemp kuglOB[kugemm]
deleteItem kuglOB kugemm))
append Kl_CCC kugetemp)
return Kl_CCC)
fn KF_RandPerFN aa bb=
(local kugetemp=#()
local kugetempB=#()
while kugetemp.count<=bb do if findItem kugetemp aa[(kugemm=random 1 aa.count)]==0 do(append kugetemp aa[kugemm]
deleteItem aa kugemm)
return #(kugetemp,aa))
fn lcl_Tools_RanSelect=
(if (KL_JianCLigObj aaa:1 bbb:3 ccc:2) do(
rollout lcl_RanSelect_roll "阿酷_随机选择对象" width:200 height:84
(local kuglOB1Back=#()
spinner KC_SN1 range:[1,15,KGM_RandomObjFS] type:#integer scale:1 fieldWidth:30 pos:[48,8]
spinner KC_SN2 range:[1,90,KGM_RandomObjBFB] type:#integer scale:1 fieldWidth:30 pos:[48,36]
button KL_CB1 "按份数区分" pos:[110,5] width:80
button KL_CB2 "按百分比选择" pos:[110,32] width:80
checkbox kugeRanColor "随机颜色" checked:KGM_RandomObjCol pos:[8,63]
checkbox kugeRanGroup "结组" checked:KGM_RandomObjGro pos:[80,63]
button KL_CB3 "更新初选" pos:[135,59] width:55
on KC_SN1 changed aa do KGM_RandomObjFS=aa
on KC_SN2 changed aa do KGM_RandomObjBFB=aa
on kugeRanColor changed aa do KGM_RandomObjCol=aa
on kugeRanGroup changed aa do KGM_RandomObjGro=aa
on KL_CB1 pressed do(undo on
(kuglOB1Back=for m in kuglOB1Back where IsValidNode m collect m
kuglOB1=join #() kuglOB1Back
if kuglOB1.count>1 do
(for m in kuglOB1 where m.parent!=undefined and findItem kuglOB1 m.parent==0 do if isGroupHead m.parent do ungroup m.parent
KL_Hggff1=KC_SN1.value 
kugeGT1=(floor(kuglOB1.count/(KL_Hggff1 as Float)))as Integer
if kugeGT1>0 do(KL_CollRanObj=KF_RandomCHFN kuglOB1 KL_Hggff1 kugeGT1    
KL_MMMMM1=KL_CollRanObj.count                                                     
if KL_MMMMM1>0 do(if kugeRanColor.checked do(lclRANCOL=(for h=1 to KL_MMMMM1 collect(random black white))
for kl=1 to KL_MMMMM1 do for oi in KL_CollRanObj[kl] do oi.wireColor=lclRANCOL[kl])

if kugeRanGroup.checked do for kl=1 to KL_MMMMM1 do group KL_CollRanObj[kl] name:("Random-"+kl as string)
select KL_CollRanObj[1])
gc light:true))))
on KL_CB2 pressed do(undo on
(kuglOB1Back=for m in kuglOB1Back where IsValidNode m collect m
kuglOB1=join #() kuglOB1Back
if kuglOB1.count>1 do
(for m in kuglOB1 where m.parent!=undefined and findItem kuglOB1 m.parent==0 do if isGroupHead m.parent do ungroup m.parent
KL_Hggff1=KC_SN2.value 
kugeGT1=(floor(kuglOB1.count*KL_Hggff1/100))as Integer                    
if kugeGT1>0 do(KL_CollRanObj=KF_RandPerFN kuglOB1 kugeGT1   
KL_MMMMM1=KL_CollRanObj.count 
KL_MMMMM2=KL_CollRanObj[1].count  
if KL_MMMMM2>0 do(if kugeRanColor.checked do(lclRANCOL=(for h=1 to KL_MMMMM1 collect(random black white))
for kl=1 to KL_MMMMM1 do for oi in KL_CollRanObj[kl] do oi.wireColor=lclRANCOL[kl])

if kugeRanGroup.checked do for kl=1 to KL_MMMMM1 do group KL_CollRanObj[kl] name:("Random-"+kl as string)
select KL_CollRanObj[1])
gc light:true))))
on KL_CB3 pressed do(kuglOB1Back=for i in selection where(ViewgeoFilt i or isGroupHead i) and not isGroupMember i collect i) 
on lcl_RanSelect_roll open do(kuglOB1Back=for i in selection where(ViewgeoFilt i or isGroupHead i) and not isGroupMember i collect i)
on lcl_RanSelect_roll rbuttondown a do DestroyDialog lcl_RanSelect_roll)
CreateDialog lcl_RanSelect_roll pos:[(mouse.screenpos[1]-200),mouse.screenpos[2]]))
