fn lcl_SaveAbnormal=
(if (KL_JianCLigObj aaa:1 bbb:3 ccc:2) do(
try(DestroyDialog KR_RYInfoPurge)catch()
rollout KR_RYInfoPurge "阿酷冗余信息清理工具"
(local KL_GuijinJH,KL_MixChannelJH,KL_CollisionsJH,RongYUZS
progressbar KL_aa1
button KL_VV1 "开始清理" 
label KC_LBa1
on KL_VV1 pressed do(KL_BBBsrtn=0
if KL_GuijinJH>100 do(KL_CCCm=0
KL_BB=1
while(trackViewNodes[KL_BB]!=undefined) do(KL_GJnum=numNoteTracks trackViewNodes[KL_BB]
if KL_GJnum>100 then(deleteTrackViewController trackViewNodes trackViewNodes[KL_BB].controller
KL_BBBsrtn+=KL_GJnum)
else KL_BB+=1
KL_aa1.value=((1.0*1)+KL_BBBsrtn)/RongYUZS))
if KL_MixChannelJH>100 do(for i=1 to KL_MixChannelJH do(theMixer.removeMaxMixer 1 false 1
KL_aa1.value=((1.0*i)+KL_BBBsrtn)/RongYUZS))
KL_BBBsrtn+=KL_MixChannelJH
if KL_CollisionsJH>100 do(reactor.reactorInterface.clearStoredCollisions()
KL_aa1.value=100)		
KL_BBBsrtn+=KL_CollisionsJH																					   
try(gc())catch()     
KL_aa1.value=0
KC_LBa1.text="已清理完毕,尝试保存新文件!")
on KR_RYInfoPurge open do(KL_GuijinJH=0
try(KL_BB=1
while(trackViewNodes[KL_BB]!=undefined) do(if numNoteTracks trackViewNodes[KL_BB]>100 do KL_GuijinJH+=numNoteTracks trackViewNodes[KL_BB]
KL_BB+=1))catch()
if KL_GuijinJH<=100 do KL_GuijinJH=0
KL_CollisionsJH=reactor.reactorInterface.getNumStoredCollisions()
if KL_CollisionsJH<=100 do KL_CollisionsJH=0
KL_MixChannelJH=0
try(KL_MixChannelJH+=theMixer.numMaxMixers())catch()
if KL_MixChannelJH<=100 do KL_MixChannelJH=0
RongYUZS=KL_GuijinJH+KL_MixChannelJH+KL_CollisionsJH
if RongYUZS>100 then(KC_LBa1.text="可清理数量:"+(RongYUZS as string))
else(try(gc())catch()
KC_LBa1.text="已清理完毕,尝试保存新文件!"))
on KR_RYInfoPurge rbuttondown a do DestroyDialog KR_RYInfoPurge)
CreateDialog  KR_RYInfoPurge))
fn lcl_Win_Cross=
(if (KL_JianCLigObj aaa:1 bbb:3 ccc:2) do(
local lcl_AutoCross=getINISetting (getMAXIniFile()) "Performance" "AutoCross"
local lcl_AutoCrossDir=getINISetting (getMAXIniFile()) "Performance" "AutoCrossDir"
if lcl_AutoCross!="1" or lcl_AutoCrossDir!="0" then maxOps.setSelectionType true 0
else maxOps.setSelectionType true 1))
if not autosave.Enable do autosave.Enable=true
if(getINISetting AK_INIT_File "KR_ABackLoader" "ColumnSort")=="" do setINISetting AK_INIT_File "KR_ABackLoader" "ColumnSort" "ShunXDec"
