KC_BU1.enabled=a
undo on(lcl_FiArrayFN KC_BU4.state lcl_FiArrayPath false)
KC_BU2.visible=(KC_Sub1.enabled and not KC_BU1.enabled))
on KC_BU1 pressed do(undo on(lcl_FiArrayFN KC_BU4.state lcl_FiArrayPath false))
on KC_BUA pressed do(undo on(group(join (getCurrentSelection())(for m in KL_FillArrY where IsValidNode m collect m))select:true))
on KC_BUB pressed do(undo on(selectMore (for m in KL_FillArrY where IsValidNode m collect m)))
on KC_BUC pressed do(undo on(selectMore (for m in KL_FillArrY where IsValidNode m and canConvertTo m Mesh collect m)
lcl_collapse_Union()))
on KC_BUD pressed do(DestroyDialog lcl_FiArray_roll
undo on(delete (for m in KL_FillArrY where IsValidNode m collect m)))
on KC_BUE pressed do(DestroyDialog lcl_FiArray_roll)
on KC_RA1 changed aa do(KL_FillSat=aa
KC_Sub2.enabled=(KL_FillSat==2)
KC_Sub1.enabled=(KL_FillSat==1)
