KG_RenCamlName=Kl_KKCCmo[2]
KR_Render_MulCam.KC_MB15.items=KG_RenCamlName)
on KC_BT1 pressed do(KC_DL11X.text="对象层选择"
KF_KLMN  ""
DestroyDialog KR_SceGroSel3)
